        // Método auxiliar para calcular período basado en mes
        private int CalcularPeriodoPorMes(int mes)
        {
            if (mes >= 1 && mes <= 4) return 1;
            if (mes >= 5 && mes <= 8) return 2;
            return 3;
        }

