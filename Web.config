  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- Sub domain | Local environment -->
    <add key="SubDomain" value="tutorias" />
    <!-- Sub domain | Production environment   -->
    <!--<add key="SubDomain" value="test_tutorias" />-->
    <!--Cookie | Local environment-->
    <add key="CookieDomain" value=".localhost.local" />
    <add key="Port" value="5123" />
    <add key="Scheme" value="http" />
    <!-- Corte automatico programado: token que valida el endpoint EjecutarCorteProgramado -->
    <add key="CorteProgramado.Token" value="GJY3ENW5jtY978XWyp0POW8On1z0b4ykFA5ACGXIez8m54sN" />
    <!-- Notificaciones por correo del modulo de Estadisticas (corte de ciclo y alerta de cierre).
         Deshabilitadas por decision del usuario 2026-07-07; poner en "true" para reactivarlas. -->
    <add key="Estadisticas.NotificacionesCorreo" value="false" />
    <!-- SMTP (opcional; si se omite, EmailService usa los valores de Gmail por defecto) -->
    <add key="Smtp.Host" value="smtp.gmail.com" />
    <add key="Smtp.Port" value="587" />
    <add key="Smtp.User" value="uttn.tutorias@gmail.com" />
    <add key="Smtp.Password" value="xhxrfrfpxhaipohw" />
    <add key="Smtp.From" value="uttn.tutorias@gmail.com" />
    <add key="Smtp.EnableSsl" value="true" />
    <!-- Kill-switch global de correo. En LOCAL debe ser false: ningun endpoint (ni el corte
         automatico) debe enviar correos reales durante pruebas. En produccion: true. -->
    <add key="Correo.Habilitado" value="false" />
    <!-- Cookie | Production environment -->
    <!--<add key="CookieDomain" value=".uttn.app" />-->
  </appSettings>
