  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Header para especificar el idioma del contenido -->
        <add name="Content-Language" value="es-MX" />
        <!-- Headers de seguridad adicionales (opcionales) -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <!-- Archivos JavaScript con UTF-8 -->
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript; charset=utf-8" />
      <!-- Archivos CSS con UTF-8 -->
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
      <!-- Archivos JSON con UTF-8 -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>
    <validation validateIntegratedModeConfiguration="false" />
