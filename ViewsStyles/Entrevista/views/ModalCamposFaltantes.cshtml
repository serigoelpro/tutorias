
@inherits System.Web.Mvc.WebViewPage
<div class="modal fade" id="ModalCamposFaltantes" tabindex="-1" role="dialog" aria-labelledby="modalCamposFaltantesLabel">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="ModalCamposFaltantesLabel">Faltan campos por responder</h4>
            </div>
            <div class="modal-body">
                Por favor, responde todas las preguntas antes de continuar.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

