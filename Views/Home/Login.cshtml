@model Plataforma_Web.Models.Usuario

@*<body>
        <img alt="full screen background image" src="~/Imagenes/ImagenesPagina/fotopoligonal.jpg" />
    </body>*@

@{
    /**/

    ViewBag.Title = "Inicio de sesión";
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <br />

    <div class="form-horizontal" id="Login">


        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <center>
            <div class="row">
                <div class="col-md-4 col-md-offset-4">
                    <div class="well">

                        <h2>Inicio de Sesión</h2>
                        <hr class="" />
                        <div class="form-group" id="Login">
                            @*@Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "control-label col-md-5" })*@
                            <label for="fullname" class="control-label">Matrícula</label>
                            <div class="col-md-12">
                           
                                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Ingresa tu matrícula" } })
                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group" id="Login">
                            @*@Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-md-5" })*@
                            <label for="fullname" class="control-label">Contraseña</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Ingresa tu contraseña" } })
                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">

                            <div class="col-md-12">
                                <input type="submit" value="Iniciar Sesión" class="btn btn-primary btn-lg btn-block" />
                                <hr />
                                <label class="text-info" style="">¿Olvidaste tu contraseña?</label>
                                <a href="@Url.Action("Index","Contraseña")" class="btn btn-default btn-lg btn-block col-md-11">Recuperar Contraseña</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </center>
    </div>

}
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <script type="text/javascript">
                alert("@ViewBag.Mensaje");
    </script>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
