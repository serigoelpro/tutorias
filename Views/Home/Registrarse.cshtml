@model Plataforma_Web.Models.Usuario
@{
    ViewBag.Title = "Registrarse";
}

<h2 class="text-center">Registrarse</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-horizontal">
        <center>
            <div class="row">
                <div class="col-md-4 col-md-offset-4">
                    <div class="well">
                        <h4>Introduce tus datos</h4>
                        <div class="form-group">
                            @*@Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "control-label col-md-2" })*@
                            <label for="fullname" class="control-label">Matrícula</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Matrícula" } })
                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @*@Html.LabelFor(model => model.NombreCompleto, htmlAttributes: new { @class = "control-label col-md-2" })*@
                            <label for="fullname" class="control-label">Correo electrónico</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.NombreCompleto, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "nombre.apellido@uttn.mx" } })
                                @Html.ValidationMessageFor(model => model.NombreCompleto, "", new { @class = "text-danger" })
                            </div>
                        </div>



                        <div class="form-group">
                            <label for="fullname" class="control-label">Contraseña</label>
                            @*@Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label" })*@
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Contraseña" } })
                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="submit" value="Registrar" class="btn btn-primary btn-lg btn-block" />
                                <hr />
                                <a class="btn btn-default btn-lg btn-block" href="@Url.Action("Index")" role="button"><span class="glyphicon glyphicon-arrow-left"></span> Regresar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </center>

    </div>
}

<div>

</div>
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <script type="text/javascript">
                alert("@ViewBag.Mensaje");
    </script>
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
