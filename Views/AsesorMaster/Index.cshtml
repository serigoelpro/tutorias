@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Plataforma_Web.Models.TutoriaGrupal
@{
    /**/

    ViewBag.Title = "Index";
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}
<div class="sga-scope">
    <h2>Grupos asignados</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h4>Seleccione un Grupo</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">

                <div class="form-group">
                    @Html.LabelFor(model => model.IdCarrera, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.IdTutoriaGrupal, (List<SelectListItem>)ViewBag.Grupos, "Seleccione un Grupo", new { @class = "form-control small" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Buscar" class="btn btn-default" />
                    </div>
                </div>

            </div>
        </div>
    }
</div>
    @section Scripts {
        <script src="~/ViewsStyles/Master/sga-theme.js"></script>
    }
