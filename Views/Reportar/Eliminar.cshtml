
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <link rel="icon" type="image/png" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Fin</title>
    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700" rel="stylesheet">

    <!-- Animate.css -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/animate.css">
    <!-- Icomoon Icon Fonts-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/icomoon.css">
    <!-- Themify Icons-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/themify-icons.css">
    <!-- Bootstrap  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/magnific-popup.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap-datepicker.min.css">

    <!-- Owl Carousel  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/EsilosEntrevista/css/owl.theme.default.min.css">

    <!-- Theme style  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/style.css">

    <!-- Modernizr JS -->
    <script src="~/EstilosEntrevista/js/modernizr-2.6.2.min.js"></script>
</head>
<body>


    <div class="gtco-loader"></div>

    <div id="page">



        <header id="gtco-header" class="gtco-cover gtco-cover-md" role="banner" style="background-image: url(../../EstilosEntrevista/images/img_4.jpg)" data-stellar-background-ratio="0.8">
            <div class="overlay"></div>
            <div class="gtco-container">
                <div class="row">
                    <div class="col-md-12 col-md-offset-0 text-left">
                        <div class="row row-mt-15em">
                            <div class="col-md-7 mt-text animate-box" data-animate-effect="fadeInUp">
                                <span class="intro-text-small">Termino de realizar el informe</span>
                                <h1>Informe terminado</h1>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            <div class="gtco-section">
                <div class="gtco-container">

                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6">

                        </div>

                        <div class=" col-md-4 col-sm-6">
                            <a href="@Url.Action("Grupo", "Entrevistas")">
                                <span class="btn btn-primary fh5co-card-item" style="border: 2px solid #fff0 !important;background: #fff0;">
                                    <input type="submit" class="btn btn-primary btn-block" value="Finalizar">
                                </span>
                            </a>
                        </div>

                        <div class=" col-md-4">

                        </div>
                    </div>
                </div>
            </div>
        </header>

    </div>



    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
    {
        <script type="text/javascript">
                alert("@ViewBag.Mensaje");
        </script>
    }
    <!-- jQuery -->
    <script src="~/EstilosEntrevista/js/jquery.min.js"></script>
    <!-- jQuery Easing -->
    <script src="~/EstilosEntrevista/js/jquery.easing.1.3.js"></script>
    <!-- Bootstrap -->
    <script src="~/EstilosEntrevista/js/bootstrap.min.js"></script>
    <!-- Waypoints -->
    <script src="~/EstilosEntrevista/js/jquery.waypoints.min.js"></script>
    <!-- Carousel -->
    <script src="~/EstilosEntrevista/js/owl.carousel.min.js"></script>
    <!-- countTo -->
    <script src="~/EstilosEntrevista/js/jquery.countTo.js"></script>

    <!-- Stellar Parallax -->
    <script src="~/EstilosEntrevista/js/jquery.stellar.min.js"></script>

    <!-- Magnific Popup -->
    <script src="~/EstilosEntrevista/js/jquery.magnific-popup.min.js"></script>
    <script src="~/EstilosEntrevista/js/magnific-popup-options.js"></script>

    <!-- Datepicker -->
    <script src="~/EstilosEntrevista/js/bootstrap-datepicker.min.js"></script>


    <!-- Main -->
    <script src="~/EstilosEntrevista/js/main.js"></script>
</body>
</html>
