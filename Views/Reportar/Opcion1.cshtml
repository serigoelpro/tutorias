@model Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales


@{
    int control = ViewBag.id;
    /**/
    int gru = ViewBag.grup;
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <link rel="icon" type="image/png" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Datos Personales</title>
    <!-- custom style sheet -->
    <!-- Animate.css -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/animate.css">
    <!-- Icomoon Icon Fonts-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/icomoon.css">
    <!-- Themify Icons-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/themify-icons.css">
    <!-- Bootstrap  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/magnific-popup.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap-datepicker.min.css">

    <!-- Owl Carousel  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.theme.default.min.css">

    <!-- Theme style  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/style.css">

    <!-- Modernizr JS -->
    <script src="~/EstilosEntrevista/js/modernizr-2.6.2.min.js"></script>

</head>
<body>
    @using (Html.BeginForm("DatosPersonales", "Entrevista", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div id="page">
            <header id="gtco-header" role="banner" style="background-color:white" data-stellar-background-ratio="0.8">
                <div class="overlay"></div>
                <div class="gtco-container">
                    <div class="row">
                        <div class="col-md-12 col-md-offset-0 text-left">


                            <div class="row" style="margin-top: 2em;">

                                <div class="col-md-10 col-md-push-1 animate-box" data-animate-effect="fadeInRight">
                                    <div class="form-wrap">
                                        <div class="tab">

                                            <div class="tab-content">
                                                <div class="tab-content-inner active" data-content="signup">
                                                    <h3>Informe de alumno</h3>
                                                    <form action="#">
                                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                @*<h4>
                                                                    El problema con este alumno corresponde a los datos ingresados, si los datos del alumno no son coherentes seleccione la Opcion 1.
                                                                </h4>
                                                                <h6>El alumno sera notificado por correo para actualizar su entrevista</h6>
                                                                <br />
                                                                <h4>
                                                                 Si el alumno no corresponde a su grupo seleccione la Opcion 2.
                                                                </h4>*@
                                                                <h6>
                                                                    @*Los datos del alumno seran eliminados, esto incluye toda la entrevista inicial junto con los datos de la seccion del tutor (exani, vulnerabilidad y examen psicometrico), seguimiento individual y tramite de baja correspondientes a este alumno en caso de existir y sera notificado por correo para que realice la entrevista nuevamente.*@
                                                                    El alumno sera removido del grupo y sera notificado por correo de ser posible, sus datos estaran disponibles para ser revisados por el cordinador.
                                                                </h6>
                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            @*<div class="col-md-6">
                                                                
                                                                <div class="row form-group">
                                                                    <div class="col-md-12">
                                                                        <input type="button" onclick="location.href = '@Url.Action("Editar", new { id = control })'" class="btn btn-primary btn-block" value="Opcion 1">
                                                                    </div>

                                                                </div>

                                                            </div>*@
                                                            <div class="col-md-6">

                                                                <div class="row form-group">
                                                                    <div class="col-md-12">
                                                                        <input type="button" style="background-color:green;" onclick="location.href='@Url.Action("Grupo","Entrevistas")'" class="btn btn-primary btn-block" value="Regresar">
                                                                    </div>

                                                                </div>

                                                            </div>

                                                            <div class="col-md-6">
                                                                
                                                                <div class="row form-group">
                                                                    <div class="col-md-12">
                                                                        <input type="button" style="background-color:red;" onclick="location.href='@Url.Action("Eliminar", new { id = control })'" class="btn btn-primary btn-block" value="Remover alumno">
                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>


                                                    </form>

                                                </div>



                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>



                        </div>

                    </div>

                </div>

            </header>


        </div>



        <!-- jQuery -->

        <script src="~/EstilosEntrevista/js/jquery.min.js"></script>

        <!-- jQuery Easing -->

        <script src="~/EstilosEntrevista/js/jquery.easing.1.3.js"></script>

        <!-- Bootstrap -->

        <script src="~/EstilosEntrevista/js/bootstrap.min.js"></script>

        <!-- Waypoints -->

        <script src="~/EstilosEntrevista/js/jquery.waypoints.min.js"></script>

        <!-- Carousel -->

        <script src="~/EstilosEntrevista/js/owl.carousel.min.js"></script>

        <!-- countTo -->

        <script src="~/EstilosEntrevista/js/jquery.countTo.js"></script>


        <!-- Stellar Parallax -->

        <script src="~/EstilosEntrevista/js/jquery.stellar.min.js"></script>


        <!-- Magnific Popup -->

        <script src="~/EstilosEntrevista/js/jquery.magnific-popup.min.js"></script>

        <script src="~/EstilosEntrevista/js/magnific-popup-options.js"></script>


        <!-- Datepicker -->

        <script src="~/EstilosEntrevista/js/bootstrap-datepicker.min.js"></script>



        <!-- Main -->

        <script src="~/EstilosEntrevista/js/main.js"></script>
        if (!string.IsNullOrEmpty(ViewBag.Mensaje))
        {
            <script type="text/javascript">
                alert("@ViewBag.Mensaje");
            </script>
        }
    }

</body>
</html>


