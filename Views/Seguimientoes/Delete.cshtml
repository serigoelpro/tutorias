@using Plataforma_Web.Models.PrimeraEntrevista
@model PlataformaWeb.Models.Seguimiento

@{
    DatosPersonales Alumno = ViewBag.Alumno as DatosPersonales;
    ViewBag.Title = "Delete";
}

<h2>Eliminar</h2>

<h3>Estas seguro que deseas eliminar este registro?</h3>
<div>
    <h4>Seguimiento de @ViewBag.Alumno.Nombre</h4>
    <hr />
    <dl class="dl-horizontal">        
        <dt>
            @Html.DisplayNameFor(model => model.Fecha)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Fecha)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Vulnerabilidad)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Vulnerabilidad)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Problematica)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Problematica)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Accion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Accion)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-default" /> |
            @Html.ActionLink("Regresar", "Index",new {id=ViewBag.idind })
        </div>
    }
</div>
