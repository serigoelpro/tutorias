@using PlataformaWeb.Controllers @* Necesario para ver la clase BajaReporteItem *@
@model List<BajaReporteItem>

@{
    ViewBag.Title = "Solicitudes de bajas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int paginaActual = (int)(ViewBag.PaginaActual ?? 1);
    int totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 20);
    int? carreraSel = ViewBag.CarreraId as int?;
    string ordenSel = ViewBag.Orden as string ?? "fecha_desc";

    var _usrSesion = Session["Usuario"] as Plataforma_Web.Models.Usuario;
    var esDirector = _usrSesion != null && _usrSesion.EsDirector;

    // Ventana corta de páginas
    int radio = 2;
    int desde = Math.Max(1, paginaActual - radio);
    int hasta = Math.Min(totalPaginas, paginaActual + radio);
}
@section Styles{
    <style>
        /* Botón limpiar filtros: cuadrado pequeño con sombra suave */
        .sga-clear {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 2px;
            padding: 0;
            line-height: 1;
            font-size: 14px;
            font-weight: 700;
            border-radius: 50%;
            color: var(--primary);
            border-color: #dcdcdc;
        }

        .sga-xbtn:hover {
            box-shadow: var(--shadow-hover);
        }

        .sga-clear:hover {
            background: #ffffff;
            box-shadow: 0 6px 14px rgba(0,0,0,.12);
            text-decoration: none;
        }

        .sga-clear:active {
            transform: translateY(1px);
            box-shadow: 0 2px 6px rgba(0,0,0,.12);
        }

        .sga-clear:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(9,167,135,.20), 0 6px 14px rgba(0,0,0,.12);
        }

        .sga-xbtn:active {
            transform: translateY(1px);
        }

        .sga-xbtn:active {
            transform: translateY(1px);
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0,0,0,0);
            border: 0;
        }

        @@media print {
            @@page {
                size: landscape;
                margin: 1.5cm;
            }

            header,
            footer,
            nav,
            .navbar,
            .sidebar,
            aside {
                display: none !important;
            }

            .no-print {
                display: none !important;
            }

            body, html {
                margin: 0 !important;
                padding: 0 !important;
                width: 100%;
                background: #fff !important;
            }

            .sga-scope {
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
                box-shadow: none !important;
            }
            /* 6. ¡Hacemos que el título se vea bien! */
            .page-title {
                text-align: center;
                font-size: 16pt; /* Un poco más pequeño que antes */
                font-weight: bold;
                margin-bottom: 20px;
                padding-top: 0; /* Sin padding extra arriba */
            }
            /* 7. CONTENEDOR DE TABLA */
            .table-responsive {
                position: static !important;
                width: 100% !important;
                margin-top: 15px;
                padding: 0;
                border: none;
                overflow: visible !important;
            }

            #gruposTable {
                width: 100% !important;
                table-layout: fixed !important;
                overflow-wrap: break-word;
            }

                #gruposTable th,
                #gruposTable td {
                    white-space: normal !important;
                    overflow-wrap: break-word;
                    font-size: 11pt !important;
                    padding: 5px 8px !important;
                }
        }

        .sga-scope {
            text-transform: uppercase;
        }

        /* Estilos para columna expandible de causa */
        .causa-toggle {
            transition: all 0.2s ease;
            cursor: pointer;
            padding: 4px 8px;
            border: none;
            background: transparent;
            color: #2d6a4f;
        }

        .causa-toggle:hover {
            background-color: #f0f0f0;
            border-radius: 4px;
        }

        .causa-toggle i {
            transition: transform 0.2s ease;
        }

        .causa-content {
            margin-top: 8px;
            padding: 10px;
            background: #f8f9fa;
            border-left: 3px solid #2d6a4f;
            font-size: 0.9em;
            line-height: 1.6;
            display: none;
        }

        .causa-content strong {
            color: #2d6a4f;
        }

        /* Estilos para buscador */
        .search-box-container {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 15px 20px;
            margin-bottom: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .search-input-wrapper {
            position: relative;
            max-width: 500px;
        }

        .search-input-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            pointer-events: none;
        }

        #searchBajas {
            padding-left: 38px;
            padding-right: 12px;
            border: 1px solid #dcdcdc;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        #searchBajas:focus {
            border-color: #2d6a4f;
            box-shadow: 0 0 0 3px rgba(45,106,79,.1);
            outline: none;
        }

        #searchBajas::placeholder {
            color: #adb5bd;
        }
    </style>
}

<link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />

<div class="sga-scope">
    <h2 class="page-title">Reportes de bajas</h2>
    <p class="page-subtle no-print">Filtra y visualiza las solicitudes de baja. Usa los botones de impresión para obtener reportes.</p>

    <div class="filters-card card p-3 mb-4 no-print">
        @using (Html.BeginForm("ReporteBajas", "Bajas", FormMethod.Get, new { @class = "row", style = "margin-bottom:0;" }))
        {
            // Campo Oculto para mantener el tamaño de página actual
            @Html.Hidden("pageSize", pageSize)

            <div class="col-md-4 mb-3">
                <div class="form-group">
                    <label for="carreraId" class="control-label form-label no-print">Carrera</label>
                    @Html.DropDownList(
                        "carreraId",
                        (IEnumerable<SelectListItem>)ViewBag.Carreras,
                        new { @class = "form-control form-select", @onchange = "this.form.submit()" })
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="form-group">
                    <label for="periodo" class="control-label form-label no-print">Periodo</label>
                    @Html.DropDownList(
                        "periodo",
                        (IEnumerable<SelectListItem>)ViewBag.Periodos,
                        "TODOS LOS PERIODOS",
                        new { @class = "form-control form-select", @onchange = "this.form.submit()" })
                </div>
            </div>

            <div class="col-md-3 mb-3 no-print">
                <div class="form-group">
                    <label for="orden" class="control-label form-label">Ordenar por</label>
                    <select name="orden" id="orden" class="form-control form-select" onchange="this.form.submit()">
                        <option value="fecha_desc" @(ViewBag.Orden == "fecha_desc" ? "selected" : "")>FECHA (MAS RECIENTE)</option>
                        <option value="fecha_asc" @(ViewBag.Orden == "fecha_asc" ? "selected" : "")>FECHA (MAS ANTIGUA)</option>
                        <option value="folio_asc" @(ViewBag.Orden == "folio_asc" ? "selected" : "")>FOLIO (ASCENDENTE)</option>
                        <option value="folio_desc" @(ViewBag.Orden == "folio_desc" ? "selected" : "")>FOLIO (DESCENDENTE)</option>
                        <option value="nombre_asc" @(ViewBag.Orden == "nombre_asc" ? "selected" : "")>NOMBRE (A-Z)</option>
                        <option value="nombre_desc" @(ViewBag.Orden == "nombre_desc" ? "selected" : "")>NOMBRE (Z-A)</option>
                        <option value="grupo_asc" @(ViewBag.Orden == "grupo_asc" ? "selected" : "")>GRUPO (A-Z)</option>
                        <option value="grupo_desc" @(ViewBag.Orden == "grupo_desc" ? "selected" : "")>GRUPO (Z-A)</option>
                        <option value="tutor_asc" @(ViewBag.Orden == "tutor_asc" ? "selected" : "")>TUTOR (A-Z)</option>
                        <option value="tutor_desc" @(ViewBag.Orden == "tutor_desc" ? "selected" : "")>TUTOR (Z-A)</option>
                    </select>
                </div>
            </div>
            <!-- Limpiar -->
            <div class="col-md-2 no-print">
                <div class="form-group">
                    <label class="control-label">&nbsp;</label>
                    <div>
                        @* Versión que limpia todo *@
                        @Html.ActionLink("×", "ReporteBajas", "Bajas", null,
                          new { @class = "sga-xbtn", @title = "Limpiar filtros", role = "button", aria_label = "Limpiar filtros" })

                        @* Si quieres conservar pageSize:
                            @Html.ActionLink("×", "ReporteBajas", "Bajas", new { pageSize = pageSize },
                              new { @class = "sga-xbtn", @title = "Limpiar filtros", role = "button", aria_label = "Limpiar filtros" })
                        *@
                    </div>
                </div>
            </div>

        }
    </div>

    <!-- Buscador -->
    <div class="search-box-container no-print">
        <div class="search-input-wrapper">
            <i class="fa fa-search"></i>
            <input type="text"
                   id="searchBajas"
                   class="form-control"
                   placeholder="BUSCAR POR MATRÍCULA, NOMBRE DEL ALUMNO O TUTOR..."
                   autocomplete="off" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="results-bar">
            @if ((int)(ViewBag.Total ?? 0) > 0)
            {
                <span id="contadorResultados" class="badge-soft no-print">@(ViewBag.Total) resultados</span>
            }
            <div class="no-print d-flex gap-2">
                <a class="btn btn-utt-outline no-print"
                   href="@Url.Action("ReporteBajas", new { carreraId = ViewBag.CarreraId, orden = ViewBag.Orden, periodo = ViewBag.Periodo, imprimir = true })">
                    <i class="fa fa-print"></i> Imprimir todo
                </a>
                <button type="button" class="btn btn-utt-outline no-print" onclick="window.print()">
                    <i class="fa fa-print no-print"></i> IMPRIMIR PÁGINA
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table id="gruposTable" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th style="width: 80px;">Motivo</th>
                        <th>Fecha</th>
                        <th>Nombre de alumno</th>
                        <th>Matrícula</th>
                        <th>Grupo</th>
                        <th>Carrera</th>
                        @* Columna Tutor: Ahora muestra al tutor del grupo *@
                        <th>Tutor de Grupo</th>

                        @* Columna Condicional para Master *@
                        @if (ViewBag.NivelUsuario == 4)
                        {
                            <th class="no-print">Elaborada por</th>
                        }

                        <th class="no-print">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Revocada: Activo=false pero NO es reingreso (revocación externa)
                        bool esRevocada = item.Baja.Activo == false && item.Baja.Reingreso != 1;

                        // Solo las revocadas tienen fondo gris, las reincorporadas se ven normales
                        string rowStyle = esRevocada ? "background-color: #fce8e6; color: #999;" : "";

                        <tr style="@rowStyle">
                            <td data-label="Folio">
                                @item.Baja.Folio
                                @if (esRevocada)
                                {<br /><small class="badge bg-danger" style="background:red; color:white;">REVOCADA</small>}
                            </td>

                            <td data-label="Motivo">
                                <button type="button" class="causa-toggle no-print" data-target="causa-@item.Baja.IdBaja" title="Ver causa de la baja">
                                    <i class="fa fa-chevron-down"></i>
                                </button>
                                <div id="causa-@item.Baja.IdBaja" class="causa-content">
                                    <strong>Categoría:</strong> @(item.Baja.Causa ?? "No especificada")<br />
                                    <strong>Causa:</strong> @(item.Baja.Otra ?? "Sin descripción")
                                </div>
                            </td>

                            @* Agregamos data-order con formato yyyyMMdd para que el plugin sepa ordenar fechas *@
                            <td data-label="Fecha" data-order="@item.Baja.Fecha.ToString("yyyyMMddHHmm")">
                                @item.Baja.Fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td data-label="Nombre de alumno">@item.Baja.Nombre</td>
                            <td data-label="Matrícula">@item.Baja.Matricula</td>
                            <td data-label="Grupo">@item.Baja.Grupo</td>
                            <td data-label="Carrera">@item.Baja.Carrera</td>

                            @* AQUI MOSTRAMOS EL TUTOR REAL (sacado del Join) *@
                            <td data-label="Tutor de Grupo">@item.NombreTutorReal</td>

                            @* SI ES MASTER: Mostramos quien hizo el trámite *@
                            @if (ViewBag.NivelUsuario == 4)
                            {
                                <td class="no-print" data-label="Elaborada por">
                                    @item.Baja.RealizadoPor
                                </td>
                            }

                            <td class="text-center no-print" data-label="Acciones">
                                @Html.ActionLink(
                                    "Detalles", "Index", "Bajas",
                                    new { id = item.Baja.IdPersona, fromReporte = true },
                                    new { @class = "btn btn-info btn-sm" })

                                @if (item.Baja.Reingreso == 1)
                                {
                                    <br />
                                    <span class="btn btn-success btn-sm disabled" style="margin-top:5px; cursor:default; opacity:1;">REINGRESADO</span>
                                }
                                else if (!esRevocada && !esDirector)
                                {
                                    using (Html.BeginForm("Reactivar", "Bajas", new { id = item.Baja.IdBaja }, FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        <button type="submit" class="btn btn-success btn-sm" style="margin-top:5px;" onclick="return confirm('¿Confirmar reingreso? Se reactivará el acceso del alumno.');">
                                            REINGRESO
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <span>
                @if (ViewBag.CarreraId != null)
                {
                    @:No hay solicitudes de baja para la carrera <strong>@(ViewBag.CarreraNombre ?? "seleccionada")</strong>.
                }
                else
                {
                    @:No hay solicitudes de baja registradas.
                }
            </span>
            <a class="btn btn-sm btn-utt-outline no-print" href="@Url.Action("ReporteBajas")">Ver todas</a>
        </div>
    }

    @* Ocultar paginación del servidor cuando DataTables maneja la paginación *@
    @*
        @if (totalPaginas > 1)
        {
            <nav class="no-print d-flex justify-content-center mt-3 no-print">
                <ul class="pagination pagination-utt">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ReporteBajas", new { carreraId = carreraSel, orden = ordenSel, periodo = ViewBag.Periodo, page = 1, pageSize = pageSize })">« Primero</a>
                    </li>
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ReporteBajas", new { carreraId = carreraSel, orden = ordenSel, periodo = ViewBag.Periodo, page = paginaActual - 1, pageSize = pageSize })">‹ Anterior</a>
                    </li>
                    @for (int i = desde; i <= hasta; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" href="@Url.Action("ReporteBajas", new { carreraId = carreraSel, orden = ordenSel, periodo = ViewBag.Periodo, page = i, pageSize = pageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ReporteBajas", new { carreraId = carreraSel, orden = ordenSel, periodo = ViewBag.Periodo, page = paginaActual + 1, pageSize = pageSize })">Siguiente ›</a>
                    </li>
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ReporteBajas", new { carreraId = carreraSel, orden = ordenSel, periodo = ViewBag.Periodo, page = totalPaginas, pageSize = pageSize })">Último »</a>
                    </li>
                </ul>
            </nav>
        }
    *@

    @if (ViewBag.Imprimir == true)
    {
        <script>
            (function () {
                var backUrl = '@Url.Action("ReporteBajas", "Bajas", new { carreraId = ViewBag.CarreraId, orden = ViewBag.Orden, periodo = ViewBag.Periodo })';
                function goBack() { window.location.replace(backUrl); }

                if ('onafterprint' in window) { window.addEventListener('afterprint', goBack); }
                var mql = window.matchMedia('print');
                if (mql.addEventListener) { mql.addEventListener('change', function (e) { if (!e.matches) goBack(); }); }
                else if (mql.addListener) { mql.addListener(function (e) { if (!e.matches) goBack(); }); }

                window.addEventListener('load', function () { setTimeout(function(){ window.print(); }, 0); });

            })();
        </script>
    }

    <script type="text/javascript">
        $(document).ready(function () {

            var tabla = $('#gruposTable').DataTable({
                paging: true,          // Habilitar paginación de DataTables
                pageLength: 20,        // 20 registros por página (igual que servidor)
                info: true,            // Mostrar info "Mostrando X de Y registros"
                searching: true,
                ordering: true,
                "order": [],           // Respetar orden del servidor
                autoWidth: false,
                dom: 'rtip',           // r=processing, t=table, i=info, p=pagination
                columnDefs: [
                    { orderable: false, targets: [1, 8] } // Columna Causa (índice 1) y Acciones (índice 8)
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json"
                }
            });

            // Conectar buscador con DataTables
            $('#searchBajas').on('keyup', function () {
                tabla.search(this.value).draw();
            });

            // Actualizar el badge de resultados cada vez que DataTables redibuja (búsqueda client-side)
            tabla.on('draw', function () {
                var info = tabla.page.info();
                $('#contadorResultados').text(info.recordsDisplay + ' resultados');
            });

            // Funcionalidad de expansión/colapso de causa
            $('.causa-toggle').on('click', function () {
                var targetId = '#' + $(this).data('target');
                var $content = $(targetId);
                var $icon = $(this).find('i');

                if ($content.is(':visible')) {
                    $content.slideUp(200);
                    $icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                } else {
                    $content.slideDown(200);
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                }
            });
        });
    </script>
</div>