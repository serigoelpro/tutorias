@{
    ViewBag.Title = "Grupos";
}

<style>
    .fixedPopUp {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1000;
    }

    .fixedPopUpHeading {
        margin: 20px;
        margin-bottom: 0px;
    }

    .student-name,
    .studentName {
        margin-top: 10px;
        min-height: 61px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile {
        margin: 10px;
        display: inline-block;
    }

    .centerContent {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .StudentImage {
        max-height: 150px;
    }

    .button {
        width: 100%;
    }

    .panelBody{
        min-height:55%;
    }

    .studentCardFooter{
        position: absolute;
        bottom: 5px;
    }

    .grow-on-hover{
        transition: transform 0.5s ease;
    }

    .grow-on-hover:hover {
        transform: scale(1.1);
    }
</style>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>

<div class="container" style="margin-top: 30px; margin-bottom: 15px;">

    <h2 id="groupTitle"></h2>

    <label>Carrera</label>
    <select id="specialtyGroup" class="form-control" style="display: inline-block">
    </select>

    <label style="margin-left: 15px;">Grupo</label>
    <select id="groupSelect" class="form-control" style="display: inline-block">
        <option selected>Selecciona un grupo...</option>
    </select>

    <button onclick="switchViewToTable()" class="btn btn-info glyphicon glyphicon-refresh pull-right"></button>
</div>

<div class="container-fluid centerContent" id="MainBody" style="padding-top: 30px">
    <div style="display:flex; align-items:center; justify-content:center; flex-direction:column;">

        <img src="~/Imagenes/noGroupSelected.png" style="height: 20vw">
        <h3>Seleccione un grupo para comenzar...</h3>
    </div>
</div>

<template id="studentCard">
    <div class="panel panel-default col-md-2 profile grow-on-hover" data-user-id="">
        <!-- Default panel contents -->
        <div class="panel-heading student-name"> </div>
        <div class="panel-body panelBody">
            <p>
                <img src="../../Imagenes/avatar.png" class="img-responsive studentImage"/>
            </p>
        </div>
        <!-- List group -->
        <ul class="list-group studentCardFooter">
            <li class="list-group-item">2316109217</li>
        </ul>
    </div>
</template>

<template id="studentPopUpMenu">
    <div class="panel panel-default col-md-3 fixedPopUp" data-user-id="5">
        <button type="button"
                class="close"
                aria-label="Close"
                id="PopUpCloseBtn">
            <span aria-hidden="true">&times;</span>
        </button>
        <div class="panel-heading fixedPopUpHeading">
            <div id="image&close-button-container center-block" style="display: flex; justify-content: center; align-items: center;">
                <img src="../../Imagenes/avatar.png" id="studentPopUpImage"
                     class="img-responsive StudentImage"
                     alt="Tijerina Medrano Mario Alberto" />
            </div>
            <p class="studentName"><strong></strong></p>
        </div>
        <div class="panel-body">
            <div class="btn-group-vertical" style="display: flex; flex-direction:column; justify-content: center; align-items: center;"
                 role="group"
                 aria-label="...">
                <button type="button" class="btn btn-primary">Revisar</button>
                <button type="button" class="btn btn-primary">Imprimir</button>
                <button type="button" class="btn btn-primary">
                    Seguimiento Individual
                </button>
                <button type="button" class="btn btn-danger">Tramitar Baja</button>
                <button type="button" class="btn btn-danger">
                    Remover del Grupo
                </button>
                <button type="button" class="btn btn-danger">Eliminar</button>
            </div>
        </div>
    </div>
</template>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/js/bootstrap.min.js"
        integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa"
        crossorigin="anonymous"></script>
 
<script src="/Script/MainGrupos.js"></script>

