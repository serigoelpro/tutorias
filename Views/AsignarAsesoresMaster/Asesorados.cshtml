@model List<Plataforma_Web.Models.TutoriaGrupal>

@{
    ViewBag.Title = "Grupos Asignados";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tutor = ViewBag.Usuario as Plataforma_Web.Models.Usuario;

    var grados = ViewBag.Grados as Dictionary<int, string> ?? new Dictionary<int, string>();
    var grupos = ViewBag.Grupos as Dictionary<int, string> ?? new Dictionary<int, string>();
    var carreras = ViewBag.Carreras as Dictionary<int, string> ?? new Dictionary<int, string>();
    var turnos = ViewBag.Turnos as Dictionary<int, string> ?? new Dictionary<int, string>();
    var periodos = ViewBag.Periodos as Dictionary<int, string> ?? new Dictionary<int, string>();
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}

<div class="sga-scope">

    @if (tutor != null)
    {
        <h2>Grupos Asignados</h2>
        <div class="panel panel-info">
            <div class="panel-heading">
                <h4>Tutor: @tutor.NombreCompleto</h4>
            </div>
            <div class="panel-body">
                <p><strong>Correo:</strong> @tutor.CorreoElectronico</p>
                <p>
                    @Html.ActionLink("Asignar Nuevo Grupo",
                                     "Asignar",
                                     new { id = tutor.IdUsuario },
                                     new { @class = "btn btn-success" })
                </p>
            </div>
        </div>
    }
    else
    {
        <h2>No se encontró el tutor.</h2>
    }


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            Lista de Grupos
        </div>
        <div class="panel-body">
            <table class="table table-striped table-bordered sga-data-table">
                <thead>
                    <tr>
                        <th>Periodo</th>
                        <th>Año</th>
                        <th>Carrera</th>
                        <th>Grado</th>
                        <th>Grupo</th>
                        <th>Turno</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var ano = ViewData["Ano_" + item.IdTutoriaGrupal]?.ToString() ?? item.Año.ToString();

                        <tr>
                            <td>@(periodos.ContainsKey(item.IdPeriodo) ? periodos[item.IdPeriodo] : "N/A")</td>
                            <td>@ano</td>
                            <td>@(carreras.ContainsKey(item.IdCarrera) ? carreras[item.IdCarrera] : "N/A")</td>
                            <td>@(grados.ContainsKey(item.IdGrado) ? grados[item.IdGrado] : "N/A")</td>
                            <td>@(grupos.ContainsKey(item.IdGrupo) ? grupos[item.IdGrupo] : "N/A")</td>
                            <td>@(turnos.ContainsKey(item.IdTurno) ? turnos[item.IdTurno] : "N/A")</td>
                            <td>
                                @Html.ActionLink("Editar", "Editar", new { id = item.IdTutoriaGrupal }, new { @class = "btn btn-xs btn-warning" })
                                @Html.ActionLink("Eliminar", "Eliminar", new { id = item.IdTutoriaGrupal }, new { @class = "btn btn-xs btn-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @Html.ActionLink("Regresar a la Lista de Tutores", "Index", null, new { @class = "btn btn-default" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/ViewsStyles/Master/sga-theme.js"></script>
}