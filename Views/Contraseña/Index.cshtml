
@model Plataforma_Web.Models.Usuario

@*<body>
        <img alt="full screen background image" src="~/Imagenes/ImagenesPagina/fotopoligonal.jpg" />
    </body>*@

@{
    ViewBag.Title = "Recuperar contraseña";
}

<h2>Recuperar contraseña</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="page-header">
        <h4 class="text-justify">
            Para poder recuperar tu contraseña debes ingresar tu matricula y el correo con
            el que te registraste, una vez hecho esto se enviara tu contraseña a dicho correo electrónico,
            la recuperación de tus credenciales para inicio de sesión solo puede hacerse a través del
            correo electrónico registrado previamente.
        </h4>
    </div>
    <div class="form-horizontal" id="Login">
        <center>
            <div class="row">
                <div class="col-md-4 col-md-offset-4">
                    <div class="well" id="">

                        <h3>Introduce tus datos</h3>
                        <div class="form-group" id="Login">
                            <label for="fullname" class="control-label">Matrícula</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Ingresa tu matrícula" } })
                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group" id="Login">
                            <label for="fullname" class="control-label">Correo electrónico</label>
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.NombreCompleto, new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Ingresa tu correo" } })
                                @Html.ValidationMessageFor(model => model.NombreCompleto, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="CorreoAlt" class="control-label">Correo electrónico alterno</label>
                            <div class="col-md-12">
                                @*@Html.ValidationSummary()*@
                                @Html.Editor("CorreoAlt", new { htmlAttributes = new { @class = "form-control text-center", @placeholder = "Ingresa tu correo personal.", @type = "email", @data_val = "true", @data_val_required = "Favor de introducir un correo valido." } })
                                @Html.ValidationMessage("CorreoAlt", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="submit" value="Enviar" class="btn btn-primary btn-lg btn-block" />
                                <hr />
                                <a class="btn btn-default btn-lg btn-block" href="@Url.Action("Login", "Home")" role="button"><span class="glyphicon glyphicon-arrow-left"></span> Regresar</a>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </center>
    </div>

}
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <script type="text/javascript">
        alert("@ViewBag.Mensaje");
    </script>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

