@model PlataformaWeb.BecasTransporte.Models.Especialidad
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Crear Programa Educativo";
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}
<div class="sga-scope">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-plus-circle"></i>
                            Crear Nuevo Programa Educativo
                        </h3>
                    </div>

                    @using (Html.BeginForm("CreateEspecialidad", "SGA", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="card-body">
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    @ViewBag.Error
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                            }

                            <div class="form-group row">
                                <label for="IdCarrera" class="col-sm-2 col-form-label">
                                    <i class="fas fa-university"></i>
                                    Carrera <span class="text-danger">*</span>
                                </label>
                                <div class="col-sm-10">
                                    @Html.DropDownList("IdCarrera", (SelectList)ViewBag.Carreras, "Seleccione una carrera...", new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.IdCarrera, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="Nombre" class="col-sm-2 col-form-label">
                                    <i class="fas fa-graduation-cap"></i>
                                    Nombre del Programa <span class="text-danger">*</span>
                                </label>
                                <div class="col-sm-10">
                                    @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ingrese el nombre del programa educativo", required = "required", maxlength = "255" } })
                                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        Ingrese un nombre descriptivo para el programa educativo (máximo 255 caracteres).
                                    </small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="SistemaNuevo" class="col-sm-2 col-form-label">
                                    <i class="fas fa-flag"></i>
                                    Sistema Nuevo
                                </label>
                                <div class="col-sm-10">
                                    <div class="form-check">
                                        @Html.CheckBox("SistemaNuevo", Model?.SistemaNuevo ?? false, new { @class = "form-check-input", id = "SistemaNuevo" })
                                        <label class="form-check-label" for="SistemaNuevo">Marcar si es sistema nuevo (1 = Sí, 0 = No)</label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SistemaNuevo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-10 offset-sm-2">
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle"></i>
                                        <strong>Información:</strong> Los campos marcados con <span class="text-danger">*</span> son obligatorios.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-sm-10 offset-sm-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i>
                                        Crear Programa
                                    </button>
                                    @Html.ActionLink("Cancelar", "Especialidades", null, new { @class = "btn btn-secondary ml-2" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Validaci�n personalizada
            $('form').on('submit', function (e) {
                var nombre = $('#Nombre').val().trim();
                var carrera = $('#IdCarrera').val();

                if (!nombre) {
                    e.preventDefault();
                    alert('Por favor ingrese el nombre del programa educativo.');
                    $('#Nombre').focus();
                    return false;
                }

                if (!carrera) {
                    e.preventDefault();
                    alert('Por favor seleccione una carrera.');
                    $('#IdCarrera').focus();
                    return false;
                }

                // Mostrar indicador de carga
                $(this).find('button[type="submit"]').prop('disabled', true).html(
                    '<i class="fas fa-spinner fa-spin"></i> Creando...'
                );
            });

            // Limpiar espacios en blanco
            $('#Nombre').on('blur', function () {
                $(this).val($(this).val().trim());
            });

            // Convertir primera letra a may�scula
            $('#Nombre').on('input', function () {
                var value = $(this).val();
                if (value.length > 0) {
                    $(this).val(value.charAt(0).toUpperCase() + value.slice(1));
                }
            });
        });
    </script>
}
