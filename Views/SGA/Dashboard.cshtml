<style>
    .dashboard-logo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 58vh;
        background: #f9fafb;
        padding: 4rem 1rem 2rem 1rem;
        border-radius: 1.5rem;
        box-shadow: 0 2px 12px 0 rgba(60,60,100,0.10);
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
    }

    .dashboard-logo {
        width: 220px;
        max-width: 95vw;
        margin-bottom: 2.5rem;
        filter: drop-shadow(0 4px 16px #00917533);
        border-radius: 20px;
        background: #fff;
        padding: 0.5rem 1rem;
    }

    .dashboard-bienvenida {
        color: #0c5a4a;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: .5rem;
        letter-spacing: .01em;
        text-align: center;
    }

    .dashboard-desc {
        font-size: 1.1rem;
        color: #666;
        text-align: center;
        max-width: 430px;
    }
</style>

<!-- SOLO COORDINADOR/MASTER: SECCIONES ADMINISTRATIVAS -->
<div class="dashboard-sections-grid">
    @if (usuario.IdNivel >= 3)
    {
        <!-- Becas -->
        <div class="dashboard-section-card">
            <div class="section-header">
                <svg class="section-icon" viewBox="0 0 24 24">
                    <path d="M12 3l1.5 4.5H18l-3.75 2.75L15 15l-3-2.25L9 15l.75-4.75L6 7.5h4.5z" />
                </svg>
                <h3 class="section-title">Becas</h3>
            </div>
            <p class="section-description">Gestión y seguimiento de becas</p>
            <div class="section-links">
                <a href="@Url.Action("Index", "Becas")" class="section-link">Ver Becas</a>
                <a href="@Url.Action("Create", "Becas")" class="section-link">Nueva Beca</a>
            </div>
        </div>
        <!-- Estudiantes -->
        <div class="dashboard-section-card">
            <div class="section-header">
                <svg class="section-icon" viewBox="0 0 24 24">
                    <path d="M12 3l1.5 4.5H18l-3.75 2.75L15 15l-3-2.25L9 15l.75-4.75L6 7.5h4.5z" />
                </svg>
                <h3 class="section-title">Estudiantes</h3>
            </div>
            <p class="section-description">Gestión y seguimiento de estudiantes</p>
            <div class="section-links">
                <a href="@Url.Action("Index", "EstudiantesNew")" class="section-link">Ver Estudiantes</a>
            </div>
        </div>
    }
</div>

    <!-- Solo Master -->
