@using System.Linq
@using System.Collections.Generic
@model PlataformaWeb.Controllers.Materias.ResultadoImportacion
@{
    ViewBag.Title = "Resumen de Importación";
    bool esExitoso = Model.Exito;
    bool tieneErrores = Model.AlumnosConErrores != null && Model.AlumnosConErrores.Count > 0;
    bool tieneExitosos = Model.AlumnosProcesados != null && Model.AlumnosProcesados.Count > 0;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">

            <!-- ✅ ENCABEZADO CON RESULTADO PRINCIPAL -->
            <div class="page-header">
                <h2>
                    @if (esExitoso)
                    {
                        <span class="glyphicon glyphicon-ok-circle text-success"></span>
                    }
                    else
                    {
                        <span class="glyphicon glyphicon-exclamation-triangle text-danger"></span>
                    }
                    Resumen de Importación
                    <small class="text-muted">@Model.NombreGrupo</small>
                </h2>
                <p class="lead">Resultados del procesamiento de calificaciones desde archivo Excel</p>
            </div>

            <!-- ✅ PANEL DE RESULTADO PRINCIPAL SEGÚN ESPECIFICACIÓN -->
            <div class="panel @(esExitoso ? "panel-success" : "panel-danger")">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        @if (esExitoso)
                        {
                            <span class="glyphicon glyphicon-ok-circle"></span> <strong>Importación Completada</strong>
                        }
                        else
                        {
                            <span class="glyphicon glyphicon-remove-circle"></span> <strong>Error en Importación</strong>
                        }
                    </h3>
                </div>
                <div class="panel-body">
                    <h4>@Model.MensajeGeneral</h4>

                    @if (!string.IsNullOrEmpty(Model.NombreCarrera) || !string.IsNullOrEmpty(Model.NombreGrado))
                    {
                        <p class="text-muted">
                            <strong>Grupo:</strong> @Model.NombreGrupo |
                            <strong>Carrera:</strong> @Model.NombreCarrera |
                            <strong>Grado:</strong> @Model.NombreGrado
                        </p>
                    }

                    <!-- ✅ RESUMEN ESTADÍSTICO - CALIFICACIONES PROCESADAS Y ERRORES DETECTADOS -->
                    @if (Model.TotalCalificacionesImportadas > 0)
                    {
                        <div class="alert alert-info">
                            <h4><span class="glyphicon glyphicon-stats"></span> <strong>Resumen de Resultados</strong></h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h3 class="text-success">@Model.TotalCalificacionesImportadas</h3>
                                        <p><strong>Calificaciones<br />Procesadas</strong></p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h3 class="text-success">@(Model.AlumnosProcesados != null ? Model.AlumnosProcesados.Count : 0)</h3>
                                        <p><strong>Alumnos<br />Exitosos</strong></p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h3 class="@(tieneErrores ? "text-warning" : "text-success")">@(Model.AlumnosConErrores != null ? Model.AlumnosConErrores.Count : 0)</h3>
                                        <p><strong>Errores<br />Detectados</strong></p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h3 class="text-info">@((Model.AlumnosProcesados != null ? Model.AlumnosProcesados.Count : 0) + (Model.AlumnosConErrores != null ? Model.AlumnosConErrores.Count : 0))</h3>
                                        <p><strong>Total<br />Procesados</strong></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ✅ DETALLES DEL PROCESAMIENTO -->
            @if (Model.DetallesImportacion != null && Model.DetallesImportacion.Count > 0)
            {
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h4><span class="glyphicon glyphicon-list-alt"></span> Detalles del Procesamiento</h4>
                    </div>
                    <div class="panel-body">
                        <div class="well">
                            @foreach (var detalle in Model.DetallesImportacion)
                            {
                                <p class="@(detalle.StartsWith("❌") ? "text-danger" : detalle.StartsWith("✓") ? "text-success" : "text-info")">
                                    @detalle
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- ✅ ALUMNOS PROCESADOS EXITOSAMENTE -->
            @if (tieneExitosos)
            {
                <div class="panel panel-success">
                    <div class="panel-heading">
                        <h4>
                            <span class="glyphicon glyphicon-ok-sign"></span>
                            Calificaciones Guardadas Exitosamente (@Model.AlumnosProcesados.Count alumnos)
                        </h4>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Matrícula</th>
                                        <th>Nombre del Alumno</th>
                                        <th>Calificaciones Guardadas</th>
                                        <th>Detalles por Materia</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int contador = 1;}
                                    @foreach (var alumno in Model.AlumnosProcesados)
                                    {
                                        <tr>
                                            <td><strong>@contador</strong></td>
                                            <td>
                                                <span class="label label-info">@alumno.Matricula</span>
                                            </td>
                                            <td>@alumno.NombreBD</td>
                                            <td>
                                                <span class="badge badge-success">@alumno.CalificacionesImportadas</span>
                                            </td>
                                            <td>
                                                @if (alumno.Calificaciones != null && alumno.Calificaciones.Count > 0)
                                                {
                                                    <div class="collapse" id="detalles-@contador">
                                                        <div class="well well-sm" style="margin-top: 10px;">
                                                            @foreach (var calificacion in alumno.Calificaciones)
                                                            {
                                                                <div class="row" style="margin-bottom: 5px;">
                                                                    <div class="col-sm-5">
                                                                        <strong>@calificacion.NombreMateria:</strong>
                                                                    </div>
                                                                    <div class="col-sm-3">
                                                                        <span class="badge @(calificacion.Calificacion >= 7 ? "badge-success" : "badge-warning")">
                                                                            @calificacion.Calificacion.ToString("0.0")
                                                                        </span>
                                                                    </div>
                                                                    <div class="col-sm-4">
                                                                        <span class="label @(calificacion.Estado == "Acreditada" ? "label-success" : "label-warning")">
                                                                            @calificacion.Estado
                                                                        </span>
                                                                        <br><small class="text-muted">@calificacion.Mensaje</small>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin detalles</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Index", "MateriasAlumno", new { id = alumno.IdPersona })"
                                                   class="btn btn-xs btn-primary" target="_blank">
                                                    <span class="glyphicon glyphicon-book"></span> Ver Materias
                                                </a>
                                            </td>
                                        </tr>
                                        contador++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- ✅ ERRORES DETECTADOS -->
            @if (tieneErrores)
            {
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h4>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            Errores Detectados (@Model.AlumnosConErrores.Count alumnos)
                        </h4>
                    </div>
                    <div class="panel-body">
                        <div class="alert alert-warning">
                            <strong>Nota:</strong> Los siguientes alumnos no pudieron ser procesados debido a errores en el archivo Excel.
                            Revisa los detalles y corrige el archivo si es necesario.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Matrícula en Excel</th>
                                        <th>Nombre en Excel</th>
                                        <th>Errores Detectados</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int contadorError = 1;}
                                    @foreach (var alumnoError in Model.AlumnosConErrores)
                                    {
                                        <tr>
                                            <td><strong>@contadorError</strong></td>
                                            <td>
                                                <span class="label label-warning">@alumnoError.Matricula</span>
                                            </td>
                                            <td>@alumnoError.NombreExcel</td>
                                            <td>
                                                @if (alumnoError.Errores != null && alumnoError.Errores.Count > 0)
                                                {
                                                    <ul class="list-unstyled" style="margin-bottom: 0;">
                                                        @foreach (var error in alumnoError.Errores)
                                                        {
                                                            <li><span class="text-danger">• @error</span></li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Error no especificado</span>
                                                }
                                            </td>
                                        </tr>
                                        contadorError++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- ✅ PANEL DE ACCIONES -->
            <div class="panel panel-default">
                <div class="panel-body text-center">
                    <div class="btn-group btn-group-lg" role="group">
                        <a href="@Url.Action("Index", "Importar")" class="btn btn-primary">
                            <span class="glyphicon glyphicon-upload"></span> Importar Otro Archivo
                        </a>

                        <a href="javascript:history.back()" class="btn btn-default">
                            <span class="glyphicon glyphicon-arrow-left"></span> Volver al Grupo
                        </a>

                        @if (tieneExitosos)
                        {
                            <button type="button" class="btn btn-info" onclick="imprimirResultados()">
                                <span class="glyphicon glyphicon-print"></span> Imprimir Resumen
                            </button>
                        }

                        @if (tieneErrores)
                        {
                            <a href="@Url.Action("MateriasGrupo", "Exportar")" class="btn btn-warning">
                                <span class="glyphicon glyphicon-download-alt"></span> Descargar Nueva Plantilla
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- ✅ BENEFICIOS ALCANZADOS -->
            @if (esExitoso && tieneExitosos)
            {
                <div class="panel panel-success">
                    <div class="panel-heading">
                        <h4><span class="glyphicon glyphicon-ok"></span> Beneficios Alcanzados</h4>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5><strong>✅ Carga Masiva Completada:</strong></h5>
                                <ul>
                                    <li>Se procesaron <strong>@Model.TotalCalificacionesImportadas calificaciones</strong> automáticamente</li>
                                    <li>Se evitó la captura manual individual de cada alumno</li>
                                    <li>El proceso se completó en segundos vs. horas de captura manual</li>
                                    <li>Coherencia mantenida con la lógica de exportación existente</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5><strong>⚙️ Procesamiento Automático:</strong></h5>
                                <ul>
                                    <li>✓ Validación automática de matrículas con el grupo</li>
                                    <li>✓ Correspondencia de materias verificada</li>
                                    <li>✓ Estados asignados según calificaciones (Acreditada/Extraordinario)</li>
                                    <li>✓ Inserción/actualización en tabla MateriasAlumno completada</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ✅ RECOMENDACIONES FINALES -->
            @if (esExitoso)
            {
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h4><span class="glyphicon glyphicon-info-sign"></span> Próximos Pasos</h4>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5><strong>📋 Verificaciones Sugeridas:</strong></h5>
                                <ul>
                                    <li>Revisar las calificaciones importadas individualmente</li>
                                    <li>Verificar que los estados asignados sean correctos</li>
                                    <li>Confirmar que no hay duplicados o inconsistencias</li>
                                    <li>Generar reportes finales para documentación</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5><strong>🔄 Para Futuros Procesos:</strong></h5>
                                <ul>
                                    <li>Mantener la estructura del Excel sin modificar encabezados</li>
                                    <li>No alterar las matrículas de los alumnos</li>
                                    <li>Usar valores numéricos válidos para calificaciones</li>
                                    <li>Conservar la plantilla original como respaldo</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- ✅ JAVASCRIPT PARA FUNCIONALIDADES ADICIONALES -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
    console.log('=== Resumen de Importación cargado ===');
    console.log('Éxito:', @Html.Raw(Model.Exito.ToString().ToLower()));
    console.log('Alumnos procesados:', @(Model.AlumnosProcesados != null ? Model.AlumnosProcesados.Count : 0));
    console.log('Calificaciones importadas:', @Model.TotalCalificacionesImportadas);
});

// ✅ FUNCIÓN PARA IMPRIMIR RESUMEN
function imprimirResultados() {
    window.print();
}

// ✅ FUNCIÓN PARA EXPANDIR/CONTRAER TODOS LOS DETALLES
function toggleTodosDetalles(expandir) {
    if (expandir) {
        $('.collapse').collapse('show');
    } else {
        $('.collapse').collapse('hide');
    }
}

// ✅ FUNCIÓN PARA VOLVER AL INICIO DEL FLUJO
function volverAExportar() {
    if (confirm('¿Deseas volver al grupo para exportar una nueva plantilla?')) {
        history.back();
    }
}
</script>

<!-- ✅ ESTILOS ADICIONALES -->
<style>
    .page-header {
        border-bottom: 2px solid #1ab192;
        margin-bottom: 30px;
    }

        .page-header h2 {
            color: #2c3e50;
        }

    .badge-success {
        background-color: #27ae60;
    }

    .badge-warning {
        background-color: #f39c12;
    }

    .badge-danger {
        background-color: #e74c3c;
    }

    .well-sm {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
    }

    .panel-success > .panel-heading {
        background-color: #27ae60;
        border-color: #27ae60;
        color: white;
    }

    .panel-warning > .panel-heading {
        background-color: #f39c12;
        border-color: #f39c12;
        color: white;
    }

    .panel-danger > .panel-heading {
        background-color: #e74c3c;
        border-color: #e74c3c;
        color: white;
    }

    .table > thead > tr > th {
        background-color: #ecf0f1;
        color: #2c3e50;
        font-weight: bold;
    }

    .btn-group-lg > .btn {
        margin: 0 5px;
    }

    .text-center h3 {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .text-center p {
        margin-bottom: 0;
        font-size: 12px;
        color: #7f8c8d;
    }

    /* Estilos para impresión */
    @@media print {
        .btn, .btn-group {
            display: none !important;
        }

        .panel {
            border: 1px solid #000 !important;
            margin-bottom: 15px !important;
        }

        .table {
            border: 1px solid #000 !important;
        }

            .table th, .table td {
                border: 1px solid #000 !important;
            }

        body {
            font-size: 12pt;
        }

        h2, h3, h4 {
            page-break-after: avoid;
        }
    }
</style>