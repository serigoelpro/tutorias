@model IEnumerable<PlataformaWeb.BecasTransporte.Models.Estudiante>
@using Plataforma_Web.Models;

@{
    ViewBag.Title = "DetallesBeca";
    var GruposMatutino = ViewBag.GruposMatutino as List<SelectListItem>;
    var GruposVespertino = ViewBag.GruposVespertino as List<SelectListItem>;
    var GruposDespresurizado = ViewBag.GruposDespresurizado as List<SelectListItem>;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}

@{
    string accionEstadisticas = "Estadisticas";
    string controlador = "EstudiantesMaster";

    var usuario = Session["Usuario"] as Plataforma_Web.Models.Usuario;
    var idNivel = usuario?.IdNivel ?? 0;

    if (idNivel == 3) { accionEstadisticas = "EstadisticasCoordinador"; }
    else if (idNivel == 4) { accionEstadisticas = "EstadisticasMaster"; }
}

@if (ViewBag.Mensaje != null)
{
    <div class="col-md-12 text-center">
        <br /><br />
        <div class="alert alert-info">@ViewBag.Mensaje</div>
        <a class="btn btn-default" href="@Url.Action(accionEstadisticas, controlador)">
            <span class="glyphicon glyphicon-arrow-left"></span> Regresar
        </a>
    </div>
}
else
{
    <div class="becas-detalles">
        <div class="row">
            <h2 class="col-md-6">
                Detalles de Becas
                <a class="btn btn-default" href="@Url.Action(accionEstadisticas, controlador)">
                    <span class="glyphicon glyphicon-arrow-left"></span> Regresar
                </a>
            </h2>

            <h2 class="col-md-6">
                Total Por Carrera: <strong>@ViewBag.montoTotalPorCuatrimestre</strong>
            </h2>
        </div>

        <ul class="nav nav-tabs">
            <li role="presentation" class="active"><a href="#">Becas por Grupos</a></li>
            <li role="presentation"><a href="@Url.Action("DetallesBecaGrado", "EstudiantesMaster")">Becas por Grado</a></li>
            <li role="presentation"><a href="@Url.Action("DetallesBecaEspecialidad", "EstudiantesMaster")">Becas por Especialidad</a></li>
        </ul>

        <br />

        <div class="row">
            @if (GruposMatutino != null && GruposMatutino.Any())
            {
                <div class="col-md-6">
                    <p>Grupos Turno Matutino</p>
                    @foreach (var grupo in GruposMatutino)
                    {
                        <a href="@Url.Action("_Graficas", "EstudiantesMaster", new { id = Convert.ToInt32(grupo.Value) })"
                           class="btn btn-primary btn-sm">@grupo.Text</a>
                    }
                </div>
            }

            @if (GruposVespertino != null && GruposVespertino.Any())
            {
                <div class="col-md-6">
                    <p>Grupos Turno Vespertino</p>
                    @foreach (var grupo in GruposVespertino)
                    {
                        <a href="@Url.Action("_Graficas", "EstudiantesMaster", new { id = Convert.ToInt32(grupo.Value) })"
                           class="btn btn-primary btn-sm">@grupo.Text</a>
                    }
                </div>
            }
        </div>

        @if (GruposDespresurizado != null && GruposDespresurizado.Any())
        {
            <div class="row">
                <div class="col-md-6">
                    <p>Grupos Turno Despresurizado</p>
                    @foreach (var grupo in GruposDespresurizado)
                    {
                        <a href="@Url.Action("_Graficas", "EstudiantesMaster", new { id = Convert.ToInt32(grupo.Value) })"
                           class="btn btn-primary btn-sm">@grupo.Text</a>
                    }
                </div>
            </div>
        }

        <div class="row">
            @Html.Partial("_Graficas")
        </div>
    </div>
}
