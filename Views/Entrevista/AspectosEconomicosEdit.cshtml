                                                                @Html.ValidationMessageFor(model => model.IdTrabajo, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label for="lastfullname">¿A qué se dedica tu papá?</label>
                                                                @Html.EditorFor(model => model.OcupacionPapa, new { htmlAttributes = new { @class = "form-control", @id = "OcupacionPapa", placeholder = "Ocupación de tu padre", @Value = (Model.OcupacionPapa != null ? Model.OcupacionPapa.ToUpper() : ""), style = "text-transform:uppercase" } })
                                                                @Html.ValidationMessageFor(model => model.OcupacionPapa, "", new { @class = "text-danger" })
                                                            </div>

