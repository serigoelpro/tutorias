    <!-- Script para mostrar/ocultar campos condicionales -->
    <script>
        $(document).ready(function () {
            // Pregunta 1: ¿Reside en esta ciudad?
            if ($('#Pregunta1').val() == 2) {
                $("#1").removeClass("hidden");
            }

            $("#Pregunta1").change(function (e) {
                if ($('#Pregunta1').val() == 2) {
                    $("#1").removeClass("hidden");
                } else {
                    $("#1").addClass("hidden");
                }
            });

            // Pregunta 2: ¿Trabajas?
            if ($('#Pregunta2').val() == 1) {
                $("#2").removeClass("hidden");
            }

            $("#Pregunta2").change(function (e) {
                if ($('#Pregunta2').val() == 1) {
                    $("#2").removeClass("hidden");
                } else {
                    $("#2").addClass("hidden");
                }
            });

            // Pregunta 3: ¿Tienes dependientes?
            if ($('#Pregunta3').val() == 1) {
                $("#3").removeClass("hidden");
            }

            $("#Pregunta3").change(function (e) {
                if ($('#Pregunta3').val() == 1) {
                    $("#3").removeClass("hidden");
                } else {
                    $("#3").addClass("hidden");
                }
            });
        });

        $(document).ready(function () {
            const solicitabeca = '@(economicos?.SolicitadoBeca?.Replace("'", "\\'") ?? "N/A")';

            if ($('#CuentaConApoyo').val() == 1) {
                $("#CuentaConApoyoInput").removeClass("hidden");
                if (solicitabeca == 'N/A') {
                    $('#CuentaConApoyoInput input').val('');
                } else {
                    $('#CuentaConApoyoInput input').val(solicitabeca);
                }
            }

            $("#CuentaConApoyo").change(function (e) {
                if ($('#CuentaConApoyo').val() == 1) {
                    $("#CuentaConApoyoInput").removeClass("hidden");
                    if (solicitabeca == 'N/A') {
                        $('#CuentaConApoyoInput input').val('');
                    } else {
                        $('#CuentaConApoyoInput input').val(solicitabeca);
                    }
                } else {
                    $("#CuentaConApoyoInput").addClass("hidden");
                    $('#CuentaConApoyoInput input').val('N/A');
                }
            });

            const idGrado = @(datos?.IdGrado ?? 0);
            if (idGrado == 1) {
                $(".seguimiento").addClass("hidden");
            }
        });
    </script>

    <!-- Script para botones Editar/Cancelar -->
    <script>
        function Mostrar() {
            $("#Editar").removeClass("hidden");
            $("#11").addClass("hidden");
            $("#33").addClass("hidden");
            $("#22").removeClass("hidden");
        }

        function Ocultar() {
            $("#Editar").addClass("hidden");
            $("#11").removeClass("hidden");
            $("#33").removeClass("hidden");
            $("#22").addClass("hidden");
        }
    </script>

    <!-- NUEVO: Script de validación del formulario -->
    <script>
        $(document).ready(function () {
            $('form').submit(function (e) {
                var isValid = true;
                var errorMessages = [];

                if (!$('#OcupacionPapa').val() || $('#OcupacionPapa').val().trim() === '') {
                    errorMessages.push('• Debes especificar la ocupación de tu papá');
                    isValid = false;
                }

                if (!$('#OcupacionMama').val() || $('#OcupacionMama').val().trim() === '') {
                    errorMessages.push('• Debes especificar la ocupación de tu mamá');
                    isValid = false;
                }

                if (!$('#CantidadHermano').val() || $('#CantidadHermano').val().trim() === '') {
                    errorMessages.push('• Debes especificar la cantidad de hermanos');
                    isValid = false;
                }

                // Validar campos condicionales
                if ($('#Pregunta1').val() == 2) {
                    if (!$('#Ciudad').val() || $('#Ciudad').val().trim() === '') {
                        errorMessages.push('• Debes especificar en qué ciudad resides');
                        isValid = false;
                    }
                } else {
                    $('#Ciudad').val('N/A');
                }

                if ($('#Pregunta2').val() == 1) {
                    if (!$('#Familiar').val() || $('#Familiar').val().trim() === '') {
                        errorMessages.push('• Debes especificar con quien vive');
                        isValid = false;
                    }
                } else {
                    $('#Familiar').val('N/A');
                }

                // Validar campos de seguimiento solo si están visibles
                const idGrado = @(datos?.IdGrado ?? 0);
                if (idGrado != 1) {
                    if ($('#CuentaConApoyo').val() == 1) {
                        var becaVal = $('#SolicitadoBeca').val();
                        if (!becaVal || becaVal.trim() === '' || becaVal === 'N/A') {
                            errorMessages.push('• Debes especificar qué beca o apoyo has solicitado');
                            isValid = false;
                        }
                    } else {
                        $('#SolicitadoBeca').val('N/A');
                    }

                } else {
                    // Primer cuatrimestre - establecer valores por defecto
                    $('#SolicitadoBeca').val('N/A');
                    $('#AfectacionEco').val('N/A');
                }

                if (!isValid) {
                    e.preventDefault();
                    alert('Por favor completa los siguientes campos:\n\n' + errorMessages.join('\n'));
                    return false;
                }

                return true;
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            function removeEmojisAndUppercase(input) {
                input.value = input.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();
            }

            var camposTexto = [
                'input[name="Ciudad"]',
                'input[name="Familiar"]',
                'input[name="OcupacionPapa"]',
                'input[name="OcupacionMama"]',
                'input[name="CantidadHermano"]',
                'input[name="CantidadPersonas"]',
                'input[name="CantidadTrabajan"]'
            ];

            camposTexto.forEach(function (selector) {
                var campo = $(selector);

                campo.on('input', function () {
                    removeEmojisAndUppercase(this);
                });

                campo.on('paste', function (e) {
                    e.preventDefault();
                    var pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                    pastedText = pastedText.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();

                    var start = this.selectionStart;
                    var end = this.selectionEnd;
                    var value = this.value;
                    this.value = value.substring(0, start) + pastedText + value.substring(end);
                    this.selectionStart = this.selectionEnd = start + pastedText.length;

                    $(this).trigger('input');
                });
            });
        });
    </script>
</body>
</html>