@model Plataforma_Web.Models.PrimeraEntrevista.AspectosEconomicos
@using Plataforma_Web.Models.PrimeraEntrevista
@{
    /**/

    AspectosEconomicos economicos = ViewBag.Aspectos as AspectosEconomicos;
    DatosPersonales datos = ViewBag.Datos as DatosPersonales;
    // Asegurar que no sean null para evitar errores masivos, aunque lo ideal es manejarlo en el controlador
    if (datos == null) { datos = new DatosPersonales(); }
    if (economicos == null) { economicos = new AspectosEconomicos(); }
    Layout = null;
}

<!DOCTYPE html>

<html>
