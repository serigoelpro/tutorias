@model Plataforma_Web.Models.PrimeraEntrevista.AspectosEconomicos

@{

    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <link rel="icon" type="image/png" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Aspectos Economicos</title>
    <!-- custom style sheet -->
    <!-- Animate.css -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/animate.css">
    <!-- Icomoon Icon Fonts-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/icomoon.css">
    <!-- Themify Icons-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/themify-icons.css">
    <!-- Bootstrap  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/magnific-popup.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap-datepicker.min.css">

    <!-- Owl Carousel  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.theme.default.min.css">

    <!-- Theme style  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/style.css">

    <!-- Modernizr JS -->
    <script src="~/EstilosEntrevista/js/modernizr-2.6.2.min.js"></script>

</head>
<body>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div id="page">
            <header id="gtco-header" role="banner" style="background-image: url(../../EstilosEntrevista/images/img_bg_1.jpg)" data-stellar-background-ratio="0.8">
                <div class="overlay"></div>
                <div class="gtco-container">
                    <div class="row">
                        <div class="col-md-12 col-md-offset-0 text-left">


                            <div class="row" style="margin-top: 2em; margin-bottom:9em;">

                                <div class="col-md-10 col-md-push-1 animate-box" data-animate-effect="fadeInRight">
                                    <div class="form-wrap">
                                        <div class="tab">

                                            <div class="tab-content">
                                                <div class="tab-content-inner active" data-content="signup">
                                                    <h3>Aspectos Económicos</h3>
                                                    <form action="#">
                                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                                        <div class="row form-group">
                                                            <div class="col-md-6">
                                                                <label for="fullname">¿Resides en esta ciudad?</label>
                                                                @Html.DropDownList("IdCiudad", null, "Elija una opción", htmlAttributes: new { @class = "form-control", id = "Pregunta1" })
                                                                @Html.ValidationMessageFor(model => model.IdCiudad, "", new { @class = "text-danger" })

                                                            </div>

                                                            <div class="col-md-6 hidden" id="1">
                                                                <label for="activities">Especifica en qué ciudad resides</label>
                                                                @Html.EditorFor(model => model.Ciudad, new { htmlAttributes = new { @class = "form-control", placeholder = "Ciudad en la que vives" } })
                                                                @Html.ValidationMessageFor(model => model.Ciudad, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label for="activities">¿Con quién vives actualmente?</label>
                                                                @Html.DropDownList("IdTipoFamiliar", null, "Elija una opción", htmlAttributes: new { @class = "form-control", id = "Pregunta2" })
                                                                @Html.ValidationMessageFor(model => model.IdTipoFamiliar, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-6 hidden" id="2">
                                                                <label for="activities">Especifica con quién vives actualmente</label>
                                                                @Html.EditorFor(model => model.Familiar, new { htmlAttributes = new { @class = "form-control", placeholder = "Amigos, familia, conocidos, solo, etc." } })
                                                                @Html.ValidationMessageFor(model => model.Familiar, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label for="lastfullname">¿Trabajas?</label>
                                                                @Html.DropDownList("IdTrabajo", null, "Elija una opción", htmlAttributes: new { @class = "form-control", id = "Pregunta2" })
                                                                @Html.ValidationMessageFor(model => model.IdTrabajo, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label for="lastfullname">¿A qué se dedica tu papá?</label>
                                                                @Html.EditorFor(model => model.OcupacionPapa, new { htmlAttributes = new { @class = "form-control", placeholder = "Ocupacion de tu padre" } })
                                                                @Html.ValidationMessageFor(model => model.OcupacionPapa, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label for="lastfullname">¿A qué se dedica tu mamá?</label>
                                                                @Html.EditorFor(model => model.OcupacionMama, new { htmlAttributes = new { @class = "form-control", placeholder = "Ocupacion de tu madre" } })
                                                                @Html.ValidationMessageFor(model => model.OcupacionMama, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label for="lastfullname">Si tienes hermanos, ¿cuántos son?</label>
                                                                @Html.EditorFor(model => model.CantidadHermano, new { htmlAttributes = new { @class = "form-control", placeholder = "Numero de hermanos(as)" } })
                                                                @Html.ValidationMessageFor(model => model.CantidadHermano, "", new { @class = "text-danger" })
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label for="lastfullname">Ingreso mensual aproximado por miembro</label>
                                                                @Html.DropDownList("IdIngresoMes", null, "Elija una opción", htmlAttributes: new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.IdIngresoMes, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <input type="submit" class="btn btn-primary btn-block" value="Siguiente">
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </header>

        </div>


        <!-- jQuery -->
        <script src="~/EstilosEntrevista/js/jquery.min.js"></script>
        <!-- jQuery Easing -->
        <script src="~/EstilosEntrevista/js/jquery.easing.1.3.js"></script>
        <!-- Bootstrap -->
        <script src="~/EstilosEntrevista/js/bootstrap.min.js"></script>
        <!-- Waypoints -->
        <script src="~/EstilosEntrevista/js/jquery.waypoints.min.js"></script>
        <!-- Carousel -->
        <script src="~/EstilosEntrevista/js/owl.carousel.min.js"></script>
        <!-- countTo -->
        <script src="~/EstilosEntrevista/js/jquery.countTo.js"></script>

        <!-- Stellar Parallax -->
        <script src="~/EstilosEntrevista/js/jquery.stellar.min.js"></script>

        <!-- Magnific Popup -->
        <script src="~/EstilosEntrevista/js/jquery.magnific-popup.min.js"></script>
        <script src="~/EstilosEntrevista/js/magnific-popup-options.js"></script>

        <!-- Datepicker -->
        <script src="~/EstilosEntrevista/js/bootstrap-datepicker.min.js"></script>


        <!-- Main -->
        <script src="~/EstilosEntrevista/js/main.js"></script>
        <script>
            $(document).ready(function () {
                if ($('#Pregunta1').val() == 2) {
                    $("#1").removeClass("hidden");
                };

                $("#Pregunta1").change(function (e) {
                    if ($('#Pregunta1').val() == 2) {
                        $("#1").removeClass("hidden");
                    } else {
                        $("#1").addClass("hidden");
                    }
                });
                if ($('#Pregunta2').val() == 1) {
                    $("#2").removeClass("hidden");
                };

                $("#Pregunta2").change(function (e) {
                    if ($('#Pregunta2').val() == 1) {
                        $("#2").removeClass("hidden");
                    } else {
                        $("#2").addClass("hidden");
                    }
                });
            });
        </script>
        <script>
            $(document).ready(function () {
                function removeEmojisAndUppercase(input) {
                    input.value = input.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();
                }

                var camposTexto = [
                    'input[name="Ciudad"]',
                    'input[name="Familiar"]',
                    'input[name="OcupacionPapa"]',
                    'input[name="OcupacionMama"]',
                    'input[name="CantidadHermano"]',
                ];

                camposTexto.forEach(function (selector) {
                    var campo = $(selector);

                    campo.on('input', function () {
                        removeEmojisAndUppercase(this);
                    });

                    campo.on('paste', function (e) {
                        e.preventDefault();
                        var pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                        pastedText = pastedText.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();

                        var start = this.selectionStart;
                        var end = this.selectionEnd;
                        var value = this.value;
                        this.value = value.substring(0, start) + pastedText + value.substring(end);
                        this.selectionStart = this.selectionEnd = start + pastedText.length;

                        $(this).trigger('input');
                    });
                });
            });
        </script>

    }

</body>
</html>
