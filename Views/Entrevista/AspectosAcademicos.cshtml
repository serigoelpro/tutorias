@model Plataforma_Web.Models.PrimeraEntrevista.AspectosAcademicos



@{


    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <link rel="icon" type="image/png" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Aspectos Academicos</title>
    <!-- custom style sheet -->
    <!-- Animate.css -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/animate.css">
    <!-- Icomoon Icon Fonts-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/icomoon.css">
    <!-- Themify Icons-->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/themify-icons.css">
    <!-- Bootstrap  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/magnific-popup.css">

    <!-- Magnific Popup -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/bootstrap-datepicker.min.css">

    <!-- Owl Carousel  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/EstilosEntrevista/css/owl.theme.default.min.css">

    <!-- Theme style  -->
    <link rel="stylesheet" href="~/EstilosEntrevista/css/style.css">

    <!-- Modernizr JS -->
    <script src="~/EstilosEntrevista/js/modernizr-2.6.2.min.js"></script>

</head>
<body>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()




        <div id="page">
            <header id="gtco-header" role="banner" style="background-image: url(../../EstilosEntrevista/images/img_bg_1.jpg)" data-stellar-background-ratio="0.8">
                <div class="overlay"></div>
                <div class="gtco-container">
                    <div class="row">
                        <div class="col-md-12 col-md-offset-0 text-left">


                            <div class="row" style="margin-top: 2em; margin-bottom:3em;">

                                <div class="col-md-6 col-md-push-3 animate-box" data-animate-effect="fadeInRight">
                                    <div class="form-wrap">
                                        <div class="tab">

                                            <div class="tab-content">
                                                <div class="tab-content-inner active" data-content="signup">
                                                    <h3>Datos Escolares</h3>
                                                    <div>
                                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="lastfullname">¿De qué bachillerato egresaste?</label>
                                                                @Html.DropDownList("IdListaBachillerato", null, "Elija una opción", htmlAttributes: new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.IdListaBachillerato, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="row form-group hidden" id="1">
                                                            <div class="col-md-12">
                                                                <label for="fullname">Especifica cuál bachillerato</label>
                                                                @Html.EditorFor(model => model.Bachillerato, new { htmlAttributes = new { @class = "form-control", placeholder = "Especifica el nombre del bachillerato" } })
                                                                @Html.ValidationMessageFor(model => model.Bachillerato, "", new { @class = "text-danger" })

                                                            </div>
                                                        </div>

                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="activities">Especialidad en el bachillerato</label>
                                                                @Html.EditorFor(model => model.Especialidad, new { htmlAttributes = new { @class = "form-control", placeholder = "Especialidad en el bachillerato" } })
                                                                @Html.ValidationMessageFor(model => model.Especialidad, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="activities">Promedio general (Bachillerato)</label>
                                                                @Html.EditorFor(model => model.Promedio, new { htmlAttributes = new { @class = "form-control", placeholder = "Promedio general en bachillerato con numeros enteros" } })
                                                                @Html.ValidationMessageFor(model => model.Promedio, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="lastfullname">¿Cuentas con equipo de cómputo para estudiar?</label>
                                                                @Html.DropDownList("IdEquipoComp", null, "Elija una opción", htmlAttributes: new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.IdEquipoComp, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="fullname">Especifica el tipo de dispositivo</label>
                                                                @Html.DropDownList("IdTipoDispositivo", null, "Elija una opción", htmlAttributes: new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.IdTipoDispositivo, "", new { @class = "text-danger" })

                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <label for="fullname">¿Cuentas con servicio de conexión a internet?</label>
                                                                @Html.DropDownList("IdAccesoInternet", null, "Elija una opción", htmlAttributes: new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.IdAccesoInternet, "", new { @class = "text-danger" })

                                                            </div>
                                                        </div>
                                                        <div class="row form-group">
                                                            <div class="col-md-12">
                                                                <input type="submit" class="btn btn-primary btn-block" value="Siguiente">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </header>

        </div>


        <!-- jQuery -->
        <script src="~/EstilosEntrevista/js/jquery.min.js"></script>
        <!-- jQuery Easing -->
        <script src="~/EstilosEntrevista/js/jquery.easing.1.3.js"></script>
        <!-- Bootstrap -->
        <script src="~/EstilosEntrevista/js/bootstrap.min.js"></script>
        <!-- Waypoints -->
        <script src="~/EstilosEntrevista/js/jquery.waypoints.min.js"></script>
        <!-- Carousel -->
        <script src="~/EstilosEntrevista/js/owl.carousel.min.js"></script>
        <!-- countTo -->
        <script src="~/EstilosEntrevista/js/jquery.countTo.js"></script>

        <!-- Stellar Parallax -->
        <script src="~/EstilosEntrevista/js/jquery.stellar.min.js"></script>

        <!-- Magnific Popup -->
        <script src="~/EstilosEntrevista/js/jquery.magnific-popup.min.js"></script>
        <script src="~/EstilosEntrevista/js/magnific-popup-options.js"></script>

        <!-- Datepicker -->
        <script src="~/EstilosEntrevista/js/bootstrap-datepicker.min.js"></script>


        <!-- Main -->
        <script src="~/EstilosEntrevista/js/main.js"></script>
        <script>
            $(document).ready(function () {
                if ($('#IdListaBachillerato').val() == 1) {
                    $("#1").removeClass("hidden");
                };

                $("#IdListaBachillerato").change(function (e) {
                    if ($('#IdListaBachillerato').val() == 1) {
                        $("#1").removeClass("hidden");
                    } else {
                        $("#1").addClass("hidden");
                    }
                });
            });
        </script>
        <script>
            $(document).ready(function () {
                function removeEmojisAndUppercase(input) {
                    input.value = input.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();
                }

                var camposTexto = [
                    'input[name="Bachillerato"]',
                    'input[name="Especialidad"]',
                    'input[name="Promedio"]'

                ];

                camposTexto.forEach(function (selector) {
                    var campo = $(selector);

                    campo.on('input', function () {
                        removeEmojisAndUppercase(this);
                    });

                    campo.on('paste', function (e) {
                        e.preventDefault();
                        var pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                        pastedText = pastedText.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();

                        var start = this.selectionStart;
                        var end = this.selectionEnd;
                        var value = this.value;
                        this.value = value.substring(0, start) + pastedText + value.substring(end);
                        this.selectionStart = this.selectionEnd = start + pastedText.length;

                        $(this).trigger('input');
                    });
                });
            });
        </script>

    }

</body>
</html>

