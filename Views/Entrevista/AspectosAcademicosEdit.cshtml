    <script>
            $(document).ready(function () {
                if ($('#IdTecnicaEst').val() == 1) {
                    $("#1").removeClass("hidden");
                };

                $("#IdTecnicaEst").change(function (e) {
                    if ($('#IdTecnicaEst').val() == 1) {
                        $("#1").removeClass("hidden");
                    } else {
                        $("#1").addClass("hidden");
                    }
                });
            });

            $(document).ready(function () {
                if ($('#IdListaBachillerato').val() == 1) {
                    $("#1").removeClass("hidden");
                };

                $("#IdListaBachillerato").change(function (e) {
                    if ($('#IdListaBachillerato').val() == 1) {
                        $("#1").removeClass("hidden");
                    } else {
                        $("#1").addClass("hidden");
                    }
                });
            });

            $(document).ready(function () {
                // Initialize on load
                var toggleOptions = function() {
                    var equipoVal = $('#IdEquipoComp').val();

                    if (equipoVal == 2) { // 2 = NO tiene equipo
                        // Ocultar el div de tipo dispositivo
                        $(".divTipoDispositivo").addClass("hidden");

                        // Seleccionar automaticamente "NO CUENTO CON EQUIPO DE TRABAJO"
                        var noEquipoOption = $("#IdTipoDispositivo option").filter(function() {
                            return $(this).text().trim().toUpperCase() === 'NO CUENTO CON EQUIPO DE TRABAJO';
                        });
                        if (noEquipoOption.length > 0) {
                            $('#IdTipoDispositivo').val(noEquipoOption.val());
                        }
                    } else if (equipoVal == 1) { // 1 = SI tiene equipo
                        // Mostrar el div de tipo dispositivo
                        $(".divTipoDispositivo").removeClass("hidden");

                        // Si el valor actual es "NO CUENTO", seleccionar la primera opcion valida
                        var currentText = $('#IdTipoDispositivo option:selected').text().trim().toUpperCase();
                        if (currentText === 'NO CUENTO CON EQUIPO DE TRABAJO' || currentText === 'ELIJA UNA OPCIÓN' || $('#IdTipoDispositivo').val() === '') {
                            // Buscar primera opcion valida (no vacia, no "elija una opcion", no "no cuento")
                            var primeraValida = $("#IdTipoDispositivo option").filter(function() {
                                var texto = $(this).text().trim().toUpperCase();
                                var val = $(this).val();
                                return val !== '' && texto !== 'NO CUENTO CON EQUIPO DE TRABAJO' && texto !== 'ELIJA UNA OPCIÓN';
                            }).first();

                            if (primeraValida.length > 0) {
                                $('#IdTipoDispositivo').val(primeraValida.val());
                            }
                        }
                    }
                };

                toggleOptions(); // Run on load

                $("#IdEquipoComp").change(toggleOptions); // Run on change
            });

            $(document).ready(function () {

                const materiaRepro = '@(academicos?.MateriasRepro?.Replace("'", "\\'") ?? "N/A")';

                if ($('#AcreditoTodo').val() == 2) {
                    $("#AcreditoTodoInput").removeClass("hidden");
                    if (materiaRepro == 'N/A') {
                        $('#AcreditoTodoInput input').val('');
                    } else {
                        $('#AcreditoTodoInput input').val(materiaRepro);
                    }

                }

                $("#AcreditoTodo").change(function (e) {
                    if ($('#AcreditoTodo').val() == 2) {
                        $("#AcreditoTodoInput").removeClass("hidden");
                        if (materiaRepro == 'N/A') {
                            $('#AcreditoTodoInput input').val('');
                        } else {
                            $('#AcreditoTodoInput input').val(materiaRepro);
                        }
                    } else {
                        $("#AcreditoTodoInput").addClass("hidden");
                        $('#AcreditoTodoInput input').val('N/A');

                    }
                });
            });


    </script>
    <script>
        function Mostrar() {
            $("#Editar").removeClass("hidden");
            $("#11").addClass("hidden");
            $("#33").addClass("hidden");
            $("#22").removeClass("hidden");

        }
        function Ocultar() {
            $("#Editar").addClass("hidden");
            $("#11").removeClass("hidden");
            $("#33").removeClass("hidden");
            $("#22").addClass("hidden");
        }
    </script>
    <script>
        $(document).ready(function () {
            function removeEmojisAndUppercase(input) {
                input.value = input.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();
            }

            var camposTexto = [
                'input[name="Bachillerato"]',
                'input[name="Especialidad"]',
                'input[name="Promedio"]',
                'input[name="RendimientoClase"]',
                'input[name="ExperienciaProfe"]',
                'input[name="MateriasRepro"]',
                'input[name="MateriasDif"]'
            ];

            camposTexto.forEach(function (selector) {
                var campo = $(selector);

                campo.on('input', function () {
                    removeEmojisAndUppercase(this);
                });

                campo.on('paste', function (e) {
                    e.preventDefault();
                    var pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                    pastedText = pastedText.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();

                    var start = this.selectionStart;
                    var end = this.selectionEnd;
                    var value = this.value;
                    this.value = value.substring(0, start) + pastedText + value.substring(end);
                    this.selectionStart = this.selectionEnd = start + pastedText.length;

                    $(this).trigger('input');
                });
            });
        });
    </script>

    @if (ViewBag.Mensaje != null)
    {
        <script type="text/javascript">
            alert("@Html.Raw(ViewBag.Mensaje)");
        </script>
    }

</body>
</html>