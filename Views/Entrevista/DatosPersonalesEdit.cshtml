    <script>
        function Mostrar() {
            $("#Editar").removeClass("hidden");
            $("#11").addClass("hidden");
            $("#33").addClass("hidden");
            $("#22").removeClass("hidden");

        }
        function Ocultar() {
            $("#Editar").addClass("hidden");
            $("#11").removeClass("hidden");
            $("#33").removeClass("hidden");
            $("#22").addClass("hidden");
        }

        $(document).ready(function () {

            if ($('#PreguntaHijos').val() == 1) {
                $("#cantidadHijos").removeClass("hidden");
            }

            $("#PreguntaHijos").change(function (e) {
                if ($('#PreguntaHijos').val() == 1) {
                    $("#cantidadHijos").removeClass("hidden");
                } else {
                    $("#cantidadHijos").addClass("hidden");
                }
            });

            $.ajax({
                url: "/Main/GetGrades",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    const $gradesBtn = $("#grados");

                    $gradesBtn.empty();
                    response.forEach(function (grado) {
                        if (grado.Nombre == "0" || grado.Nombre == "12") {
                            return;
                        }

                        if (Number(grado.Nombre) > 6) {

                            let newGrade = Number(grado.Nombre) - 6;

                            $gradesBtn.append(
                                `<option value = "` +
                                grado.IdGrado +
                                `">` +
                                newGrade.toString() +
                                "&deg; / " + grado.Nombre + "&deg; en Ingeniería</option>"
                            )
                        }
                        else {

                            $gradesBtn.append(
                                `<option value = "` +
                                grado.IdGrado +
                                `">` +
                                grado.Nombre +
                                "&deg;</option>"
                            );
                        }
                    });
                },
            });

            var editGradoInpt = $("#editGradoInpt");

            $.ajax({
                url: "/Main/GetGrades",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    const $gradesBtn = editGradoInpt;
                    var selectedGrade = $gradesBtn.find("option:selected").val();

                    $gradesBtn.empty();

                    response.forEach(function (grado) {
                        if (grado.Nombre == "0" || grado.Nombre == "12") {
                            return;
                        }

                        if (Number(grado.Nombre) > 6) {

                            $gradesBtn.append(
                                `<option value = "` +
                                grado.IdGrado +
                                `">` +
                                grado.Nombre +
                                "&deg; en Ingeniería</option>"
                            )
                        }
                        else {

                            $gradesBtn.append(
                                `<option value = "` +
                                grado.IdGrado +
                                `">` +
                                grado.Nombre +
                                "&deg; en TSU</option>"
                            );
                        }
                    });
                    $gradesBtn.val(selectedGrade);
                }
            });

            var editTurnInpt = $("#editTurnInpt");

            var currentGrade = @(datos?.Grado?.Nombre ?? "0");
            var currentGradeNum = Number(currentGrade);

            if (currentGradeNum > 6) {
                editTurnInpt.val(2);
            }
            else {
                editTurnInpt.val(1);
            }

            editGradoInpt.on("change", function () {
                if ($(this).val() > 6) {
                    editTurnInpt.val(2);
                }
                else {
                    editTurnInpt.val(1);
                }
            });

            editTurnInpt.on('mousedown keydown', function (e) {
                e.preventDefault();
            });

            var select = $("#es");

            var selectedCarrera = $("#Carrera").find("option:selected");
            const Carreravalue = $("#Carrera").val();

            $.ajax({
                url: "/Main/GetSpecialties",
                type: "GET",
                data: { userCarrera: Carreravalue },
                dataType: "json",
                success: function (response) {
                    const $specialtyButtonList = $("#es");

                    $specialtyButtonList.empty();
                    response.forEach(function (especialidad) {
                        $specialtyButtonList.append(
                            `<option value = "` +
                            especialidad.Nombre +
                            `">` +
                            especialidad.Nombre +
                            "</option>"
                        );
                    });
                    document.getElementById("es").selectedIndex = -1;
                }
            });

            $("#Carrera").on("change", function () {
                var selectedOption = $(this).find("option:selected");
                const selectedValue = $(this).val();

                $.ajax({
                    url: "/Main/GetSpecialties",
                    type: "GET",
                    data: { userCarrera: selectedValue },
                    dataType: "json",
                    success: function (response) {
                        const $specialtyButtonList = $("#es");


                        $specialtyButtonList.empty();

                        response.forEach(function (especialidad) {
                            $specialtyButtonList.append(
                                `<option value = "` +
                                especialidad.Nombre +
                                `">` +
                                especialidad.Nombre +
                                "</option>"
                            );
                        });
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            function removeEmojisAndUppercase(input) {
                input.value = input.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();
            }

            var camposTexto = [
                'input[name="Nom"]',
                'input[name="Paterno"]',
                'input[name="Materno"]'
            ];

            camposTexto.forEach(function (selector) {
                var campo = $(selector);

                campo.on('input', function () {
                    removeEmojisAndUppercase(this);
                });

                campo.on('paste', function (e) {
                    e.preventDefault();
                    var pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                    pastedText = pastedText.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s./-]/g, '').toUpperCase();

                    var start = this.selectionStart;
                    var end = this.selectionEnd;
                    var value = this.value;
                    this.value = value.substring(0, start) + pastedText + value.substring(end);
                    this.selectionStart = this.selectionEnd = start + pastedText.length;

                    $(this).trigger('input');
                });
            });
        });
    </script>
</body>
</html>