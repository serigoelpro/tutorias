        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        background: rgba(255, 255, 255, 0.2);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .header-text h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 600;
    }

    .subtitle {
        margin: 3px 0 0 0;
        opacity: 0.9;
        font-size: 16px;
    }

