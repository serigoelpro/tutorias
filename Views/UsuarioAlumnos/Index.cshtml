                        value: userCarreraId,
                        text: userCarreraNombre
                    }));
                    $select.val(userCarreraId);
                    $select.prop('disabled', true);
                }
                else if (userNivel == 4) {
                    $select.html('<option value="">Cargando...</option>');
                    $select.prop('disabled', false);

                    $.ajax({
                        url: '@Url.Action("GetCarrerasList", "UsuarioAlumnos")',
                        type: 'GET',
                        success: function (response) {
                            if (response.success) {
                                $select.html('<option value="">-- Seleccione una Carrera --</option>');
                                response.data.forEach(function (carrera) {
                                    $select.append($('<option>', {
                                        value: carrera.IdCarrera,
                                        text: carrera.Nombre
                                    }));
                                });
                            } else {
                                $select.html('<option value="">Error al cargar</option>');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Error en cargarDropdownCarreras:", xhr.responseText, status, error);
                            $select.html('<option value="">Error de conexión</option>');
                        }
                    });
                }
                else {
                    $select.html('<option value="">No autorizado</option>');
                    $select.prop('disabled', true);
                }
