@{
    ViewBag.Title = "Gestión de Usuarios";
    var _usrSesion = Session["Usuario"] as Plataforma_Web.Models.Usuario;
    var esDirector = _usrSesion != null && _usrSesion.EsDirector;
}
@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}
<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="sga-scope">

    <div class="container-fluid usuarios-container">
        <!-- Header Section -->
        <div class="row">
            <div class="col-md-12">
                <div class="page-header-modern">
                    <div class="header-content">
                        <div class="header-icon">
                            <i class="fa fa-users"></i>
                        </div>
                        <div class="header-text">
                            <h1>Gestión de Usuarios</h1>
                            <p class="subtitle">Sistema de Tutorías y Gestión</p>
                        </div>
                    </div>
                    <div class="header-divider"></div>
                </div>
            </div>
        </div>

        <!-- Mensajes de Alerta -->
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade in">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="fa fa-check-circle"></i>
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade in">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="fa fa-exclamation-circle"></i>
                @TempData["Error"]
            </div>
        }

        <!-- Estadísticas Generales -->
        <!--<div class="row stats-section">-->
        <!-- Tarjetas para TODOS (Coordinador y Master) -->
        <!--<div class="col-md-6">
                <div class="stat-card tutorias-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <i class="fa fa-graduation-cap"></i>
                        </div>
                        <div class="stat-info">
                            <h4>Sistema de Tutorías</h4>
                            <p class="stat-description">Gestión de usuarios del sistema de tutorías</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card gestion-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <i class="fa fa-user"></i>
                        </div>
                        <div class="stat-info">
                            <h4>Sistema de Gestión</h4>
                            <p class="stat-description">Gestión de alumnos del sistema general</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>-->
        <!-- Tabla de Usuarios de Tutorías -->
        <section class="data-block">
            <h3 class="section-title">
                <i class="fa fa-graduation-cap"></i>
                Usuarios del Sistema de Tutorías
            </h3>

            <div class="row controls-row" style="margin-bottom:12px; align-items:end;">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="buscarTutorias" class="control-label">Buscar:</label>
                        <input id="buscarTutorias" type="text" class="form-control" placeholder="Escribe un nombre, carrera o matrícula..." />
                    </div>
                </div>

                <!-- placeholder donde moveremos el select "Mostrar X" -->
                <div class="col-md-4 d-flex align-items-end">
                    <div id="tutorias-length-placeholder" style="width: 220px;"></div>
                </div>
            </div>


            <div class="panel-content">
                <div class="table-responsive">
                    <table id="tablaTutorias" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre Completo</th>
                                <th>Nombre de Usuario</th>
                                <th>Correo Electrónico</th>
                                <th>Carrera</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DataTables llena esto automáticamente -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Tabla de Alumnos de Gestión -->
        <section class="data-block">
            <div class="section-title">
                <i class="fa fa-user"></i>
                Alumnos del Sistema de Gestión
            </div>

            <div class="row controls-row" style="margin-bottom:12px; align-items:end;">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="buscarGestion" class="control-label">Buscar:</label>
                        <input id="buscarGestion" type="text" class="form-control" placeholder="Escribe un nombre o matrícula..." />
                    </div>
                </div>

                <!-- placeholder donde moveremos el select "Mostrar X" -->
                <div class="col-md-4 d-flex align-items-end">
                    <div id="gestion-length-placeholder" style="width: 220px;"></div>
                </div>
            </div>

            <div class="panel-content">
                <div class="table-responsive">
                    <table id="tablaGestion" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido Paterno</th>
                                <th>Apellido Materno</th>
                                <th>Matrícula</th>
                                <th>Correo Electrónico</th>
                                <th>Carrera</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DataTables llena esto automáticamente -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </div>

    <!-- MODAL: Editar Usuario de Tutorías -->
    <div class="modal fade" id="modalEditarTutorias" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-modern" role="document">
            <div class="modal-content">
                <form id="formEditarTutorias">

                    <div class="modal-header modal-header-tutorias">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">
                            <i class="fa fa-edit"></i>
                            Editar Usuario - Tutorías
                        </h4>
                    </div>

                    <div class="modal-body">

                        <div id="vistaPrincipalTutorias">

                            <input type="hidden" id="tutoriaIdUsuario" name="IdUsuario" />

                            <div class="form-group">
                                <label>Nombre Completo <span class="text-danger">*</span></label>

                                <input type="text"
                                       class="form-control modern-input"
                                       id="tutoriaNombreCompleto"
                                       name="NombreCompleto"
                                       required
                                       style="text-transform: uppercase;"
                                       oninput="this.value = this.value.toUpperCase()" />

                                <input type="hidden" id="tutoriaNombreCompletoOriginal" />
                            </div>

                            <div class="form-group">
                                <label>Nombre de Usuario <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="tutoriaUserName" name="UserName" required />
                                <small class="text-muted">Ingrese un nombre de usuario único</small>
                            </div>

                            <div class="form-group">
                                <label>Correo Electrónico (Usuarios)</label>
                                <div class="input-group">
                                    <input type="text" class="form-control modern-input readonly-field" id="tutoriaCorreo" readonly />
                                    @if (!esDirector)
                                    {
                                    <span class="input-group-btn">
                                        <button class="btn btn-info" type="button" id="btnSincronizarCorreo" style="border-radius: 0 8px 8px 0;">
                                            <i class="fa fa-refresh"></i> Sincronizar
                                        </button>
                                    </span>
                                    }
                                </div>
                                <small class="text-muted">Sincroniza desde Gestión si es incorrecto.</small>
                            </div>

                            <div class="form-group">
                                <label>Microsoft Identifier</label>
                                <div class="input-group">
                                    <input type="text" class="form-control modern-input readonly-field" id="tutoriaMicrosoftIdentifier" readonly />
                                    @if (!esDirector)
                                    {
                                    <span class="input-group-btn">
                                        <button class="btn btn-info" type="button" id="btnSincronizarIdentifier" style="border-radius: 0 8px 8px 0;">
                                            <i class="fa fa-refresh"></i> Sincronizar
                                        </button>
                                    </span>
                                    }
                                </div>
                                <small class="text-muted">Sincroniza desde Gestión. El ID se guardará en Tutorías y Estadias.</small>
                            </div>

                            <input type="hidden" id="tutoriaUserNameOriginal" />

                        </div> <div id="vistaDatosPersonales" style="display:none;">
                            <h4 style="color: var(--primary-color);"><i class="fa fa-id-card"></i> Editar Datos Personales Completos</h4>
                            <p class="text-muted" style="display:block; margin-top:-10px; margin-bottom:15px;">
                                Información detallada del registro `DatosPersonales`.
                            </p>

                            <input type="hidden" id="dp-idpersona-hidden" />
                            <input type="hidden" id="dp-matricula-original" />
                            <input type="hidden" id="dp-nombre-original" />
                            <input type="hidden" id="dp-email-original" />
                            <input type="hidden" id="dp-idcarrera-original" />
                            <input type="hidden" id="dp-especialidad-original" />

                            <div class="form-group">
                                <label>Matrícula <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="dp-matricula-edit" required />
                            </div>

                            <div class="form-group">
                                <label>Nombre Completo <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control modern-input"
                                       id="dp-nombre-edit"
                                       required
                                       style="text-transform: uppercase;"
                                       oninput="this.value = this.value.toUpperCase()" />
                            </div>

                            <div class="form-group">
                                <label>Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control modern-input" id="dp-email-edit" required />
                            </div>

                            <div class="form-group">
                                <label>Carrera <span class="text-danger">*</span></label>
                                <select class="form-control modern-input" id="dp-carrera-select" required>
                                    <option value="">Cargando carreras...</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Especialidad</label>
                                <select class="form-control modern-input" id="dp-especialidad-select" disabled>
                                    <option value="">Seleccione una carrera primero...</option>
                                </select>
                            </div>

                            <small id="dp-no-encontrado-msg" class="text-danger" style="display:none; font-size: 16px; text-align: center; display: block; padding: 20px;">
                                <i class="fa fa-exclamation-triangle"></i> No se encontró un registro completo en DatosPersonales.
                            </small>
                        </div>

                    </div> <div class="modal-footer" id="footerEdicionTutorias">
                        <button type="button" class="btn btn-info btn-modern" id="btnVerDatosPersonales" style="float:left;">
                            <i class="fa fa-id-card"></i> Ver Datos Personales
                        </button>

                        <button type="button" class="btn btn-danger btn-modern" data-dismiss="modal">
                            <i class="fa fa-times"></i> Cancelar
                        </button>
                        @if (!esDirector)
                        {
                        <button type="submit" class="btn btn-success btn-modern">
                            <i class="fa fa-save"></i> Guardar Cambios (Usuario)
                        </button>
                        }
                    </div>

                    <div class="modal-footer" id="footerDatosPersonales" style="display:none;">
                        <button type="button" class="btn btn-utt-outline btn-modern" id="btnVolverAEdicion">
                            <i class="fa fa-arrow-left"></i> Volver (Sin Guardar)
                        </button>
                        @if (!esDirector)
                        {
                        <button type="button" class="btn btn-success btn-modern" id="btnGuardarDatosPersonales">
                            <i class="fa fa-save"></i> Guardar Cambios (Datos)
                        </button>
                        }
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Editar Alumno de Gestión -->
    <div class="modal fade" id="modalEditarGestion" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-modern" role="document">
            <div class="modal-content">

                <div class="modal-header modal-header-gestion">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="fa fa-edit"></i>
                        Editar Alumno - Gestión
                    </h4>
                </div>

                <div id="vistaPrincipalGestion">
                    <form id="formEditarGestion">
                        <div class="modal-body">

                            <input type="hidden" id="gestionIdAlumno" name="IdAlumno" />

                            <div class="form-group">
                                <label>Nombre <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="gestionNombre" name="Nombre" required />
                            </div>

                            <div class="form-group">
                                <label>Apellido Paterno <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="gestionApellidoPaterno" name="ApellidoPaterno" required />
                            </div>

                            <div class="form-group">
                                <label>Apellido Materno <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="gestionApellidoMaterno" name="ApellidoMaterno" required />
                            </div>

                            <div class="form-group">
                                <label>Matrícula <span class="text-danger">*</span></label>
                                <input type="text" class="form-control modern-input" id="gestionMatricula" name="Matricula" required />
                                <small class="text-muted">Ingrese una matrícula única</small>
                            </div>

                            <div class="form-group">
                                <label>Correo Electrónico</label>
                                <input type="text" class="form-control modern-input readonly-field" id="gestionCorreo" readonly />
                                <small class="text-muted">Este campo no se puede modificar</small>
                            </div>

                            <input type="hidden" id="gestionNombreOriginal" />
                            <input type="hidden" id="gestionApellidoPaternoOriginal" />
                            <input type="hidden" id="gestionApellidoMaternoOriginal" />
                            <input type="hidden" id="gestionMatriculaOriginal" />
                        </div>

                        <div class="modal-footer" id="footerEdicionGestion">
                            <button type="button" class="btn btn-utt-outline btn-modern" id="btnVerDatosAcademicos" style="float:left;">
                                <i class="fa fa-graduation-cap"></i> Ver Datos Académicos
                            </button>
                            <button type="button" class="btn btn-danger btn-modern" data-dismiss="modal">
                                <i class="fa fa-times"></i> Cancelar
                            </button>
                            @if (!esDirector)
                            {
                            <button type="submit" class="btn btn-success btn-modern">
                                <i class="fa fa-save"></i> Guardar Cambios (Datos)
                            </button>
                            }
                        </div>
                    </form>
                </div>

                <div id="vistaDatosAcademicosGestion" style="display:none;">
                    <form id="formEditarGestionCarrera">
                        <div class="modal-body">

                            <h4 style="color: var(--primary-color);"><i class="fa fa-graduation-cap"></i> Editar Datos Académicos</h4>
                            <p class="text-muted" style="display:block; margin-top:-10px; margin-bottom:15px;">
                                Información de la base de datos de Estadias.
                            </p>

                            <input type="hidden" id="gestion-id_alumno-carrera" />
                            <input type="hidden" id="gestion-idcarrera-original" />

                            <div class="form-group">
                                <label>Carrera (Área)</label>
                                <select class="form-control modern-input" id="gestion-carrera-select" required>
                                    <option value="">Cargando carreras...</option>
                                </select>
                                <small class="text-muted">Esta es la carrera principal (Ej: TECNOLOGÍAS DE LA INFORMACIÓN) de la BD Estadias.</small>
                            </div>

                            @*<div class="form-group">
                                    <label><i class="fa fa-star"></i> Especialidad (Programa Específico)</label>
                                    <select class="form-control modern-input" id="gestion-especialidad-select" disabled>
                                        <option value="">(No implementado)</option>
                                    </select>
                                    <small class="text-danger">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        La edición de Especialidad (Programas de Area1) no está implementada.
                                        El sistema de Gestión solo guarda la Carrera principal.
                                    </small>
                                </div>*@

                        </div>

                        <div class="modal-footer" id="footerDatosAcademicosGestion">
                            <button type="button" class="btn btn-utt-outline btn-modern" id="btnVolverAEdicionGestion">
                                <i class="fa fa-arrow-left"></i> Volver (Sin Guardar)
                            </button>
                            @if (!esDirector)
                            {
                            <button type="button" class="btn btn-success btn-modern" id="btnGuardarGestionCarrera">
                                <i class="fa fa-save"></i> Guardar Carrera
                            </button>
                            }
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- MODAL: Confirmación de Cambios -->
    <div class="modal fade" id="modalConfirmarCambios" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-modern" role="document">
            <div class="modal-content">
                <div class="modal-header modal-header-warning">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="fa fa-exclamation-triangle"></i>
                        Confirmar Cambios
                    </h4>
                </div>
                <div class="modal-body">
                    <p class="lead">¿Está seguro de que desea modificar los siguientes datos?</p>
                    <div id="listaCambios"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger btn-modern" data-dismiss="modal">
                        <i class="fa fa-times"></i> Cancelar
                    </button>
                    @if (!esDirector)
                    {
                    <button type="button" class="btn btn-info btn-modern" id="btnConfirmarCambios">
                        <i class="fa fa-check"></i> Sí, Modificar
                    </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var formularioPendiente = null;
            var esDirector = @(esDirector ? "true" : "false");
            var userNivel = @(ViewBag.UserNivel ?? 0);
            var userCarreraId = @(ViewBag.UserCarrera ?? 0);
            var userCarreraNombre = '@Html.Raw(ViewBag.UserCarreraNombre ?? "N/A")';

            var tablaTutorias = $('#tablaTutorias').DataTable({
                "processing": true,
                "serverSide": true,
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
                "dom": 'rtip',
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json",
                    "infoFiltered": ""
                },
                "ajax": {
                    "url": "@Url.Action("GetUsuariosTutorias", "UsuarioAlumnos")",
                    "type": "POST",
                    "error": function (xhr, error, code) {
                        console.log('Error en Tabla Tutorías:', error);
                        alert('Error al cargar los datos de tutorías');
                    }
                },
                "columns": [
                    { "data": "NombreCompleto", "width": "25%" },
                    { "data": "UserName", "width": "15%" },
                    { "data": "CorreoElectronico", "width": "20%" },
                    { "data": "CarreraNombre", "width": "20%" },
                    {
                        "data": null,
                        "width": "20%",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row) {
                            if (esDirector) { return ''; }
                            return '<button class="btn btn-warning btn-sm btn-action btn-editar-tutorias" data-id="' + row.IdUsuario + '">' +
                                '<i class="fa fa-edit"></i> Editar' +
                                '</button>';
                        }
                    }
                ],
                "order": [[0, "asc"]],
                "responsive": true
            });

            var tablaGestion = $('#tablaGestion').DataTable({
                "processing": true,
                "serverSide": true,
                "pageLength": 10,
                "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
                "dom": 'rtip',
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json",
                    "processing": "Cargando...",
                    "infoFiltered": ""
                },
                "ajax": {
                    "url": "@Url.Action("GetAlumnosGestion", "AlumnosGestion")",
                    "type": "POST",
                    "error": function (xhr, error, code) {
                        console.log('Error en Tabla Gestión:', error);
                        console.log('Respuesta del servidor:', xhr.responseText);
                        alert('Error al cargar los datos de gestión');
                    }
                },
                "columns": [
                    { "data": "Nombre", "width": "15%" },
                    { "data": "ApellidoPaterno", "width": "15%" },
                    { "data": "ApellidoMaterno", "width": "15%" },
                    { "data": "Matricula", "width": "12%" },
                    { "data": "CorreoElectronico", "width": "18%" },
                    { "data": "CarreraNombre", "width": "15%" },
                    {
                        "data": null,
                        "width": "10%",
                        "orderable": false,
                        "searchable": false,
                        "render": function (data, type, row) {
                            if (esDirector) { return ''; }
                            return '<button class="btn btn-warning btn-sm btn-action btn-editar-gestion" data-id="' + row.IdAlumno + '">' +
                                '<i class="fa fa-edit"></i> Editar' +
                                '</button>';
                        }
                    }
                ],
                "order": [[0, "asc"]],
                "responsive": true
            });

            $('#buscarTutorias').on('keyup', function () {
                tablaTutorias.search(this.value).draw();
            });

            $('#buscarGestion').on('keyup', function () {
                tablaGestion.search(this.value).draw();
            });

            $('#tablaTutorias').on('click', '.btn-editar-tutorias', function () {
                var idUsuario = $(this).data('id');

                $.ajax({
                    url: '@Url.Action("GetUsuarioById", "UsuarioAlumnos")',
                    type: 'GET',
                    data: { id: idUsuario },
                    success: function (data) {

                        if (data.success) {

                            $('#tutoriaIdUsuario').val(data.usuario.IdUsuario);
                            $('#tutoriaNombreCompleto').val(data.usuario.NombreCompleto);
                            $('#tutoriaNombreCompletoOriginal').val(data.usuario.NombreCompleto);
                            $('#tutoriaUserName').val(data.usuario.UserName);
                            $('#tutoriaUserNameOriginal').val(data.usuario.UserName);
                            $('#tutoriaCorreo').val(data.usuario.CorreoElectronico);
                            $('#tutoriaMicrosoftIdentifier').val(data.usuario.MicrosoftIdentifier || 'No asignado');

                            if (data.datosPersonales) {
                                $('#dp-idpersona-hidden').val(data.datosPersonales.IdPersona);
                                $('#dp-matricula-edit').val(data.datosPersonales.Matricula);
                                $('#dp-nombre-edit').val(data.datosPersonales.Nombre);
                                $('#dp-email-edit').val(data.datosPersonales.Email);

                                $('#dp-matricula-original').val(data.datosPersonales.Matricula);
                                $('#dp-nombre-original').val(data.datosPersonales.Nombre);
                                $('#dp-email-original').val(data.datosPersonales.Email);
                                $('#dp-idcarrera-original').val(data.datosPersonales.IdCarrera);
                                $('#dp-especialidad-original').val(data.datosPersonales.Especialidad || '');

                                var esMaster = (userNivel == 4);
                                var esCoordinador = (userNivel == 3);
                                var puedeEditarCampos = (esMaster || esCoordinador);

                                $('#dp-matricula-edit').prop('readonly', !puedeEditarCampos);
                                $('#dp-nombre-edit').prop('readonly', !puedeEditarCampos);
                                $('#dp-email-edit').prop('readonly', !puedeEditarCampos);

                                var idCarreraParaEspecialidad;

                                if (esMaster) {
                                    $('#dp-carrera-select').prop('disabled', false);
                                    $('#dp-carrera-select').val(data.datosPersonales.IdCarrera);
                                    idCarreraParaEspecialidad = data.datosPersonales.IdCarrera;
                                } else if (esCoordinador) {
                                    $('#dp-carrera-select').val(userCarreraId);
                                    idCarreraParaEspecialidad = userCarreraId;
                                }

                                cargarDropdownEspecialidades(idCarreraParaEspecialidad, data.datosPersonales.Especialidad);

                                $('#dp-no-encontrado-msg').hide();
