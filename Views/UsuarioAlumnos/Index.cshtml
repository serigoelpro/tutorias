            $('#btnConfirmarCambios').on('click', function () {
                $('#modalConfirmarCambios').modal('hide');

                if (formularioPendiente === 'tutorias') {
                    enviarFormularioTutorias();
                } else if (formularioPendiente === 'gestion') {
                    enviarFormularioGestion();
