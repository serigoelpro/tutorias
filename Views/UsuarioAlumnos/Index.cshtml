            function cargarDropdownEspecialidades(idCarrera, especialidadPreseleccionada) {
                var $select = $('#dp-especialidad-select');
                if (!idCarrera || idCarrera === "") {
                    $select.html('<option value="">Seleccione una carrera primero...</option>');
                    $select.prop('disabled', true);
                    return;
                }

                $select.html('<option value="">Cargando...</option>');
                var puedeEditar = (userNivel == 3 || userNivel == 4);
                $select.prop('disabled', !puedeEditar);
                $.ajax({
                    url: '@Url.Action("GetEspecialidadesList", "UsuarioAlumnos")',
                    type: 'GET',
                    data: { idCarrera: idCarrera },
                    success: function (response) {
                        if (response.success) {
                            $select.html('<option value="">-- Sin Especialidad --</option>');
                            response.data.forEach(function (esp) {
                                $select.append($('<option>', {
                                    value: esp.Nombre,
                                    text: esp.Nombre
                                }));
                            });

                            if (especialidadPreseleccionada) {
                                $select.val(especialidadPreseleccionada);
                            }
                        } else {
                            $select.html('<option value="">Error al cargar</option>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error en cargarDropdownEspecialidades:", xhr.responseText, status, error);
                        $select.html('<option value="">Error de conexión</option>');
                    }
                });
