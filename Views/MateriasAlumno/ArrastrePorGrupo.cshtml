<script>
// ✅ CORRECCIÓN PRINCIPAL: Aquí defino mis variables de JavaScript con URL generada correctamente
var parametrosVista = {
    idGrupo: parseInt('@(ViewBag.IdGrupo ?? 1)') || 1,
    idCarrera: parseInt('@(ViewBag.IdCarrera ?? 1)') || 1,
    idGrado: parseInt('@(ViewBag.IdGrado ?? 1)') || 1,
    idTutoriaGrupal: parseInt('@(ViewBag.IdTutoriaGrupal ?? 1)') || 1,
    totalRegistros: parseInt('@modeloSeguro.Count') || 0,
    hayDatos: @Html.Raw(hayDatos.ToString().ToLower()),
    // ✅ NUEVA VARIABLE: URL base generada por Razor
    urlBaseArrastre: '@Url.Action("ArrastrePorGrupo", "MateriasAlumno")'
};

// Log de los valores del ViewBag
console.log('🔍 VALORES DEL VIEWBAG:');
console.log('- ViewBag.IdTutoriaGrupal:', '@ViewBag.IdTutoriaGrupal');
console.log('- ViewBag.IdGrupo:', '@ViewBag.IdGrupo');
console.log('- ViewBag.IdCarrera:', '@ViewBag.IdCarrera');
console.log('- ViewBag.IdGrado:', '@ViewBag.IdGrado');
console.log('- URL Base generada:', parametrosVista.urlBaseArrastre);
console.log('- Parámetros parseados:', parametrosVista);

$(document).ready(function () {
    console.log('Vista ArrastrePorGrupo cargada correctamente');
    console.log('Parámetros de la vista:', parametrosVista);

    // ✅ DEBUG: Verificar estado del dropdown al cargar
    var dropdownValue = $('.group-dropdown').val();
    var dropdownText = $('.group-dropdown option:selected').text();
    var expectedValue = parametrosVista.idTutoriaGrupal;

    console.log('🔍 DEBUG DROPDOWN AL CARGAR:');
    console.log('- Valor seleccionado en dropdown:', dropdownValue);
    console.log('- Texto seleccionado en dropdown:', dropdownText);
    console.log('- Valor esperado (parametrosVista.idTutoriaGrupal):', expectedValue);
    console.log('- ¿Coinciden?', dropdownValue == expectedValue);

    // ✅ CORRECCIÓN: Si no coinciden, forzar la selección
    if (dropdownValue != expectedValue && expectedValue) {
        console.log('⚠ CORRIGIENDO: Dropdown no coincide, forzando selección...');
        $('.group-dropdown').val(expectedValue);

        // Verificar después de forzar
        var newValue = $('.group-dropdown').val();
        var newText = $('.group-dropdown option:selected').text();
        console.log('✅ DESPUÉS DE CORRECCIÓN:');
        console.log('- Nuevo valor:', newValue);
        console.log('- Nuevo texto:', newText);
    }

    // Aquí inicializo todos mis componentes principales
    inicializarComponentes();

    // Escucho los cambios de filtro desde la tabla
    escucharCambiosFiltro();

    console.log('Todos los componentes inicializados correctamente');
});

// Esta función inicializa todos mis componentes de la interfaz
function inicializarComponentes() {
    // Configuro mis tooltips con opciones avanzadas
    $('[title]').tooltip({
        placement: 'top',
        container: 'body',
        delay: { show: 500, hide: 100 },
        animation: true
    });

    // Configuro mis dropdowns de Bootstrap
    $('.dropdown-toggle').dropdown();

    // Mejoro la experiencia del selector de grupo
    $('.group-dropdown').on('focus', function() {
        $(this).closest('.group-selector-section').addClass('focused');
    }).on('blur', function() {
        $(this).closest('.group-selector-section').removeClass('focused');
    });

    // Animo mis estadísticas al cargar si hay datos
    if (parametrosVista.totalRegistros > 0) {
        animarEstadisticas();
    }

    // Configuro el indicador inicial de filtro
    actualizarIndicadorFiltro('todos', parametrosVista.totalRegistros);
}

// Esta función escucha los cambios de filtro desde la tabla
function escucharCambiosFiltro() {
    $(document).on('filtroChanged', function(event, tipoFiltro, cantidad) {
        actualizarIndicadorFiltro(tipoFiltro, cantidad);
    });
}

// Aquí actualizo mi indicador de filtro según lo que esté mostrando
function actualizarIndicadorFiltro(tipo, cantidad) {
    var texto = '';
    var clase = 'label-info';

    switch(tipo) {
        case 'criticos':
            texto = 'Críticos (' + cantidad + ')';
            clase = 'label-danger';
            break;
        case 'medios':
            texto = 'Medios (' + cantidad + ')';
            clase = 'label-warning';
            break;
        case 'recientes':
            texto = 'Recientes (' + cantidad + ')';
            clase = 'label-info';
            break;
        case null:
        case 'todos':
            texto = 'Todos (' + cantidad + ')';
            clase = 'label-success';
            break;
        default:
            texto = 'Filtrado (' + cantidad + ')';
            clase = 'label-primary';
    }

    $('#indicadorFiltro').removeClass('label-info label-danger label-warning label-success label-primary')
                         .addClass(clase)
                         .html('<i class="fa fa-filter"></i> Mostrando: ' + texto);
}

// ✅ Esta es mi función principal para cambiar de grupo
function cambiarGrupo(idTutoriaGrupal) {
    console.log('=== INICIANDO CAMBIO DE GRUPO ===');
    console.log('ID recibido:', idTutoriaGrupal, 'Tipo:', typeof idTutoriaGrupal);

    // ✅ VALIDACIÓN ROBUSTA
    if (!idTutoriaGrupal ||
        idTutoriaGrupal === '' ||
        idTutoriaGrupal === '0' ||
        idTutoriaGrupal === 'Selecciona un grupo...' ||
        idTutoriaGrupal === 'undefined') {

        console.error('❌ ID inválido:', idTutoriaGrupal);
        mostrarNotificacion('Por favor seleccione un grupo válido', 'warning');

        // Restaurar selección anterior
        $('.group-dropdown').val(parametrosVista.idTutoriaGrupal);
        return;
    }

    // ✅ EVITAR RECARGAR EL MISMO GRUPO
    if (parseInt(idTutoriaGrupal) === parametrosVista.idTutoriaGrupal) {
        console.log('ℹ Ya está viendo este grupo');
        mostrarNotificacion('Ya estás viendo este grupo', 'info');
        return;
    }

    console.log('✅ Cambiando a grupo:', idTutoriaGrupal);

    // Deshabilitar dropdown durante cambio
    $('.group-dropdown').prop('disabled', true);

    // Mostrar modal de carga
    $('#modalDescarga').modal({
        backdrop: 'static',
        keyboard: false
    });

    $('.loading-title').text('Cambiando de grupo...');
    $('.loading-description').text('Cargando datos del nuevo grupo. Por favor espere...');

    // ✅ CORRECCIÓN PRINCIPAL: Determinar controlador correcto automáticamente
    var nuevaUrl;
    var controllerActual = window.location.pathname.split('/')[1]; // Extraer controlador actual

    console.log('🔍 Controlador actual detectado:', controllerActual);

    // ✅ USAR EL MISMO CONTROLADOR QUE ESTÁ FUNCIONANDO ACTUALMENTE
    if (controllerActual && controllerActual.toLowerCase() === 'arrastregrupo') {
        // Si venimos de ArrastreGrupoController, usar ese
        nuevaUrl = '/ArrastreGrupo/ArrastrePorGrupo/' + encodeURIComponent(idTutoriaGrupal);
    } else {
        // Si venimos de MateriasAlumnoController, usar ese
        nuevaUrl = '/MateriasAlumno/ArrastrePorGrupo/' + encodeURIComponent(idTutoriaGrupal);
    }

    console.log('🔗 URL final generada:', nuevaUrl);

    // ✅ MÉTODO DE RESPALDO SI DETECTA PROBLEMA
    setTimeout(function () {
        console.log('🚀 Navegando a:', nuevaUrl);

        try {
            window.location.href = nuevaUrl;
        } catch (error) {
            console.error('❌ Error navegando:', error);

            // ✅ MÉTODO ALTERNATIVO: Recarga con parámetros
            var urlAlternativa = window.location.pathname + '?id=' + encodeURIComponent(idTutoriaGrupal);
            console.log('🔄 URL alternativa:', urlAlternativa);
            window.location.href = urlAlternativa;
        }
    }, 800);
}

// Mi función de exportación de críticos ahora recibe todos los parámetros
function exportarSoloCriticos(idGrupo, idCarrera, idGrado) {
    console.log('Iniciando exportación de materias críticas');
    console.log('Parámetros recibidos:', { idGrupo: idGrupo, idCarrera: idCarrera, idGrado: idGrado });

    // Ahora genero la URL con todos los parámetros necesarios
    var url = '@Url.Action("ExportarArrastreExcel", "MateriasAlumno")' +
              '?idGrupo=' + idGrupo +
              '&idCarrera=' + idCarrera +
              '&idGrado=' + idGrado +
              '&soloCriticos=true';

    console.log('URL generada:', url);

    // Muestro feedback visual
    $('#modalDescarga').modal('show');
    $('.loading-title').text('Generando Excel...');
    $('.loading-description').text('Preparando el reporte de materias críticas. Por favor espere.');

    // Proceso la descarga
    setTimeout(function() {
        try {
            window.location.href = url;
            $('#modalDescarga').modal('hide');
            mostrarNotificacion('Excel de materias críticas generado exitosamente', 'success');
        } catch (error) {
            console.error('Error al generar Excel:', error);
            $('#modalDescarga').modal('hide');
            mostrarNotificacion('Error al generar el archivo Excel', 'danger');
        }
    }, 1200);
}

// Esta función permite imprimir la tabla actual
function imprimirTabla() {
    console.log('Iniciando impresión de tabla');

    var titulo = '@ViewBag.NombreGrupo - @ViewBag.NombreCarrera';
    var contenidoTabla = document.querySelector('.tabla-principal table');

    if (!contenidoTabla) {
        console.warn('No se encontró tabla para imprimir');
        mostrarNotificacion('No hay tabla disponible para imprimir', 'warning');
        return;
    }

    // Creo una ventana de impresión optimizada
    var ventanaImpresion = window.open('', '_blank', 'width=1200,height=800,scrollbars=yes');

    if (!ventanaImpresion) {
        mostrarNotificacion('Error: Las ventanas emergentes están bloqueadas', 'danger');
        return;
    }

    var fechaActual = new Date();
    var fechaFormateada = fechaActual.toLocaleDateString('es-ES');
    var horaFormateada = fechaActual.toLocaleTimeString('es-ES');

    ventanaImpresion.document.write(`
        <!DOCTYPE html>
        <html lang="es">
        <head>
            <title>Reporte de Arrastre - ${titulo}</title>
            <meta charset="utf-8">
            <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
            <style>
                body {
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    font-size: 12px;
                    margin: 20px;
                    line-height: 1.4;
                }
                .page-header {
                    color: #2c3e50;
                    border-bottom: 3px solid #1abc9c;
                    padding-bottom: 15px;
                    margin-bottom: 30px;
                }
                .page-header h2 { margin-top: 0; color: #1abc9c; }
                .table {
                    font-size: 11px;
                    border-collapse: collapse;
                    width: 100%;
                }
                .table thead th {
                    background-color: #1abc9c !important;
                    color: white !important;
                    -webkit-print-color-adjust: exact;
                    text-align: center;
                    padding: 8px 4px;
                }
                .fila-danger {
                    background-color: rgba(231, 76, 60, 0.1) !important;
                    -webkit-print-color-adjust: exact;
                }
                .fila-warning {
                    background-color: rgba(243, 156, 18, 0.1) !important;
                    -webkit-print-color-adjust: exact;
                }
                .fila-info {
                    background-color: rgba(52, 152, 219, 0.1) !important;
                    -webkit-print-color-adjust: exact;
                }
                .controles-tabla, .btn-group-vertical { display: none; }
                .table td { padding: 6px 4px; border: 1px solid #ddd; }
                .text-center { text-align: center; }
                @@media print {
                    body { margin: 10px; }
                    .table { font-size: 9px; }
                    .no-print { display: none; }
                }
                .footer {
                    margin-top: 30px;
                    text-align: center;
                    color: #7f8c8d;
                    font-size: 10px;
                    border-top: 1px solid #ddd;
                    padding-top: 10px;
                }
            </style>
        </head>
        <body>
            <div class="page-header">
                <h2>Reporte de Materias en Arrastre</h2>
                <h4>${titulo}</h4>
                <div style="margin-top: 10px;">
                    <strong>Generado:</strong> ${fechaFormateada} a las ${horaFormateada}<br>
                    <strong>Total de registros:</strong> ${$('.fila-filtrable:visible').length || parametrosVista.totalRegistros}<br>
                    <strong>Alumnos únicos:</strong> @totalAlumnosUnicos
                </div>
            </div>
            <div style="overflow-x: auto;">
                ${contenidoTabla.outerHTML}
            </div>
            <div class="footer">
                <strong>Sistema de Control Académico</strong> - Plataforma Web<br>
                Este reporte contiene información confidencial del sistema académico
            </div>
        </body>
        </html>
    `);

    ventanaImpresion.document.close();

    // Espero a que cargue y luego imprimo
    setTimeout(function() {
        ventanaImpresion.focus();
        ventanaImpresion.print();
    }, 1500);

    mostrarNotificacion('Ventana de impresión abierta exitosamente', 'info');
}

// Mi sistema de notificaciones profesional
function mostrarNotificacion(mensaje, tipo, duracion) {
    // Configuración de tipos de notificación
    var config = {
        'success': { icono: 'fa-check-circle', color: '#27ae60' },
        'info': { icono: 'fa-info-circle', color: '#3498db' },
        'warning': { icono: 'fa-exclamation-triangle', color: '#f39c12' },
        'danger': { icono: 'fa-exclamation-circle', color: '#e74c3c' }
    };

    var tipoConfig = config[tipo] || config['info'];
    duracion = duracion || 5000;

    // Creo la notificación moderna
    var notificacion = $(`
        <div class="notification-toast animate__animated animate__slideInRight"
             style="position: fixed; top: 20px; right: 20px; z-index: 10000;
                    background: white; min-width: 320px; max-width: 400px;
                    box-shadow: 0 8px 25px rgba(0,0,0,0.15); border-radius: 6px;
                    border-left: 4px solid ${tipoConfig.color}; padding: 15px 20px;
                    display: flex; align-items: flex-start; font-family: 'Segoe UI', sans-serif;">
            <i class="fa ${tipoConfig.icono}"
               style="font-size: 20px; color: ${tipoConfig.color}; margin-right: 12px; margin-top: 2px;"></i>
            <div style="flex: 1;">
                <div style="font-weight: 600; color: #2c3e50; margin-bottom: 4px; font-size: 0.95em;">
                    ${tipo.charAt(0).toUpperCase() + tipo.slice(1)}
                </div>
                <div style="color: #7f8c8d; font-size: 0.9em; line-height: 1.4;">
                    ${mensaje}
                </div>
            </div>
            <button type="button" class="close-notification"
                    style="background: none; border: none; color: #bdc3c7;
                           font-size: 18px; cursor: pointer; margin-left: 10px; padding: 0;">
                &times;
            </button>
        </div>
    `);

    // Configuro el evento de cerrar
    notificacion.find('.close-notification').click(function() {
        cerrarNotificacion(notificacion);
    });

    // Agrego al DOM con animación
    $('body').append(notificacion);

    // Auto-cierro después del tiempo especificado
    setTimeout(function() {
        if (notificacion.is(':visible')) {
            cerrarNotificacion(notificacion);
        }
    }, duracion);

    console.log(`Notificación ${tipo}: ${mensaje}`);
}

function cerrarNotificacion($notificacion) {
    $notificacion.removeClass('animate__slideInRight')
                .addClass('animate__slideOutRight');

    setTimeout(function() {
        $notificacion.remove();
    }, 300);
}

// Esta función anima mis estadísticas cuando hay datos
function animarEstadisticas() {
    $('.stat-number').each(function() {
        var $numero = $(this);
        var valorFinal = parseInt($numero.text()) || parseFloat($numero.text()) || 0;
        var contador = 0;
        var incremento = valorFinal / 30;

        var animacion = setInterval(function() {
            contador += incremento;
            if (contador >= valorFinal) {
                contador = valorFinal;
                clearInterval(animacion);
            }

            if (Number.isInteger(valorFinal)) {
                $numero.text(Math.floor(contador));
            } else {
                $numero.text(contador.toFixed(1));
            }
        }, 50);
    });
}

// Eventos del modal de descarga
$('#modalDescarga').on('hidden.bs.modal', function() {
    // Restauro el estado del selector
    $('.group-dropdown').prop('disabled', false);

    // Restauro textos por defecto
    $('.loading-title').text('Cargando grupo...');
    $('.loading-description').text('Por favor espere mientras se cargan los datos del nuevo grupo.');
});

$('#modalDescarga').on('shown.bs.modal', function() {
    console.log('Modal de carga mostrado');
});

// Mi manejo global de errores
window.onerror = function(mensaje, archivo, linea, columna, error) {
    console.error('Error JavaScript:', {
        mensaje: mensaje,
        archivo: archivo,
        linea: linea,
        columna: columna,
        error: error
    });

    mostrarNotificacion(
        'Se produjo un error en la aplicación. Por favor, recargue la página.',
        'danger',
        8000
    );

    return false;
};

console.log('Vista ArrastrePorGrupo completamente lista y optimizada');
</script>