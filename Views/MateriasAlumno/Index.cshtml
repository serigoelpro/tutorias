console.log('Planes de estudio cargados:', window.planesEstudio);

// FUNCIÓN PRINCIPAL PARA GUARDAR MATERIAS
function guardarTodasMaterias() {
    console.log('INICIANDO GUARDADO DE MATERIAS');

    var $filasPendientes = $('.materia-pendiente');
    console.log('Filas pendientes encontradas:', $filasPendientes.length);

    if ($filasPendientes.length === 0) {
        mostrarNotificacion('No se encontraron materias pendientes para procesar', 'warning', 3000);
        return;
    }

    var materias = [];
    var materiasConCambios = 0;
    var erroresValidacion = [];

    $filasPendientes.each(function(index) {
        var $fila = $(this);
        var idMateria = $fila.data('materia');
        var idPersona = $fila.data('persona');

        if (!idMateria || !idPersona) {
            return;
        }

        var $inputCalif = $fila.find('.calificacion-input');
        if ($inputCalif.length === 0) {
            return;
        }

        var calificacionTexto = $inputCalif.val();

        if (calificacionTexto && calificacionTexto.trim() !== '') {
            var calificacion = parseFloat(calificacionTexto.trim());

            if (isNaN(calificacion) || calificacion < 0 || calificacion > 10) {
                erroresValidacion.push(`Materia ${idMateria}: Calificación inválida "${calificacionTexto}"`);
                return;
            }

            var planMinima = parseFloat($inputCalif.data('plan-minima')) || 7.0;
            var planDecimales = $inputCalif.data('plan-decimales') === 'true' || $inputCalif.data('plan-decimales') === true;

            var calificacionFinal = calificacion;
            if (!planDecimales) {
                calificacionFinal = Math.round(calificacion);
                if (Math.abs(calificacion - calificacionFinal) > 0.001) {
                    $inputCalif.val(calificacionFinal);
                }
            }

            var estado;
            if (calificacionFinal >= planMinima) {
                estado = 'Acreditada';
            } else {
                estado = 'Extraordinario';
            }

            materias.push({
                IdMateria: parseInt(idMateria),
                IdPersona: parseInt(idPersona),
                Calificacion: calificacionFinal,
                Estado: estado,
                IntentosExtraordinarios: estado === 'Extraordinario' ? 1 : 0,
                Observaciones: '',
                FechaInicioArrastre: null
            });

            materiasConCambios++;
        }
    });

    console.log(`Resumen: ${materiasConCambios} materias preparadas`);

    if (materiasConCambios === 0) {
        mostrarNotificacion('No hay calificaciones nuevas para guardar', 'warning', 3000);
        return;
    }

    if (erroresValidacion.length > 0) {
        mostrarNotificacion('Errores de validación: ' + erroresValidacion.join(', '), 'error', 5000);
        return;
    }

    var $boton = $('button[onclick="guardarTodasMaterias()"]');
    var textoOriginal = $boton.html();
    $boton.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> Guardando...');

    console.log('Enviando datos al servidor:', materias);

    $.ajax({
        url: '@Url.Action("GuardarTodasMaterias", "MateriasAlumno")',
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: JSON.stringify(materias),
        dataType: 'json',
        success: function(response) {
            console.log('Respuesta del servidor:', response);
            $boton.prop('disabled', false).html(textoOriginal);

            if (response.success) {
                mostrarNotificacion(response.message, 'success', 4000);

                if (response.alumnoReprobado) {
                    setTimeout(function() {
                        mostrarNotificacion((response.motivoReprobacion || 'Límites académicos excedidos'), 'error', 8000);
                    }, 2000);
                }

                setTimeout(function() {
                    location.reload();
                }, response.alumnoReprobado ? 4000 : 2000);

            } else {
                mostrarNotificacion('Error: ' + response.message, 'error', 6000);
            }
        },
        error: function(xhr, status, error) {
            console.error('Error AJAX:', {xhr: xhr, status: status, error: error});
            $boton.prop('disabled', false).html(textoOriginal);

            var mensajeError = 'Error de conexión';
            if (xhr.responseJSON && xhr.responseJSON.message) {
                mensajeError = xhr.responseJSON.message;
            } else if (xhr.responseText) {
                mensajeError = xhr.responseText.substring(0, 100);
            }

            mostrarNotificacion(mensajeError, 'error', 6000);
        }
    });
}

