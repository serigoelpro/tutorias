// MODAL 2: CONFIRMAR CAMBIO DE MATERIA EN EXTRAORDINARIO
// ====================================

window.guardarExtraordinarioConPlan = function(idMateria, idPersona) {
    // Guardar IDs
    materiaIdActualModal = idMateria;
    personaIdActualModal = idPersona;

    // Obtener nombre de la materia
    var nombreMateria = $(`tr[data-materia="${idMateria}"][data-persona="${idPersona}"] td:first strong`).text() || 'esta materia';

    // Mostrar modal
    $('#modalExtraordinarioNombreMateria').text(nombreMateria);
    $('#modalConfirmarExtraordinario').modal('show');
};

$('#btnConfirmarExtraordinarioModal').on('click', function () {
    $('#modalConfirmarExtraordinario').modal('hide');

    var idMateria = materiaIdActualModal;
    var idPersona = personaIdActualModal;

    console.log(`Guardando extraordinario - Materia ${idMateria}...`);

    var $row = $(`tr[data-materia="${idMateria}"][data-persona="${idPersona}"]`);
    var $inputCalif = $row.find('.calificacion-extra');
    var calificacionTexto = $inputCalif.val().trim();

    var observaciones = $row.find('.observaciones-extra').val() || '';
    var intentos = 1;

    var planMinima = parseFloat($inputCalif.data('plan-minima')) || 7.0;
    var planDecimales = $inputCalif.data('plan-decimales') === 'true' || $inputCalif.data('plan-decimales') === true;
    var planNombre = $inputCalif.data('plan-nombre') || 'Plan Estándar';

    if (!calificacionTexto || calificacionTexto === '') {
        mostrarNotificacion('Por favor ingrese una calificacion valida', 'warning', 3000);
        return;
    }

    var calificacion = parseFloat(calificacionTexto);

    if (isNaN(calificacion) || calificacion < 0 || calificacion > 10) {
        mostrarNotificacion('La calificacion debe estar entre 0 y 10', 'warning', 3000);
        return;
    }

    var calificacionFinal = calificacion;
    if (!planDecimales) {
        if (calificacion < 8.0) {
            calificacionFinal = Math.floor(calificacion);
        } else {
            calificacionFinal = Math.round(calificacion);
        }
    }

    var estado;
    if (calificacionFinal >= planMinima) {
        estado = 'Acreditada';
    } else {
        estado = 'Reprobada';
    }

    console.log(`Estado determinado: ${estado}`);

    var $boton = $row.find('button[onclick*="guardarExtraordinarioConPlan"]');
    var textoOriginal = $boton.html();
    $boton.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> Guardando...');

    $.ajax({
        url: '@Url.Action("ActualizarMateria", "MateriasAlumno")',
        type: 'POST',
        data: {
            idMateria: idMateria,
            idPersona: idPersona,
            calificacion: calificacionFinal,
            estado: estado,
            intentosExtraordinarios: estado === 'Reprobada' ? 2 : 0,
            observaciones: observaciones,
            fechaExamen: new Date().toISOString().split('T')[0],
            fechaInicioArrastre: estado === 'Reprobada' ? new Date().toISOString().split('T')[0] : null
        },
        success: function(result) {
            $boton.prop('disabled', false).html(textoOriginal);

            if (result.success) {
                var mensaje = estado === 'Acreditada' ?
                    `Materia acreditada` :
                    `Materia reprobada`;

                mostrarNotificacion(mensaje, estado === 'Acreditada' ? 'success' : 'warning', 4000);

                setTimeout(function() {
                    location.reload();
                }, 2000);
            } else {
                mostrarNotificacion('Error: ' + result.message, 'error', 4000);
            }
        },
        error: function(xhr, status, error) {
            $boton.prop('disabled', false).html(textoOriginal);
            mostrarNotificacion('Error de conexion', 'error', 4000);
        }
    });
});

// ====================================
// MODAL 3: CONFIRMAR CALIFICACIÓN DE ARRASTRE
// ====================================

window.guardarArrastreConPlan = function(idMateria, idPersona) {
    // Guardar IDs
    materiaIdActualModal = idMateria;
    personaIdActualModal = idPersona;

    // Obtener nombre de la materia
    var nombreMateria = $(`tr[data-materia="${idMateria}"][data-persona="${idPersona}"] td:first strong`).text() || 'esta materia';

    // Mostrar modal
    $('#modalArrastreNombreMateria').text(nombreMateria);
    $('#modalConfirmarArrastre').modal('show');
};

$('#btnConfirmarArrastreModal').on('click', function () {
    $('#modalConfirmarArrastre').modal('hide');

    var idMateria = materiaIdActualModal;
    var idPersona = personaIdActualModal;

    console.log(`Guardando arrastre - Materia ${idMateria}...`);

    var $row = $(`tr[data-materia="${idMateria}"][data-persona="${idPersona}"]`);
    var $inputCalif = $row.find('.calificacion-arrastre');
    var calificacionTexto = $inputCalif.val().trim();

    var observaciones = $row.find('.observaciones-arrastre').val() || '';
    var intentoActual = parseInt($row.data('intentos-originales')) || 2;

    var planMinima = parseFloat($inputCalif.data('plan-minima')) || 7.0;
    var planDecimales = $inputCalif.data('plan-decimales') === 'true';
    var planNombre = $inputCalif.data('plan-nombre') || 'Plan Estándar';

    if (!calificacionTexto || calificacionTexto === '') {
        mostrarNotificacion('Por favor ingrese una calificacion valida', 'warning', 3000);
        return;
    }

    var calificacion = parseFloat(calificacionTexto);

    if (isNaN(calificacion) || calificacion < 0 || calificacion > 10) {
        mostrarNotificacion('La calificacion debe estar entre 0 y 10', 'warning', 3000);
        return;
    }

    var calificacionFinal = calificacion;
    if (!planDecimales) {
        if (calificacion < 8.0) {
            calificacionFinal = Math.floor(calificacion);
        } else {
            calificacionFinal = Math.round(calificacion);
        }
    }

    var estado;
    var nuevoIntento = intentoActual;

    if (calificacionFinal >= planMinima) {
        estado = 'Acreditada';
        nuevoIntento = 0;
    } else {
        estado = 'Reprobada';
        // Piso de 2: indica que la materia esta en fase de arrastre (no incrementa)
        nuevoIntento = Math.max(intentoActual, 2);

        if (nuevoIntento > 3) {
            mostrarNotificacion('Se agotaron los intentos permitidos. La materia queda como REPROBADA DEFINITIVA.', 'error', 5000);
        }
    }

    console.log(`Estado: ${estado}, Intento: ${nuevoIntento}`);

    var $boton = $row.find('button[onclick*="guardarArrastreConPlan"]');
    var textoOriginal = $boton.html();
    $boton.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> Guardando...');

    $.ajax({
        url: '@Url.Action("ActualizarMateria", "MateriasAlumno")',
        type: 'POST',
        data: {
            idMateria: idMateria,
            idPersona: idPersona,
            calificacion: calificacionFinal,
            estado: estado,
            intentosExtraordinarios: nuevoIntento,
            observaciones: observaciones,
            fechaInicioArrastre: $row.find('.fecha-inicio-arrastre').val()
        },
        success: function(result) {
            $boton.prop('disabled', false).html(textoOriginal);

            if (result.success) {
                var mensaje;
                if (estado === 'Acreditada') {
                    mensaje = `Materia acreditada`;
                } else if (nuevoIntento >= 3) {
                    mensaje = `Intento ${nuevoIntento}/2 registrado - ULTIMO INTENTO`;
                } else {
                    mensaje = `Intento ${nuevoIntento}/2 registrado`;
                }

                mostrarNotificacion(mensaje, estado === 'Acreditada' ? 'success' : 'warning', 4000);

                setTimeout(function() {
                    location.reload();
                }, 2000);
            } else {
                mostrarNotificacion('Error: ' + result.message, 'error', 4000);
            }
        },
        error: function(xhr, status, error) {
            $boton.prop('disabled', false).html(textoOriginal);
            mostrarNotificacion('Error de conexion', 'error', 4000);
        }
    });
});

