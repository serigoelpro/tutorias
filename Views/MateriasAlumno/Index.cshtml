    function abrirModalEditarCalificacionHistorial(idPersona, idMateria, numeroIntento, tipoIntento, calificacionActual, nombreMateria) {
        console.log('Abriendo modal de edición:', { idPersona, idMateria, numeroIntento, tipoIntento, calificacionActual, nombreMateria });

        // Llenar campos del modal
        $('#editHist_IdPersona').val(idPersona);
        $('#editHist_IdMateria').val(idMateria);
        $('#editHist_NumeroIntento').val(numeroIntento);
        $('#editHist_NombreMateria').text(nombreMateria);
        $('#editHist_TipoIntento').text(tipoIntento);
        $('#editHist_CalificacionActual').text(calificacionActual.toFixed(2));
        $('#editHist_NuevaCalificacion').val('');
        $('#editHist_Observaciones').val('');

        // Mostrar modal
        $('#modalEditarCalificacionHistorial').modal('show');

        // Focus en el campo de nueva calificación
        setTimeout(function () {
            $('#editHist_NuevaCalificacion').focus();
        }, 500);
    }

$(document).ready(function() {
    $('#btnGuardarEdicionHistorial').off('click').on('click', function() {
        var idPersona = parseInt($('#editHist_IdPersona').val());
        var idMateria = parseInt($('#editHist_IdMateria').val());
        var numeroIntento = parseInt($('#editHist_NumeroIntento').val());

        // Asegurar que siempre sea decimal con 2 decimales
var nuevaCalificacion = parseFloat(parseFloat($('#editHist_NuevaCalificacion').val()).toFixed(2));

        var observaciones = $('#editHist_Observaciones').val() || '';

        console.log('Datos a enviar:', {
            idPersona: idPersona,
            idMateria: idMateria,
            numeroIntento: numeroIntento,
            nuevaCalificacion: nuevaCalificacion,
            tipoNuevaCalificacion: typeof nuevaCalificacion,
            observaciones: observaciones
        });

        // Validaciones
        if (isNaN(nuevaCalificacion) || nuevaCalificacion < 0 || nuevaCalificacion > 10) {
            alert('Por favor, ingrese una calificacion valida entre 0 y 10');
            return;
        }

        if (!confirm('¿Está seguro de que desea actualizar esta calificación?\n\nNueva calificación: ' + nuevaCalificacion.toFixed(2))) {
            return;
        }

        // Deshabilitar botón
        var btnOriginalHtml = $('#btnGuardarEdicionHistorial').html();
        $('#btnGuardarEdicionHistorial').prop('disabled', true).html('<i class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></i> Guardando...');

        // Enviar solicitud AJAX
        $.ajax({
            url: '@Url.Action("EditarCalificacionHistorialMaster", "MateriasAlumno")',
            type: 'POST',
            data: {
                idPersona: idPersona,
                idMateria: idMateria,
                numeroIntento: numeroIntento,
                nuevaCalificacion: nuevaCalificacion,
                observaciones: observaciones
            },
            success: function(response) {
                console.log('Respuesta de edición:', response);

                if (response.success) {
                    alert(response.mensaje);

                    // Cerrar modal de edición
                    $('#modalEditarCalificacionHistorial').modal('hide');

                    // Recargar historial
                    var nombreMateria = $('#editHist_NombreMateria').text();
                    verHistorialMateria(idPersona, idMateria, nombreMateria);

                    // Recargar la página después de 2 segundos para reflejar cambios
                    setTimeout(function() {
                        location.reload();
                    }, 2000);

                } else {
                    alert('❌ ' + response.mensaje);
                }
            },
            error: function(xhr, status, error) {
                console.error('Error al editar calificación:', error);
                console.error('Respuesta del servidor:', xhr.responseText);
                alert('❌ Error al procesar la solicitud: ' + error);
            },
            complete: function() {
                // Rehabilitar botón
                $('#btnGuardarEdicionHistorial').prop('disabled', false).html(btnOriginalHtml);
            }
        });
    });
});





</script>

