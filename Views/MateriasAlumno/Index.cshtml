// FUNCION PARA GUARDAR FECHA DE ARRASTRE (MASTER)
// ====================================
function guardarFechaArrastre(input, idMateria, idPersona) {
    var $input = $(input);
    var nuevaFecha = $input.val();

    if (!nuevaFecha) {
        mostrarNotificacion('La fecha no puede estar vacía.', 'error');
        $input.val($input.prop('defaultValue')); // Revertir
        return;
    }

    console.log(`Actualizando Fecha Arrastre: Materia ${idMateria}, Fecha ${nuevaFecha}`);
    // Guardar el valor original en caso de que falle
    var valorOriginal = $input.prop('defaultValue');
    $input.prop('disabled', true).css('opacity', 0.5);

    $.ajax({
        url: '@Url.Action("ActualizarFechaInicioArrastre", "MateriasAlumno")',
        type: 'POST',
        data: {
            idMateria: idMateria,
            idPersona: idPersona,
            nuevaFechaInicio: nuevaFecha
        },
        success: function (response) {
            $input.prop('disabled', false).css('opacity', 1);
            if (response.success) {
                mostrarNotificacion('Fecha de inicio actualizada.', 'success');

                // 1. Actualizar celda "Período Límite"
                var $celdaLimiteDisplay = $(`#limite-display-${idMateria}`);
                if ($celdaLimiteDisplay.length) {
                    $celdaLimiteDisplay.text(response.nuevaFechaLimiteDisplay);
                }

                // 2. Actualizar celda "Días Restantes"
                var $containerDias = $(`#dias-restantes-${idMateria}`);
                if ($containerDias.length) {
                    var nuevoHtmlDias =
                        '<br/><span class="label ' + response.nuevoEstadoLabel + '" style="font-size: 10px;">' +
                        '<span class="glyphicon ' + response.nuevoIcono + '"></span> ' +
                        response.nuevoEstadoTiempo +
                        '</span>';
                    $containerDias.html(nuevoHtmlDias);
                }

                // Actualizar el valor por defecto del input
                $input.prop('defaultValue', nuevaFecha);

            } else {
                mostrarNotificacion(response.message, 'error', 5000);
                $input.val(valorOriginal); // Revertir al valor original si falla
            }
        },
        error: function () {
            $input.prop('disabled', false).css('opacity', 1);
            mostrarNotificacion('Error de conexion al guardar la fecha.', 'error', 5000);
            $input.val(valorOriginal); // Revertir al valor original si falla
        }
    });
}

// FUNCIÓN PARA ACTUALIZAR ESTADO DINÁMICO
function actualizarEstadoDinamico(input) {
    var row = $(input).closest('tr');
    var idMateria = row.data('materia');
    var calificacionTexto = $(input).val().trim();
    var estadoSpan = row.find('.estado-dinamico');
    var mensajeDiv = row.find('.plan-validation-message');

    var planMinima = parseFloat($(input).data('plan-minima')) || 7.0;
    var planDecimales = $(input).data('plan-decimales') === 'true' || $(input).data('plan-decimales') === true;
    var planNombre = $(input).data('plan-nombre') || 'Plan Estándar';

    console.log(`Validando materia ${idMateria}`);

    // Limpiar mensajes previos
    mensajeDiv.html('');

    if (!calificacionTexto || calificacionTexto === '') {
        estadoSpan.removeClass('label-success label-warning label-danger').addClass('label-default').text('Pendiente');
        return;
    }

    var calificacion = parseFloat(calificacionTexto);

    if (isNaN(calificacion) || calificacion < 0 || calificacion > 10) {
        estadoSpan.removeClass('label-success label-warning').addClass('label-danger').text('Error');
        return;
    }

    // Aplicar redondeo según el plan
    var calificacionFinal = calificacion;

    if (!planDecimales) {
        if (calificacion < 8.0) {
            calificacionFinal = Math.floor(calificacion);
            if (Math.abs(calificacion - calificacionFinal) > 0.001) {
                $(input).val(calificacionFinal);
            }
        } else {
            calificacionFinal = Math.round(calificacion);
            if (Math.abs(calificacion - calificacionFinal) > 0.001) {
                $(input).val(calificacionFinal);
            }
        }
    } else {
        calificacionFinal = Math.round(calificacion * 100) / 100;
    }

    // Determinar estado según la calificación mínima del plan
    if (calificacionFinal >= planMinima) {
        estadoSpan.removeClass('label-default label-warning label-danger').addClass('label-success').text('Acreditado');
        mensajeDiv.html('');
    } else if (calificacionFinal >= 0) {
