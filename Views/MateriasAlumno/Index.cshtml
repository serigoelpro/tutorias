// FUNCION PARA GUARDAR CALIFICACION DE UNIDAD
function guardarCalificacionUnidad(input) {
    var $input = $(input);
    var idMateria = $input.data('materia-id');
    var idPersona = $input.data('persona-id');
    var numeroUnidad = $input.data('unidad');
    var calificacion = $input.val().trim();

    if (!calificacion || calificacion === '') {
        return; // No guardar si está vacío
    }

    var calif = parseFloat(calificacion);
    if (isNaN(calif) || calif < 0 || calif > 10) {
        mostrarNotificacion('Calificacion debe estar entre 0 y 10', 'warning', 3000);
        return;
    }

    console.log(`Guardando Unidad ${numeroUnidad} de materia ${idMateria}: ${calif}`);

    $.ajax({
        url: '@Url.Action("GuardarCalificacionUnidad", "MateriasAlumno")',
        type: 'POST',
        data: {
            idMateria: idMateria,
            idPersona: idPersona,
            numeroUnidad: numeroUnidad,
            calificacion: calif
        },
        success: function(result) {
            if (result.success) {
                // Actualizar contador de unidades calificadas
                $(`.calificadas-info-${idMateria}`).text(
                    `${result.unidadesCalificadas} de ${result.totalUnidades} calificadas (${result.porcentajeAvance}%)`
                );

                // Si todas las unidades estan calificadas, actualizar calificacion final
                if (result.todasCalificadas && result.calificacionFinal) {
                    $(`.calificacion-final-${idMateria}`).text(result.calificacionFinal.toFixed(2));

                    var estado = result.calificacionFinal >= parseFloat($input.data('plan-minima')) ? 'Acreditada' : 'No Acreditada';
                    var labelClass = estado === 'Acreditada' ? 'label-success' : 'label-danger';

                    $(`.estado-materia-${idMateria}`)
                        .removeClass('label-default label-success label-danger label-warning')
                        .addClass(labelClass)
                        .text(estado);

                    mostrarNotificacion(result.message, 'success', 4000);

                    // Recargar después de 2 segundos para reflejar cambios en el estado general
                    setTimeout(function() {
                        location.reload();
                    }, 2000);
                } else {
                    mostrarNotificacion(result.message, 'success', 3000);
                }
            } else {
                mostrarNotificacion(result.message, 'error', 4000);
            }
        },
        error: function() {
            mostrarNotificacion('Error de conexion', 'error', 3000);
        }
    });
}

