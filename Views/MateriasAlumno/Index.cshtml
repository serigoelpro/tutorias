                if (estado === 'Acreditada') {
                    mensaje = `✓ Materia acreditada exitosamente`;
                } else if (nuevoIntento >= 3) {
                    mensaje = `Materia bloqueada - se agotaron los 2 cambios permitidos en arrastre`;
                } else {
                    var cambiosRestantes = 3 - nuevoIntento;
                    var cambioActual = nuevoIntento - 1;
                    mensaje = `✓ Cambio ${cambioActual}/2 guardado`;
