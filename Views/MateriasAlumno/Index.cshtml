@model List<PlataformaWeb.Models.Materias.MateriaAlumno>
@using System.Collections.Generic
@using System.Web.Script.Serialization
@using PlataformaWeb.Models.Materias
@{
    ViewBag.Title = "Materias del Alumno";

    string nombreAlumno = ViewBag.AlumnoNombre as string ?? "Alumno";
    string matricula = ViewBag.Matricula as string ?? "";
    string carrera = ViewBag.Carrera as string ?? "";
    int idPersona = ViewBag.IdPersona != null ? (int)ViewBag.IdPersona : 0;

    // OBTENER EL GRADO ACTUAL DEL ALUMNO DESDE VIEWBAG
    int gradoActualAlumno = ViewBag.IdGrado != null ? (int)ViewBag.IdGrado : 0;

    // ESTADO ACTUAL DEL ALUMNO - LÍMITES CORREGIDOS 3/4
    int totalReprobadas = ViewBag.TotalReprobadas != null ? (int)ViewBag.TotalReprobadas : 0;
    int totalExtraordinarios = ViewBag.TotalExtraordinarios != null ? (int)ViewBag.TotalExtraordinarios : 0;

    // LÍMITES CORREGIDOS: >=4 arrastre O >=4 extraordinario = BAJA
    bool dadoDeBajaPorArrastre = totalReprobadas >= 4;
    bool dadoDeBajaPorExtraordinarios = totalExtraordinarios >= 4;
    bool alumnoReprobado = dadoDeBajaPorArrastre || dadoDeBajaPorExtraordinarios;

    // Determinar motivo de reprobación
    string motivoReprobacion = "";
    if (dadoDeBajaPorArrastre && dadoDeBajaPorExtraordinarios)
    {
        motivoReprobacion = "Excedió límite de materias en arrastre (≥4) y extraordinario (≥4)";
    }
    else if (dadoDeBajaPorArrastre)
    {
        motivoReprobacion = "Excedió límite de materias en arrastre (≥4)";
    }
    else if (dadoDeBajaPorExtraordinarios)
    {
        motivoReprobacion = "Excedió límite de materias en extraordinario (≥4)";
    }

    // INDICADORES DE LÍMITE CORREGIDOS
    bool enElLimiteArrastre = totalReprobadas == 2;
    bool enElLimiteExtraordinarios = totalExtraordinarios == 3;
    bool cercaDelLimite = enElLimiteArrastre || enElLimiteExtraordinarios;

    // Precalcular estados y separar materias por estado
    var materiasReprobadas = new List<PlataformaWeb.Models.Materias.MateriaAlumno>();
    var materiasExtraordinario = new List<PlataformaWeb.Models.Materias.MateriaAlumno>();
    var materiasAcreditadas = new List<PlataformaWeb.Models.Materias.MateriaAlumno>();
    var materiasPendientes = new List<PlataformaWeb.Models.Materias.MateriaAlumno>();


    // Lista de materias no acreditadas para mostrar en la tabla de unidades
    var materiasNoAcreditadas = new List<PlataformaWeb.Models.Materias.MateriaAlumno>();



    decimal suma = 0;
    int contador = 0;
    bool hayReprobadaEnPromedio = false;
    bool tieneReprobadas = false;
    bool tieneExtraordinario = false;
    decimal promedioFinal = 0;

    // Contadores para determinar plan predominante
    int materiasPlan2020 = 0;
    int materiasPlan2024 = 0;

    // DECLARAR CALIFICACIÓN MÍNIMA DEL PLAN
    decimal calificacionMinimaDelPlan = 7.0m;

    if (Model != null)
    {
        foreach (var item in Model)
        {

            // Contar materias por plan de estudio Y CALCULAR PROMEDIO
            if (item.IdGrado == gradoActualAlumno)
            {
                string nombrePlan = item.NombrePlan ??
"";
                if (nombrePlan.Contains("2020"))
                {
                    materiasPlan2020++;
                }
                else if (nombrePlan.Contains("2024"))
                {
                    materiasPlan2024++;
                }

                // SUMAR CALIFICACIONES PARA EL PROMEDIO (LÓGICA CORREGIDA)
                // Solo sumar si la materia es del cuatrimestre actual
                if (item.Calificacion.HasValue && item.Estado != null && item.Estado.ToLower() != "pendiente")
                {
                    decimal calificacionParaSuma = item.Calificacion.Value;

                    if (nombrePlan.Contains("2020"))
                    {
                        // 1. Detectar si falló alguna unidad (Usamos Exists para evitar error de LINQ)
                        bool tieneUnidadReprobada = false;
                        if (item.CalificacionesUnidades != null && item.CalificacionesUnidades.Count > 0)
                        {
                            tieneUnidadReprobada = item.CalificacionesUnidades.Exists(u => u.Calificacion.HasValue && u.Calificacion.Value < 8.0m);
                        }

                        // 2. Ajustar calificación individual
                        // NOTA: En Razor es OBLIGATORIO usar llaves { } en los if/else
                        // Castigar sólo cuando la calificación realmente NO alcanzó el mínimo.
                        // Si Estado="Extraordinario" pero la calificación es >= 8 (pasó el extraordinario
                        // aunque Estado no se actualizó a "Acreditada"), NO aplicar castigo.
                        bool extraordinarioSinAcreditar = item.Estado == "Extraordinario" &&
                            (!item.Calificacion.HasValue || item.Calificacion.Value < 8.0m);

                        // El resultado del EXTRAORDINARIO o de un registro ya ACREDITADO con >= 8
                        // PREVALECE sobre las calificaciones originales de las unidades.
                        // Si la materia se acreditó (por extraordinario o por curso) con >=8, las
                        // unidades reprobadas originales NO deben castigar el promedio general.
                        bool acreditadaPorExtraordinarioOCurso =
                            item.Calificacion.HasValue && item.Calificacion.Value >= 8.0m &&
                            (item.Estado == "Extraordinario" || item.Estado == "Acreditada");
                        if (acreditadaPorExtraordinarioOCurso)
                        {
                            tieneUnidadReprobada = false;
                        }

                        if (tieneUnidadReprobada || extraordinarioSinAcreditar || item.Estado == "Reprobada")
                        {
                            // Castigo: Si tiene >= 8 pero reprobó unidad, baja a 7
                            if (calificacionParaSuma >= 8.0m)
                            {
                                calificacionParaSuma = 7.0m;
                            }
                            else
                            {
                                calificacionParaSuma = Math.Floor(calificacionParaSuma);
                            }
                        }
                        else
                        {
                            // Aprobada limpia
                            if (calificacionParaSuma >= 8.0m)
                            {
                                calificacionParaSuma = Math.Round(calificacionParaSuma, 0);
                            }
                            else
                            {
                                calificacionParaSuma = Math.Floor(calificacionParaSuma);
                            }
                        }

                        // 3. BANDERA GLOBAL: Si esta materia quedo reprobada (< 8), marcamos para castigar el promedio final
                        if (calificacionParaSuma < 8.0m)
                        {
                            hayReprobadaEnPromedio = true;
                        }
                    }

                    suma += calificacionParaSuma;
                    contador++;

                }
            }


            // Separar materias por estado (para las listas de arrastre, etc.)
            var estado = item.Estado != null ?
    item.Estado.ToLower() : null;
            switch (estado)
            {
                case "reprobada":
                    materiasReprobadas.Add(item);
                    tieneReprobadas = true;
                    break;
                case "extraordinario":
                    materiasExtraordinario.Add(item);
                    tieneExtraordinario = true;
                    break;
                case "acreditada":
                    materiasAcreditadas.Add(item);
                    break;
                default:
                    materiasPendientes.Add(item);
                    break;
            }

            // Solo agregar materias que NO estén acreditadas
            if (estado != "acreditada")
            {
                materiasNoAcreditadas.Add(item);
            }
        }

        // Determinar plan predominante
        bool usarPlan2020 = materiasPlan2020 > materiasPlan2024;
        bool usarPlan2024 = materiasPlan2024 >= materiasPlan2020;

        string planPredominante = usarPlan2020 ? "Plan 2020" : "Plan 2024";

        // Determinar calificación mínima según plan predominante
        calificacionMinimaDelPlan = usarPlan2020 ? 8.0m : 7.0m;

        // Lógica del promedio según plan predominante
        if (contador > 0)
        {
            decimal promedioBase = suma / contador;

            if (usarPlan2020)
            {
                // PLAN 2020: Lógica Estricta

                // VALIDACION MAESTRA:
                // Si hay AL MENOS UNA materia reprobada (<8) en el promedio,
                // el promedio general NO puede ser aprobatorio (>=8), aunque la matemática diga lo contrario.
                if (hayReprobadaEnPromedio && promedioBase >= 8.0m)
                {
                    promedioFinal = 7.0m; // Castigo: Tope máximo reprobatorio
                }
                else if (promedioBase < 8.0m)
                {
                    // Si ya era reprobatorio, aplicamos Floor (ej: 7.9 -> 7)
                    promedioFinal = Math.Floor(promedioBase);
                }
                else
                {
                    // Si no hay reprobadas y el promedio es bueno, redondeo normal (ej: 9.5 -> 10)
                    promedioFinal = Math.Round(promedioBase, 0);
                }
            }
            else
            {
                // PLAN 2024: Mantener decimales
                promedioFinal = Math.Round(promedioBase, 2);
            }
        }
        else
        {
            promedioFinal = 0;
        }
    }

    bool tieneMaterias = Model != null && Model.Count > 0;

    int usuarioNivel = ViewBag.UsuarioNivel ?? 0;
    bool esMaster = usuarioNivel == 4;
}

<div class="sga-scope">
    <h2>
        Materias de @nombreAlumno
        @if (!string.IsNullOrEmpty(matricula))
        {
            <small class="text-muted">(@matricula - @carrera)</small>
        }
    </h2>

    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @ViewBag.Error
        </div>
    }

    <!-- ALERTA CRÍTICA DE BAJA ACADÉMICA -->
    @if (alumnoReprobado)
    {
        <div class="alert alert-danger alert-dismissible" style="border: 3px solid #d9534f; animation: pulse-critical 2s infinite;">
            <h3><span class="glyphicon glyphicon-ban-circle"></span> <strong> LÍMITES ACADÉMICOS EXCEDIDOS</strong></h3>
            <h4>@motivoReprobacion</h4>
            <p><strong>El sistema detectó automáticamente que se excedieron los límites permitidos.</strong></p>

            <div class="row">
                <div class="col-md-6">
                    <h5><strong>Límites Excedidos:</strong></h5>
                    <ul style="font-size: 14px;">
                        @if (dadoDeBajaPorArrastre)
                        {
                            <li style="color: #d9534f;"><strong>✗ Materias en Arrastre:</strong> @totalReprobadas/3 </li>
                        }
                        @if (dadoDeBajaPorExtraordinarios)
                        {
                            <li style="color: #d9534f;"><strong>✗ Materias en Extraordinario:</strong> @totalExtraordinarios/3</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- PANEL DE ESTADO ACADÉMICO -->
    <div class="panel @(alumnoReprobado ? "panel-danger" : (cercaDelLimite ? "panel-warning" : "panel-info"))">
        <div class="panel-heading">
            <h4>
                <span class="glyphicon @(alumnoReprobado ? "glyphicon-exclamation-sign" : "glyphicon-info-sign")"></span>
                Estado Académico
            </h4>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4">
                    <h5><strong>Materias en Arrastre</strong></h5>
                    <span class="badge @(totalReprobadas >= 4 ? "badge-danger" : (totalReprobadas == 3 ? "badge-warning" : "badge-success"))" style="font-size: 18px;">
                        @totalReprobadas / 3
                    </span>
                    @if (totalReprobadas >= 4)
                    {
                        <br /><small class="text-danger"><strong><span class="glyphicon glyphicon-ban-circle"></span> LÍMITE EXCEDIDO</strong></small>
                    }
                    else if (totalReprobadas >= 3)
                    {
                        <br /><small class="text-warning"><strong><span class="glyphicon glyphicon-warning-sign"></span> EN EL LÍMITE</strong></small>
                    }
                    else
                    {
                        <br /><small class="text-success"><strong><span class="glyphicon glyphicon-ok-circle"></span> Dentro del límite</strong></small>
                    }
                </div>

                <div class="col-md-4">
                    <h5><strong>Materias en Extraordinario</strong></h5>
                    <span class="badge @(totalExtraordinarios >= 4 ? "badge-danger" : (totalExtraordinarios == 3 ? "badge-warning" : "badge-success"))" style="font-size: 18px;">
                        @totalExtraordinarios / 3
                    </span>
                    @if (totalExtraordinarios >= 4)
                    {
                        <br /><small class="text-danger"><strong><span class="glyphicon glyphicon-ban-circle"></span> LÍMITE EXCEDIDO</strong></small>
                    }
                    else if (totalExtraordinarios == 3)
                    {
                        <br /><small class="text-warning"><strong><span class="glyphicon glyphicon-warning-sign"></span> EN EL LÍMITE</strong></small>
                    }
                    else
                    {
                        <br /><small class="text-success"><strong><span class="glyphicon glyphicon-ok-circle"></span> Dentro del límite</strong></small>
                    }
                </div>

                <div class="col-md-4">
                    <h5><strong>Estado del Sistema</strong></h5>
                    <span class="badge @(alumnoReprobado ? "badge-danger" : "badge-success")" style="font-size: 18px;">
                        @(alumnoReprobado ? "REPROBADO" : "ACTIVO")
                    </span>
                    @if (cercaDelLimite && !alumnoReprobado)
                    {
                        <br /><small class="text-warning"><strong><span class="glyphicon glyphicon-warning-sign"></span> EN RIESGO CRÍTICO</strong></small>
                    }
                    else if (!alumnoReprobado)
                    {
                        <br /><small class="text-success"><strong><span class="glyphicon glyphicon-ok-circle"></span> Permite agregar materias</strong></small>
                    }
                </div>
            </div>

            <div class="alert @(alumnoReprobado ? "alert-danger" : "alert-info")" style="margin-top: 15px; margin-bottom: 0;">
                @if (alumnoReprobado)
                {
                    <strong><span class="glyphicon glyphicon-ban-circle"></span> SISTEMA ACTIVADO:</strong> <text>Se detectó exceso de límites.</text>
                }
                else
                {
                    if (cercaDelLimite)
                    {
                        <br /><strong>ALERTA:</strong> <text>El alumno está cerca del límite.</text>
                    }
                }
            </div>
        </div>
    </div>

    @if (ViewBag.TieneMateriasDesactivadas == true)
    {
        <div class="alert alert-warning alert-dismissible" style="border-left: 5px solid #f0ad4e; margin-top: 15px;">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <h4><span class="glyphicon glyphicon-warning-sign"></span> <strong>Materias Desactivadas Detectadas</strong></h4>
            <p>
                <strong>Este alumno tiene @ViewBag.MateriasDesactivadas materia(s) desactivada(s) en su historial académico.</strong>
            </p>
            <div class="row">
                <div class="col-md-8">
                    <ul style="margin-bottom: 10px;">
                        <li><strong>Las materias desactivadas mantienen su estado académico</strong> (reprobada, extraordinario, etc.)</li>
                        <li><strong>Siguen contando para los límites</strong> de arrastre y extraordinario</li>
                        <li><strong>Su historial se conserva completamente</strong> para efectos de control académico</li>
                        <li><strong>Se muestran con indicador visual</strong>  para fácil identificación</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <div style="background-color: #fcf8e3; padding: 10px; border-radius: 5px; border: 1px solid #f0ad4e;">
                        <strong>Estadísticas:</strong><br>
                        Materias Activas: <strong>@ViewBag.MateriasActivas</strong><br>
                        Materias Desactivadas: <strong>@ViewBag.MateriasDesactivadas</strong><br>
                        Total: <strong>@ViewBag.TotalMaterias</strong>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- CALIFICACION POR UNIDADES -->
    <h4><span class="glyphicon glyphicon-list-alt text-success"></span> Calificación por Unidades</h4>
    <div class="table-responsive">
        <table class="table table-bordered" id="tabla-unidades">
            <thead style="background-color: #5cb85c; color: white;">
                <tr>
                    <th>Materia</th>
                    <th>Plan</th>
                    <th>Unidades</th>
                    <th>Calificación Final</th>
                    <th>Estado Actual</th>
                </tr>
            </thead>
            <tbody>
                @if (!tieneMaterias)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            <span class="glyphicon glyphicon-info-sign"></span>
                            Sin materias para calificar por unidades
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var materia in materiasNoAcreditadas)
                    {
                        var idMateria = materia.IdMateria;
                        var personaId = materia.IdPersona;
                        var numeroUnidades = materia.NumeroUnidades;

                        int unidadesCalificadas = 0;
                        if (materia.CalificacionesUnidades != null)
                        {
                            foreach (var u in materia.CalificacionesUnidades)
                            {
                                if (u.Calificacion.HasValue)
                                {
                                    unidadesCalificadas++;
                                }
                            }
                        }

                        bool todasCalificadas = unidadesCalificadas == numeroUnidades;
                        decimal porcentajeAvance = numeroUnidades > 0 ? Math.Round((decimal)unidadesCalificadas / numeroUnidades * 100, 1) : 0;

                        <tr data-materia="@idMateria" class="fila-materia-unidades">
                            <td>
                                <strong>@materia.NombreMateria</strong>
                                <br><small class="text-muted">@numeroUnidades unidad(es)</small>
                            </td>
                            <td class="text-center">
                                <span class="label @materia.LabelPlan">
                                    @materia.NombrePlan
                                </span>

                            </td>
                            <td>
                                <div class="unidades-container" data-materia-id="@idMateria" data-persona-id="@personaId">
                                    @for (int i = 1; i <= numeroUnidades; i++)
                                    {
                                        CalificacionUnidad unidadEncontrada = null;
                                        if (materia.CalificacionesUnidades != null)
                                        {
                                            foreach (var u in materia.CalificacionesUnidades)
                                            {
                                                if (u.NumeroUnidad == i)
                                                {
                                                    unidadEncontrada = u;
                                                    break;
                                                }
                                            }
                                        }
                                        var calificacion = unidadEncontrada?.Calificacion;

                                        <div class="unidad-item" data-unidad="@i">
                                            <label>U@(i):</label>
                                            <input type="number"
                                                   class="form-control input-sm unidad-input"
                                                   data-materia-id="@idMateria"
                                                   data-persona-id="@personaId"
                                                   data-unidad="@i"
                                                   data-plan-minima="@materia.CalificacionMinimaPlan"
                                                   data-plan-decimales="@materia.PermiteDecimales.ToString().ToLower()"
                                                   min="0" max="10"
                                                   step="@(materia.PermiteDecimales ? "0.01" : "1")"
                                                   value="@(calificacion.HasValue ? calificacion.Value.ToString("0.00") : "")"
                                                   placeholder="0.00"
                                                   onchange="guardarCalificacionUnidadSinRecargar(this)" />
                                        </div>
                                    }
                                </div>
                                <small class="text-muted calificadas-info-@idMateria" style="display: block; margin-top: 5px;">
                                    @unidadesCalificadas de @numeroUnidades calificadas (@porcentajeAvance%)
                                </small>

                                <!-- BOTON PARA CONFIRMAR MATERIA -->
                                @{
                                    bool materiaYaCalificada = materia.Estado == "Acreditada" || materia.Estado == "Extraordinario" || materia.Estado == "Reprobada";
                                    bool botonDesactivado = !todasCalificadas || materiaYaCalificada;
                                }
                                <div style="margin-top: 10px; text-align: center;">
                                    <button type="button"
                                            class="btn btn-success btn-sm btn-confirmar-materia"
                                            data-materia-id="@idMateria"
                                            data-persona-id="@personaId"
                                            onclick="confirmarCalificacionesMateria(@idMateria, @personaId)"
                                            @(botonDesactivado ? "disabled" : "")
                                            style="@(botonDesactivado ? "opacity: 0.5;" : "")">
                                        <span class="glyphicon glyphicon-ok-sign"></span>
                                        @(materiaYaCalificada ? "YA CALIFICADA" : "CONFIRMAR MATERIA")
                                    </button>
                                    <br>
                                    <small class="text-muted mensaje-confirmar-@idMateria">
                                        @if (materiaYaCalificada)
                                        {
                                            <span class="text-info">✓ Calificada</span>
                                        }
                                        else if (!todasCalificadas)
                                        {
                                            <span class="text-warning">Faltan unidades</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">✓ Listo</span>
                                        }
                                    </small>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-info calificacion-final-preview-@idMateria" style="font-size: 16px;">
                                    @(materia.Calificacion?.ToString("0.00") ?? "---")
                                </span>

                            </td>
                            <td class="text-center">
                                @if (materia.Estado == "Acreditada")
                                {
                                    <span class="label label-success">
                                        <span class="glyphicon glyphicon-ok-circle"></span> Acreditada
                                    </span>
                                }
                                else if (materia.Estado == "Extraordinario")
                                {
                                    <span class="label label-warning">
                                        <span class="glyphicon glyphicon-time"></span> Extraordinario
                                    </span>
                                }
                                else if (materia.Estado == "Reprobada")
                                {
                                    <span class="label label-danger">
                                        <span class="glyphicon glyphicon-remove-circle"></span> Reprobada
                                    </span>
                                }
                                else
                                {
                                    <span class="label label-default estado-preview-@idMateria">
                                        @(todasCalificadas ? "Listo para confirmar" : "Pendiente")
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="panel panel-info">
        <div class="panel-heading">
            <h4>
                <span class="glyphicon glyphicon-list-alt"></span>
                Estado de Materias
            </h4>
        </div>
        <div class="panel-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-condensed" id="tablaEstadoMaterias">
                        <thead>
                            <tr style="background-color: #337ab7; color: white;">
                                <th style="text-align: center; width: 5%;">#</th>
                                <th style="text-align: center; width: 25%;">Materia</th>
                                <th style="text-align: center; width: 10%;">Plan</th>
                                <th style="text-align: center; width: 15%;">Estado Final</th>
                                <th style="text-align: center; width: 20%;">Forma de Aprobación</th>
                                <th style="text-align: center; width: 25%;">Historial</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int numeroFila = 1;
                            }
                            @foreach (var materia in Model)
                            {
                                string claseFilaEstado = "";
                                if (materia.Estado == "Acreditada")
                                {
                                    claseFilaEstado = "success";
                                }
                                else if (materia.Estado == "Extraordinario")
                                {
                                    claseFilaEstado = "warning";
                                }
                                else if (materia.Estado == "Reprobada")
                                {
                                    claseFilaEstado = "danger";
                                }

                                <tr class="@claseFilaEstado fila-materia"
                                    data-id-materia="@materia.IdMateria"
                                    data-id-persona="@idPersona">
                                    <td style="text-align: center; vertical-align: middle;">
                                        <strong>@numeroFila</strong>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <strong>@materia.NombreMateria</strong>
                                        @if (!materia.MateriaActiva)
                                        {
                                            <br />
                                            <small>
                                                <span class="label label-warning">
                                                    <span class="glyphicon glyphicon-ban-circle"></span> DESACTIVADA
                                                </span>
                                            </small>
                                        }
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span class="label @materia.LabelPlan" title="@materia.InfoCompletaPlan">
                                            @materia.NombrePlan
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span class="label @materia.EstadoLabel" style="font-size: 13px; padding: 6px 10px;">
                                            @materia.EstadoTexto
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <div class="forma-aprobacion-@materia.IdMateria">
                                            @if (materia.Estado == "Pendiente")
                                            {
                                                <span class="text-muted">
                                                    <em>Sin intentos aún</em>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span>
                                                <em>Cargando...</em>
                                            }
                                        </div>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <div class="historial-intentos-@materia.IdMateria">
                                            @if (materia.Estado == "Pendiente")
                                            {
                                                <span class="text-muted">
                                                    <em>Sin intentos registrados</em>
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-info btn-sm btn-ver-historial"
                                                        data-id-materia="@materia.IdMateria"
                                                        data-id-persona="@idPersona"
                                                        data-nombre-materia="@materia.NombreMateria"
                                                        style="min-width: 140px;">
                                                    <span class="glyphicon glyphicon-list-alt"></span>
                                                    VER HISTORIAL
                                                </button>
                                                <div class="historial-detalle-@materia.IdMateria" style="margin-top: 10px; display: none;">

                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                numeroFila++;
                            }
                        </tbody>
                        @if (contador > 0)
                        {
                            <tfoot>
                                <tr style="background-color: #f8f9fa; border-top: 3px solid #337ab7; font-weight: bold;">
                                    <td colspan="2" style="text-align: right; vertical-align: middle; padding: 15px;">
                                        <span class="glyphicon glyphicon-stats"></span>
                                        <strong style="font-size: 15px;">PROMEDIO GENERAL:</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span class="label @(materiasPlan2020 > materiasPlan2024 ? "label-warning" : "label-success")" title="Plan predominante: @(materiasPlan2020 > materiasPlan2024 ? "2020" : "2024")">
                                            @(materiasPlan2020 > materiasPlan2024 ? "Plan 2020" : "Plan 2024")
                                        </span>
                                        <br />
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span class="label @(promedioFinal >= calificacionMinimaDelPlan ? "label-success" : "label-danger")"
                                              style="font-size: 16px; padding: 10px 15px;">
                                            @(promedioFinal >= calificacionMinimaDelPlan ? "APROBADO" : "REPROBADO")
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <div style="background-color: @(promedioFinal >= calificacionMinimaDelPlan ? "#d4edda" : "#f8d7da");
                                                padding: 10px;
                                                border-radius: 6px;
                                                border: 2px solid @(promedioFinal >= calificacionMinimaDelPlan ? "#28a745" : "#dc3545");">
                                            <strong style="font-size: 24px; color: @(promedioFinal >= calificacionMinimaDelPlan ? "#155724" : "#721c24");">
                                                @(materiasPlan2020 > materiasPlan2024 ? promedioFinal.ToString("0") : promedioFinal.ToString("0.00"))
                                            </strong>
                                            <br />
                                            <small class="text-muted">
                                                (@contador materias)
                                            </small>
                                        </div>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <em class="text-muted">Promedio calculado</em>
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <span class="glyphicon glyphicon-info-sign"></span>
                    No hay materias registradas para este alumno.
                </div>
            }
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- MODAL PARA MOSTRAR HISTORIAL DETALLADO -->
    <!-- ============================================================ -->
    <div class="modal fade" id="modalHistorialMateria" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #337ab7; color: white;">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" style="color: white;">&times;</span>
                    </button>
                    <h4 class="modal-title">
                        <span class="glyphicon glyphicon-list-alt"></span>
                        Historial Completo de Intentos
                    </h4>
                </div>
                <div class="modal-body">
                    <h5 id="nombreMateriaHistorial" style="margin-top: 0;"></h5>
                    <div id="contenidoHistorial">
                        <!-- Se llenará dinámicamente con JavaScript -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>





    <!-- MATERIAS EN EXTRAORDINARIO -->
    <h4>
        <span class="glyphicon glyphicon-time text-warning"></span> Materias en Extraordinario
    </h4>
    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="materias-extraordinario">
            <thead style="background-color: #f0ad4e; color: white;">
                <tr>
                    <th>Materia</th>
                    <th>Cuatrimestre</th>
                    <th>Plan de Estudio</th>
                    <th>Intento Actual</th>
                    <th>Calificación</th>
                    <th>Estado</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @if (materiasExtraordinario.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            <span class="glyphicon glyphicon-ok-circle text-success"></span>
                            Sin materias en extraordinario.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in materiasExtraordinario)
                    {
                        <tr data-materia="@item.IdMateria" data-persona="@item.IdPersona"
                            data-plan-id="@item.IdPlanEstudio"
                            data-plan-minima="@item.CalificacionMinimaPlan"
                            data-plan-decimales="@item.PermiteDecimales.ToString().ToLower()"
                            data-plan-nombre="@item.NombrePlan"
                            data-calificacion-guardada="@(item.Calificacion.HasValue ? item.Calificacion.Value.ToString("0.00") : "")"
                            class="materia-extraordinario @(totalExtraordinarios >= 4 ? "danger" : (totalExtraordinarios == 3 ? "warning" : ""))">

                            <td>
                                <strong>@item.NombreMateria</strong>
                                @if (!item.MateriaActiva)
                                {
                                    <br><small class="text-warning">Materia desactivada</small>
                                }
                            </td>

                            <td class="text-center">
                                @{
                                    var esActualExtra = item.IdGrado == gradoActualAlumno;
                                    var labelExtra = esActualExtra ? "label-primary" : "label-danger";
                                }
                                <span class="label @labelExtra" style="font-size: 11px;">
                                    @item.IdGrado Cuatri
                                </span>
                                @if (!esActualExtra)
                                {
                                    <br><small class="text-danger" style="font-size: 9px;"><strong>Arrastrada</strong></small>
                                }
                            </td>

                            <!-- INFORMACIÓN DEL PLAN -->
                            <td class="text-center">
                                <span class="label @item.LabelPlan plan-info-badge"
                                      title="@item.InfoCompletaPlan">
                                    @item.NombrePlan
                                </span>
                            </td>

                            <td class="text-center">
                                <span class="badge badge-warning" style="font-size: 12px;">
                                    1º intento (ÚNICO)
                                </span>
                                <input type="hidden" class="intentos-value" value="1" />
                            </td>

                            <!-- INPUT DE CALIFICACIÓN -->
                            <td>
                                <input type="number"
                                       class="form-control input-sm calificacion-extra"
                                       data-materia-id="@item.IdMateria"
                                       data-persona-id="@item.IdPersona"
                                       data-plan-minima="@item.CalificacionMinimaPlan"
                                       data-plan-decimales="@item.PermiteDecimales.ToString().ToLower()"
                                       data-plan-nombre="@item.NombrePlan"
                                       min="0" max="10"
                                       step="@(item.PermiteDecimales ? "0.01" : "1")"
                                       placeholder="0.00"
                                       value=""
                                       onchange="actualizarEstadoExtraordinarioConPlan(this)" />

                                <div style="margin-top: 10px; text-align: center; white-space: nowrap;">
                                    <button type="button" class="btn btn-sm btn-success" onclick="guardarExtraordinarioConPlan(@item.IdMateria, @item.IdPersona)">
                                        <span class="glyphicon glyphicon-floppy-disk"></span> GUARDAR
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            style="margin-left: 6px;"
                                            title="Eliminar este registro"
                                            onclick="confirmarEliminarMateriaIndex(
                                                @item.IdMateria, @item.IdPersona,
                                                '@Html.Raw((item.NombreMateria ?? "").Replace("'", "\\'"))',
                                                '@(item.IdGrado)°', '@(item.Estado ?? "")')">
                                        <span class="glyphicon glyphicon-trash"></span>
                                    </button>
                                    @if (item.IntentosExtraordinarios >= 4)
                                    {
                                        <br /><small class="text-warning"><strong>ULTIMO INTENTO</strong></small>
                                    }
                                </div>
                            </td>

                            <td style="text-align: center;">
                                <span class="estado-extraordinario label label-warning">No acreditado</span>
                            </td>

                            <td>
                                <textarea class="form-control input-sm observaciones-extra"
                                          rows="2" placeholder="OBSERVACIONES"
                                          style="resize: vertical;">@item.Observaciones</textarea>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- MATERIAS EN ARRASTRE -->
    <h4>
        <span class="glyphicon glyphicon-exclamation-sign text-danger"></span> Materias en Arrastre
    </h4>
    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="materias-arrastradas">
            <thead style="background-color: #d9534f; color: white;">
                <tr>
                    <th>Materia</th>
                    <th>Cuatrimestre</th>
                    <th>Plan de Estudio</th>
                    <th>Intento</th>
                    <th>Fecha Inicio Arrastre</th>
                    <th>Período Límite</th>
                    <th>Estado Materia</th>
                    <th>Calificación</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @if (materiasReprobadas.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            <span class="glyphicon glyphicon-ok-circle text-success"></span>
                            Sin materias reprobadas asignadas.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in materiasReprobadas)
                    {
                        var fechaInicio = item.FechaInicioArrastre ??
DateTime.Now;
                        var fechaLimiteItem = fechaInicio.AddMonths(8);

                        var diasRestantes = (fechaLimiteItem.Date - DateTime.Today).Days;

                        var esReprobadaDefinitiva = item.IntentosExtraordinarios >= 3;

                        var estadoMateriaTexto = esReprobadaDefinitiva ? "REPROBADA DEFINITIVA" : "EN ARRASTRE";
                        var estadoMateriaLabel = esReprobadaDefinitiva ? "label-danger" : "label-warning";
                        var estadoMateriaIcon = esReprobadaDefinitiva ? "glyphicon-ban-circle" : "glyphicon-time";

                        <tr data-materia="@item.IdMateria" data-persona="@item.IdPersona"
                            data-plan-id="@item.IdPlanEstudio"
                            data-plan-minima="@item.CalificacionMinimaPlan"
                            data-plan-decimales="@item.PermiteDecimales.ToString().ToLower()"
                            data-plan-nombre="@item.NombrePlan"
                            data-intentos-originales="@item.IntentosExtraordinarios"
                            class="materia-reprobada @(totalReprobadas >= 4 ? "danger" : (totalReprobadas == 3 ? "warning" : "")) @(esReprobadaDefinitiva ? "reprobada-definitiva" : "")">
                            <td>
                                <strong>@item.NombreMateria</strong>
                                @if (!item.MateriaActiva)
                                {
                                    <br><small class="text-warning">Materia desactivada</small>
                                }
                            </td>

                            <!-- CUATRIMESTRE -->
                            <td class="text-center">
                                @{
                                    var esActualArr = item.IdGrado == gradoActualAlumno;
                                    var labelArr = esActualArr ? "label-primary" : "label-danger";
                                    var iconoArr = esActualArr ? "glyphicon-ok-circle" : "glyphicon-arrow-up";
                                }
                                <span class="label @labelArr" style="font-size: 11px;">
                                    <span class="glyphicon @iconoArr" style="font-size: 10px;"></span>
                                    @item.IdGrado Cuatri
                                </span>
                                @if (!esActualArr)
                                {
                                    <br><small class="text-danger" style="font-size: 9px;">
                                        <strong>De cuatrimestre anterior</strong>
                                    </small>
                                }
                            </td>

                            <!-- INFORMACIÓN DEL PLAN -->
                            <td class="text-center">
                                <span class="label @item.LabelPlan plan-info-badge"
                                      title="@item.InfoCompletaPlan">
                                    @item.NombrePlan
                                </span>
                            </td>

                            <td class="text-center">
                                @{
                                    // Logica de intentos en arrastre
                                    // IntentosExtraordinarios cuenta el numero de intento DENTRO de arrastre:
                                    // = 1 → Primer intento de arrastre (tiene 1 mas disponible)
                                    // = 2 → Segundo y ultimo intento de arrastre
                                    // >= 3 → Agoto ambos intentos de arrastre (bloqueado)

                                    string intentoTexto = "";
                                    string mensajeAdicional = "";
                                    string badgeClass = "badge-warning";

                                    if (item.IntentosExtraordinarios == 1)
                                    {
                                        // Recien entro a arrastre desde extraordinario, primer intento disponible
                                        intentoTexto = "Intento 1";
                                        mensajeAdicional = "1 intento restante";
                                        badgeClass = "badge-warning";
                                    }
                                    else if (item.IntentosExtraordinarios == 2)
                                    {
                                        // Ya fue calificada en arrastre al menos una vez, ultimo intento
                                        intentoTexto = "Intento 2";
                                        mensajeAdicional = "ULTIMO INTENTO";
                                        badgeClass = "badge-danger";
                                    }
                                    else if (item.IntentosExtraordinarios >= 3)
                                    {
                                        // Intentos agotados
                                        intentoTexto = "Se agotaron los intentos";
                                        mensajeAdicional = "INTENTOS AGOTADOS";
                                        badgeClass = "badge-danger";
                                    }
                                    else
                                    {
                                        // IntentosExtraordinarios = 0 en arrastre, dato inconsistente
                                        intentoTexto = "Intento 1";
                                        mensajeAdicional = "1 intento restante";
                                        badgeClass = "badge-warning";
                                    }
                                }

                                <span class="badge @badgeClass" style="font-size: 12px;">
                                    @intentoTexto
                                </span>

                                @if (!string.IsNullOrEmpty(mensajeAdicional))
                                {
                                    <br /><small class="@(item.IntentosExtraordinarios >= 3 ? "text-danger" : "text-warning")" style="font-weight: bold;">
                                        @mensajeAdicional
                                    </small>
                                }
                            </td>

                            <td>
                                <input type="date"
                                       class="form-control input-sm fecha-inicio-arrastre"
                                       value="@(item.FechaInicioArrastre?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                                       data-materia-id="@item.IdMateria"
                                       data-persona-id="@item.IdPersona"
                                       @(esMaster ? "" : "readonly")
                                       @(esMaster ? "" : "style=background-color:#f9f9f9;")
                                       @(esMaster ? $"onchange=guardarFechaArrastre(this,{item.IdMateria},{item.IdPersona})" : "") />
                            </td>

                            <!-- PERÍODO LÍMITE CON DÍAS RESTANTES -->
                            <td class="text-center">
                                <strong class="fecha-limite-display" id="limite-display-@item.IdMateria">@fechaLimiteItem.ToString("dd/MM/yyyy")</strong>
                                <br>
                                <div id="dias-restantes-@item.IdMateria">
                                    @if (esReprobadaDefinitiva)
                                    {
                                        <span class="label label-danger" style="font-size: 10px;">
                                            <span class="glyphicon glyphicon-ban-circle"></span> SIN TIEMPO
                                        </span>
                                    }
                                    else if (diasRestantes <= 0)
                                    {
                                        <span class="label label-danger" style="font-size: 10px;">
                                            <span class="glyphicon glyphicon-remove"></span> VENCIDO (@Math.Abs(diasRestantes) días)
                                        </span>
                                    }
                                    else if (diasRestantes <= 30)
                                    {
                                        <span class="label label-danger" style="font-size: 10px;">
                                            <span class="glyphicon glyphicon-fire"></span> CRÍTICO: @diasRestantes días
                                        </span>
                                    }
                                    else if (diasRestantes <= 60)
                                    {
                                        <span class="label label-warning" style="font-size: 10px;">
                                            <span class="glyphicon glyphicon-warning-sign"></span> ALERTA: @diasRestantes días
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="label label-info" style="font-size: 10px;">
                                            <span class="glyphicon glyphicon-time"></span> @diasRestantes días restantes
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- ESTADO DE LA MATERIA -->
                            <td class="text-center">
                                <span class="label @estadoMateriaLabel" style="font-size: 11px;">
                                    <span class="glyphicon @estadoMateriaIcon"></span>
                                    @estadoMateriaTexto
                                </span>

                                @if (esReprobadaDefinitiva)
                                {
                                    <br><small class="text-danger" style="font-size: 9px;">
                                        <strong>Ya no puede acreditar</strong>
                                    </small>
                                }
                                else if (diasRestantes <= 0)
                                {
                                    <br><small class="text-danger" style="font-size: 9px;">
                                        <strong>Fuera de tiempo límite</strong>
                                    </small>
                                }
                                else
                                {
                                    <br><small class="text-info" style="font-size: 9px;">
                                        <strong>Puede acreditar</strong>
                                    </small>
                                }
                            </td>

                            <!-- CALIFICACIÓN -->
                            <td>
                                <input type="number"
                                       class="form-control input-sm calificacion-arrastre"
                                       data-materia-id="@item.IdMateria"
                                       data-persona-id="@item.IdPersona"
                                       data-plan-minima="@item.CalificacionMinimaPlan"
                                       data-plan-decimales="@item.PermiteDecimales.ToString().ToLower()"
                                       data-plan-nombre="@item.NombrePlan"
                                       min="0" max="10"
                                       step="@(item.PermiteDecimales ? "0.01" : "1")"
                                       placeholder="0.00"
                                       value="@(item.Calificacion.HasValue ? item.Calificacion.Value.ToString("0.00") : "")"
                                       onchange="actualizarEstadoArrastreConPlan(this)"
                                       @(item.IntentosExtraordinarios >= 3 ? "disabled" : "")>

                                <div style="text-align: center; margin-top: 5px;">
                                    <span class="estado-arrastre label @(esReprobadaDefinitiva ? "label-danger" : "label-danger")" style="font-size: 10px;">
                                        @(esReprobadaDefinitiva ? "Reprobada Definitiva" : "Reprobada")
                                    </span>
                                </div>

                                @if (esReprobadaDefinitiva)
                                {
                                    <br /><small class="text-danger"><strong>NO SE PUEDE CALIFICAR</strong></small>
                                }

                                <div style="margin-top: 10px; text-align: center; white-space: nowrap;">
                                    <button type="button"
                                            class="btn btn-sm @(esReprobadaDefinitiva ? "btn-default" : "btn-success")"
                                            onclick="guardarArrastreConPlan(@item.IdMateria, @item.IdPersona)"
                                            @(esReprobadaDefinitiva ? "disabled" : "")>
                                        <span class="glyphicon glyphicon-floppy-disk"></span> GUARDAR
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            style="margin-left: 6px;"
                                            title="Eliminar este registro"
                                            onclick="confirmarEliminarMateriaIndex(
                                                @item.IdMateria, @item.IdPersona,
                                                '@Html.Raw((item.NombreMateria ?? "").Replace("'", "\\'"))',
                                                '@(item.IdGrado)°', '@(item.Estado ?? "")')">
                                        <span class="glyphicon glyphicon-trash"></span>
                                    </button>

                                    @if (esReprobadaDefinitiva)
                                    {
                                        <br /><small class="text-muted" style="font-size: 9px;"><em>Sin acciones</em></small>
                                    }
                                </div>
                            </td>

                            <td>
                                <textarea class="form-control input-sm observaciones-arrastre"
                                          rows="2" placeholder="OBSERVACIONES..."
                                          style="resize: vertical;"
                                          @(esReprobadaDefinitiva ? "disabled" : "")>@item.Observaciones</textarea>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Panel de Reportes -->
    <div class="panel panel-default">
        <div class="panel-body">
            <h4>
                <span class="glyphicon glyphicon-filter"></span> Reporte del Alumno
            </h4>
            <div class="btn-group" role="group">
                <a class="btn btn-success" href="@Url.Action("DescargarPDF", new { id = idPersona })">
                    <span class="glyphicon glyphicon-file"></span> Descargar PDF
                </a>
                <a class="btn btn-success" href="@Url.Action("DescargarExcel", new { id = idPersona })">
                    <span class="glyphicon glyphicon-list-alt"></span> Descargar Excel
                </a>
                <button type="button" class="btn btn-info" onclick="imprimirReporte()">
                    <span class="glyphicon glyphicon-print"></span> IMPRIMIR
                </button>
                <button type="button" class="btn btn-warning" onclick="history.back()">
                    <span class="glyphicon glyphicon-arrow-left"></span> VOLVER
                </button>
            </div>
        </div>
    </div>

    <!-- Alertas de Materias Reprobadas -->
    @if (tieneReprobadas)
    {
        <div class="alert @(totalReprobadas >= 4 ? "alert-danger" : "alert-warning")">
            <h4>
                <span class="glyphicon @(totalReprobadas >= 4 ? "glyphicon-ban-circle" : "glyphicon-warning-sign")"></span>
                @(totalReprobadas >= 4 ? "CRÍTICO: Límite de Arrastre Excedido" : "Atención: Materias Reprobadas Detectadas")
            </h4>
            <ul>
                @foreach (var item in materiasReprobadas)
                {
                    <li>
                        <strong>@item.NombreMateria</strong> - Estado: Reprobada
                        @{
                            var fechaInicio = item.FechaInicioArrastre ?? DateTime.Now;
                            var fechaLimiteItem = fechaInicio.AddMonths(8);
                            var diasRestantes = Math.Max(0, (fechaLimiteItem - DateTime.Now).Days);
                        }
                        @if (diasRestantes <= 0)
                        {
                            <span class="text-danger">(FUERA DE TIEMPO)</span>
                        }
                        else if (diasRestantes <= 30)
                        {
                            <span class="text-warning">(EN RIESGO - @diasRestantes días)</span>
                        }
                        else
                        {
                            <span class="text-info">(@diasRestantes días restantes)</span>
                        }
                    </li>
                }
            </ul>
            @if (totalReprobadas >= 4)
            {
                <p><small><em><strong>El alumno excedio el limite de 3 materias en arrastre. Restricciones academicas aplicadas.</strong></em></small></p>
            }
            else
            {
