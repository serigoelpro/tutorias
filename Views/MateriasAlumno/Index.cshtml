            idMateria: idMateria,
            idPersona: idPersona,
            numeroUnidad: numeroUnidad,
            calificacion: calif
        },
        success: function(result) {
            if (result.success) {
                // Actualizar contador
                $(`.calificadas-info-${idMateria}`).text(
                    `${result.unidadesCalificadas} de ${result.totalUnidades} calificadas (${result.porcentajeAvance}%)`
                );

                // Actualizar preview de calificacion final
                if (result.calificacionFinalPreview) {
                    $(`.calificacion-final-preview-${idMateria}`).text(result.calificacionFinalPreview.toFixed(2));

                    var planMinima = parseFloat($input.data('plan-minima')) || 7.0;
                    var esAprobatoria = result.calificacionFinalPreview >= planMinima;

                    $(`.estado-preview-${idMateria}`)
                        .removeClass('label-default label-success label-danger label-warning')
                        .addClass(esAprobatoria ? 'label-success' : 'label-warning')
                        .text(esAprobatoria ? 'Aprobatoria' : 'No Aprobatoria');
                }

                // Habilitar/deshabilitar boton de confirmar
                var $botonConfirmar = $(`.btn-confirmar-materia[data-materia-id="${idMateria}"]`);
                if (result.puedeConfirmar) {
                    $botonConfirmar.prop('disabled', false).css('opacity', '1');
                    $(`.mensaje-confirmar-${idMateria}`).html('<span class="text-success">✓ Listo para confirmar</span>');
                } else {
                    $botonConfirmar.prop('disabled', true).css('opacity', '0.5');
                    $(`.mensaje-confirmar-${idMateria}`).html('<span class="text-warning">Faltan unidades</span>');
                }

                // ACTUALIZAR CONTADOR DE MATERIAS LISTAS
                if (typeof actualizarContadorMateriasListas === 'function') {
                    actualizarContadorMateriasListas();
                }

                // Mostrar notificacion sin recargar
                mostrarNotificacion(result.message, 'success', 2000);

            } else {
                mostrarNotificacion(result.message, 'error', 4000);
            }
        },
        error: function() {
            mostrarNotificacion('Error de conexion', 'error', 3000);
        }
    });
}

// FUNCION: Confirmar calificaciones y pasar a otras tablas
function confirmarCalificacionesMateria(idMateria, idPersona) {
