                            <script>
                                // ===== Modo Tablas / Graficas =====
                                // Framework: cada seccion convertible se registra con su contenedor original,
                                // su contenedor de canvas y una funcion que dibuja el chart desde el ultimo JSON.
                                // Los loaders AJAX llaman ModoEstadisticas.datos(key, json) al recibir datos.
                                (function () {
                                    var LS_GLOBAL = 'estadisticasModo', LS_OVR = 'estadisticasModoOverrides';
                                    var secciones = {};
                                    var overrides = {};
                                    try { overrides = JSON.parse(localStorage.getItem(LS_OVR) || '{}'); } catch (e) { overrides = {}; }
                                    var global = localStorage.getItem(LS_GLOBAL) || 'tabla';

                                    function modoDe(key) { return overrides[key] || global; }
                                    function aplicar(key) {
                                        var s = secciones[key]; if (!s) return;
                                        var g = modoDe(key) === 'grafica';
                                        document.querySelectorAll(s.original).forEach(function (e) { e.style.display = g ? 'none' : ''; });
                                        document.querySelectorAll(s.charts).forEach(function (e) { e.style.display = g ? 'block' : 'none'; });
                                        var btn = document.getElementById('modoBtn_' + key);
                                        if (btn) btn.innerHTML = g ? '<i class="fas fa-table"></i> Ver tabla' : '<i class="fas fa-chart-pie"></i> Ver gráfica';
                                        if (g && s.ultimo) s.render(s.ultimo);
                                        else if (g && !s.ultimo && s.cargar && !s.cargando) {
                                            // Carga perezosa DIFERIDA: esperar a que los loaders propios de la pagina
                                            // terminen su init (evita doble-init de DataTables); solo si sigue sin datos.
                                            s.cargando = true;
                                            setTimeout(function () { if (!s.ultimo && modoDe(key) === 'grafica') { try { s.cargar(); } catch (e) { } } }, 3000);
                                        }
                                    }
                                    function aplicarTodo() { Object.keys(secciones).forEach(aplicar); pintarSwitch(); }
                                    function pintarSwitch() {
                                        var el = document.getElementById('modoSwitchGlobal'); if (!el) return;
                                        el.querySelector('[data-modo="tabla"]').classList.toggle('activo', global === 'tabla');
                                        el.querySelector('[data-modo="grafica"]').classList.toggle('activo', global === 'grafica');
                                    }
                                    window.ModoEstadisticas = {
                                        registrar: function (key, o) {
                                            secciones[key] = { original: o.original, charts: o.charts, render: o.render, cargar: o.cargar || null, ultimo: null, cargando: false };
                                            var host = o.botonHost ? document.querySelector(o.botonHost) : null;
                                            if (host) {
                                                var b = document.createElement('button');
                                                b.type = 'button'; b.className = 'modo-toggle-seccion'; b.id = 'modoBtn_' + key;
                                                b.addEventListener('click', function (ev) {
                                                    ev.stopPropagation(); // los headers de panel colapsan al clic; el toggle no debe colapsar
                                                    overrides[key] = (modoDe(key) === 'grafica') ? 'tabla' : 'grafica';
                                                    localStorage.setItem(LS_OVR, JSON.stringify(overrides));
                                                    aplicar(key);
                                                });
                                                host.appendChild(b);
                                            }
                                            aplicar(key);
                                        },
                                        datos: function (key, json) {
                                            var s = secciones[key]; if (!s || !json) return;
                                            s.ultimo = json;
                                            if (modoDe(key) === 'grafica') s.render(json);
                                        },
                                        modoDe: modoDe
                                    };
                                    document.addEventListener('DOMContentLoaded', function () {
                                        var nav = document.getElementById('menuRapidoEstadisticas'); if (!nav) return;
                                        var sw = document.createElement('div');
                                        sw.className = 'modo-switch'; sw.id = 'modoSwitchGlobal';
                                        sw.innerHTML = '<button type="button" data-modo="tabla"><i class="fas fa-table"></i> Tablas</button>' +
                                            '<button type="button" data-modo="grafica"><i class="fas fa-chart-pie"></i> Gráficas</button>';
                                        sw.addEventListener('click', function (e) {
                                            var b = e.target.closest('button'); if (!b) return;
                                            global = b.getAttribute('data-modo');
                                            overrides = {}; localStorage.setItem(LS_OVR, '{}');
                                            localStorage.setItem(LS_GLOBAL, global);
                                            aplicarTodo();
                                        });
                                        document.body.appendChild(sw); // flotante abajo-izquierda; ya no vive en la barra sticky
                                        pintarSwitch();
                                    });
                                })();
                            </script>
