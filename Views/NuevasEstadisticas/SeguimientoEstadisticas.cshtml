                                                            @if (ViewBag.NombresMeses != null)
                                                            {
                                                                var nombresMeses = ViewBag.NombresMeses as Dictionary<int, string>;
                                                                var mesActual = ViewBag.MesFiltro ?? DateTime.Now.Month; // Usar mes del filtro o mes actual
                                                                foreach (var mes in nombresMeses)
                                                                {
                                                                    <option value="@mes.Key" @(mesActual == mes.Key ? "selected" : "")>@mes.Value</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4" style="margin-bottom: 10px;">
                                                        <label class="form-label" style="font-weight: 600; margin-bottom: 5px;">Año:</label>
