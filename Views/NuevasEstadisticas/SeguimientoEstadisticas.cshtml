            var top10 = arr.slice(0, 10);
            barChart('chartDemoSexoCarrera', top10.map(function (c) { return c.nombre; }), [
                { label: 'Hombres', data: top10.map(function (c) { return c.hombres || 0; }), backgroundColor: '#1f4e5f' },
                { label: 'Mujeres', data: top10.map(function (c) { return c.mujeres || 0; }), backgroundColor: '#b56d8e' }
            ], { indexAxis: 'y', scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true, ticks: { font: { size: 9 } } } } });
        }
        // Vulnerabilidad por carrera top-10 (apiladas econ/acad/pers) — mockup, seccion Vulnerabilidad.
        function renderVulnCarrera(arr) {
            if (!document.getElementById('chartVulnCarrera') || !arr || !arr.length) return;
            var top10 = arr.slice().sort(function (a, b) {
                return ((b.econ || 0) + (b.acad || 0) + (b.pers || 0)) - ((a.econ || 0) + (a.acad || 0) + (a.pers || 0));
            }).slice(0, 10);
            barChart('chartVulnCarrera', top10.map(function (c) { return c.nombre; }), [
