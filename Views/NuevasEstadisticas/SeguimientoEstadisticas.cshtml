                                            _chMatRepExt = new Chart(ctxR, {
                                                type: 'bar',
                                                data: { labels: ['Arrastre (reprobadas)', 'Extraordinario'], datasets: [{ label: 'Registros', data: [totRep, totExt], backgroundColor: ['#b3402e', '#dba13a'] }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { precision: 0 } } } }
                                            });
                                        }
                                    }
                                    var _chMatTasa = null, _chMatIntentos = null, _chMatRepExt = null;
                                    var _chComparativo = null;
                                    function renderChartComparativo(d) {
                                        var ctx = document.getElementById('chartModoComparativo'); if (!ctx || typeof Chart === 'undefined' || !d || !d.filas || !d.filas.length) return;
                                        if (_chComparativo) _chComparativo.destroy();
                                        _chComparativo = new Chart(ctx, {
                                            type: 'bar',
                                            data: {
                                                labels: d.filas.map(function (f) { return f.indicador; }),
                                                datasets: [
                                                    { label: d.n1 || 'Período 1', data: d.filas.map(function (f) { return f.c1 || 0; }), backgroundColor: '#1f4e5f' },
                                                    { label: d.n2 || 'Período 2', data: d.filas.map(function (f) { return f.c2 || 0; }), backgroundColor: '#00897B' }
                                                ]
                                            },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { ticks: { precision: 0 } } } }
                                        });
                                    }
                                    function renderChartGrupo(arr) {
                                        var ctx = document.getElementById('chartModoGrupo'); if (!ctx || typeof Chart === 'undefined') return;
                                        if (_chGrupo) _chGrupo.destroy();
                                        var nota = document.getElementById('chartNotaGrupo');
                                        // Nivel 3: la tabla filtra su carrera client-side (DataTables search); la grafica
                                        // debe respetar el mismo filtro para no mostrar grupos de otras carreras.
                                        var carreraCoord = (document.getElementById('buscarCarreraGrupos') || {}).value;
                                        if (arr && arr.length && carreraCoord) {
                                            var cc = carreraCoord.toUpperCase();
                                            arr = arr.filter(function (g) { return ((g.carreraNombre || '').toUpperCase().indexOf(cc) >= 0); });
                                        }
                                        if (!arr || !arr.length) { if (nota) nota.textContent = 'Sin datos de grupos para graficar.'; return; }
                                        var orden = arr.slice().sort(function (a, b) { return (b.totalEstudiantes || 0) - (a.totalEstudiantes || 0); });
                                        var top = orden.slice(0, 15);
                                        if (nota) nota.textContent = orden.length > 15 ? ('Mostrando los 15 grupos con más alumnos de ' + orden.length + ' — cambia a modo tabla para ver todos.') : '';
                                        _chGrupo = new Chart(ctx, {
                                            type: 'bar',
                                            data: { labels: top.map(function (g) { return g.grupoId || ''; }), datasets: SERIES.map(function (s) { return { label: s.label, data: top.map(function (g) { return v(g, s); }), backgroundColor: s.color }; }) },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } }, plugins: { legend: { labels: { font: { size: 10 } } } } }
                                        });
                                        // Dona: agregado de los grupos mostrados (respeta el filtro de carrera de arriba).
                                        var ctxD = document.getElementById('chartGrupoDona');
                                        if (ctxD) {
                                            if (_chGrupoDona) _chGrupoDona.destroy();
                                            var sumas = SERIES.map(function (s) { return arr.reduce(function (acc, g) { return acc + v(g, s); }, 0); });
                                            _chGrupoDona = new Chart(ctxD, {
                                                type: 'doughnut',
                                                data: { labels: SERIES.map(function (s) { return s.label; }), datasets: [{ data: sumas, backgroundColor: SERIES.map(function (s) { return s.color; }) }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } } }
                                            });
                                        }
                                        // Top-10 por % de vulnerabilidad (min 10 alumnos para no premiar grupos chiquitos).
                                        var ctxP = document.getElementById('chartGrupoPctVuln');
                                        if (ctxP) {
                                            if (_chGrupoPct) _chGrupoPct.destroy();
                                            var conPct = arr.filter(function (g) { return (g.totalEstudiantes || 0) >= 10; }).map(function (g) {
                                                var vuln = (g.econ || g.vulnerablesEconomicos || 0) + (g.acad || g.vulnerablesAcademicos || 0) + (g.pers || g.vulnerablesPersonales || 0);
                                                return { id: g.grupoId || '', pct: Math.round(vuln / g.totalEstudiantes * 1000) / 10 };
                                            }).sort(function (a, b) { return b.pct - a.pct; }).slice(0, 10);
                                            _chGrupoPct = new Chart(ctxP, {
                                                type: 'bar',
                                                data: { labels: conPct.map(function (x) { return x.id; }), datasets: [{ label: '% vulnerables', data: conPct.map(function (x) { return x.pct; }), backgroundColor: '#b3402e' }] },
                                                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return ' ' + c.parsed.x + '%'; } } } }, scales: { x: { max: 100, ticks: { callback: function (val) { return val + '%'; } } } } }
                                            });
                                        }
                                    }

                                    document.addEventListener('DOMContentLoaded', function () {
                                        if (!window.ModoEstadisticas) return;
                                        if (document.getElementById('chartWrapNivel'))
                                            ModoEstadisticas.registrar('nivel', { original: '#tablaNiveldeEstudio', charts: '#chartWrapNivel', botonHost: '#modoHostNivel', render: renderChartNivel, cargar: function () { if (typeof cargarNivelEstudio === 'function') cargarNivelEstudio(); } });
                                        if (document.getElementById('chartWrapCierre'))
                                            ModoEstadisticas.registrar('cierre', { original: '#tablaCierreCuatrimestres', charts: '#chartWrapCierre', botonHost: '#modoHostCierre', render: renderChartCierre });
                                        if (document.getElementById('chartWrapCarrera'))
                                            ModoEstadisticas.registrar('carrera', { original: '#tablaCarreras_wrapper, #tablaCarreras', charts: '#chartWrapCarrera', botonHost: '#modoHostCarrera', render: renderChartCarrera, cargar: function () { if (typeof cargarCarreras === 'function') cargarCarreras(); } });
                                        if (document.getElementById('chartWrapGrupo'))
                                            ModoEstadisticas.registrar('grupo', { original: '#tablaGrupos_wrapper, #tablaGrupos', charts: '#chartWrapGrupo', botonHost: '#modoHostGrupo', render: renderChartGrupo, cargar: function () { if (typeof window.cargarEstadisticasGrupos === 'function') window.cargarEstadisticasGrupos(); } });
                                        if (document.getElementById('chartWrapComparativo'))
                                            ModoEstadisticas.registrar('comparativo', { original: '#tablaComparativo', charts: '#chartWrapComparativo', botonHost: '#modoHostComparativo', render: renderChartComparativo });
                                        if (document.getElementById('chartWrapMateriasTabla'))
                                            @* 2026-08-01: el modo grafica de Materias quedo reducido a la top-10 (chartMaterias);
                                               el resto de sus graficas vive en las secciones Reprobados/Extraordinarios. *@
                                            ModoEstadisticas.registrar('materiasTabla', { original: '#wrapTablaMaterias, #filtroMaterias', charts: '#chartWrapMateriasTabla', botonHost: '#modoHostMaterias', render: function (materias) { if (window.renderMateriasTop10) window.renderMateriasTop10(materias); } });
                                    });
                                })();
                            </script>

