                                .btn-corte-manual:disabled { opacity:.55; cursor:not-allowed; background:#fff; color:#c0392b; border-color:#E4B7B0; box-shadow:none; }
                                /* Modal de confirmacion del corte manual (propio: la vista mezcla BS3/BS5) */
                                .corte-modal-overlay { position:fixed; top:0; right:0; bottom:0; left:0; background:rgba(17,24,39,.55); z-index:2000; display:none; align-items:center; justify-content:center; padding:16px; }
                                .corte-modal { background:#fff; border-radius:14px; max-width:540px; width:100%; box-shadow:0 20px 50px rgba(0,0,0,.35); overflow:hidden; animation:corteModalIn .16s ease-out; }
                                .corte-modal-head { display:flex; align-items:center; gap:11px; padding:15px 22px; background:#fff; border-bottom:1px solid #eef0f2; }
                                .corte-modal-head i { color:#6b7280; font-size:15px; }
                                .corte-modal-head strong { color:#1f2937; font-size:15px; letter-spacing:.2px; }
                                .corte-modal-body { padding:18px 22px 6px; color:#374151; font-size:13.5px; line-height:1.6; }
