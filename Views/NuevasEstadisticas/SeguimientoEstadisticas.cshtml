    // Fase 1 dashboard: colapso por seccion con persistencia (mismo slug que el menu rapido)
    $(function () {
        function slugDe(sec) {
            var h = sec.querySelector('h3.section-title');
            return h ? h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-') : '';
        }
        var KEY = 'dashColapsadas';
        var colapsadas = [];
        try { colapsadas = JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { }
        document.querySelectorAll('section.data-block').forEach(function (sec) {
            var header = sec.querySelector('.card-header');
            var slug = slugDe(sec);
            if (!header || !slug) return;
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'dash-chevron'; btn.title = 'Mostrar/ocultar sección';
            btn.innerHTML = '<i class="fas fa-chevron-up"></i>';
            header.appendChild(btn);
            function cuerpo() { return $(sec).children().not('.card-header, script, style'); }
            if (colapsadas.indexOf(slug) !== -1) { sec.classList.add('dash-colapsada'); cuerpo().hide(); }
            function alternar() {
                sec.classList.toggle('dash-colapsada');
                var i = colapsadas.indexOf(slug);
                if (sec.classList.contains('dash-colapsada') && i === -1) colapsadas.push(slug);
                if (!sec.classList.contains('dash-colapsada') && i !== -1) colapsadas.splice(i, 1);
                localStorage.setItem(KEY, JSON.stringify(colapsadas));
                // Suave (como los paneles internos): slideUp/slideDown en vez de display:none seco.
                if (sec.classList.contains('dash-colapsada')) {
                    cuerpo().slideUp(250);
                } else {
                    // Al expandir, disparar resize para que Chart.js reacomode las graficas
                    cuerpo().slideDown(250, function () { window.dispatchEvent(new Event('resize')); });
                }
            }
            btn.addEventListener('click', function (e) { e.stopPropagation(); alternar(); });
            // 2026-08-01: toda la franja verde colapsa/expande, no solo el chevron. Se ignoran los
            // clics sobre controles del header (filtros, botones, historico) para no colapsar al usarlos.
            header.style.cursor = 'pointer';
            header.addEventListener('click', function (e) {
                if (e.target.closest('button, select, input, a, label, option, .hist-wrap, .hist-menu, .badge, .modo-toggle-seccion')) return;
                alternar();
            });
        });
        // Solo la HORA en la barra (el sello completo iba muy ancho y amontonaba las pildoras);
        // la fecha completa queda como tooltip.
        var u = document.getElementById('dashUltimaAct');
        if (u) {
            var ahora = new Date();
            u.textContent = ahora.toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit' });
            var uw = document.getElementById('dashUltimaActWrap');
            if (uw) uw.title = 'Última actualización: ' + ahora.toLocaleString('es-MX');
        }
    });
</script>
