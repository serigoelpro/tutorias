                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="chart-container" style="min-height: 350px;">
                                                                <canvas id="graficaPATsPorEstado"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (esMaster)
                                                    {
                                                        <div class="row mt-4">
                                                            <div class="col-12">
                                                                <div class="chart-container" style="min-height: 450px;">
                                                                    <canvas id="graficaPATsPorCarrera"></canvas>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
