                                display: true,
                                text: 'Bajas por Causa',
                                font: { size: 16, weight: 'bold' }
                            },
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var value = context.parsed.x;
                                        var pct = totalBajasCausa > 0 ? ((value / totalBajasCausa) * 100).toFixed(1) : '0.0';
                                        return ' ' + value + ' (' + pct + '%)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { precision: 0, font: { size: 11 } },
                                grid: { color: 'rgba(0,0,0,0.06)' }
