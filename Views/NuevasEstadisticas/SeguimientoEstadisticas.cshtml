<script>
    // Fase 5: Insights Clave — reglas client-side sobre los JSON ya cargados (spec §5). Sin backend.
    $(function () {
        var cache = { resumen: null, materias: null, carreras: null, kpisAnt: null };
        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
        function pct(n, d) { return d ? Math.round(n / d * 1000) / 10 : null; }
        function card(ico, tono, cifra, titulo, detalle) {
            return '<div class="insight-card t-' + tono + '"><div class="ins-top"><span class="ins-badge"><i class="fas ' + ico + '"></i></span><span class="ins-num">' + cifra + '</span></div><div class="ins-titulo">' + titulo + '</div><p>' + detalle + '</p></div>';
        }
        function miles(n) { return (n || 0).toLocaleString('es-MX'); }

        function render() {
            var out = [];
            var r = cache.resumen;
            // 1) Mayor tasa de reprobación (materia, min 10 registros para no premiar materias de 2 alumnos)
            if (cache.materias && cache.materias.length) {
                var top = null;
                cache.materias.forEach(function (m) {
                    if ((m.totalRegistros || 0) >= 10) {
                        var t = pct(m.reprobadas || 0, m.totalRegistros);
                        if (t !== null && (!top || t > top.t)) top = { t: t, m: m };
                    }
                });
                if (top) out.push(card('fa-book', 'riesgo', top.t + '%', 'Mayor tasa de reprobación', '<b>' + esc(top.m.nombreMateria) + '</b>: ' + top.m.reprobadas + ' de ' + top.m.totalRegistros + ' registros reprobados.'));
            }
            // 2) Factor principal de situación familiar
            if (r) {
                var f = [['embarazadas', 'estudiantes embarazadas'], ['madres', 'madres de familia'], ['padres', 'padres de familia'], ['alumnosTrabajando', 'estudiantes que trabajan']]
                    .map(function (x) { return { n: r[x[0]] || 0, t: x[1] }; }).sort(function (a, b) { return b.n - a.n; })[0];
                if (f && f.n > 0) out.push(card('fa-house-user', 'info', miles(f.n), 'Factor familiar principal', esc(f.t.charAt(0).toUpperCase() + f.t.slice(1)) + ' (' + pct(f.n, r.totalEstudiantes) + '% del total).'));
            }
            // 3) Carrera con mayor vulnerabilidad % (solo Máster — cache.carreras solo existe si la sección Carrera cargó)
            if (cache.carreras && cache.carreras.length) {
                var c = cache.carreras.map(function (x) { var v = (x.econ || 0) + (x.acad || 0) + (x.pers || 0); return { x: x, p: pct(v, x.cantidad) }; })
                    .filter(function (y) { return y.p !== null && (y.x.cantidad || 0) >= 20; }).sort(function (a, b) { return b.p - a.p; })[0];
                if (c) out.push(card('fa-graduation-cap', 'alerta', c.p + '%', 'Carrera con mayor vulnerabilidad', '<b>' + esc(c.x.nombre) + '</b>, sobre ' + miles(c.x.cantidad) + ' estudiantes.'));
            }
            // 4) Vulnerables sin seguimiento del tutor
            if (r && r.sinSeguimiento > 0) out.push(card('fa-user-clock', 'alerta', miles(r.sinSeguimiento), 'Sin seguimiento del tutor', 'Estudiantes sin clasificación de su tutor (' + pct(r.sinSeguimiento, r.totalEstudiantes) + '% del total).'));
            // 5) Variación de vulnerabilidad vs. año anterior (solo si hay corte previo — Fase 3)
            if (r && cache.kpisAnt && cache.kpisAnt.totalVulnerables > 0) {
                var d = Math.round(((r.totalVulnerables || 0) - cache.kpisAnt.totalVulnerables) / cache.kpisAnt.totalVulnerables * 1000) / 10;
