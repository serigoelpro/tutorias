    <script>
        $(function () {
            // Resumen server-side (Demografia / Situacion Familiar) y Vulnerabilidad:
            // reusan el snapshot ResumenGlobal via GetEstadisticasPorEspecialidad(corteId) y
            // las funciones de render existentes (actualizarResumenDetallado / actualizarVulnerabilidades).
            function cargarResumenHist(corteId) {
                var dataHist = { corteId: corteId || null };
                window._vulnParamsActuales = dataHist;
                // Los filtros nuevos (grado/grupo) solo operan EN VIVO: los snapshots guardan agregados.
                $('#gradoFiltroResumen, #grupoFiltroResumen')
                    .prop('disabled', !!corteId)
                    .attr('title', corteId ? 'Filtros disponibles solo en vivo (viendo un corte histórico solo hay totales)' : '');
                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataHist,
                    success: function (r) { if (r && r.success) window.actualizarResumenDetallado(r.data); }
                });
            }
            function cargarVulnerabilidadHist(corteId) {
                var dataVulnHist = { corteId: corteId || null };
                window._vulnParamsActuales = dataVulnHist;
                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataVulnHist,
                    success: function (r) { if (r && r.success) window.actualizarVulnerabilidades(r.data); }
                });
            }
            initHistoricoSeccion({
                btn: '#btnHistResumen', menu: '#menuHistResumen', rotulo: '#rotuloHistResumen',
                onCorte: function (c) { cargarResumenHist(c.idCorte); },
                onVivo: function () { cargarResumenHist(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistVulnerabilidad', menu: '#menuHistVulnerabilidad', rotulo: '#rotuloHistVulnerabilidad',
                onCorte: function (c) { cargarVulnerabilidadHist(c.idCorte); },
                onVivo: function () { cargarVulnerabilidadHist(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistBajas', menu: '#menuHistBajas', rotulo: '#rotuloHistBajas',
                onCorte: function (c) { cargarBajas(c.idCorte); },
                onVivo: function () { renderBajas(window._bajasServerData); }
            });
            initHistoricoSeccion({
                btn: '#btnHistNivel', menu: '#menuHistNivel', rotulo: '#rotuloHistNivel',
                onCorte: function (c) { cargarNivelEstudio(c.idCorte); },
                onVivo: function () { cargarNivelEstudio(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistCierre', menu: '#menuHistCierre', rotulo: '#rotuloHistCierre',
                onCorte: function (c) { cargarEstadisticasCierreCuatrimestres(c.idCorte); },
                onVivo: function () { cargarEstadisticasCierreCuatrimestres(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistCarrera', menu: '#menuHistCarrera', rotulo: '#rotuloHistCarrera',
                onCorte: function (c) { cargarCarreras(c.idCorte); },
                onVivo: function () { cargarCarreras(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistGrupo', menu: '#menuHistGrupo', rotulo: '#rotuloHistGrupo',
                onCorte: function (c) { cargarEstadisticasGrupos(c.idCorte); },
                onVivo: function () { cargarEstadisticasGrupos(null); }
            });

            // Materias reprobadas (requerimiento dirección): agregado por materia + alumnos en vivo
            // Filtro por carrera (requerimiento profe 2026-07-14). Máster: select; nivel 3: fijo.
            var carreraFijaMaterias = '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.CarreraNombreMateriasNivel3 as string ?? ""))'.trim().toUpperCase();
            var corteMateriasActual = null;
            function nombreCarreraFiltroMaterias() {
                var $sel = $('#carreraFiltroMaterias');
                if ($sel.length) { // Máster
                    var $opt = $sel.find('option:selected');
                    return ($sel.val() ? ($opt.data('nombre') || $opt.text()) : '').trim().toUpperCase();
                }
                return carreraFijaMaterias; // nivel 3 (o '' para otros roles)
            }
            var chartMaterias = null;
            window.cargarMaterias = function (corteId, _retry) {
                corteMateriasActual = corteId || null;
                // Filtros de la seccion (solo en vivo; el snapshot historico es agregado).
                $('#especialidadFiltroMaterias, #materiaFiltroMaterias, #estadoFiltroMaterias, #intentosFiltroMaterias, #gradoFiltroMaterias, #grupoFiltroMaterias').prop('disabled', !!corteId)
                    .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
                $.ajax({
                    url: '@Url.Action("GetEstadisticasMaterias", "NuevasEstadisticas")',
                    type: 'POST',
                    data: {
                        corteId: corteId || null,
                        carreraId: (!corteId && $('#carreraFiltroMaterias').length) ? ($('#carreraFiltroMaterias').val() || null) : null,
                        especialidadId: (corteId ? null : ($('#especialidadFiltroMaterias').val() || null)),
                        materiaNombre: (corteId ? null : ($('#materiaFiltroMaterias').val() || null)),
                        estado: (corteId ? null : ($('#estadoFiltroMaterias').val() || null)),
                        intentos: (corteId ? null : ($('#intentosFiltroMaterias').val() || null)),
                        gradoId: (corteId ? null : ($('#gradoFiltroMaterias').val() || null)),
                        grupoId: (corteId ? null : ($('#grupoFiltroMaterias').val() || null)),
                        agruparPor: ($('#agruparPorMaterias').length && !corteId) ? ($('#agruparPorMaterias').val() || 'materia') : 'materia'
                    },
                    success: function (r) {
                        var $nd = $('#materiasNoDisponible'), $tb = $('#tablaMaterias tbody');
                        if (!r || !r.success) {
                            $tb.empty(); $('#materiasResumen').empty();
                            if (chartMaterias) { chartMaterias.destroy(); chartMaterias = null; }
                            $nd.toggle(!!(r && r.noDisponible));
                            $('#tablaMaterias').toggle(!(r && r.noDisponible));
                            if (!(r && r.noDisponible)) console.error('GetEstadisticasMaterias:', r && r.error);
                            return;
                        }
                        $nd.hide();
                        $('#tablaMaterias').show();
                        var d = r.data, materias = d.materias || [];
                        var modoCarrera = (d.agruparPor === 'carrera');
                        // Modo carrera: renombrar cabecera Materia→Carrera, ocultar col Carrera (queda vacía)
                        var $thMateria = $('#tablaMaterias thead tr th:eq(0)');
                        var $thCarrera = $('#tablaMaterias thead tr th:eq(1)');
                        if (modoCarrera) {
                            $thMateria.text('Carrera');
                            $thCarrera.hide();
                        } else {
                            $thMateria.text('Materia');
                            $thCarrera.show();
                        }
                        if (window.ModoEstadisticas) ModoEstadisticas.datos('materiasTabla', materias);
                        // En histórico el snapshot es global: filtrar client-side por nombre de carrera.
                        var nombreFiltro = corteId ? nombreCarreraFiltroMaterias() : '';
                        if (nombreFiltro) {
                            materias = materias.filter(function (m) {
                                return ((m.carreraNombre || '').trim().toUpperCase()) === nombreFiltro;
                            });
                        }
                        if (nombreFiltro) {
                            // Sin detalle nominal en el snapshot: "alumnos" es suma por materia (aprox., puede contar
                            // dos veces a un alumno con 2 materias).
                            var sumaAlumnos = materias.reduce(function (s, m) { return s + (m.alumnosDistintos || 0); }, 0);
                            $('#materiasResumen').text('Materias con reprobación: ' + materias.length +
                                ' · Alumnos (suma por materia): ' + sumaAlumnos);
                        } else {
                            $('#materiasResumen').text(modoCarrera
                                ? ('Carreras con reprobación: ' + materias.length + ' · Alumnos afectados: ' + (d.totalAlumnosAfectados || 0))
                                : ('Materias con reprobación: ' + (d.totalMateriasDistintas || 0) + ' · Alumnos afectados: ' + (d.totalAlumnosAfectados || 0)));
                        }

                        var top = materias.slice(0, 10);
                        if (chartMaterias) chartMaterias.destroy();
                        chartMaterias = new Chart(document.getElementById('chartMaterias'), {
                            type: 'bar',
                            data: {
                                labels: top.map(function (m) { return m.nombreMateria; }),
                                datasets: [
                                    { label: 'Reprobadas (arrastre)', data: top.map(function (m) { return m.reprobadas; }), backgroundColor: '#b3402e' },
                                    { label: 'Extraordinario', data: top.map(function (m) { return m.extraordinarios; }), backgroundColor: '#dba13a' }
                                ]
                            },
                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } } }
                        });

                        $tb.empty();
                        materias.forEach(function (m, i) {
                            var tieneAlumnos = (!modoCarrera && m.alumnos && m.alumnos.length > 0);
                            var textoBuscar = ((m.nombreMateria || '') + ' ' + (m.carreraNombre || '')).toLowerCase();
                            var tdCarrera = modoCarrera ? '<td style="display:none;">' + (m.carreraNombre || '') + '</td>' : '<td>' + (m.carreraNombre || '') + '</td>';
                            var fila = '<tr class="fila-materia" data-idx="' + i + '" data-buscar="' + textoBuscar.replace(/"/g, '') + '">' +
                                '<td>' + m.nombreMateria + '</td>' +
                                tdCarrera +
                                '<td class="text-center"><span class="badge bg-dark">' + m.alumnosDistintos + '</span></td>' +
                                '<td class="text-center">' + m.reprobadas + '</td>' +
                                '<td class="text-center">' + m.extraordinarios + '</td>' +
                                '<td class="text-center">' + m.intentos1 + '</td>' +
                                '<td class="text-center">' + m.intentos2 + '</td>' +
                                '<td class="text-center">' + m.intentos3Mas + '</td>' +
                                '<td>' + (tieneAlumnos ? '<button type="button" class="btn btn-default btn-xs btn-ver-alumnos" data-idx="' + i + '">Ver alumnos</button>' : '') + '</td>' +
                                '</tr>';
                            if (tieneAlumnos) {
                                var detalle = m.alumnos.map(function (a) {
                                    return '<tr><td>' + a.matricula + '</td><td>' + (a.nombreAlumno || '') + '</td><td>' + a.estado + '</td><td class="text-center">' + a.intentos + '</td></tr>';
                                }).join('');
                                fila += '<tr class="fila-alumnos" id="alumnosMateria' + i + '" style="display:none;"><td colspan="9">' +
                                    '<table class="table table-condensed" style="margin:0;"><thead><tr><th>Matrícula</th><th>Alumno</th><th>Estado</th><th class="text-center">Intentos</th></tr></thead><tbody>' +
                                    detalle + '</tbody></table></td></tr>';
                            }
                            $tb.append(fila);
                        });
                        $tb.off('click', '.btn-ver-alumnos').on('click', '.btn-ver-alumnos', function () {
                            $('#alumnosMateria' + $(this).data('idx')).toggle();
                        });

                        // Filtro por materia/carrera (la tabla vive en un contenedor con scroll propio)
                        function aplicarFiltroMaterias() {
                            var q = ($('#filtroMaterias').val() || '').toLowerCase().trim();
                            var visibles = 0;
                            $tb.find('tr.fila-materia').each(function () {
                                var coincide = !q || ($(this).data('buscar') || '').indexOf(q) >= 0;
                                $(this).toggle(coincide);
                                if (coincide) visibles++;
                                // El detalle de alumnos se oculta siempre al filtrar (se reabre con el botón)
                                $('#alumnosMateria' + $(this).data('idx')).hide();
                            });
                            $('#materiasFiltroInfo').text(q ? ('Mostrando ' + visibles + ' de ' + materias.length + ' materias') : '');
                        }
                        $('#filtroMaterias').off('input').on('input', aplicarFiltroMaterias);
                        aplicarFiltroMaterias();
                        $('#wrapTablaMaterias').scrollTop(0);
                    },
                    error: function () {
                        if (!_retry) { setTimeout(function () { window.cargarMaterias(corteId, true); }, 1500); return; }
                        console.error('Error al cargar estadísticas de materias');
                    }
                });
            };
            window.cargarMaterias(null);
            $('#carreraFiltroMaterias').on('change', function () { window.cargarMaterias(corteMateriasActual); });
            $('#especialidadFiltroMaterias, #materiaFiltroMaterias, #estadoFiltroMaterias, #intentosFiltroMaterias, #gradoFiltroMaterias, #grupoFiltroMaterias').on('change', function () { window.cargarMaterias(corteMateriasActual); });
            $('#agruparPorMaterias').on('change', function () {
                // En modo carrera, los filtros por materia/especialidad no aplican — deshabilitarlos visualmente
                var esCarrera = $(this).val() === 'carrera';
                $('#materiaFiltroMaterias, #especialidadFiltroMaterias').prop('disabled', esCarrera)
                    .attr('title', esCarrera ? 'No aplica en modo Carrera' : '');
                window.cargarMaterias(corteMateriasActual);
            });
            initHistoricoSeccion({
                btn: '#btnHistMaterias', menu: '#menuHistMaterias', rotulo: '#rotuloHistMaterias',
                onCorte: function (c) { window.cargarMaterias(c.idCorte); },
                onVivo: function () { window.cargarMaterias(null); }
            });
        });
    </script>
    <script>
        // Comparativo entre cuatrimestres
        $(function () {
            var $c1 = $('#selComparativoC1'), $c2 = $('#selComparativoC2'), $tb = $('#tbodyComparativo');
            if (!$c1.length || typeof cargarCortesHist !== 'function') return;

            function cargarComparativo() {
                var id1 = $c1.val(), id2 = $c2.val();
                if (!id1 || !id2) return;
                $('#thComparativoC1').text($c1.find('option:selected').text());
                $('#thComparativoC2').text($c2.find('option:selected').text());
                $tb.html('<tr><td colspan="4" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando...</td></tr>');
                $.ajax({
                    url: '@Url.Action("GetComparativoCortes", "NuevasEstadisticas")',
                    type: 'POST',
                    data: { idCorte1: id1, idCorte2: id2 },
                    success: function (r) {
                        if (!r || !r.success) { $tb.html('<tr><td colspan="4" class="text-center text-danger">Error al cargar el comparativo.</td></tr>'); return; }
                        if (window.ModoEstadisticas) ModoEstadisticas.datos('comparativo', { filas: r.filas, n1: $c1.find('option:selected').text(), n2: $c2.find('option:selected').text() });
                        var html = r.filas.map(function (f) {
                            var varHtml;
                            if (f.variacion === null || f.variacion === undefined) {
                                varHtml = '<span class="text-muted">—</span>';
                            } else {
                                var flecha = f.c2 > f.c1 ? '▲' : (f.c2 < f.c1 ? '▼' : '=');
                                var signo = f.variacion > 0 ? '+' : '';
                                var clase = f.mejora === true ? 'text-success' : (f.mejora === false ? 'text-danger' : 'text-muted');
                                varHtml = '<span class="' + clase + '">' + flecha + ' ' + signo + f.variacion.toFixed(1) + '%</span>';
                            }
                            return '<tr><td class="fw-bold">' + f.indicador + '</td>' +
                                   '<td class="text-center">' + f.c1 + '</td>' +
                                   '<td class="text-center">' + f.c2 + '</td>' +
                                   '<td class="text-center">' + varHtml + '</td></tr>';
                        }).join('');
                        $tb.html(html);
                    },
                    error: function () { $tb.html('<tr><td colspan="4" class="text-center text-danger">Error de conexión.</td></tr>'); }
                });
            }

            cargarCortesHist(function (cortes) {
                if (!cortes || cortes.length < 2) {
                    $c1.add($c2).prop('disabled', true);
                    $tb.html('<tr><td colspan="4" class="text-center text-muted py-3">Se necesitan al menos 2 cortes para comparar.</td></tr>');
                    return;
                }
                var opts = cortes.map(function (c) { return '<option value="' + c.idCorte + '">' + c.nombre + ' — ' + c.fecha + '</option>'; }).join('');
                $c1.html(opts); $c2.html(opts);
                $c2.val(cortes[0].idCorte);
                $c1.val(cortes[1].idCorte);
                cargarComparativo();
            });
            $c1.add($c2).on('change', cargarComparativo);
            $('#btnDescargarPdfComparativo').on('click', function () {
                var id1 = $c1.val(), id2 = $c2.val();
                if (!id1 || !id2) { alert('Selecciona dos cuatrimestres.'); return; }
                window.location = '@Url.Action("DescargarPdfEjecutivo", "NuevasEstadisticas")' + '?idCorte1=' + id1 + '&idCorte2=' + id2;
            });
        });
    </script>
    <script>
        // Dashboard de tendencias entre cuatrimestres
        $(function () {
            if (!document.getElementById('tendPoblacion')) return;
            $.ajax({
                url: '@Url.Action("GetTendenciasCortes", "NuevasEstadisticas")',
                type: 'POST',
                success: function (r) {
                    if (!r || !r.success) { $('#tendMensaje').text('Error al cargar las tendencias.').show(); $('#tendGraficas').hide(); return; }
                    if (!r.labels || r.labels.length < 2) {
                        $('#tendMensaje').text('Se necesitan al menos 2 cortes para ver tendencias.').show();
                        $('#tendGraficas').hide();
                        return;
                    }
                    var s = r.series;
                    function linea(label, data, color) {
                        return { label: label, data: data, borderColor: color, backgroundColor: color, tension: 0.2, fill: false, pointRadius: 3 };
                    }
                    function crear(id, datasets) {
                        var prev = (Chart.getChart ? Chart.getChart(document.getElementById(id)) : null);
                        if (prev) prev.destroy();
                        return new Chart(document.getElementById(id).getContext('2d'), {
                            type: 'line',
                            data: { labels: r.labels, datasets: datasets },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
                        });
                    }
                    crear('tendPoblacion', [ linea('Total estudiantes', s.totalEstudiantes, '#009688') ]);
                    crear('tendVulnerabilidad', [
                        linea('Económicos', s.vulnerablesEconomicos, '#dc3545'),
                        linea('Académicos', s.vulnerablesAcademicos, '#fd7e14'),
                        linea('Personales', s.vulnerablesPersonales, '#6c757d')
                    ]);
                    crear('tendSeguimiento', [
                        linea('No vulnerables', s.noVulnerables, '#198754'),
                        linea('Sin seguimiento', s.sinSeguimiento, '#0d6efd')
                    ]);
                    crear('tendBajas', [ linea('Total de bajas', s.TotalBajas, '#dc3545') ]);
                    crear('tendSitFam', [
                        linea('Embarazadas', s.embarazadas, '#b56d8e'),
                        linea('Madres', s.madres, '#74628f'),
                        linea('Padres', s.padres, '#1f4e5f'),
                        linea('Trabajando', s.alumnosTrabajando, '#dba13a')
                    ]);
                    (function () {
                        var datosRep = s.tasaReprobacionx10.map(function (v) { return v < 0 ? null : v / 10; });
                        var prev = (Chart.getChart ? Chart.getChart(document.getElementById('tendReprobacion')) : null);
                        if (prev) prev.destroy();
                        new Chart(document.getElementById('tendReprobacion').getContext('2d'), {
                            type: 'line',
                            data: { labels: r.labels, datasets: [{ label: 'Tasa de reprobación', data: datosRep, borderColor: '#b3402e', backgroundColor: '#b3402e', tension: 0.2, fill: false, pointRadius: 3, spanGaps: false }] },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom' }, tooltip: { callbacks: { label: function (ctx) { return ctx.parsed.y !== null ? ctx.parsed.y.toFixed(1) + '%' : 'Sin datos'; } } } }, scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return v + '%'; } } } } }
                        });
                    })();
                },
                error: function () { $('#tendMensaje').text('Error de conexión al cargar las tendencias.').show(); $('#tendGraficas').hide(); }
            });
        });
    </script>
    <script>
        // Cascada carrera -> especialidad (2026-07-29). Compara por TEXTO normalizado porque
        // los selects de carrera usan 2 espacios de IDs (area vs Tutorias) pero los nombres coinciden.
        (function () {
            function normTxt(s) {
                return (s || '').toString().normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toUpperCase();
            }
            window.initCascadaEspecialidad = function (carreraSelId, espSelId) {
                var $car = $(carreraSelId), $esp = $(espSelId);
                if (!$car.length || !$esp.length) return;
                $car.on('change', function () {
                    var carNombre = normTxt($car.find('option:selected').text());
                    var esTodas = !$car.val();
                    var limpiado = false;
                    $esp.find('option').each(function () {
                        var $o = $(this);
                        if (!$o.attr('value')) { $o.show(); return; } // "Todas"
                        var visible = esTodas || normTxt($o.data('carrera')) === carNombre;
                        $o.toggle(visible);
                        if (!visible && $o.is(':selected')) { $esp.val(''); limpiado = true; }
                    });
                    if (limpiado) $esp.trigger('change');
                });
            };
            $(function () {
                window.initCascadaEspecialidad('#carreraFiltroResumen', '#especialidadFiltro');
                window.initCascadaEspecialidad('#carreraFiltroNivel', '#especialidadFiltroNivel');
                window.initCascadaEspecialidad('#carreraFiltroCierre', '#especialidadFiltroCierre');
                window.initCascadaEspecialidad('#carreraFiltro', '#especialidadFiltroGrupos');
                window.initCascadaEspecialidad('#carreraFiltroMaterias', '#especialidadFiltroMaterias');
                window.initCascadaEspecialidad('#carreraFiltroBajas', '#especialidadFiltroBajas');
            });
        })();
    </script>
}
