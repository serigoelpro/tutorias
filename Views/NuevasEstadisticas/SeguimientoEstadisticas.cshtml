                            @* Menu rapido sticky: accesos directos a cada seccion (se arma por JS segun lo que exista en el DOM) *@
                            <nav id="menuRapidoEstadisticas" aria-label="Secciones">
                                <span id="dashAccionesRapidas" style="display:flex; align-items:center; gap:8px; flex:0 0 auto; order:99;">
                                    <span style="font-size:11px; color:#6b7280; white-space:nowrap;">Actualizado: <strong id="dashUltimaAct"></strong></span>
                                    <button type="button" id="btnExportarModulo" class="btn btn-success btn-sm" title="Descarga un ZIP con los mismos archivos Excel que las exportaciones por sección (respeta filtros y toggles de bajas)">
                                        <i class="fas fa-file-export"></i> Exportar
                                    </button>
                                    <button type="button" id="btnProgramarReporte" class="btn btn-default btn-sm" title="Programar Reporte">
                                        <i class="far fa-clock"></i>
                                    </button>
                                </span>
                            </nav>
                            <style>
                                /* Compacto (pedido 2026-07-28): UNA fila con scroll horizontal si no caben. */
                                #menuRapidoEstadisticas { position: sticky; top: 51px; z-index: 1500; background: #fff; padding: 7px 12px; margin: 8px 0 14px; border-radius: 0 0 10px 10px; display: flex; flex-wrap: nowrap; align-items: center; gap: 10px; transition: box-shadow .15s; }
                                #menuRapidoEstadisticas.pegado { box-shadow: 0 4px 10px rgba(0,0,0,.14); }
                                /* Carril de pildoras con scroll propio; el switch queda FUERA, a la derecha, sin tapar nada. */
                                #menuRapidoPills { display: flex; flex-wrap: nowrap; align-items: center; gap: 6px; flex: 1 1 auto; min-width: 0; overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; padding-bottom: 2px; }
                                #menuRapidoEstadisticas #modoSwitchGlobal { margin-left: auto; flex: 0 0 auto; }
                                .menu-rapido-pill { border: 1px solid #cfd8de; background: #f6f9fa; color: #2c3e50; border-radius: 22px; padding: 5px 12px; font-size: 12.5px; font-weight: 500; cursor: pointer; white-space: nowrap; flex: 0 0 auto; }
                                .menu-rapido-pill:hover { background: #2c3e50; color: #fff; }
                                /* Modo Tablas/Graficas */
                                .modo-switch { margin-left: auto; display: flex; align-items: center; }
                                .modo-switch button { border: 1px solid #cfd8de; background: #f6f9fa; color: #2c3e50; padding: 8px 14px; font-size: 1rem; cursor: pointer; }
                                .modo-switch button:first-child { border-radius: 18px 0 0 18px; }
                                .modo-switch button:last-child { border-radius: 0 18px 18px 0; border-left: 0; }
                                .modo-switch button.activo { background: #2c3e50; color: #fff; }
                                .modo-toggle-seccion { border: 1px solid #cfd8de; background: #fff; border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: .85rem; margin-left: 6px; color: #2c3e50; }
                                .modo-toggle-seccion:hover { background: #eef3f7; }
                                .modo-chart-wrap { display: none; max-width: 950px; margin: 0 auto; height: 380px; position: relative; }
                                .modo-chart-wrap > canvas { max-height: 350px; }
                            </style>
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    var nav = document.getElementById('menuRapidoEstadisticas');
                                    if (!nav) return;
                                    var vistos = {};
                                    document.querySelectorAll('section.data-block').forEach(function (sec) {
                                        var h = sec.querySelector('h3.section-title');
                                        if (!h) return;
                                        var nombre = h.textContent.replace(/\s+/g, ' ').trim()
                                            .replace(/^Estadísticas (por|de)\s+/i, '')
                                            .replace(/\s*\(.*\)$/, '');
                                        if (!nombre || vistos[nombre]) return;
                                        vistos[nombre] = true;
                                        var icono = h.querySelector('i');
                                        var pill = document.createElement('button');
                                        pill.type = 'button';
                                        pill.className = 'menu-rapido-pill';
                                        pill.innerHTML = (icono ? '<i class="' + icono.className + '"></i> ' : '') + nombre;
                                        pill.addEventListener('click', function () {
                                            var y = sec.getBoundingClientRect().top + window.pageYOffset - nav.offsetHeight - 51 - 12;
                                            window.scrollTo({ top: y, behavior: 'smooth' });
                                        });
                                        // Las pildoras van en su propio carril con scroll (#menuRapidoPills),
                                        // separado del switch Tablas/Graficas para que este no las tape.
                                        var carril = document.getElementById('menuRapidoPills');
                                        if (!carril) {
                                            carril = document.createElement('div');
                                            carril.id = 'menuRapidoPills';
                                            nav.insertBefore(carril, nav.firstChild);
                                        }
                                        carril.appendChild(pill);
                                    });
                                    if (!nav.children.length) nav.style.display = 'none';
                                    // Sombra solo cuando la barra va "pegada" (evita que parezca un pedazo suelto)
                                    window.addEventListener('scroll', function () {
                                        nav.classList.toggle('pegado', nav.getBoundingClientRect().top <= 52);
                                    }, { passive: true });
                                });
                            </script>
                            <script>
    // Fase 1 dashboard: colapso por seccion con persistencia (mismo slug que el menu rapido)
    $(function () {
        function slugDe(sec) {
            var h = sec.querySelector('h3.section-title');
            return h ? h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-') : '';
        }
        var KEY = 'dashColapsadas';
        var colapsadas = [];
        try { colapsadas = JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { }
        document.querySelectorAll('section.data-block').forEach(function (sec) {
            var header = sec.querySelector('.card-header');
            var slug = slugDe(sec);
            if (!header || !slug) return;
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'dash-chevron'; btn.title = 'Mostrar/ocultar sección';
            btn.innerHTML = '<i class="fas fa-chevron-up"></i>';
            header.appendChild(btn);
            if (colapsadas.indexOf(slug) !== -1) sec.classList.add('dash-colapsada');
            btn.addEventListener('click', function () {
                sec.classList.toggle('dash-colapsada');
                var i = colapsadas.indexOf(slug);
                if (sec.classList.contains('dash-colapsada') && i === -1) colapsadas.push(slug);
                if (!sec.classList.contains('dash-colapsada') && i !== -1) colapsadas.splice(i, 1);
                localStorage.setItem(KEY, JSON.stringify(colapsadas));
                // Al expandir, disparar resize para que Chart.js reacomode las graficas
                if (!sec.classList.contains('dash-colapsada')) {
                    window.dispatchEvent(new Event('resize'));
                }
            });
        });
        var u = document.getElementById('dashUltimaAct'); if (u) u.textContent = new Date().toLocaleString('es-MX');
    });
