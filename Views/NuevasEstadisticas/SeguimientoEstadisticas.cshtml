                            @* Categoría: Vulnerabilidad (separada del Resumen Detallado) *@
                            <section class="data-block">
                                <div class="card-header d-flex justify-content-between align-items-center" style=" margin-bottom: 10px;">
                                    <h3 class="section-title">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Vulnerabilidad
                                    </h3>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBajasVulnerabilidad" onclick="toggleIncluirBajas('Vulnerabilidad', this)" title="Incluir bajas en el conteo">
                                            <i class="fas fa-user-slash me-1"></i>
                                            Incluir Bajas
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" onclick="exportarVulnerabilidades()">
                                            <i class="fas fa-file-excel me-1"></i>
