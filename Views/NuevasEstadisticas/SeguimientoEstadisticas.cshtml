            ], { scales: { x: { stacked: true }, y: { stacked: true, ticks: { precision: 0 } } } });
            barChart('chartDemoMatriculaNivel', labels, [
                { label: 'Estudiantes', data: niveles.map(function (x) { return x.n.total || 0; }), backgroundColor: '#00695C' }
