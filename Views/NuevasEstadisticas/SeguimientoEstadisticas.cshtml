        // Click en un alumno del detalle -> abre su mini-ficha flotante (script de la ficha 360).
        $('#tutor360Cuerpo').on('click', '.tutor360-alumno', function () {
            if (window.Alumno360Mini) window.Alumno360Mini.abrirCon($(this).data('idpersona'));
        });
        $('#tutor360Cerrar').on('click', cerrarTutor360);
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && $('#tutor360Overlay').is(':visible')) cerrarTutor360(); });
        // Arrastre del panel (mismo patron que la mini-ficha de alumno): se toma del encabezado.
        (function () {
            var panel = document.getElementById('tutor360Overlay'), handle = document.getElementById('tutor360Handle');
            if (!panel || !handle) return;
            var arrastrando = false, sx = 0, sy = 0, px = 0, py = 0;
            handle.addEventListener('mousedown', function (e) {
                if (e.target.closest('button')) return;
                arrastrando = true; sx = e.clientX; sy = e.clientY;
                var rect = panel.getBoundingClientRect(); px = rect.left; py = rect.top;
                e.preventDefault();
            });
            document.addEventListener('mousemove', function (e) {
                if (!arrastrando) return;
                var nl = px + e.clientX - sx, nt = py + e.clientY - sy;
                nl = Math.max(0, Math.min(window.innerWidth - 120, nl));
                nt = Math.max(0, Math.min(window.innerHeight - 46, nt));
                panel.style.left = nl + 'px'; panel.style.top = nt + 'px';
            });
            document.addEventListener('mouseup', function () { arrastrando = false; });
        })();

        // Modal accionable: alumnos del tutor SIN seguimiento del cuatrimestre.
        // El indice sale de la columna # (posicion en el ranking visible).
        $('#tablaCumplTutores tbody').on('click', 'tr', function () {
