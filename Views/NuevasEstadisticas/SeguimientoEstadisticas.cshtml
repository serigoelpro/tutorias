                        @* Estadísticas de Materias Reprobadas (requerimiento dirección).
                           2026-08-01: esta sección conserva SU TABLA como estaba (filtros + Histórico + gráfica
                           top-10). Lo que se eliminó fue su MODO GRÁFICAS (top-15/tasa/intentos): esas gráficas
                           quedaron divididas en las secciones Reprobados y Extraordinarios de abajo. *@
                        <style>
                            /* Tabla de materias con scroll propio: el encabezado se queda fijo */
                            #wrapTablaMaterias thead th { position: sticky; top: 0; z-index: 2; }
                        </style>
                        <section class="data-block" id="seccionMaterias">
                            <div class="card-header d-flex justify-content-between align-items-center" style="margin-bottom: 10px;">
                                <h3 class="section-title">
                                    <i class="fas fa-book me-2"></i>
                                    Materias Reprobadas y en Extraordinario
                                </h3>
                                <div class="d-flex gap-2 align-items-center">
                                    @{
                                        var nivelUsuarioMaterias = ViewBag.UsuarioNivel as int? ?? 0;
                                    }
                                    @if (nivelUsuarioMaterias == 4)
                                    {
                                        <select id="carreraFiltroMaterias" class="form-select form-select-sm" style="width:auto; max-width:280px;" title="Filtrar por carrera">
                                            <option value="">Todas las carreras</option>
                                            @if (ViewBag.CarrerasMaterias != null)
                                            {
                                                var carrerasMat = ViewBag.CarrerasMaterias as Dictionary<int, string>;
                                                foreach (var cm in carrerasMat)
                                                {
                                                    <option value="@cm.Key" data-nombre="@cm.Value">@cm.Value</option>
                                                }
                                            }
                                        </select>
                                        <select id="agruparPorMaterias" class="form-select form-select-sm" style="width:auto;" title="Al agrupar por carrera, 'Alumnos' suma alumnos por materia (un alumno con varias materias cuenta varias veces)">
