                        }
                        // Sin filas: dejar el tbody vacio (no una fila colspan) para que DataTables muestre
                        // su mensaje "No hay datos" sin romperse con "unknown parameter".
                        if (filas) { $tbody.html(filas); } else { $tbody.empty(); }
                        inicializarDataTableGrupos();
                        if (typeof aplicarBusquedaGrupos === 'function') {
                            aplicarBusquedaGrupos();
                        }
                    },
                    error: function() {
                        // Reintento unico (arranque en frio de IIS/EF): no mostrar el error de inmediato.
                        if (!_retry) { setTimeout(function () { window.cargarEstadisticasGrupos(corteId, true); }, 1500); return; }
                        $tbody.html('<tr><td colspan="14" class="text-center text-danger">Error de conexión al cargar grupos.</td></tr>');
                    }
