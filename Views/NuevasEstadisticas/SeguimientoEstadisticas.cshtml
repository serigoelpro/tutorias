        $('#cumplModalOverlay').on('click', function (e) { if (e.target === this) cerrarCumplModal(); });
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && $('#cumplModalOverlay').is(':visible')) cerrarCumplModal(); });
        // Exportar: CSV con BOM UTF-8 (abre directo en Excel), generado del mismo ranking en pantalla.
        $('#btnExportarCumpl').on('click', function () {
            var filas = listaCumplActual.length ? listaCumplActual : (cacheCT || []); // exporta lo visible (orden + filtro)
            if (!filas.length) return;
            function celda(v) { v = String(v == null ? '' : v); return '"' + v.replace(/"/g, '""') + '"'; }
            var lineas = [['#', 'Tutor', 'Carrera', 'Grupos', 'Alumnos', 'Con seguimiento (cuatrimestre)', '% cuatrimestre', 'Con seguimiento (este mes)', '% este mes', 'Con entrevista', '% entrevista', 'Última captura', 'Días sin capturar', 'Alumnos sin seguimiento'].map(celda).join(',')];
            filas.forEach(function (f, i) {
                lineas.push([i + 1, f.tutor, f.carrera, f.grupos, f.alumnos, f.conSeguimiento, f.pctSeguimiento + '%', f.conSeguimientoMes, f.pctSeguimientoMes + '%', f.conEntrevista, f.pctEntrevista + '%', f.ultimaCaptura || 'Sin capturas', (f.diasSinCaptura === null ? 'Sin capturas' : f.diasSinCaptura), (f.alumnosSinSeguimiento || []).map(function (a) { return a.matricula; }).join(' ')].map(celda).join(','));
            });
            var blob = new Blob(['﻿' + lineas.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'CumplimientoTutores.csv';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(a.href);
        });
        function pintarCumplCharts(filas) {
            filas = filas || cacheCT || [];
            if (typeof Chart === 'undefined') return;
            var peores = filas.slice(0, 10);
            var elP = document.getElementById('chartCumplPeores');
            if (elP) {
                if (chartsCT.peores) chartsCT.peores.destroy();
                chartsCT.peores = new Chart(elP.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: peores.map(function (f) { return f.tutor; }),
                        datasets: [{ label: '% de alumnos con seguimiento', data: peores.map(function (f) { return f.pctSeguimiento; }), backgroundColor: peores.map(function (f) { return f.pctSeguimiento >= 80 ? '#00897B' : (f.pctSeguimiento >= 50 ? '#dba13a' : '#b3402e'); }) }]
                    },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { min: 0, max: 100, ticks: { callback: function (v) { return v + '%'; } } }, y: { ticks: { font: { size: 10 } } } } }
                });
            }
            var elG = document.getElementById('chartCumplGlobal');
            if (elG) {
                var totAl = 0, totSeg = 0;
                filas.forEach(function (f) { totAl += f.alumnos; totSeg += f.conSeguimiento; });
                if (chartsCT.global) chartsCT.global.destroy();
                chartsCT.global = new Chart(elG.getContext('2d'), {
                    type: 'doughnut',
                    data: { labels: ['Con seguimiento', 'Sin seguimiento'], datasets: [{ data: [totSeg, Math.max(0, totAl - totSeg)], backgroundColor: ['#00897B', '#b3402e'] }] },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
        }
        if (window.ModoEstadisticas) {
            ModoEstadisticas.registrar('cumplTutores', { original: '#tablaCumplWrap', charts: '#chartWrapCumpl', botonHost: '#modoHostCumpl', render: pintarCumplCharts });
        }
        function cargarCumpl(corteIdHist, _retry) {
            $('#cumplCargando').show(); $('#cumplError, #cumplVacio').hide();
            $.ajax({
                url: '@Url.Action("GetCumplimientoTutores", "NuevasEstadisticas")',
                type: 'POST',
                data: { corteId: corteIdHist || null },
                success: function (r) {
                    $('#cumplCargando').hide();
                    if (!r || !r.success) {
                        var msg = (r && r.message) ? r.message : ('No se pudo obtener el cumplimiento: ' + ((r && r.error) || 'error desconocido'));
                        $('#cumplError').text(msg).show();
                        return;
                    }
                    cacheCT = r.data || [];
                    if (!cacheCT.length) { $('#cumplVacio').show(); $('#cumplResumen').text(''); return; }
                    var totAl = 0, totSeg = 0;
                    cacheCT.forEach(function (f) { totAl += f.alumnos; totSeg += f.conSeguimiento; });
                    $('#cumplResumen').text(cacheCT.length + ' tutores · ' + (totAl ? Math.round(totSeg * 1000 / totAl) / 10 : 0) + '% de alumnos con seguimiento');
                    aplicarVistaCumpl();
                    if (window.ModoEstadisticas) { ModoEstadisticas.datos('cumplTutores', cacheCT); } else { pintarCumplCharts(cacheCT); }
                },
                error: function () {
                    if (!_retry) { setTimeout(function () { cargarCumpl(corteIdHist, true); }, 1500); return; } // reintento 1 vez (patron existente)
                    $('#cumplCargando').hide();
                    $('#cumplError').text('Error de conexión al cargar el cumplimiento de tutores.').show();
                }
            });
        }
        // Carga diferida 3.5s: despues de las demas cargas perezosas para no amontonar AJAX.
        setTimeout(function () { cargarCumpl(null); }, 3500);
        if (typeof initHistoricoSeccion === 'function') {
            initHistoricoSeccion({
                btn: '#btnHistCumpl', menu: '#menuHistCumpl', rotulo: '#rotuloHistCumpl',
                onCorte: function (c) { cargarCumpl(c.idCorte); },
                onVivo: function () { cargarCumpl(null); }
            });
        }
    });
</script>
<script>
    // ===== FICHA DEL ALUMNO 360° (2026-08-02) =====
    $(function () {
        if (!document.getElementById('seccionAlumno360')) return;
        function escA(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function chip(texto, titulo) {
            return '<span title="' + escA(titulo || '') + '" style="background:#eceff1; color:#455a64; border-radius:10px; padding:3px 10px; font-size:12px; white-space:nowrap;">' + escA(texto) + '</span>';
        }
        // Color del banner segun la clasificacion (mismos tonos del dashboard).
        function colorClasif(texto) {
            var t = (texto || '').toUpperCase();
            if (t.indexOf('ECON') >= 0) return '#b3402e';
            if (t.indexOf('ACAD') >= 0) return '#b26a00';
            if (t.indexOf('PERS') >= 0) return '#74628f';
            if (t.indexOf('NO VULNERABLE') >= 0 || t === 'NO VULNERABLE') return '#00897B';
            return '#78909c'; // sin informacion / otros
        }
        function mostrar(id) {
            $('#a360Ayuda, #a360Cargando, #a360Error, #a360Sugerencias, #a360Ficha').hide();
            if (id) $('#' + id).show();
        }
        function pintarFicha(d) {
            $('#a360Nombre').text(d.nombre + ' (' + d.matricula + ')');
            var chips = [chip(d.carrera, 'Carrera')];
            if (d.especialidad) chips.push(chip(d.especialidad, 'Especialidad'));
            if (d.grupo) chips.push(chip('Grupo ' + d.grupo, 'Grado y grupo'));
            if (d.turno) chips.push(chip(d.turno, 'Turno'));
            if (d.sexo) chips.push(chip(d.sexo, 'Sexo'));
            chips.push(chip(d.tutor ? ('Tutor: ' + d.tutor) : 'Sin tutor asignado', 'Tutor del grupo en el periodo'));
            // Contexto de situación familiar (chips ámbar para distinguir del resto).
            function chipCtx(t, titulo) { return '<span title="' + escA(titulo || '') + '" style="background:#fff3e0; color:#b26a00; border:1px solid #f0ddc0; border-radius:10px; padding:3px 10px; font-size:12px; white-space:nowrap;">' + escA(t) + '</span>'; }
            var sf = d.situacionFamiliar || {};
            if (sf.trabaja) chips.push(chipCtx('Trabaja', 'Reportó trabajar en su entrevista inicial'));
            if (sf.embarazada) chips.push(chipCtx('Embarazada', 'Reportado en aspectos personales'));
            else if (sf.tieneHijos) {
                var esMujer = /^(M|MUJER|FEMENINO)$/i.test((d.sexo || '').trim());
                chips.push(chipCtx(esMujer ? 'Madre de familia' : 'Padre de familia', 'Reportó tener hijos en aspectos personales'));
            }
            $('#a360Chips').html(chips.join(''));
            var c = colorClasif(d.clasificacion);
            $('#a360Clasif').css({ background: c, color: '#fff' }).html(
                '<div style="font-size:1.05rem; font-weight:700;">' + escA(d.clasificacion) + '</div>' +
                '<div style="font-size:11.5px; opacity:.9;">Fuente: ' + escA(d.fuente) + '</div>');
            // Materias
            if (d.materias && d.materias.length) {
                $('#a360Materias').html('<div style="border:1px solid #eceff1; border-radius:8px; overflow:hidden;">' +
                    d.materias.map(function (m, i) {
                        var badge = m.estado === 'Extraordinario'
                            ? '<span style="background:#fff3e0; color:#b26a00; border-radius:10px; padding:2px 8px; font-size:11.5px;">Extraordinario · ' + m.intentos + ' intento' + (m.intentos === 1 ? '' : 's') + '</span>'
                            : '<span style="background:#fdecea; color:#b3402e; border-radius:10px; padding:2px 8px; font-size:11.5px;">Arrastre' + (m.intentos ? ' · ' + m.intentos + ' intento' + (m.intentos === 1 ? '' : 's') : '') + '</span>';
                        return '<div style="display:flex; justify-content:space-between; align-items:center; gap:10px; padding:6px 12px;' + (i % 2 ? ' background:#fafbfc;' : '') + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                            '<span>' + escA(m.materia) + '</span>' + badge + '</div>';
                    }).join('') + '</div>');
            } else {
                $('#a360Materias').html('<p class="text-muted" style="margin:0;">Sin materias reprobadas ni en extraordinario.</p>');
            }
            // Entrevista
            $('#a360Entrevista').html(d.entrevista
                ? '<p style="margin:0;">Capturada el <strong>' + escA(d.entrevista.fecha) + '</strong>' + (d.entrevista.vulnerable ? ' · Identificado como: <strong>' + escA(d.entrevista.vulnerable) + '</strong>' : '') + '</p>'
                : '<p class="text-muted" style="margin:0;">Sin entrevista inicial registrada.</p>');
            // Canalizaciones
            $('#a360Canalizaciones').html(d.canalizaciones && d.canalizaciones.length
                ? '<div style="border:1px solid #eceff1; border-radius:8px; overflow:hidden;">' +
                  d.canalizaciones.map(function (c, i) {
                      var st = (c.status || '').toUpperCase();
                      var colorSt = st.indexOf('ATEND') >= 0 || st.indexOf('CERRAD') >= 0 || st.indexOf('CONCLU') >= 0 ? '#00897B' : '#b26a00';
                      return '<div style="padding:7px 12px;' + (i % 2 ? ' background:#fafbfc;' : '') + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                          '<div style="display:flex; justify-content:space-between; gap:10px; align-items:center;">' +
                          '<span><span style="color:#888; font-size:12px;">' + escA(c.fecha) + '</span> · <strong>' + escA(c.tipo || 'Canalización') + '</strong></span>' +
                          (c.status ? '<span style="background:' + colorSt + '; color:#fff; border-radius:10px; padding:2px 10px; font-size:11.5px; white-space:nowrap;">' + escA(c.status) + '</span>' : '') +
                          '</div>' +
                          (c.motivo ? '<div style="font-size:12.5px; color:#607d8b;">' + escA(c.motivo) + '</div>' : '') +
                          '</div>';
                  }).join('') + '</div>'
                : '<p class="text-muted" style="margin:0;">Sin canalizaciones registradas.</p>');
            // Bajas
            $('#a360Bajas').html(d.bajas && d.bajas.length
                ? d.bajas.map(function (b) { return '<p style="margin:0 0 4px;"><span style="background:#fdecea; color:#b3402e; border-radius:10px; padding:2px 8px; font-size:11.5px;">' + escA(b.fecha) + '</span> ' + escA(b.causa || 'Sin causa registrada') + '</p>'; }).join('')
                : '<p class="text-muted" style="margin:0;">Sin bajas registradas.</p>');
            // Timeline
            if (d.seguimientos && d.seguimientos.length) {
                $('#a360Timeline').html(d.seguimientos.map(function (s) {
                    var c2 = colorClasif(s.vulnerabilidad);
                    return '<div style="position:relative; padding:0 0 14px 18px; border-left:2px solid #e0e5e9;">' +
                        '<span style="position:absolute; left:-6px; top:2px; width:10px; height:10px; border-radius:50%; background:' + c2 + ';"></span>' +
                        '<div style="font-size:12px; color:#888;">' + escA(s.fecha) + (s.vulnerabilidad ? ' · <strong style="color:' + c2 + ';">' + escA(s.vulnerabilidad) + '</strong>' : '') + '</div>' +
                        (s.problematica ? '<div style="font-size:13px; color:#374151;">' + escA(s.problematica) + '</div>' : '') +
                        (s.accion ? '<div style="font-size:12px; color:#607d8b;">Acción: ' + escA(s.accion) + '</div>' : '') +
                        '</div>';
                }).join(''));
            } else {
                $('#a360Timeline').html('<p class="text-muted" style="margin:0;">Sin seguimientos capturados.</p>');
            }
            mostrar('a360Ficha');
            $('#a360BtnImprimir').show();
        }
        // Imprimir SOLO la ficha: se marca el body y el CSS @@media print oculta el resto.
        $('#a360BtnImprimir').on('click', function () {
            document.body.classList.add('imprimiendo-ficha360');
            window.print();
        });
        window.addEventListener('afterprint', function () { document.body.classList.remove('imprimiendo-ficha360'); });
        function cargarFicha(idPersona) {
            mostrar('a360Cargando');
            $.post('@Url.Action("GetAlumno360", "NuevasEstadisticas")', { idPersona: idPersona }, function (r) {
                if (!r || !r.success) { mostrar('a360Error'); $('#a360Error').text((r && r.error) || 'No se pudo cargar la ficha.'); return; }
                pintarFicha(r.data);
            }, 'json').fail(function () { mostrar('a360Error'); $('#a360Error').text('Error de conexión al cargar la ficha.'); });
        }
        function buscar() {
            // Si la seccion esta colapsada, expandirla: el buscador vive en el header y el
            // resultado quedaria oculto.
            var $chev = $('#seccionAlumno360.dash-colapsada .dash-chevron');
            if ($chev.length) $chev.trigger('click');
            var q = ($('#a360Buscar').val() || '').trim();
            if (q.length < 3) { mostrar('a360Error'); $('#a360Error').text('Escribe al menos 3 caracteres de la matrícula o el nombre.'); return; }
            mostrar('a360Cargando');
            $.post('@Url.Action("BuscarAlumno360", "NuevasEstadisticas")', { q: q }, function (r) {
                if (!r || !r.success) { mostrar('a360Error'); $('#a360Error').text((r && r.error) || 'Error al buscar.'); return; }
                var lista = r.data || [];
                if (!lista.length) { mostrar('a360Error'); $('#a360Error').text('Sin coincidencias para "' + q + '".'); return; }
                if (lista.length === 1) { cargarFicha(lista[0].idPersona); return; }
                $('#a360Sugerencias').html('<p style="margin:0 0 8px; color:#607d8b;">Se encontraron ' + lista.length + ' coincidencias, elige una:</p>' +
                    '<div style="border:1px solid #eceff1; border-radius:8px; overflow:hidden;">' +
                    lista.map(function (a, i) {
                        return '<div class="a360-sug" data-id="' + a.idPersona + '" style="display:flex; justify-content:space-between; gap:12px; padding:8px 12px; cursor:pointer;' + (i % 2 ? ' background:#fafbfc;' : '') + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                            '<span>' + escA(a.nombre) + ' <small class="text-muted">(' + escA(a.matricula) + ')</small></span><span class="text-muted">' + escA(a.carrera) + '</span></div>';
                    }).join('') + '</div>');
                mostrar('a360Sugerencias');
            }, 'json').fail(function () { mostrar('a360Error'); $('#a360Error').text('Error de conexión al buscar.'); });
        }
        $('#a360BtnBuscar').on('click', buscar);
        $('#a360Buscar').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); buscar(); } });

        // ===== MINI-FICHA FLOTANTE (arrastrable y redimensionable, estilo mini-player) =====
        var $mini = $('#mini360');
        // Redimensionable con resize:both; al cerrar vuelve al tamaño por defecto.
        var miniResetSize = (function () {
            var panel = document.getElementById('mini360'), cuerpo = document.getElementById('mini360Cuerpo');
            var defW = panel.style.width, defH = panel.style.height;
            if (window.ResizeObserver) {
                new ResizeObserver(function () {
                    // Si el usuario cambió el tamaño, soltar el tope del cuerpo para que el contenido crezca.
                    if (panel.style.width !== defW || panel.style.height !== defH) cuerpo.style.maxHeight = 'none';
                }).observe(panel);
            }
            return function () { panel.style.width = defW; panel.style.height = defH; cuerpo.style.maxHeight = '52vh'; };
        })();
        function abrirMini() { $mini.css('display', 'flex'); $('#mini360Buscar').focus(); }
        function cerrarMini() { $mini.hide(); miniResetSize(); }
        $('#fab360').on('click', function () { if ($mini.is(':visible')) cerrarMini(); else abrirMini(); });
        $('#mini360Cerrar').on('click', cerrarMini);
        // Arrastre: se toma del encabezado; el panel pasa a coordenadas left/top libres.
        (function () {
            var panel = document.getElementById('mini360'), handle = document.getElementById('mini360Handle');
            var arrastrando = false, sx = 0, sy = 0, px = 0, py = 0;
            handle.addEventListener('mousedown', function (e) {
                if (e.target.closest('button')) return;
                arrastrando = true; sx = e.clientX; sy = e.clientY;
                var rect = panel.getBoundingClientRect(); px = rect.left; py = rect.top;
                e.preventDefault();
            });
            document.addEventListener('mousemove', function (e) {
                if (!arrastrando) return;
                var nl = px + e.clientX - sx, nt = py + e.clientY - sy;
                nl = Math.max(0, Math.min(window.innerWidth - 80, nl));
                nt = Math.max(0, Math.min(window.innerHeight - 46, nt));
                panel.style.left = nl + 'px'; panel.style.top = nt + 'px';
                panel.style.right = 'auto'; panel.style.bottom = 'auto';
            });
            document.addEventListener('mouseup', function () { arrastrando = false; });
        })();
        function miniMsg(html) { $('#mini360Cuerpo').html(html); }
        function pintarMini(d) {
            var c = colorClasif(d.clasificacion);
            var rep = 0, ext = 0;
            (d.materias || []).forEach(function (m) { if (m.estado === 'Extraordinario') ext++; else rep++; });
            var ult = (d.seguimientos || []).slice(0, 3);
            miniMsg(
                '<div style="font-weight:700; color:#1f2937;">' + escA(d.nombre) + '</div>' +
                '<div style="color:#888; font-size:12px; margin-bottom:6px;">' + escA(d.matricula) + ' · ' + escA(d.carrera) + (d.grupo ? ' · Grupo ' + escA(d.grupo) : '') + '</div>' +
                '<div style="background:' + c + '; color:#fff; border-radius:8px; padding:5px 10px; display:inline-block; margin-bottom:8px;">' +
                '<strong>' + escA(d.clasificacion) + '</strong> <span style="font-size:11px; opacity:.9;">(' + escA(d.fuente) + ')</span></div>' +
                '<div style="margin-bottom:6px;"><i class="fas fa-user-tie" style="color:#607d8b; width:16px;"></i> ' + (d.tutor ? escA(d.tutor) : '<span class="text-muted">Sin tutor asignado</span>') + '</div>' +
                '<div style="margin-bottom:6px;"><i class="fas fa-book" style="color:#607d8b; width:16px;"></i> ' +
                ((rep + ext) ? (rep + ' en arrastre · ' + ext + ' en extraordinario') : 'Sin materias reprobadas') + '</div>' +
                ((d.bajas && d.bajas.length) ? '<div style="margin-bottom:6px;"><i class="fas fa-user-slash" style="color:#b3402e; width:16px;"></i> Baja: ' + escA(d.bajas[0].fecha) + ' (' + escA(d.bajas[0].causa || 'sin causa') + ')</div>' : '') +
                ((d.canalizaciones && d.canalizaciones.length) ? '<div style="margin-bottom:6px;"><i class="fas fa-hand-holding-heart" style="color:#607d8b; width:16px;"></i> ' + d.canalizaciones.length + ' canalización' + (d.canalizaciones.length === 1 ? '' : 'es') + ' (últ. ' + escA(d.canalizaciones[0].fecha) + ')</div>' : '') +
                (ult.length ? ('<div style="margin-top:8px; font-weight:600; color:#455a64; font-size:12px;">Últimos seguimientos</div>' +
                    ult.map(function (s) {
                        return '<div style="border-left:2px solid ' + colorClasif(s.vulnerabilidad) + '; padding:2px 0 2px 8px; margin-top:4px;">' +
                            '<span style="color:#888; font-size:11.5px;">' + escA(s.fecha) + '</span>' + (s.vulnerabilidad ? ' · <strong style="font-size:11.5px; color:' + colorClasif(s.vulnerabilidad) + ';">' + escA(s.vulnerabilidad) + '</strong>' : '') +
                            (s.problematica ? '<div style="font-size:12px; color:#374151;">' + escA(s.problematica).slice(0, 140) + '</div>' : '') + '</div>';
                    }).join('')) : '<div class="text-muted" style="font-size:12px; margin-top:6px;">Sin seguimientos capturados.</div>') +
                '<button type="button" class="btn btn-utt-outline btn-sm" id="mini360VerCompleta" data-id="' + d.idPersona + '" style="margin-top:10px; width:100%;"><i class="fas fa-id-card me-1"></i> Ver ficha completa</button>'
            );
        }
        function miniCargar(idPersona) {
            miniMsg('<p class="text-muted" style="margin:0;"><i class="fas fa-spinner fa-spin"></i> Cargando...</p>');
            $.post('@Url.Action("GetAlumno360", "NuevasEstadisticas")', { idPersona: idPersona }, function (r) {
                if (!r || !r.success) { miniMsg('<p style="color:#b3402e; margin:0;">' + escA((r && r.error) || 'No se pudo cargar.') + '</p>'); return; }
                pintarMini(r.data);
            }, 'json').fail(function () { miniMsg('<p style="color:#b3402e; margin:0;">Error de conexión.</p>'); });
        }
        function miniBuscar() {
            var q = ($('#mini360Buscar').val() || '').trim();
            if (q.length < 3) { miniMsg('<p style="color:#b26a00; margin:0;">Escribe al menos 3 caracteres.</p>'); return; }
            miniMsg('<p class="text-muted" style="margin:0;"><i class="fas fa-spinner fa-spin"></i> Buscando...</p>');
            $.post('@Url.Action("BuscarAlumno360", "NuevasEstadisticas")', { q: q }, function (r) {
                if (!r || !r.success) { miniMsg('<p style="color:#b3402e; margin:0;">' + escA((r && r.error) || 'Error al buscar.') + '</p>'); return; }
                var lista = r.data || [];
                if (!lista.length) { miniMsg('<p class="text-muted" style="margin:0;">Sin coincidencias para "' + escA(q) + '".</p>'); return; }
                if (lista.length === 1) { miniCargar(lista[0].idPersona); return; }
                miniMsg(lista.map(function (a, i) {
                    return '<div class="mini360-sug" data-id="' + a.idPersona + '" style="padding:6px 8px; cursor:pointer; border-radius:6px;' + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                        escA(a.nombre) + ' <small class="text-muted">(' + escA(a.matricula) + ' · ' + escA(a.carrera) + ')</small></div>';
                }).join(''));
            }, 'json').fail(function () { miniMsg('<p style="color:#b3402e; margin:0;">Error de conexión.</p>'); });
        }
        $('#mini360BtnBuscar').on('click', miniBuscar);
        $('#mini360Buscar').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); miniBuscar(); } });
        $('#mini360Cuerpo').on('click', '.mini360-sug', function () { miniCargar($(this).data('id')); });
        // Para que la ficha del tutor pueda abrir la mini-ficha de un alumno de su detalle.
        window.Alumno360Mini = {
            abrirCon: function (idPersona) { $mini.css('display', 'flex'); miniCargar(idPersona); },
            // Por matrícula (los modales del dashboard solo traen matrícula): resuelve el id con el buscador.
            abrirPorMatricula: function (matricula) {
                if (!matricula) return;
                $mini.css('display', 'flex');
                miniMsg('<p class="text-muted" style="margin:0;"><i class="fas fa-spinner fa-spin"></i> Cargando...</p>');
                $.post('@Url.Action("BuscarAlumno360", "NuevasEstadisticas")', { q: matricula }, function (r) {
                    var lista = (r && r.success && r.data) || [];
                    var exacto = lista.filter(function (a) { return (a.matricula || '').toUpperCase() === String(matricula).trim().toUpperCase(); });
                    var elegido = exacto.length ? exacto[0] : (lista.length ? lista[0] : null);
                    if (!elegido) { miniMsg('<p class="text-muted" style="margin:0;">No se encontró al alumno ' + escA(matricula) + '.</p>'); return; }
                    miniCargar(elegido.idPersona);
                }, 'json').fail(function () { miniMsg('<p style="color:#b3402e; margin:0;">Error de conexión.</p>'); });
            }
        };
        // Conector universal: cualquier elemento .abrir-mini360 con data-matricula (modal de
        // vulnerabilidad, modal del alumno reprobado, modal del tutor) abre la mini-ficha.
        $(document).on('click', '.abrir-mini360', function () {
            window.Alumno360Mini.abrirPorMatricula($(this).data('matricula'));
        });
        // ===== Buscador flotante de TUTORES (abre la ficha del tutor al elegir) =====
        var $miniT = $('#miniT360');
        $('#fabTutor360').on('click', function () {
            $miniT.toggle();
            if ($miniT.is(':visible')) $('#miniT360Buscar').focus();
        });
        $('#miniT360Cerrar').on('click', function () { $miniT.hide(); });
        function miniTMsg(html) { $('#miniT360Cuerpo').html(html); }
        function miniTBuscar() {
            var q = ($('#miniT360Buscar').val() || '').trim();
            if (q.length < 3) { miniTMsg('<p style="color:#b26a00; margin:0;">Escribe al menos 3 letras del nombre.</p>'); return; }
            miniTMsg('<p class="text-muted" style="margin:0;"><i class="fas fa-spinner fa-spin"></i> Buscando...</p>');
            $.post('@Url.Action("BuscarTutor360", "NuevasEstadisticas")', { q: q }, function (r) {
                if (!r || !r.success) { miniTMsg('<p style="color:#b3402e; margin:0;">' + escA((r && r.error) || 'Error al buscar.') + '</p>'); return; }
                var lista = r.data || [];
                if (!lista.length) { miniTMsg('<p class="text-muted" style="margin:0;">Sin tutores con grupo este periodo para "' + escA(q) + '".</p>'); return; }
                if (lista.length === 1 && window.abrirTutor360) { window.abrirTutor360(lista[0].idUsuario); $miniT.hide(); return; }
                miniTMsg(lista.map(function (t, i) {
                    return '<div class="miniT360-sug" data-id="' + t.idUsuario + '" style="padding:6px 8px; cursor:pointer; border-radius:6px;' + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                        escA(t.nombre) + ' <small class="text-muted">(' + escA(t.carrera) + ')</small></div>';
                }).join(''));
            }, 'json').fail(function () { miniTMsg('<p style="color:#b3402e; margin:0;">Error de conexión.</p>'); });
        }
        $('#miniT360BtnBuscar').on('click', miniTBuscar);
        $('#miniT360Buscar').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); miniTBuscar(); } });
        $('#miniT360Cuerpo').on('click', '.miniT360-sug', function () {
            if (window.abrirTutor360) { window.abrirTutor360($(this).data('id')); $miniT.hide(); }
        });
        $('#miniT360Cuerpo').on('mouseenter', '.miniT360-sug', function () { $(this).css('background', '#eef3f7'); })
                            .on('mouseleave', '.miniT360-sug', function () { $(this).css('background', ''); });
        $('#mini360Cuerpo').on('mouseenter', '.mini360-sug', function () { $(this).css('background', '#eef3f7'); })
                           .on('mouseleave', '.mini360-sug', function () { $(this).css('background', ''); });
        // "Ver ficha completa": carga la seccion grande y baja hasta ella.
        $('#mini360Cuerpo').on('click', '#mini360VerCompleta', function () {
            var id = $(this).data('id');
            var $chev = $('#seccionAlumno360.dash-colapsada .dash-chevron');
            if ($chev.length) $chev.trigger('click');
            cargarFicha(id);
            document.getElementById('seccionAlumno360').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        $('#a360Sugerencias').on('click', '.a360-sug', function () { cargarFicha($(this).data('id')); });
        $('#a360Sugerencias').on('mouseenter', '.a360-sug', function () { $(this).css('background', '#eef3f7'); })
                             .on('mouseleave', '.a360-sug', function (e) { $(this).css('background', $(this).index() % 2 ? '#fafbfc' : ''); });
    });
</script>
}
