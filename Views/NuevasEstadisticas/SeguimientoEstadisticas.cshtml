    <script>
        $(function () {
            // Resumen server-side (Demografia / Situacion Familiar) y Vulnerabilidad:
            // reusan el snapshot ResumenGlobal via GetEstadisticasPorEspecialidad(corteId) y
            // las funciones de render existentes (actualizarResumenDetallado / actualizarVulnerabilidades).
            function cargarResumenHist(corteId) {
                var dataHist = { corteId: corteId || null };
                window._vulnParamsActuales = dataHist;
                // Los filtros nuevos (grado/grupo) solo operan EN VIVO: los snapshots guardan agregados.
                $('#gradoFiltroResumen, #grupoFiltroResumen')
                    .prop('disabled', !!corteId)
                    .attr('title', corteId ? 'Filtros disponibles solo en vivo (viendo un corte histórico solo hay totales)' : '');
                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataHist,
                    success: function (r) { if (r && r.success) window.actualizarResumenDetallado(r.data); }
                });
            }
            function cargarVulnerabilidadHist(corteId) {
                var dataVulnHist = { corteId: corteId || null };
                window._vulnParamsActuales = dataVulnHist;
                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataVulnHist,
                    success: function (r) { if (r && r.success) window.actualizarVulnerabilidades(r.data); }
                });
            }
            initHistoricoSeccion({
                btn: '#btnHistResumen', menu: '#menuHistResumen', rotulo: '#rotuloHistResumen',
                onCorte: function (c) { cargarResumenHist(c.idCorte); },
                onVivo: function () { cargarResumenHist(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistVulnerabilidad', menu: '#menuHistVulnerabilidad', rotulo: '#rotuloHistVulnerabilidad',
                onCorte: function (c) { cargarVulnerabilidadHist(c.idCorte); },
                onVivo: function () { cargarVulnerabilidadHist(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistBajas', menu: '#menuHistBajas', rotulo: '#rotuloHistBajas',
                onCorte: function (c) { cargarBajas(c.idCorte); },
                onVivo: function () { renderBajas(window._bajasServerData); }
            });
            initHistoricoSeccion({
                btn: '#btnHistNivel', menu: '#menuHistNivel', rotulo: '#rotuloHistNivel',
                onCorte: function (c) { cargarNivelEstudio(c.idCorte); },
                onVivo: function () { cargarNivelEstudio(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistCierre', menu: '#menuHistCierre', rotulo: '#rotuloHistCierre',
                onCorte: function (c) { cargarEstadisticasCierreCuatrimestres(c.idCorte); },
                onVivo: function () { cargarEstadisticasCierreCuatrimestres(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistCarrera', menu: '#menuHistCarrera', rotulo: '#rotuloHistCarrera',
                onCorte: function (c) { cargarCarreras(c.idCorte); },
                onVivo: function () { cargarCarreras(null); }
            });
            initHistoricoSeccion({
                btn: '#btnHistGrupo', menu: '#menuHistGrupo', rotulo: '#rotuloHistGrupo',
                onCorte: function (c) { cargarEstadisticasGrupos(c.idCorte); },
                onVivo: function () { cargarEstadisticasGrupos(null); }
            });

            // Materias reprobadas (requerimiento dirección): agregado por materia + alumnos en vivo
            // Filtro por carrera (requerimiento profe 2026-07-14). Máster: select; nivel 3: fijo.
            var carreraFijaMaterias = '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.CarreraNombreMateriasNivel3 as string ?? ""))'.trim().toUpperCase();
            var corteMateriasActual = null;
            function nombreCarreraFiltroMaterias() {
                var $sel = $('#carreraFiltroMaterias');
                if ($sel.length) { // Máster
                    var $opt = $sel.find('option:selected');
                    return ($sel.val() ? ($opt.data('nombre') || $opt.text()) : '').trim().toUpperCase();
                }
                return carreraFijaMaterias; // nivel 3 (o '' para otros roles)
            }
            var chartMaterias = null;
            // Top-10 de materias (apilada arrastre/extraordinario). Extraida de cargarMaterias para que
            // el framework de modos pueda re-dibujarla al cambiar a Graficas (un canvas oculto al
            // momento del draw queda en blanco).
            window.renderMateriasTop10 = function (materias) {
                var el = document.getElementById('chartMaterias');
                if (!el || typeof Chart === 'undefined' || !materias || !materias.length) return;
                var top = materias.slice(0, 10);
                if (chartMaterias) chartMaterias.destroy();
                chartMaterias = new Chart(el, {
                    type: 'bar',
                    data: {
                        labels: top.map(function (m) { return m.nombreMateria; }),
                        datasets: [
                            { label: 'Reprobadas (arrastre)', data: top.map(function (m) { return m.reprobadas; }), backgroundColor: '#b3402e' },
                            { label: 'Extraordinario', data: top.map(function (m) { return m.extraordinarios; }), backgroundColor: '#dba13a' }
                        ]
                    },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } } }
                });
            };
            window.cargarMaterias = function (corteId, _retry) {
                corteMateriasActual = corteId || null;
                // Filtros de la seccion (solo en vivo; el snapshot historico es agregado).
                $('#especialidadFiltroMaterias, #materiaFiltroMaterias, #estadoFiltroMaterias, #intentosFiltroMaterias, #gradoFiltroMaterias, #grupoFiltroMaterias').prop('disabled', !!corteId)
                    .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
                $.ajax({
                    url: '@Url.Action("GetEstadisticasMaterias", "NuevasEstadisticas")',
                    type: 'POST',
                    data: {
                        corteId: corteId || null,
                        carreraId: (!corteId && $('#carreraFiltroMaterias').length) ? ($('#carreraFiltroMaterias').val() || null) : null,
                        especialidadId: (corteId ? null : ($('#especialidadFiltroMaterias').val() || null)),
                        materiaNombre: (corteId ? null : ($('#materiaFiltroMaterias').val() || null)),
                        estado: (corteId ? null : ($('#estadoFiltroMaterias').val() || null)),
                        intentos: (corteId ? null : ($('#intentosFiltroMaterias').val() || null)),
                        gradoId: (corteId ? null : ($('#gradoFiltroMaterias').val() || null)),
                        grupoId: (corteId ? null : ($('#grupoFiltroMaterias').val() || null)),
                        agruparPor: ($('#agruparPorMaterias').length && !corteId) ? ($('#agruparPorMaterias').val() || 'materia') : 'materia'
                    },
                    success: function (r) {
                        // 2026-08-01: la seccion Materias se elimino de la vista; este AJAX se conserva
                        // SOLO porque los listeners globales ajaxSuccess (KPIs del Resumen General y
                        // Hallazgos Clave) consumen su respuesta. Sin DOM propio, no hay nada que pintar.
                        if (!document.getElementById('tablaMaterias')) return;
                        var $nd = $('#materiasNoDisponible'), $tb = $('#tablaMaterias tbody');
                        if (!r || !r.success) {
                            $tb.empty();
                            if (chartMaterias) { chartMaterias.destroy(); chartMaterias = null; }
                            $nd.toggle(!!(r && r.noDisponible));
                            $('#tablaMaterias').toggle(!(r && r.noDisponible));
                            if (!(r && r.noDisponible)) console.error('GetEstadisticasMaterias:', r && r.error);
                            return;
                        }
                        $nd.hide();
                        $('#tablaMaterias').show();
                        var d = r.data, materias = d.materias || [];
                        var modoCarrera = (d.agruparPor === 'carrera');
                        // Modo carrera: renombrar cabecera Materia→Carrera, ocultar col Carrera (queda vacía)
                        var $thMateria = $('#tablaMaterias thead tr th:eq(0)');
                        var $thCarrera = $('#tablaMaterias thead tr th:eq(1)');
                        if (modoCarrera) {
                            $thMateria.text('Carrera');
                            $thCarrera.hide();
                        } else {
                            $thMateria.text('Materia');
                            $thCarrera.show();
                        }
                        if (window.ModoEstadisticas) ModoEstadisticas.datos('materiasTabla', materias);
                        // En histórico el snapshot es global: filtrar client-side por nombre de carrera.
                        var nombreFiltro = corteId ? nombreCarreraFiltroMaterias() : '';
                        if (nombreFiltro) {
                            materias = materias.filter(function (m) {
                                return ((m.carreraNombre || '').trim().toUpperCase()) === nombreFiltro;
                            });
                        }
                        // 2026-07-29: se elimino el subtitulo "Materias con reprobacion / Alumnos afectados"
                        // (la directora no lo entendia).

                        window.renderMateriasTop10(materias);

                        $tb.empty();
                        materias.forEach(function (m, i) {
                            var tieneAlumnos = (!modoCarrera && m.alumnos && m.alumnos.length > 0);
                            var textoBuscar = ((m.nombreMateria || '') + ' ' + (m.carreraNombre || '')).toLowerCase();
                            var tdCarrera = modoCarrera ? '<td style="display:none;">' + (m.carreraNombre || '') + '</td>' : '<td>' + (m.carreraNombre || '') + '</td>';
                            var fila = '<tr class="fila-materia" data-idx="' + i + '" data-buscar="' + textoBuscar.replace(/"/g, '') + '">' +
                                '<td>' + m.nombreMateria + '</td>' +
                                tdCarrera +
                                '<td class="text-center"><span class="badge bg-dark">' + m.alumnosDistintos + '</span></td>' +
                                '<td class="text-center">' + m.reprobadas + '</td>' +
                                '<td class="text-center">' + m.extraordinarios + '</td>' +
                                '<td class="text-center">' + m.intentos1 + '</td>' +
                                '<td class="text-center">' + m.intentos2 + '</td>' +
                                '<td class="text-center">' + m.intentos3Mas + '</td>' +
                                '<td>' + (tieneAlumnos ? '<button type="button" class="btn btn-default btn-xs btn-ver-alumnos" data-idx="' + i + '">Ver alumnos</button>' : '') + '</td>' +
                                '</tr>';
                            if (tieneAlumnos) {
                                var detalle = m.alumnos.map(function (a) {
                                    return '<tr><td>' + a.matricula + '</td><td>' + (a.nombreAlumno || '') + '</td><td>' + a.estado + '</td><td class="text-center">' + a.intentos + '</td></tr>';
                                }).join('');
                                fila += '<tr class="fila-alumnos" id="alumnosMateria' + i + '" style="display:none;"><td colspan="9">' +
                                    '<table class="table table-condensed" style="margin:0;"><thead><tr><th>Matrícula</th><th>Alumno</th><th>Estado</th><th class="text-center">Intentos</th></tr></thead><tbody>' +
                                    detalle + '</tbody></table></td></tr>';
                            }
                            $tb.append(fila);
                        });
                        $tb.off('click', '.btn-ver-alumnos').on('click', '.btn-ver-alumnos', function () {
                            $('#alumnosMateria' + $(this).data('idx')).toggle();
                        });

                        // Filtro por materia/carrera (la tabla vive en un contenedor con scroll propio)
                        function aplicarFiltroMaterias() {
                            var q = ($('#filtroMaterias').val() || '').toLowerCase().trim();
                            var visibles = 0;
                            $tb.find('tr.fila-materia').each(function () {
                                var coincide = !q || ($(this).data('buscar') || '').indexOf(q) >= 0;
                                $(this).toggle(coincide);
                                if (coincide) visibles++;
                                // El detalle de alumnos se oculta siempre al filtrar (se reabre con el botón)
                                $('#alumnosMateria' + $(this).data('idx')).hide();
                            });
                            $('#materiasFiltroInfo').text(q ? ('Mostrando ' + visibles + ' de ' + materias.length + ' materias') : '');
                        }
                        $('#filtroMaterias').off('input').on('input', aplicarFiltroMaterias);
                        aplicarFiltroMaterias();
                        $('#wrapTablaMaterias').scrollTop(0);
                    },
                    error: function () {
                        if (!_retry) { setTimeout(function () { window.cargarMaterias(corteId, true); }, 1500); return; }
                        console.error('Error al cargar estadísticas de materias');
                    }
                });
            };
            window.cargarMaterias(null);
            $('#carreraFiltroMaterias').on('change', function () { window.cargarMaterias(corteMateriasActual); });
            $('#especialidadFiltroMaterias, #materiaFiltroMaterias, #estadoFiltroMaterias, #intentosFiltroMaterias, #gradoFiltroMaterias, #grupoFiltroMaterias').on('change', function () { window.cargarMaterias(corteMateriasActual); });
            $('#agruparPorMaterias').on('change', function () {
                // En modo carrera, los filtros por materia/especialidad no aplican — deshabilitarlos visualmente
                var esCarrera = $(this).val() === 'carrera';
                $('#materiaFiltroMaterias, #especialidadFiltroMaterias').prop('disabled', esCarrera)
                    .attr('title', esCarrera ? 'No aplica en modo Carrera' : '');
                window.cargarMaterias(corteMateriasActual);
            });
            initHistoricoSeccion({
                btn: '#btnHistMaterias', menu: '#menuHistMaterias', rotulo: '#rotuloHistMaterias',
                onCorte: function (c) { window.cargarMaterias(c.idCorte); },
                onVivo: function () { window.cargarMaterias(null); }
            });
        });
    </script>
    <script>
        // Comparativo entre cuatrimestres
        $(function () {
            var $c1 = $('#selComparativoC1'), $c2 = $('#selComparativoC2'), $tb = $('#tbodyComparativo');
            if (!$c1.length || typeof cargarCortesHist !== 'function') return;

            function cargarComparativo() {
                var id1 = $c1.val(), id2 = $c2.val();
                if (!id1 || !id2) return;
                $('#thComparativoC1').text($c1.find('option:selected').text());
                $('#thComparativoC2').text($c2.find('option:selected').text());
                $tb.html('<tr><td colspan="4" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando...</td></tr>');
                $.ajax({
                    url: '@Url.Action("GetComparativoCortes", "NuevasEstadisticas")',
                    type: 'POST',
                    data: { idCorte1: id1, idCorte2: id2 },
                    success: function (r) {
                        if (!r || !r.success) { $tb.html('<tr><td colspan="4" class="text-center text-danger">Error al cargar el comparativo.</td></tr>'); return; }
                        if (window.ModoEstadisticas) ModoEstadisticas.datos('comparativo', { filas: r.filas, n1: $c1.find('option:selected').text(), n2: $c2.find('option:selected').text() });
                        var html = r.filas.map(function (f) {
                            var varHtml;
                            if (f.variacion === null || f.variacion === undefined) {
                                varHtml = '<span class="text-muted">—</span>';
                            } else {
                                var flecha = f.c2 > f.c1 ? '▲' : (f.c2 < f.c1 ? '▼' : '=');
                                var signo = f.variacion > 0 ? '+' : '';
                                var clase = f.mejora === true ? 'text-success' : (f.mejora === false ? 'text-danger' : 'text-muted');
                                varHtml = '<span class="' + clase + '">' + flecha + ' ' + signo + f.variacion.toFixed(1) + '%</span>';
                            }
                            return '<tr><td class="fw-bold">' + f.indicador + '</td>' +
                                   '<td class="text-center">' + f.c1 + '</td>' +
                                   '<td class="text-center">' + f.c2 + '</td>' +
                                   '<td class="text-center">' + varHtml + '</td></tr>';
                        }).join('');
                        $tb.html(html);
                    },
                    error: function () { $tb.html('<tr><td colspan="4" class="text-center text-danger">Error de conexión.</td></tr>'); }
                });
            }

            cargarCortesHist(function (cortes) {
                if (!cortes || cortes.length < 2) {
                    $c1.add($c2).prop('disabled', true);
                    $tb.html('<tr><td colspan="4" class="text-center text-muted py-3">Se necesitan al menos 2 cortes para comparar.</td></tr>');
                    return;
                }
                var opts = cortes.map(function (c) { return '<option value="' + c.idCorte + '">' + c.nombre + ' (' + c.fecha + ')</option>'; }).join('');
                $c1.html(opts); $c2.html(opts);
                $c2.val(cortes[0].idCorte);
                $c1.val(cortes[1].idCorte);
                cargarComparativo();
            });
            $c1.add($c2).on('change', cargarComparativo);
            $('#btnDescargarPdfComparativo').on('click', function () {
                var id1 = $c1.val(), id2 = $c2.val();
                if (!id1 || !id2) { alert('Selecciona dos cuatrimestres.'); return; }
                window.location = '@Url.Action("DescargarPdfEjecutivo", "NuevasEstadisticas")' + '?idCorte1=' + id1 + '&idCorte2=' + id2;
            });
        });
    </script>
    <script>
        // Dashboard de tendencias entre cuatrimestres
        $(function () {
            if (!document.getElementById('tendPoblacion')) return;
            $.ajax({
                url: '@Url.Action("GetTendenciasCortes", "NuevasEstadisticas")',
                type: 'POST',
                success: function (r) {
                    if (!r || !r.success) { $('#tendMensaje').text('Error al cargar las tendencias.').show(); $('#tendGraficas').hide(); return; }
                    if (!r.labels || r.labels.length < 2) {
                        $('#tendMensaje').text('Se necesitan al menos 2 cortes para ver tendencias.').show();
                        $('#tendGraficas').hide();
                        return;
                    }
                    var s = r.series;
                    function linea(label, data, color) {
                        return { label: label, data: data, borderColor: color, backgroundColor: color, tension: 0.2, fill: false, pointRadius: 3 };
                    }
                    function crear(id, datasets) {
                        var prev = (Chart.getChart ? Chart.getChart(document.getElementById(id)) : null);
                        if (prev) prev.destroy();
                        return new Chart(document.getElementById(id).getContext('2d'), {
                            type: 'line',
                            data: { labels: r.labels, datasets: datasets },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
                        });
                    }
                    crear('tendPoblacion', [ linea('Total estudiantes', s.totalEstudiantes, '#009688') ]);
                    crear('tendVulnerabilidad', [
                        linea('Económicos', s.vulnerablesEconomicos, '#dc3545'),
                        linea('Académicos', s.vulnerablesAcademicos, '#fd7e14'),
                        linea('Personales', s.vulnerablesPersonales, '#6c757d')
                    ]);
                    crear('tendSeguimiento', [
                        linea('No vulnerables', s.noVulnerables, '#198754'),
                        linea('Sin seguimiento', s.sinSeguimiento, '#0d6efd')
                    ]);
                    crear('tendBajas', [ linea('Total de bajas', s.TotalBajas, '#dc3545') ]);
                    crear('tendSitFam', [
                        linea('Embarazadas', s.embarazadas, '#b56d8e'),
                        linea('Madres', s.madres, '#74628f'),
                        linea('Padres', s.padres, '#1f4e5f'),
                        linea('Trabajando', s.alumnosTrabajando, '#dba13a')
                    ]);
                    (function () {
                        var datosRep = s.tasaReprobacionx10.map(function (v) { return v < 0 ? null : v / 10; });
                        var prev = (Chart.getChart ? Chart.getChart(document.getElementById('tendReprobacion')) : null);
                        if (prev) prev.destroy();
                        new Chart(document.getElementById('tendReprobacion').getContext('2d'), {
                            type: 'line',
                            data: { labels: r.labels, datasets: [{ label: 'Tasa de reprobación', data: datosRep, borderColor: '#b3402e', backgroundColor: '#b3402e', tension: 0.2, fill: false, pointRadius: 3, spanGaps: false }] },
                            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom' }, tooltip: { callbacks: { label: function (ctx) { return ctx.parsed.y !== null ? ctx.parsed.y.toFixed(1) + '%' : 'Sin datos'; } } } }, scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return v + '%'; } } } } }
                        });
                    })();
                },
                error: function () { $('#tendMensaje').text('Error de conexión al cargar las tendencias.').show(); $('#tendGraficas').hide(); }
            });
        });
    </script>
    <script>
        // Cascada carrera -> especialidad (2026-07-29). Compara por TEXTO normalizado porque
        // los selects de carrera usan 2 espacios de IDs (area vs Tutorias) pero los nombres coinciden.
        (function () {
            function normTxt(s) {
                return (s || '').toString().normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toUpperCase();
            }
            window.initCascadaEspecialidad = function (carreraSelId, espSelId) {
                var $car = $(carreraSelId), $esp = $(espSelId);
                if (!$car.length || !$esp.length) return;
                $car.on('change', function () {
                    var carNombre = normTxt($car.find('option:selected').text());
                    var esTodas = !$car.val();
                    var limpiado = false;
                    $esp.find('option').each(function () {
                        var $o = $(this);
                        if (!$o.attr('value')) { $o.show(); return; } // "Todas"
                        var visible = esTodas || normTxt($o.data('carrera')) === carNombre;
                        $o.toggle(visible);
                        if (!visible && $o.is(':selected')) { $esp.val(''); limpiado = true; }
                    });
                    if (limpiado) $esp.trigger('change');
                });
            };
            $(function () {
                window.initCascadaEspecialidad('#carreraFiltroResumen', '#especialidadFiltro');
                window.initCascadaEspecialidad('#carreraFiltroNivel', '#especialidadFiltroNivel');
                window.initCascadaEspecialidad('#carreraFiltroCierre', '#especialidadFiltroCierre');
                window.initCascadaEspecialidad('#carreraFiltro', '#especialidadFiltroGrupos');
                window.initCascadaEspecialidad('#carreraFiltroMaterias', '#especialidadFiltroMaterias');
                window.initCascadaEspecialidad('#carreraFiltroBajas', '#especialidadFiltroBajas');
            });
        })();
    </script>
<script>
    // ===== REPROBADOS / EXTRAORDINARIOS / tabla de alumnos (2026-07-29) =====
    // 1 POST a GetReprobadosDetalle; las 8 graficas top-10 y la tabla se derivan client-side.
    $(function () {
        var GRADOS = {};
        var GRUPOS = {};
        @if (ViewBag.FiltroGrados != null) { foreach (var gd in (Dictionary<int, string>)ViewBag.FiltroGrados) { @:GRADOS[@gd.Key] = '@Html.Raw(HttpUtility.JavaScriptStringEncode(gd.Value))';
        } }
        @if (ViewBag.FiltroGrupos != null) { foreach (var gu in (Dictionary<int, string>)ViewBag.FiltroGrupos) { @:GRUPOS[@gu.Key] = '@Html.Raw(HttpUtility.JavaScriptStringEncode(gu.Value))';
        } }

        var chartsRD = {};
        var histRegs = { rep: null, ext: null, alu: null }; // datos congelados por sección (null = en vivo)
        function regsRep() { return histRegs.rep || (window.ReprobDetalle && ReprobDetalle.cache) || []; }
        function regsExt() { return histRegs.ext || (window.ReprobDetalle && ReprobDetalle.cache) || []; }
        function regsAlu() { return histRegs.alu || (window.ReprobDetalle && ReprobDetalle.cache) || []; }
        function barTop10(canvasId, pares, color, desglose) {
            var el = document.getElementById(canvasId);
            if (!el || typeof Chart === 'undefined') return;
            if (chartsRD[canvasId]) { chartsRD[canvasId].destroy(); delete chartsRD[canvasId]; }
            chartsRD[canvasId] = new Chart(el.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: pares.map(function (p) { return p[0]; }),
                    datasets: [{ label: 'Registros', data: pares.map(function (p) { return p[1]; }), backgroundColor: color }]
                },
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                afterBody: function (items) {
                                    if (!desglose || !items.length) return [];
                                    var d = desglose[items[0].label];
                                    return d ? d.map(function (p) { return p[0] + ': ' + p[1]; }) : [];
                                }
                            }
                        }
                    },
                    scales: { x: { ticks: { precision: 0 } }, y: { ticks: { font: { size: 10 } } } }
                }
            });
        }
        function etiquetaGrupo(r) {
            if (r.idGrado == null || r.idGrupo == null) return null;
            var g = GRADOS[r.idGrado], l = GRUPOS[r.idGrupo];
            if (g === undefined || l === undefined) return null;
            return g + l;
        }
        function top10(regs, keyFn) {
            var acc = {};
            regs.forEach(function (r) {
                var k = keyFn(r);
                if (!k) return; // sin dato: fuera del top-10 (spec §3)
                acc[k] = (acc[k] || 0) + 1;
            });
            return Object.keys(acc).map(function (k) { return [k, acc[k]]; })
                .sort(function (a, b) { return b[1] - a[1]; }).slice(0, 10);
        }
        function desgloseCarreras(regs, keyFn) {
            var acc = {};
            regs.forEach(function (r) {
                var k = keyFn(r);
                if (!k) return; // sin dato: fuera, igual que top10
                var c = (r.carreraNombre || '').trim() || 'Sin carrera';
                if (!acc[k]) acc[k] = {};
                acc[k][c] = (acc[k][c] || 0) + 1;
            });
            var out = {};
            Object.keys(acc).forEach(function (k) {
                out[k] = Object.keys(acc[k]).map(function (c) { return [c, acc[k][c]]; })
                    .sort(function (a, b) { return b[1] - a[1]; });
            });
            return out;
        }
        function calcularTops(regs) {
            var rep = regs.filter(function (r) { return r.estado === 'Reprobada'; });
            var ext = regs.filter(function (r) { return r.estado === 'Extraordinario'; });
            function porMateria(r) { return r.materia; }
            function porCarrera(r) { return r.carreraNombre; }
            function porEsp(r) { return (r.especialidad || '').trim() || null; }
            return {
                repM: top10(rep, porMateria), repC: top10(rep, porCarrera), repE: top10(rep, porEsp), repG: top10(rep, etiquetaGrupo),
                extM: top10(ext, porMateria), extC: top10(ext, porCarrera), extE: top10(ext, porEsp), extG: top10(ext, etiquetaGrupo),
                repGDes: desgloseCarreras(rep, etiquetaGrupo), extGDes: desgloseCarreras(ext, etiquetaGrupo)
            };
        }
        // Modo GRAFICAS: barras. (Se re-dibuja al cambiar de modo: un canvas oculto queda en blanco.)
        function pintarCharts() {
            var tRep = calcularTops(regsRep());
            var tExt = calcularTops(regsExt());
            barTop10('chartReprobMaterias', tRep.repM, '#b3402e');
            barTop10('chartReprobCarreras', tRep.repC, '#b3402e');
            barTop10('chartReprobEspecialidades', tRep.repE, '#b3402e');
            barTop10('chartReprobGrupos', tRep.repG, '#b3402e', tRep.repGDes);
            barTop10('chartExtraMaterias', tExt.extM, '#dba13a');
            barTop10('chartExtraCarreras', tExt.extC, '#dba13a');
            barTop10('chartExtraEspecialidades', tExt.extE, '#dba13a');
            barTop10('chartExtraGrupos', tExt.extG, '#dba13a', tExt.extGDes);
        }
        // Modo TABLAS: los mismos rankings como tablas #/nombre/registros.
        function pintarTablas() {
            var tRep = calcularTops(regsRep());
            var tExt = calcularTops(regsExt());
            function llenar(id, pares, desglose) {
                var $tb = $('#' + id); if (!$tb.length) return;
                var cols = desglose ? 4 : 3;
                $tb.html(pares.length
                    ? pares.map(function (p, i) {
                        var extra = desglose ? '<td>' + escR((desglose[p[0]] || []).map(function (c) { return c[0] + ' (' + c[1] + ')'; }).join(', ')) + '</td>' : '';
                        return '<tr><td class="text-center" style="color:#888;">' + (i + 1) + '</td><td>' + escR(p[0]) + '</td>' + extra + '<td class="text-center"><strong>' + p[1] + '</strong></td></tr>';
                    }).join('')
                    : '<tr><td colspan="' + cols + '" class="text-center text-muted">Sin datos</td></tr>');
            }
            llenar('tbodyRepMaterias', tRep.repM); llenar('tbodyRepCarreras', tRep.repC); llenar('tbodyRepEspecialidades', tRep.repE); llenar('tbodyRepGrupos', tRep.repG, tRep.repGDes);
            llenar('tbodyExtMaterias', tExt.extM); llenar('tbodyExtCarreras', tExt.extC); llenar('tbodyExtEspecialidades', tExt.extE); llenar('tbodyExtGrupos', tExt.extG, tExt.extGDes);
        }
        function pintar(regs) {
            // Tras actualizar cache, renderizar con orígenes independientes por sección
            pintarTablas();
            if (window.ModoEstadisticas) {
                ModoEstadisticas.datos('reprobTops', regsRep()); // el framework llama pintarCharts solo si la seccion esta en Graficas
                ModoEstadisticas.datos('extraTops', regsExt());
            } else {
                pintarCharts();
            }
            if (window.ReprobDetalle && window.ReprobDetalle.onDatos) window.ReprobDetalle.onDatos(regsAlu()); // tabla (Task 3)
        }
        var SELS = '#carreraFiltroReprob, #especialidadFiltroReprob, #gradoFiltroReprob, #grupoFiltroReprob';
        function cargar(_retry) {
            $('#reprobCargando').show(); $('#reprobError').hide(); $(SELS).prop('disabled', true);
            $.ajax({
                url: '@Url.Action("GetReprobadosDetalle", "NuevasEstadisticas")',
                type: 'POST',
                data: {
                    carreraId: $('#carreraFiltroReprob').val() || null,
                    especialidadId: $('#especialidadFiltroReprob').val() || null,
                    gradoId: $('#gradoFiltroReprob').val() || null,
                    grupoId: $('#grupoFiltroReprob').val() || null
                },
                success: function (r) {
                    $('#reprobCargando').hide();
                    if (!histRegs.rep) $(SELS).prop('disabled', false);
                    if (!r || !r.success) {
                        $('#reprobError').text('No se pudieron obtener los datos: ' + ((r && r.error) || 'error desconocido')).show();
                        return;
                    }
                    window.ReprobDetalle.cache = (r.data && r.data.registros) || [];
                    pintar(window.ReprobDetalle.cache);
                },
                error: function () {
                    if (!_retry) { setTimeout(function () { cargar(true); }, 1500); return; } // reintento 1 vez (patron existente)
                    $('#reprobCargando').hide(); if (!histRegs.rep) $(SELS).prop('disabled', false);
                    $('#reprobError').text('Error de conexión al cargar Reprobados/Extraordinarios.').show();
                }
            });
        }
        window.ReprobDetalle = { cache: [], cargar: cargar, etiquetaGrupo: etiquetaGrupo, onDatos: null };
        // Registro en el framework Tablas/Graficas (2026-08-01): tablas de ranking en modo Tablas,
        // barras en modo Graficas.
        if (window.ModoEstadisticas) {
            if (document.getElementById('chartWrapReprob'))
                ModoEstadisticas.registrar('reprobTops', { original: '#tablasReprobWrap', charts: '#chartWrapReprob', botonHost: '#modoHostReprob', render: pintarCharts });
            if (document.getElementById('chartWrapExtra'))
                ModoEstadisticas.registrar('extraTops', { original: '#tablasExtraWrap', charts: '#chartWrapExtra', botonHost: '#modoHostExtra', render: pintarCharts });
        }
        $(SELS).on('change', function () { cargar(); });
        if (window.initCascadaEspecialidad) window.initCascadaEspecialidad('#carreraFiltroReprob', '#especialidadFiltroReprob');
        // Carga diferida 3s como las demas graficas (choque con DataTables init, regla del proyecto).
        setTimeout(function () { if (document.getElementById('seccionReprobados')) cargar(); }, 3000);
        // ===== Tabla de alumnos (Task 3) =====
        var dtAlumnosReprob = null;
        function escR(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
        window.ReprobDetalle.onDatos = function (regs) {
            var porAlumno = {};
            regs.forEach(function (r) {
                var k = (r.matricula || '').toUpperCase();
                if (!k) return;
                if (!porAlumno[k]) porAlumno[k] = { matricula: r.matricula, nombre: r.nombreAlumno || r.matricula, grupo: etiquetaGrupo(r), rep: 0, ext: 0, materias: [] };
                if (r.estado === 'Reprobada') porAlumno[k].rep++;
                else if (r.estado === 'Extraordinario') porAlumno[k].ext++;
                porAlumno[k].materias.push(r);
            });
            // Ranking: ordenado por total (reprobadas + extraordinario) descendente; la columna #
            // es la posicion en ese ranking (fija aunque el usuario reordene por otra columna).
            var alumnos = Object.keys(porAlumno).map(function (k) { return porAlumno[k]; })
                .sort(function (x, y) { return (y.rep + y.ext) - (x.rep + x.ext); });
            if ($.fn.dataTable.isDataTable('#tablaAlumnosReprobados')) { $('#tablaAlumnosReprobados').DataTable().destroy(); }
            var $tb = $('#tablaAlumnosReprobados tbody').empty();
            alumnos.forEach(function (a, i) {
                $tb.append('<tr data-idx="' + i + '" style="cursor:pointer;">' +
                    '<td class="text-center" style="color:#888;">' + (i + 1) + '</td>' +
                    '<td>' + escR(a.nombre) + ' <small class="text-muted">(' + escR(a.matricula) + ')</small></td>' +
                    '<td class="text-center">' + (a.grupo ? escR(a.grupo) : '—') + '</td>' +
                    '<td class="text-center">' + a.rep + '</td>' +
                    '<td class="text-center">' + a.ext + '</td>' +
                    '<td class="text-center"><strong>' + (a.rep + a.ext) + '</strong></td></tr>');
            });
            window.ReprobDetalle._alumnos = alumnos;
            dtAlumnosReprob = $('#tablaAlumnosReprobados').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                order: [[0, 'asc']],
                pageLength: 10
            });
        };
        $('#tablaAlumnosReprobados tbody').on('click', 'tr', function () {
            var idx = $(this).data('idx');
            var a = (window.ReprobDetalle._alumnos || [])[idx];
            if (!a) return;
            $('#reprobAlumnoModalTitulo').text(a.nombre + ' (' + a.matricula + ')' + (a.grupo ? ' · Grupo ' + a.grupo : ''));
            function lista(estado, titulo, color) {
                var items = a.materias.filter(function (m) { return m.estado === estado; });
                if (!items.length) return '';
                var h = '<h5 style="color:' + color + '; margin:12px 0 8px; font-weight:700; letter-spacing:.3px;">' + titulo +
                    ' <span style="background:' + color + '; color:#fff; border-radius:10px; padding:1px 8px; font-size:12px; vertical-align:2px;">' + items.length + '</span></h5>' +
                    '<div style="border:1px solid #eceff1; border-radius:8px; overflow:hidden;">';
                items.forEach(function (m, idx) {
                    var badge = m.intentos
                        ? '<span style="background:#fff3e0; color:#b26a00; border:1px solid #f0ddc0; border-radius:10px; padding:2px 10px; font-size:11.5px; white-space:nowrap;">' + m.intentos + (m.intentos === 1 ? ' intento' : ' intentos') + ' de extraordinario</span>'
                        : '<span style="background:#eceff1; color:#607d8b; border:1px solid #dfe5e8; border-radius:10px; padding:2px 10px; font-size:11.5px; white-space:nowrap;">Sin intento</span>';
                    h += '<div style="display:flex; justify-content:space-between; align-items:center; gap:12px; padding:7px 12px;' + (idx % 2 ? ' background:#fafbfc;' : '') + (idx ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                        '<span style="color:#1f2937;">' + escR(m.materia) + '</span>' + badge + '</div>';
                });
                return h + '</div>';
            }
            $('#reprobAlumnoModalCuerpo').html(
                ((lista('Reprobada', 'Reprobadas (arrastre)', '#b3402e') + lista('Extraordinario', 'En extraordinario', '#b26a00')) ||
                '<p class="text-muted">Sin materias.</p>') +
                '<button type="button" class="btn btn-utt-outline btn-sm abrir-mini360" data-matricula="' + escR(a.matricula) + '" style="width:100%; margin-top:10px;"><i class="fas fa-id-card me-1"></i> Ver mini-ficha del alumno</button>');
            $('#reprobAlumnoModalOverlay').css('display', 'block');
        });
        function cerrarReprobModal() { $('#reprobAlumnoModalOverlay').hide(); }
        $('#reprobAlumnoModalCerrar').on('click', cerrarReprobModal);
        $('#reprobAlumnoModalOverlay').on('click', function (e) { if (e.target === this) cerrarReprobModal(); });
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && $('#reprobAlumnoModalOverlay').is(':visible')) cerrarReprobModal(); });

        // ===== Histórico independiente por sección (Task 3, 2026-08-02) =====
        function cargarHistSeccion(clave, corteId) {
            if (!corteId) {
                histRegs[clave] = null;
                if (clave === 'rep') $(SELS).prop('disabled', false).attr('title', '');
                repintar();
                return;
            }
            if (clave === 'rep') $(SELS).prop('disabled', true).attr('title', 'Filtro disponible solo en vivo');
            $.ajax({
                url: '@Url.Action("GetReprobadosDetalle", "NuevasEstadisticas")',
                type: 'POST', data: { corteId: corteId },
                success: function (r) {
                    if (!r || !r.success) { alert((r && r.message) || 'Sin datos de esta sección en ese corte'); return; }
                    histRegs[clave] = (r.data && r.data.registros) || [];
                    repintar();
                },
                error: function () { alert('Error de conexión al cargar el corte.'); }
            });
        }
        function repintar() {
            pintarTablas();
            if (window.ModoEstadisticas) { ModoEstadisticas.datos('reprobTops', regsRep()); ModoEstadisticas.datos('extraTops', regsExt()); }
            else { pintarCharts(); }
            if (window.ReprobDetalle && ReprobDetalle.onDatos) ReprobDetalle.onDatos(regsAlu());
        }
        if (typeof initHistoricoSeccion === 'function') {
            initHistoricoSeccion({ btn: '#btnHistReprob', menu: '#menuHistReprob', rotulo: '#rotuloHistReprob',
                onCorte: function (c) { cargarHistSeccion('rep', c.idCorte); }, onVivo: function () { cargarHistSeccion('rep', null); } });
            initHistoricoSeccion({ btn: '#btnHistExtra', menu: '#menuHistExtra', rotulo: '#rotuloHistExtra',
                onCorte: function (c) { cargarHistSeccion('ext', c.idCorte); }, onVivo: function () { cargarHistSeccion('ext', null); } });
            initHistoricoSeccion({ btn: '#btnHistAlumnosRep', menu: '#menuHistAlumnosRep', rotulo: '#rotuloHistAlumnosRep',
                onCorte: function (c) { cargarHistSeccion('alu', c.idCorte); }, onVivo: function () { cargarHistSeccion('alu', null); } });
        }
    });
</script>
<script>
    // ===== Seccion BAJAS (2026-08-01): causa / carreras / especialidades del periodo vigente =====
    // 1 POST a GetEstadisticasBajas (la misma respuesta alimenta el KPI de Bajas via ajaxSuccess).
    $(function () {
        if (!document.getElementById('seccionBajasResumen')) return;
        var chartsBS = {};
        function barrasBS(canvasId, pares, color) {
            var el = document.getElementById(canvasId);
            if (!el || typeof Chart === 'undefined') return;
            if (chartsBS[canvasId]) { chartsBS[canvasId].destroy(); delete chartsBS[canvasId]; }
            chartsBS[canvasId] = new Chart(el.getContext('2d'), {
                type: 'bar',
                data: { labels: pares.map(function (p) { return p[0]; }), datasets: [{ label: 'Bajas', data: pares.map(function (p) { return p[1]; }), backgroundColor: color }] },
                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { precision: 0 } }, y: { ticks: { font: { size: 10 } } } } }
            });
        }
        function pares(dic) {
            return Object.keys(dic || {}).map(function (k) { return [k, dic[k]]; })
                .sort(function (a, b) { return b[1] - a[1]; }).slice(0, 10);
        }
        function escB(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        var cacheBS = null;
        function pintarBajasCharts(d) {
            d = d || cacheBS; if (!d) return;
            barrasBS('chartBajasSecCausa', pares(d.BajasPorCausa), '#b3402e');
            barrasBS('chartBajasSecCarreras', pares(d.BajasPorCarrera), '#74628f');
            barrasBS('chartBajasSecEspecialidades', pares(d.BajasPorEspecialidad), '#dba13a');
        }
        function pintarBajasTablas(d) {
            function llenar(id, ps) {
                var $tb = $('#' + id); if (!$tb.length) return;
                $tb.html(ps.length
                    ? ps.map(function (p, i) { return '<tr><td class="text-center" style="color:#888;">' + (i + 1) + '</td><td>' + escB(p[0]) + '</td><td class="text-center"><strong>' + p[1] + '</strong></td></tr>'; }).join('')
                    : '<tr><td colspan="3" class="text-center text-muted">Sin bajas en el periodo</td></tr>');
            }
            llenar('tbodyBajasSecCausa', pares(d.BajasPorCausa));
            llenar('tbodyBajasSecCarreras', pares(d.BajasPorCarrera));
            llenar('tbodyBajasSecEspecialidades', pares(d.BajasPorEspecialidad));
        }
        if (window.ModoEstadisticas) {
            ModoEstadisticas.registrar('bajasSec', { original: '#tablasBajasSecWrap', charts: '#chartWrapBajasSec', botonHost: '#modoHostBajasSec', render: pintarBajasCharts });
        }
        var corteBajasSecActual = null;
        window.cargarBajasSec = function cargarBajasSec(corteId, _retry) {
            corteBajasSecActual = corteId || null;
            $('#bajasSecCargando').show(); $('#bajasSecError').hide();
            var data = {};
            if (corteId) { data.corteId = corteId; }
            $.ajax({
                url: '@Url.Action("GetEstadisticasBajas", "NuevasEstadisticas")',
                type: 'POST',
                data: data,
                success: function (r) {
                    $('#bajasSecCargando').hide();
                    if (!r || !r.success || !r.data) { $('#bajasSecError').text('No se pudieron obtener las bajas: ' + ((r && r.message) || (r && r.error) || 'error desconocido')).show(); return; }
                    cacheBS = r.data;
                    $('#bajasSecTotal').text('Total: ' + (r.data.TotalBajas || 0));
                    pintarBajasTablas(r.data);
                    if (window.ModoEstadisticas) { ModoEstadisticas.datos('bajasSec', r.data); } else { pintarBajasCharts(r.data); }
                },
                error: function () {
                    if (!_retry) { setTimeout(function () { window.cargarBajasSec(corteId, true); }, 1500); return; } // reintento 1 vez (patron existente)
                    $('#bajasSecCargando').hide();
                    $('#bajasSecError').text('Error de conexión al cargar Bajas.').show();
                }
            });
        };
        // Carga diferida 3s (regla del proyecto). Esta misma respuesta alimenta el KPI de Bajas.
        setTimeout(function () { window.cargarBajasSec(null); }, 3000);
        if (typeof initHistoricoSeccion === 'function') {
            initHistoricoSeccion({
                btn: '#btnHistBajasSec', menu: '#menuHistBajasSec', rotulo: '#rotuloHistBajasSec',
                onCorte: function (c) { window.cargarBajasSec(c.idCorte); },
                onVivo: function () { window.cargarBajasSec(null); }
            });
        }
    });
</script>
<script>
    // ===== Seccion CUMPLIMIENTO DE TUTORES (2026-08-02) =====
    // Ranking por tutor: % de alumnos con seguimiento/entrevista del periodo y dias sin capturar.
    // Semaforo: verde >=80%, amarillo >=50%, rojo <50%.
    $(function () {
        if (!document.getElementById('seccionCumplTutores')) return;
        var cacheCT = null, dtCumpl = null, chartsCT = {};
        var listaCumplActual = []; // lo que se ve en la tabla tras aplicar orden + filtro
        function escC(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function badgePct(pct) {
            var color = pct >= 80 ? '#00897B' : (pct >= 50 ? '#dba13a' : '#b3402e');
            return '<span style="background:' + color + '; color:#fff; border-radius:10px; padding:2px 10px; font-size:12px; white-space:nowrap;">' + pct + '%</span>';
        }
        // Semaforo de RECENCIA: aunque un tutor tenga 100% del cuatrimestre, si lleva semanas sin
        // capturar sale en ambar/rojo (es el caso "capturo en mayo y desaparecio").
        function badgeDias(dias) {
            if (dias === null || dias === undefined) return '<span style="background:#b3402e; color:#fff; border-radius:10px; padding:2px 10px; font-size:12px; white-space:nowrap;">Sin capturas</span>';
            var color = dias <= 14 ? '#00897B' : (dias <= 30 ? '#dba13a' : '#b3402e');
            return '<span style="background:' + color + '; color:#fff; border-radius:10px; padding:2px 10px; font-size:12px; white-space:nowrap;">' + dias + ' día' + (dias === 1 ? '' : 's') + '</span>';
        }
        function pintarCumplTabla(filas) {
            // El DataTable se crea UNA vez y solo se repueblan filas: destruir/recrear en cambios
            // rapidos de orden/filtro choca con la carga asincrona del paquete de idioma.
            if (!dtCumpl) {
                dtCumpl = $('#tablaCumplTutores').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                    order: [[0, 'asc']],
                    pageLength: 15,
                    lengthChange: false,
                    columnDefs: [{ targets: [0, 3, 4, 5, 6, 7, 8, 9], className: 'text-center' }],
                    createdRow: function (row) { row.style.cursor = 'pointer'; }
                });
            }
            dtCumpl.clear();
            filas.forEach(function (f, i) {
                dtCumpl.row.add([
                    '<span style="color:#888;">' + (i + 1) + '</span>',
                    '<span class="tutor360-link" data-idusuario="' + f.idUsuario + '" title="Ver ficha del tutor" style="color:#00695C; font-weight:600; cursor:pointer;">' + escC(f.tutor) + '</span>',
                    escC(f.carrera),
                    escC(f.grupos),
                    f.alumnos,
                    f.conSeguimiento + ' de ' + f.alumnos + ' ' + badgePct(f.pctSeguimiento),
                    f.conSeguimientoMes + ' de ' + f.alumnos + ' ' + badgePct(f.pctSeguimientoMes),
                    f.conEntrevista + ' de ' + f.alumnos + ' ' + badgePct(f.pctEntrevista),
                    (f.ultimaCaptura ? escC(f.ultimaCaptura) : '<span class="text-muted">Sin capturas</span>'),
                    badgeDias(f.diasSinCaptura)
                ]);
            });
            dtCumpl.order([0, 'asc']).draw();
        }
        // Orden + filtro del ranking (client-side, sobre los datos ya cargados).
        function aplicarVistaCumpl() {
            var lista = (cacheCT || []).slice();
            var filtro = $('#cumplFiltro').val();
            if (filtro === 'rojo') lista = lista.filter(function (f) { return f.diasSinCaptura === null || f.diasSinCaptura > 30; });
            else if (filtro === 'ambar') lista = lista.filter(function (f) { return f.diasSinCaptura === null || f.diasSinCaptura > 14; });
            else if (filtro === 'sinmes') lista = lista.filter(function (f) { return (f.conSeguimientoMes || 0) === 0; });
            else if (filtro === 'pend') lista = lista.filter(function (f) { return (f.alumnosSinSeguimiento || []).length > 0; });
            var orden = $('#cumplOrden').val();
            function dias(f) { return f.diasSinCaptura === null ? Number.MAX_VALUE : f.diasSinCaptura; } // sin capturas = el peor
            if (orden === 'dias') lista.sort(function (a, b) { return dias(b) - dias(a) || a.pctSeguimiento - b.pctSeguimiento; });
            else if (orden === 'mes') lista.sort(function (a, b) { return a.pctSeguimientoMes - b.pctSeguimientoMes || dias(b) - dias(a); });
            else lista.sort(function (a, b) { return a.pctSeguimiento - b.pctSeguimiento || a.pctEntrevista - b.pctEntrevista || a.tutor.localeCompare(b.tutor); });
            listaCumplActual = lista;
            pintarCumplTabla(lista);
        }
        $('#cumplOrden, #cumplFiltro').on('change', aplicarVistaCumpl);
        // ===== FICHA DEL TUTOR 360° (integrada: click en el nombre del tutor) =====
        function barraActividad(mes, n, max) {
            var w = max > 0 ? Math.round(n * 100 / max) : 0;
            return '<div style="display:flex; align-items:center; gap:8px; margin-top:4px;">' +
                '<span style="width:86px; font-size:12px; color:#607d8b; text-transform:capitalize;">' + escC(mes) + '</span>' +
                '<div style="flex:1; background:#eceff1; border-radius:6px; height:16px; overflow:hidden;"><div style="width:' + w + '%; height:100%; background:#00897B;"></div></div>' +
                '<strong style="width:46px; text-align:right; font-size:12px;">' + n + '</strong></div>';
        }
        function chipT(texto, bg, color) {
            return '<span style="background:' + (bg || '#eceff1') + '; color:' + (color || '#455a64') + '; border-radius:10px; padding:3px 10px; font-size:12px; white-space:nowrap;">' + escC(texto) + '</span>';
        }
        function colorClasifT(texto) {
            var t = (texto || '').toUpperCase();
            if (t.indexOf('ECON') >= 0) return '#b3402e';
            if (t.indexOf('ACAD') >= 0) return '#b26a00';
            if (t.indexOf('PERS') >= 0) return '#74628f';
            if (t.indexOf('NO VULNERABLE') >= 0) return '#00897B';
            return '#78909c';
        }
        function tituloTutor(texto) {
            $('#tutor360Titulo').html('<i class="fas fa-arrows-alt me-1" style="opacity:.7;"></i> ' + escC(texto));
        }
        function abrirTutor360(idUsuario) {
            tituloTutor('Ficha del Tutor');
            $('#tutor360Cuerpo').html('<p class="text-muted" style="margin:0;"><i class="fas fa-spinner fa-spin"></i> Cargando...</p>');
            $('#tutor360Overlay').css('display', 'flex');
            $.post('@Url.Action("GetTutor360", "NuevasEstadisticas")', { idUsuario: idUsuario }, function (r) {
                if (!r || !r.success) { $('#tutor360Cuerpo').html('<p style="color:#b3402e; margin:0;">' + escC((r && r.error) || 'No se pudo cargar la ficha.') + '</p>'); return; }
                var d = r.data;
                tituloTutor(d.nombre + ' · ' + d.carrera);
                var maxAct = Math.max.apply(null, (d.actividad || []).map(function (a) { return a.capturas; }).concat([1]));
                var e = d.estadoAlumnos || {};
                var html =
                    '<div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;">' +
                    chipT('Grupos: ' + ((d.grupos || []).join(', ') || 'Sin grupos'), '#eceff1') +
                    chipT(d.alumnos + ' alumnos a cargo', '#e9f8f4', '#00695C') +
                    ((d.canalizaciones && d.canalizaciones.total) ? chipT(d.canalizaciones.total + ' canalizaciones realizadas', '#e9f8f4', '#00695C') : '') +
                    chipT(d.periodo, '#eceff1') + '</div>' +
                    '<div class="dash-graf-row" style="margin-bottom:4px;">' +
                    '<div class="demo-graf-col">' +
                        '<h4 class="dash-sub">Cumplimiento</h4>' +
                        '<div style="margin-bottom:5px;">Seguimiento del cuatrimestre: <strong>' + d.conSeguimiento + ' de ' + d.alumnos + '</strong> ' + badgePct(d.pctSeguimiento) + '</div>' +
                        '<div style="margin-bottom:5px;">Con captura este mes: <strong>' + d.conSeguimientoMes + ' de ' + d.alumnos + '</strong></div>' +
                        '<div style="margin-bottom:5px;">Con entrevista inicial: <strong>' + d.conEntrevista + ' de ' + d.alumnos + '</strong></div>' +
                        '<div>Última captura: <strong>' + (d.ultimaCaptura || 'Sin capturas') + '</strong> ' + badgeDias(d.diasSinCaptura) + '</div>' +
                        '<h4 class="dash-sub" style="margin-top:14px;">Actividad del cuatrimestre</h4>' +
                        (d.actividad || []).map(function (a) { return barraActividad(a.mes, a.capturas, maxAct); }).join('') +
                        '<h4 class="dash-sub" style="margin-top:14px;">Canalizaciones que ha realizado</h4>' +
                        ((d.canalizaciones && d.canalizaciones.total)
                            ? ('<div>' + d.canalizaciones.porTipo.map(function (t) { return chipT(t.tipo + ': ' + t.n, '#fff3e0', '#b26a00'); }).join(' ') + '</div>' +
                               '<div style="color:#888; font-size:12px; margin-top:4px;">Última: ' + escC(d.canalizaciones.ultima) + '</div>')
                            : '<p class="text-muted" style="margin:0;">Sin canalizaciones registradas.</p>') +
                    '</div>' +
                    '<div class="demo-graf-col">' +
                        '<h4 class="dash-sub">Estado de sus alumnos</h4>' +
                        '<div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px;">' +
                        chipT('Económicos: ' + (e.econ || 0), '#fdecea', '#b3402e') +
                        chipT('Académicos: ' + (e.acad || 0), '#fff3e0', '#b26a00') +
                        chipT('Personales: ' + (e.pers || 0), '#efeaf5', '#74628f') +
                        chipT('No vulnerables: ' + (e.noVul || 0), '#e9f8f4', '#00695C') +
                        chipT('Sin información: ' + (e.sinInfo || 0)) + '</div>' +
                        '<div style="margin-bottom:4px;">Con materias reprobadas/extraordinario: <strong>' + (e.conReprobadas || 0) + '</strong></div>' +
                        '<div style="margin-bottom:10px;">Bajas del periodo en sus grupos: <strong>' + (e.bajasPeriodo || 0) + '</strong></div>' +
