                                        </div>
                                        <span id="modoHostCierre"></span><span id="rotuloHistCierre" class="badge bg-warning text-dark" style="display:none; align-self:center;"></span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @* Cierre de cuatrimestres en modo grafica: dona agregada + agrupadas + 100% (consistente con Nivel). *@
                                    <div class="modo-chart-wrap" id="chartWrapCierre" style="max-width:none; height:auto; padding:12px;">
                                        <div class="dash-graf-row">
                                            <div class="demo-graf-col"><h4 class="dash-sub">Distribución (todos los cierres)</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartCierreDona"></canvas></div></div>
                                            <div class="demo-graf-col"><h4 class="dash-sub">Comparativa por Cierre</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartModoCierre"></canvas></div></div>
                                            <div class="demo-graf-col"><h4 class="dash-sub">Composición por Cierre (100%)</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartCierrePct"></canvas></div></div>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
