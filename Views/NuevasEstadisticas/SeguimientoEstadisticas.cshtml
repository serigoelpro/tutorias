                                display: true,
                                text: 'Bajas por Carrera',
                                font: {
                                    size: 16,
                                    weight: 'bold'
                                }
                            },
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var value = context.parsed.y || 0;
                                        var total = dataBajasCarrera.reduce(function(a, b) { return a + b; }, 0);
                                        var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
                                        return 'Bajas: ' + value + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        },
                        scales: {
