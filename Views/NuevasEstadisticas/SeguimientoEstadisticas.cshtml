                                        </button>
                                        <div class="hist-wrap" style="position:relative; display:inline-block;">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHistVulnerabilidad" title="Ver un corte histórico de esta sección">
                                                <i class="fas fa-clock-rotate-left me-1"></i> Histórico
                                            </button>
                                            <ul class="hist-menu" id="menuHistVulnerabilidad" style="display:none; position:absolute; right:0; top:100%; z-index:1050; background:#fff; border:1px solid #ddd; border-radius:6px; box-shadow:0 4px 12px rgba(0,0,0,.15); list-style:none; margin:4px 0 0; padding:4px 0; min-width:240px; max-height:280px; overflow:auto;"></ul>
                                        </div>
                                        <span id="rotuloHistVulnerabilidad" class="badge bg-warning text-dark" style="display:none; align-self:center;"></span>
                                        <span id="modoHostVulnerabilidad"></span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @* Categoría: Vulnerabilidad *@
                                    <div class="panel panel-success" style="margin-bottom: 10px;">
                                        <div class="panel-heading categoria-header" style="cursor: pointer; background-color: #009688; border-color: #009688;">
                                            <h5 style="margin: 0; color: white; font-size: 1rem; padding: 8px 0;">
                                                <span class="glyphicon glyphicon-exclamation-sign"></span>
                                                <strong>Vulnerabilidad</strong>
                                                <span class="glyphicon glyphicon-chevron-down pull-right" style="color: white;"></span>
                                            </h5>
                                        </div>
                                        <div class="panel-body categoria-body" style="display: block; padding: 12px;">
                                            @* Filtros de fecha para vulnerabilidades *@
                                            <div class="filter-bar" style="margin-bottom: 15px; background-color: #f8f9fa; padding: 15px; border-radius: 8px; border: 1px solid #e9ecef;">
                                                <div class="row">
                                                    <div class="col-md-4" style="margin-bottom: 10px;">
                                                        <label for="mesFiltroVulnerabilidad" class="form-label" style="font-weight: 600; margin-bottom: 5px;">Mes:</label>
                                                        <select id="mesFiltroVulnerabilidad" class="form-select" style="padding: .5rem .75rem; border-radius: 8px; border: 1px solid #e9ecef;">
                                                            <option value="">No aplicado</option>
                                                            @if (ViewBag.NombresMeses != null)
                                                            {
                                                                var nombresMeses = ViewBag.NombresMeses as Dictionary<int, string>;
                                                                var mesActual = ViewBag.MesFiltro ?? DateTime.Now.Month; // Usar mes del filtro o mes actual
                                                                foreach (var mes in nombresMeses)
                                                                {
                                                                    <option value="@mes.Key" @(mesActual == mes.Key ? "selected" : "")>@mes.Value</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4" style="margin-bottom: 10px;">
                                                        <label class="form-label" style="font-weight: 600; margin-bottom: 5px;">Año:</label>
                                                        <div class="form-control" style="padding: .5rem .75rem; border-radius: 8px; border: 1px solid #e9ecef; background-color: #f8f9fa; color: #495057; display: flex; align-items: center;">
                                                            <strong>@DateTime.Now.Year</strong>
                                                            <small class="text-muted ms-2">(Año actual)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 d-flex align-items-end" style="margin-bottom: 10px;">
                                                        <button id="aplicarFiltroVulnerabilidad" class="btn btn-success me-2" style="flex: 1;">
                                                            <i class="fas fa-search me-1"></i>
                                                            Aplicar
                                                        </button>
                                                        <button id="limpiarFiltroVulnerabilidad" class="btn btn-utt-outline" style="flex: 1;">
                                                            <i class="fas fa-times me-1"></i>
                                                            Limpiar
                                                        </button>
                                                    </div>
                                                </div>
                                                <div id="filtroActivoVulnerabilidad" class="alert alert-info" style="margin-top: 10px; margin-bottom: 0; display: none; padding: 8px 12px; border-radius: 6px;">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    <strong>Filtro activo:</strong> <span id="nombreFiltroActivoVulnerabilidad"></span>
                                                </div>
                                            </div>
                                            @* Vulnerabilidad en modo grafica: 4 charts compactos (mockup). El heatmap Carrera x Tipo
                                               ya vive en la seccion Carrera; turno/especialidad requeririan backend (fuera). *@
                                            <div class="modo-chart-wrap" id="chartWrapVulnerabilidad" style="padding: 12px; max-width: none; height: auto;">
                                                <div class="dash-graf-row">
                                                    <div class="demo-graf-col"><h4 class="dash-sub">Vulnerabilidad por Tipo</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartVulnTipo"></canvas></div></div>
                                                    <div class="demo-graf-col"><h4 class="dash-sub">Clasificación General</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartModoVulnerabilidad"></canvas></div></div>
                                                    <div class="demo-graf-col" id="vulnFuenteCol"><h4 class="dash-sub">Fuente de Clasificación</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartVulnFuente"></canvas></div></div>
                                                </div>
                                                @* Por carrera abajo, a lo ancho de las tres donas (pedido del usuario). *@
                                                <div id="vulnCarreraCol" style="margin-top:16px;"><h4 class="dash-sub">Vulnerabilidad por Carrera (Top 10)</h4><div class="dash-canvas-wrap" style="height:300px;"><canvas id="chartVulnCarrera"></canvas></div></div>
                                            </div>
                                            <div id="contenidoVulnerabilidades">
                                                <div class="row">
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="vulnerables" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@totalVulnerables</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">Total de Vulnerables</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="personales" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@(vulnerabilidades?.VulnerablesPersonales ?? 0)</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">Vulnerables Personales</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="economicos" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@(vulnerabilidades?.VulnerablesEconomicos ?? 0)</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">Vulnerables Económicos</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="academicos" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@(vulnerabilidades?.VulnerablesAcademicos ?? 0)</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">Vulnerables Académicos</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="noVulnerables" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@(vulnerabilidades?.NoVulnerables ?? 0)</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">No Vulnerables</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="sinInformacion" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.2rem; font-weight: bold; color: #00695C;">@(vulnerabilidades?.SinSeguimiento ?? 0)</div>
                                                            <div style="font-size: 0.85rem; color: #00695C; margin-top: 3px;">Sin información</div>
                                                            <small class="vuln-card-hint">(click para ver alumnos)</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="desgloseFuenteVulnerabilidad" class="text-center" style="margin-top: 8px; padding: 8px; background-color: #f5f5f5; border-radius: 6px; font-size: 0.85rem; color: #555;">
                                                    @{
                                                        bool tieneDesgloseFuente = false;
                                                        int fuenteSeg = 0, fuenteIdent = 0;
                                                        try
                                                        {
                                                            tieneDesgloseFuente = (bool)(ViewBag.TieneDesgloseFuente ?? false);
                                                            if (tieneDesgloseFuente)
                                                            {
                                                                fuenteSeg = (int)(vulnerabilidades?.ClasificadosPorSeguimiento ?? 0);
                                                                fuenteIdent = (int)(vulnerabilidades?.ClasificadosPorIdentificacion ?? 0);
                                                            }
                                                        }
                                                        catch { tieneDesgloseFuente = false; }
                                                    }
                                                    @if (tieneDesgloseFuente)
                                                    {
                                                        <span>Fuente de clasificación &mdash; Por seguimiento del tutor: <strong>@fuenteSeg</strong> &middot; Por identificación (tutor sin seguimiento): <strong style="color:#b26a00;">@fuenteIdent</strong></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Desglose de fuente: no disponible en este corte.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            @* Tabla de Estadísticas por Cierre de Cuatrimestres *@
                            <section class="data-block">
                                <div class="card-header d-flex justify-content-between align-items-center" style=" margin-bottom: 10px;">
                                    <h3 class="section-title">
                                        <i class="fas fa-calendar-check me-2"></i>
                                        Estadísticas por Cierre de Cuatrimestres
                                    </h3>
                                    <div class="d-flex gap-2">
                                        <select id="anioFiltroCierre" class="form-select form-select-sm" style="width:auto;" title="Año a mostrar">
                                            @if (ViewBag.FiltroAnios != null)
                                            {
                                                foreach (var anioC in (List<int>)ViewBag.FiltroAnios)
                                                {
                                                    <option value="@anioC" @(anioC == DateTime.Now.Year ? "selected" : "")>@anioC</option>
                                                }
                                            }
                                        </select>
                                        @if ((ViewBag.UsuarioNivel as int? ?? 0) == 4)
                                        {
                                            <select id="carreraFiltroCierre" class="form-select form-select-sm" style="width:auto; max-width:220px;" title="Filtrar por carrera">
                                                <option value="">Todas las carreras</option>
                                                @if (ViewBag.Carreras != null)
                                                {
                                                    foreach (var cC in (Dictionary<int, string>)ViewBag.Carreras)
                                                    {
                                                        <option value="@cC.Key">@cC.Value</option>
                                                    }
                                                }
                                            </select>
                                        }
                                        <select id="especialidadFiltroCierre" class="form-select form-select-sm" style="width:auto; max-width:240px;" title="Filtrar por especialidad">
                                            <option value="">Todas las especialidades</option>
                                            @if (ViewBag.Especialidades != null) {
                                                var espCarreraMapCierre = ViewBag.EspecialidadCarrera as Dictionary<int, string>;
                                                foreach (var e in (List<PlataformaWeb.BecasTransporte.Models.Especialidad>)ViewBag.Especialidades) {
                                                    <option value="@e.Id" data-carrera="@(espCarreraMapCierre != null && espCarreraMapCierre.ContainsKey(e.Id) ? espCarreraMapCierre[e.Id] : "")">@e.Nombre</option>
                                                }
                                            }
                                        </select>
                                        <select id="gradoFiltroCierre" class="form-select form-select-sm" style="width:auto;" title="Filtrar por cuatrimestre (grado)">
                                            <option value="">Todos los grados</option>
                                            @if (ViewBag.FiltroGrados != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrados) { <option value="@g.Key">@g.Value</option> } }
                                        </select>
                                        <select id="grupoFiltroCierre" class="form-select form-select-sm" style="width:auto;" title="Filtrar por grupo">
                                            <option value="">Todos los grupos</option>
                                            @if (ViewBag.FiltroGrupos != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrupos) { <option value="@g.Key">@g.Value</option> } }
                                        </select>
