            function aplicarFiltroVulnerabilidades(mes, año, periodo) {
                mostrarCargando('Aplicando filtros de vulnerabilidad...');

                // El año siempre es el actual
                var añoActual = @DateTime.Now.Year;

                // Preparar datos para enviar (null se convierte a cadena vacía para que C# lo reciba como null)
                var dataToSend = {
                    año: añoActual // Siempre usar el año actual
                };

                // Solo agregar mes y periodo si no son null
                if (mes !== null && mes !== undefined) {
                    dataToSend.mes = mes;
                }
                if (periodo !== null && periodo !== undefined) {
                    dataToSend.periodo = periodo;
                }

                console.log('Enviando datos al servidor:', dataToSend);
                console.log('Parámetros recibidos - mes:', mes, 'año:', año, 'periodo:', periodo);

                dataToSend.incluirBajas = incluirBajasVulnerabilidad;

                $.ajax({
                    url: '@Url.Action("GetEstadisticasDetalladas", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataToSend,
                    success: function(response) {
                        ocultarCargando();
                        console.log('Respuesta del servidor:', response);
                        if (response.success) {
                            console.log('Datos recibidos:', response.data);
                            // Actualizar las vulnerabilidades con los datos recibidos
                            actualizarVulnerabilidades(response.data);
                            // Mostrar el filtro activo usando añoActual en lugar de año
                            mostrarFiltroActivoVulnerabilidad(mes, añoActual, periodo);
                        } else {
                            alert('Error al aplicar el filtro: ' + (response.error || 'Error desconocido'));
                        }
                    },
                    error: function(xhr, status, error) {
                        ocultarCargando();
                        console.error('Error AJAX:', xhr, status, error);
                        alert('Error al conectar con el servidor: ' + error);
                    }
                });
            }

            function actualizarVulnerabilidades(data) {
                // Modo graficas: guardar/repintar el chart con el MISMO dato de las tarjetas
                if (window.ModoEstadisticas) ModoEstadisticas.datos('vulnerabilidad', data);
                // Función auxiliar para calcular porcentaje
                function calcularPorcentaje(valor, total) {
                    return total > 0 ? ((valor / total) * 100).toFixed(1) : '0.0';
                }

                var totalEstudiantes = data.totalEstudiantes || 0;
                var totalVulnerables = (data.vulnerablesPersonales || 0) +
                                      (data.vulnerablesEconomicos || 0) +
                                      (data.vulnerablesAcademicos || 0);

                // Actualizar las tarjetas de vulnerabilidad
                // NOTA: Vulnerabilidad ahora está en su propia sección separada
                var $cards = $('#contenidoVulnerabilidades .col-md-2');

                console.log('Actualizando vulnerabilidades con datos:', data);
                console.log('Tarjetas encontradas:', $cards.length);

                if ($cards.length === 0) {
                    console.error('No se encontraron tarjetas de vulnerabilidad. Verificar selector: #contenidoVulnerabilidades .col-md-2');
                    return;
                }

                // Actualizar cada tarjeta
                $cards.each(function(index) {
                    var $card = $(this).find('div');
                    var $value = $card.find('div').first();

                    var values = [
                        totalVulnerables,  // Total de Vulnerables
                        data.vulnerablesPersonales || 0,
                        data.vulnerablesEconomicos || 0,
                        data.vulnerablesAcademicos || 0,
                        data.noVulnerables || 0,
                        (data.sinInformacion != null ? data.sinInformacion : data.sinSeguimiento) || 0
                    ];

                    if (index < values.length) {
                        $value.text(values[index]);
                    }
                });

                // Desglose de fuente (fallback identificación)
                var $desglose = $('#desgloseFuenteVulnerabilidad');
                if ($desglose.length) {
                    if (data.clasificadosPorSeguimiento != null) {
                        $desglose.html('Fuente de clasificación — Por seguimiento del tutor: <strong>' + (data.clasificadosPorSeguimiento || 0) +
                            '</strong> &middot; Por identificación (tutor sin seguimiento): <strong style="color:#b26a00;">' + (data.clasificadosPorIdentificacion || 0) + '</strong>');
                    } else {
                        $desglose.html('Desglose de fuente: no disponible en este corte.');
                    }
                }

                console.log('Actualización completada. Total estudiantes:', totalEstudiantes, 'Total vulnerables:', totalVulnerables);
            }
            // Exponer a window: el histórico por sección (Task 7) vive en otro <script>/ready y necesita alcanzarla.
            window.actualizarVulnerabilidades = actualizarVulnerabilidades;

            function mostrarFiltroActivoVulnerabilidad(mes, año, periodo) {
                var filtros = [];
                var añoActual = @DateTime.Now.Year;

                // Siempre mostrar el año actual como información
                filtros.push('Año: ' + añoActual);

                if (mes) {
                    // Obtener el nombre del mes desde el select o usar un diccionario
                    var $mesSelect = $('#mesFiltroVulnerabilidad');
                    var mesNombre = $mesSelect.find('option:selected').text();

                    // Si no se encuentra en el select, usar un diccionario de meses
                    if (!mesNombre || mesNombre === 'No aplicado') {
                        var nombresMeses = {
                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                        };
                        mesNombre = nombresMeses[mes] || mes.toString();
                    }

                    if (mesNombre && mesNombre !== 'No aplicado') {
                        filtros.push('Mes: ' + mesNombre);
                    }
                }

                // El filtro de período ya no se usa en vulnerabilidad

                // Mostrar el filtro activo siempre (ya que siempre hay un mes aplicado)
                var $filtroActivo = $('#filtroActivoVulnerabilidad');
                var $nombreFiltro = $('#nombreFiltroActivoVulnerabilidad');

                if ($nombreFiltro.length > 0) {
                    $nombreFiltro.text(filtros.join(', '));
                }

                if ($filtroActivo.length > 0) {
                    $filtroActivo.show();
                }
            }

            function cargarEstadisticasCierreCuatrimestres(corteId) {
                var añoActual = parseInt($('#anioFiltroCierre').val() || '@DateTime.Now.Year', 10);
                // Filtros solo en vivo (el snapshot historico es agregado).
                $('#anioFiltroCierre, #carreraFiltroCierre, #especialidadFiltroCierre, #gradoFiltroCierre, #grupoFiltroCierre').prop('disabled', !!corteId)
                    .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');

                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorCierreCuatrimestres", "NuevasEstadisticas")',
                    type: 'POST',
                    data: {
                        año: corteId ? @DateTime.Now.Year : añoActual,
                        incluirBajas: incluirBajasCierre,
                        corteId: corteId || null,
                        carreraId: (corteId ? null : ($('#carreraFiltroCierre').val() || null)),
                        especialidadId: (corteId ? null : ($('#especialidadFiltroCierre').val() || null)),
                        gradoId: (corteId ? null : ($('#gradoFiltroCierre').val() || null)),
                        grupoId: (corteId ? null : ($('#grupoFiltroCierre').val() || null))
                    },
                    success: function(response) {
                        console.log('Respuesta estadísticas cierre cuatrimestres:', response);
                        if (response.success && response.data) {
                            actualizarTablaCierreCuatrimestres(response.data);
                        } else {
                            mostrarErrorTablaCierreCuatrimestres(response.error || 'Error al cargar los datos');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error AJAX cierre cuatrimestres:', xhr, status, error);
                        mostrarErrorTablaCierreCuatrimestres('Error al conectar con el servidor: ' + error);
                    }
                });
            }

            $('#anioFiltroCierre, #carreraFiltroCierre, #especialidadFiltroCierre, #gradoFiltroCierre, #grupoFiltroCierre').on('change', function () { cargarEstadisticasCierreCuatrimestres(null); });

            function actualizarTablaCierreCuatrimestres(datos) {
                if (window.ModoEstadisticas) ModoEstadisticas.datos('cierre', datos);
                var $tbody = $('#tbodyCierreCuatrimestres');
                $tbody.empty();

                if (!datos || datos.length === 0) {
                    $tbody.html('<tr><td colspan="7" class="text-center text-muted py-4">No hay datos disponibles.</td></tr>');
                    return;
                }

                datos.forEach(function(item) {
                    var fila = '<tr>';
                    fila += '<td class="fw-bold">' + item.periodoNombre + '</td>';
                    fila += '<td class="text-center">' + item.año + '</td>';

                    if (!item.tieneDatos) {
                        fila += '<td colspan="5" class="text-center text-muted py-3">';
                        fila += '<i class="fas fa-info-circle me-2"></i>';
                        fila += 'Sin datos por el momento';
                        fila += '</td>';
                    } else {
                        fila += '<td class="text-center"><span class="badge bg-danger">' + item.vulnerablesEconomicos + '</span></td>';
                        fila += '<td class="text-center"><span class="badge bg-warning">' + item.vulnerablesAcademicos + '</span></td>';
                        fila += '<td class="text-center"><span class="badge bg-secondary">' + item.vulnerablesPersonales + '</span></td>';
                        fila += '<td class="text-center"><span class="badge bg-success">' + item.noVulnerables + '</span></td>';
                        fila += '<td class="text-center"><span class="badge bg-dark">' + item.sinSeguimiento + '</span></td>';
                    }

