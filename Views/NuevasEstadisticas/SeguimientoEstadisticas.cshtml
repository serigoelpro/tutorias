            window.cargarEstadisticasGrupos = function(corteId, _retry) {
                var $tbody = $('#tablaGrupos tbody');
                if (!$tbody.length) return;
                // Filtros solo en vivo (el snapshot historico es agregado).
                $('#turnoFiltroGrupos, #especialidadFiltroGrupos, #gradoFiltroGrupos').prop('disabled', !!corteId)
