                                        Func<int, string> formatearCelda = (valor) =>
                                            $"{valor} ({calcularPorcentaje(valor)}%)";

                                        // Calcular total de vulnerables
                                        var totalVulnerables = (vulnerabilidades?.VulnerablesPersonales ?? 0) +
                                                              (vulnerabilidades?.VulnerablesEconomicos ?? 0) +
                                                              (vulnerabilidades?.VulnerablesAcademicos ?? 0);
