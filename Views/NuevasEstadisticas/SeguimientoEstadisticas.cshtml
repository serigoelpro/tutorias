                                        </button>
                                    }
                                </div>
                            </div>
                            if (nivelUsuarioBanner == 4)
                            {
                                <div class="corte-modal-overlay" id="corteModalOverlay">
                                    <div class="corte-modal" role="dialog" aria-modal="true" aria-labelledby="corteModalTitulo">
                                        <div class="corte-modal-head">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            <strong id="corteModalTitulo">Corte manual</strong>
                                        </div>
                                        <div class="corte-modal-body">
                                            <div class="corte-modal-dato">
                                                <span class="corte-modal-chip"><i class="fas fa-calendar-alt"></i> @ViewBag.PeriodoActivoNombre</span>
                                                <span class="corte-modal-chip"><i class="fas fa-hourglass-half"></i> @diasCierre día@(diasCierre == 1 ? "" : "s") restante@(diasCierre == 1 ? "" : "s")</span>
                                            </div>
                                            <p>
                                                Se cerrará el período actual <strong>ahora</strong>: se guardará el snapshot en el historial
                                                y <strong>todas las secciones de estadísticas se reiniciarán a cero</strong>
