                                                                        <td><strong>Alumnos con Arrastre:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-warning">@estadisticasArrastre.TotalAlumnosConArrastre</span></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><strong>Fuera de Tiempo:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-danger">@estadisticasArrastre.FueraDeTiempo</span></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><strong>Críticos (≤60 días):</strong></td>
                                                                        <td class="text-end"><span class="badge bg-warning">@estadisticasArrastre.Criticos</span></td>
                                                                    </tr>
