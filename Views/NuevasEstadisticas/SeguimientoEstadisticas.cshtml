                            var ctx = chart.ctx;
                            chart.data.datasets.forEach(function(dataset, i) {
                                var meta = chart.getDatasetMeta(i);
                                meta.data.forEach(function(bar, index) {
                                    var value = dataset.data[index];
                                    if (!value) return;
                                    var pct = totalBajasVuln > 0 ? ((value / totalBajasVuln) * 100).toFixed(1) : '0';
                                    var x = bar.x;
                                    var y = bar.y;
                                    var chartArea = chart.chartArea;
                                    ctx.save();
                                    ctx.fillStyle = '#333';
                                    ctx.font = 'bold 11px Arial';
                                    ctx.textBaseline = 'middle';
                                    var texto = value + ' (' + pct + '%)';
                                    var pad = 6;
                                    if (x + pad + ctx.measureText(texto).width > chartArea.right - 4) {
                                        ctx.textAlign = 'right';
                                        ctx.fillText(texto, x - pad, y);
                                    } else {
                                        ctx.textAlign = 'left';
                                        ctx.fillText(texto, x + pad, y);
                                    }
                                    ctx.restore();
                                });
                            });
                        }
                    }]
                });
            }
        }

        function cargarBajas(corteId) {
            // Filtros solo en vivo (el snapshot historico es agregado).
            $('#causaFiltroBajas, #mesFiltroBajas, #carreraFiltroBajas, #especialidadFiltroBajas, #gradoFiltroBajas, #grupoFiltroBajas').prop('disabled', !!corteId)
                .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
            $.ajax({
                url: '@Url.Action("GetEstadisticasBajas", "NuevasEstadisticas")',
                type: 'POST',
                data: {
                    corteId: corteId || null,
                    causa: (corteId ? null : ($('#causaFiltroBajas').val() || null)),
                    mes: (corteId ? null : ($('#mesFiltroBajas').val() || null)),
                    carreraId: (corteId ? null : ($('#carreraFiltroBajas').val() || null)),
                    especialidadId: (corteId ? null : ($('#especialidadFiltroBajas').val() || null)),
