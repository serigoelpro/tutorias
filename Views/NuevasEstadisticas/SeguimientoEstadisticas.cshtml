<script>
    // Fase 4: tasas por nivel, heatmap carrera×tipo, sexo×carrera, heatmap materia×carrera (client-side puro).
    $(function () {
        var charts = {};

        // ── helpers ──────────────────────────────────────────────────────────────
        function fmt1(v) { return Math.round(v * 10) / 10; }

        function colorHeat(v, max) {
            if (v === null || v === undefined || isNaN(v) || max === 0) return '';
            var t = Math.max(0, Math.min(1, v / max));
            // blanco (#fff) → #b3402e
            var r = Math.round(255 + (224 - 255) * t);
            var g = Math.round(255 + (91  - 255) * t);
            var b = Math.round(255 + (75  - 255) * t);
            return 'background:rgb(' + r + ',' + g + ',' + b + ');color:#1f2937;';
        }

        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

        function renderHeat(contId, columnas, filas) {
            var $c = $('#' + contId); if (!$c.length) return;
            if (!filas || !filas.length) { $c.html('<p class="text-muted small p-2">Sin datos.</p>'); return; }
            // Calcular máximo global para escala de color
            var maxV = 0;
            filas.forEach(function (f) { f.celdas.forEach(function (c) { if (c.v !== null && c.v > maxV) maxV = c.v; }); });

            var html = '<div style="overflow-x:auto;"><table class="dash-heat table table-bordered table-sm mb-1" style="font-size:0.78rem;min-width:300px;">';
            html += '<thead><tr><th class="rowh" style="min-width:120px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></th>';
            columnas.forEach(function (col) { html += '<th style="text-align:center;white-space:nowrap;">' + esc(col) + '</th>'; });
            html += '</tr></thead><tbody>';
            filas.forEach(function (f) {
                html += '<tr><th class="rowh" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;" title="' + esc(f.nombre) + '">' + esc(f.nombre) + '</th>';
                f.celdas.forEach(function (c) {
                    if (c.v === null || c.v === undefined) {
                        html += '<td style="text-align:center;color:#9ca3af;">–</td>';
                    } else {
                        var estilo = colorHeat(c.v, maxV);
                        var titulo = c.abs ? ' title="' + esc(c.abs) + '"' : '';
                        html += '<td style="text-align:center;' + estilo + '"' + titulo + '>' + fmt1(c.v) + '%</td>';
                    }
                });
                html += '</tr>';
            });
            html += '</tbody></table></div>';
            // Leyenda Bajo → Alto
            html += '<div style="display:flex;align-items:center;gap:6px;font-size:0.72rem;color:#6b7280;margin-top:2px;">' +
                '<span>Bajo</span>' +
                '<div class="heat-barra" style="width:80px;height:10px;border-radius:3px;background:linear-gradient(to right,#ffffff,#b3402e);border:1px solid #e5e7eb;"></div>' +
                '<span>Alto</span></div>';
            $c.html(html);
        }

        function barChart(canvasId, labels, datasets, opciones) {
            var el = document.getElementById(canvasId);
            if (!el || typeof Chart === 'undefined') return;
            if (charts[canvasId]) { charts[canvasId].destroy(); delete charts[canvasId]; }
            charts[canvasId] = new Chart(el.getContext('2d'), {
                type: 'bar',
                data: { labels: labels, datasets: datasets },
                options: $.extend(true, { responsive: true, maintainAspectRatio: false }, opciones || {})
            });
        }

        // ── render tasas por nivel ────────────────────────────────────────────────
        function renderTasasNivel(d) {
            if (!$('#tasasNivelWrap').length) return;
            var niveles = [];
            if (d.tsu && d.tsu.total)          niveles.push({ label: 'TSU',          n: d.tsu });
            if (d.ingenieria && d.ingenieria.total)  niveles.push({ label: 'Ingeniería',   n: d.ingenieria });
            if (d.licenciatura && d.licenciatura.total) niveles.push({ label: 'Licenciatura', n: d.licenciatura });
            if (!niveles.length) return;

            // Fila "Total" = suma de los niveles presentes
            var tot = { total: 0, econ: 0, acad: 0, pers: 0, sinSeg: 0 };
            niveles.forEach(function (item) {
                tot.total  += (item.n.total  || 0);
                tot.econ   += (item.n.econ   || 0);
                tot.acad   += (item.n.acad   || 0);
                tot.pers   += (item.n.pers   || 0);
                tot.sinSeg += (item.n.sinSeg || 0);
            });
            var allLabels = niveles.map(function (x) { return x.label; }).concat(['Total']);

            function tasaVuln(n) {
                if (!n.total) return null;
                return (n.econ + n.acad + n.pers) / n.total * 100;
            }
            function tasaSeg(n) {
                if (!n.total) return null;
                return (n.total - n.sinSeg) / n.total * 100;
            }

            var vulnData = niveles.map(function (x) { return tasaVuln(x.n); }).concat([tasaVuln(tot)]);
            var segData  = niveles.map(function (x) { return tasaSeg(x.n); }).concat([tasaSeg(tot)]);

            var optsBase = {
                indexAxis: 'y',
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { min: 0, max: 100, ticks: { callback: function (v) { return v + '%'; } } }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (ctx) { return ' ' + fmt1(ctx.parsed.x) + '%'; }
                        }
                    },
                    legend: { display: false }
                }
            };

            barChart('chartTasaVuln', allLabels,
                [{ label: 'Tasa de Vulnerabilidad', data: vulnData, backgroundColor: '#00695C' }],
                optsBase);
            barChart('chartTasaSeg', allLabels,
                [{ label: 'Tasa de Seguimiento', data: segData, backgroundColor: '#00695C' }],
                optsBase);
        }

        // ── render carrera: heatmap + sexo×carrera ────────────────────────────────
        function renderCarrera(arr) {
            if (!arr || !arr.length) return;

            // ── Heatmap Carrera×Tipo ──────────────────────────────────────────────
            if ($('#heatCarreraTipo').length) {
                var colsTipo = ['Económica', 'Académica', 'Personal', 'Sin Seguimiento'];
                var filasTipo = arr.map(function (c) {
                    var cant = c.cantidad || 0;
                    function pct(x) { return cant ? (x / cant * 100) : null; }
                    return {
                        nombre: c.nombre,
                        celdas: [
                            { v: cant ? pct(c.econ   || 0) : null, abs: cant ? ((c.econ   || 0) + ' de ' + cant) : null },
                            { v: cant ? pct(c.acad   || 0) : null, abs: cant ? ((c.acad   || 0) + ' de ' + cant) : null },
                            { v: cant ? pct(c.pers   || 0) : null, abs: cant ? ((c.pers   || 0) + ' de ' + cant) : null },
                            { v: cant ? pct(c.sinSeg || 0) : null, abs: cant ? ((c.sinSeg || 0) + ' de ' + cant) : null }
                        ]
                    };
                });
                renderHeat('heatCarreraTipo', colsTipo, filasTipo);
            }

            // ── Sexo × Carrera (top-10 por cantidad, apilado) ────────────────────
            if ($('#sexoCarreraWrap').length && $('#chartSexoCarrera').length) {
                var top10 = arr.slice(0, 10);
                var labelsCarr = top10.map(function (c) { return c.nombre; });
                var dataH = top10.map(function (c) { return c.hombres || 0; });
                var dataM = top10.map(function (c) { return c.mujeres || 0; });
                barChart('chartSexoCarrera', labelsCarr,
                    [
                        { label: 'Hombres', data: dataH, backgroundColor: '#1f4e5f' },
                        { label: 'Mujeres', data: dataM, backgroundColor: '#b56d8e' }
                    ],
                    {
                        indexAxis: 'y',
                        responsive: true, maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true, ticks: { precision: 0 } },
                            y: { stacked: true }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) { return ' ' + ctx.dataset.label + ': ' + ctx.parsed.x; }
                                }
                            }
                        }
                    });
            }
        }

        // ── render heatmap materia×carrera ────────────────────────────────────────
        function renderMaterias(materias) {
            if (!$('#heatMateriaCarrera').length || !materias || !materias.length) return;
            // Modo carrera: todas las filas tienen carreraNombre vacío → heatmap no tiene sentido; ocultarlo.
            var todasSinCarrera = materias.every(function (m) { return !m.carreraNombre; });
            var $heatWrap = $('#heatMateriaCarrera').closest('.dash-heat, [class*="col"], [id*="heat"]').addBack();
            if (todasSinCarrera) { $('#heatMateriaCarrera').hide(); $('h4.dash-sub').filter(function(){ return $(this).text().indexOf('Mapa de Calor') >= 0; }).hide(); return; }
            $('#heatMateriaCarrera').show(); $('h4.dash-sub').filter(function(){ return $(this).text().indexOf('Mapa de Calor') >= 0; }).show();

            // Agrupar por materia → suma de reprobadas
            var mapaMateria = {};
            materias.forEach(function (m) {
                var nom = m.nombreMateria || '(sin nombre)';
                if (!mapaMateria[nom]) mapaMateria[nom] = { total: 0, carreras: {} };
                mapaMateria[nom].total += (m.reprobadas || 0);
                if (!mapaMateria[nom].carreras[m.carreraNombre]) {
                    mapaMateria[nom].carreras[m.carreraNombre] = { reprobadas: 0, totalRegistros: 0 };
                }
                mapaMateria[nom].carreras[m.carreraNombre].reprobadas    += (m.reprobadas    || 0);
                mapaMateria[nom].carreras[m.carreraNombre].totalRegistros += (m.totalRegistros || 0);
            });

            // Top-10 materias por suma de reprobadas
            var sorted = Object.keys(mapaMateria).map(function (k) { return { nombre: k, total: mapaMateria[k].total, carreras: mapaMateria[k].carreras }; });
            sorted.sort(function (a, b) { return b.total - a.total; });
            var top10 = sorted.slice(0, 10);

            // Carreras presentes en esas 10 filas
            var carrerasSet = {};
            top10.forEach(function (m) { Object.keys(m.carreras).forEach(function (c) { carrerasSet[c] = true; }); });
            var colsCarr = Object.keys(carrerasSet);

            var filasHeat = top10.map(function (m) {
                return {
                    nombre: m.nombre,
                    celdas: colsCarr.map(function (c) {
                        var datos = m.carreras[c];
                        if (!datos || !datos.totalRegistros) return { v: null, abs: null };
                        var pct = datos.reprobadas / datos.totalRegistros * 100;
                        return { v: pct, abs: datos.reprobadas + ' de ' + datos.totalRegistros + ' registros' };
                    })
                };
            });

            renderHeat('heatMateriaCarrera', colsCarr, filasHeat);
        }

        // ── graficas extra de Demografia (mockup): sexo x nivel, matricula x nivel, sexo x carrera ──
