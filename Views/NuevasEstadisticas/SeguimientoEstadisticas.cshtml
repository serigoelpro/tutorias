<script>
    // Fase 3 Task 3: KPIs en vivo (escuchando los AJAX que la pagina ya hace) + variacion anual.
    $(function () {
        function num(n) { return (n === null || n === undefined || isNaN(n)) ? null : Number(n); }
        function fmt(n) { return n === null ? '–' : n.toLocaleString('es-MX'); }
        var kpisVivo = {}, kpisAnt = null, antCargado = false;

        function pct(parte, total) { return (parte === null || !total) ? null : Math.round(parte * 1000 / total) / 10; }
        function setCard(id, cifra, pctTxt) {
            var $c = $('#' + id);
            $c.find('.kpi-cifra').text(fmt(cifra));
            if (pctTxt !== undefined) $c.find('.kpi-pct').text(pctTxt === null ? '–' : pctTxt + '% del total');
        }
        function pintarVivo() {
            var t = num(kpisVivo.totalEstudiantes);
            setCard('kpiTotal', t, t === null ? null : 100);
            setCard('kpiVulnerables', num(kpisVivo.totalVulnerables), pct(num(kpisVivo.totalVulnerables), t));
            setCard('kpiSinSeg', num(kpisVivo.sinSeguimiento), pct(num(kpisVivo.sinSeguimiento), t));
            setCard('kpiAfectados', num(kpisVivo.alumnosAfectados), pct(num(kpisVivo.alumnosAfectados), t));
            setCard('kpiReprobadas', num(kpisVivo.materiasReprobadas));
            setCard('kpiExtra', num(kpisVivo.extraordinarios));
            setCard('kpiBajas', num(kpisVivo.totalBajas), pct(num(kpisVivo.totalBajas), t));
            pintarVariaciones();
        }
        var MAPA_VAR = { kpiTotal:'totalEstudiantes', kpiVulnerables:'totalVulnerables', kpiSinSeg:'sinSeguimiento', kpiAfectados:'alumnosAfectados', kpiReprobadas:'materiasReprobadas', kpiExtra:'extraordinarios', kpiBajas:'totalBajas' };
        function pintarVariaciones() {
            if (!antCargado) return;
            Object.keys(MAPA_VAR).forEach(function (id) {
                var $v = $('#' + id + ' .kpi-var'); if (!$v.length) return;
                if (!kpisAnt) { $v.attr('class', 'kpi-var var-sindatos').text('Sin datos del periodo anterior'); return; }
                var ahora = num(kpisVivo[MAPA_VAR[id]]), antes = num(kpisAnt[MAPA_VAR[id]]);
                if (ahora === null || antes === null || antes === 0) { $v.attr('class', 'kpi-var var-sindatos').text('Sin comparativo'); return; }
                var delta = Math.round((ahora - antes) * 1000 / antes) / 10;
                var sentido = $v.data('sentido');
                var clase = delta === 0 ? 'var-neutra' : (sentido === 'neutral' ? 'var-neutra' : ((delta < 0) === (sentido === 'down') ? 'var-buena' : 'var-mala'));
                $v.attr('class', 'kpi-var ' + clase).html((delta > 0 ? '▲ +' : (delta < 0 ? '▼ ' : '')) + delta + '% <span style="font-weight:400;">vs. ' + (kpisAnt._nombre || 'año anterior') + '</span>');
            });
        }
        // Alimentacion en vivo: escuchar los AJAX existentes (no se toca ningun loader).
        $(document).ajaxSuccess(function (e, xhr, opts) {
            var u = (opts.url || '');
            var r = xhr.responseJSON; if (!r || !r.success) return;
            if (u.indexOf('GetEstadisticasPorEspecialidad') !== -1 && r.data) {
                kpisVivo.totalEstudiantes = r.data.totalEstudiantes;
                kpisVivo.totalVulnerables = r.data.totalVulnerables;
                kpisVivo.sinSeguimiento = r.data.sinSeguimiento;
                pintarVivo();
            } else if (u.indexOf('GetEstadisticasMaterias') !== -1 && r.data) {
                kpisVivo.alumnosAfectados = r.data.totalAlumnosAfectados;
                var rep = 0, ext = 0;
                (r.data.materias || []).forEach(function (m) { rep += (m.reprobadas || 0); ext += (m.extraordinarios || 0); });
                kpisVivo.materiasReprobadas = rep; kpisVivo.extraordinarios = ext;
                pintarVivo();
            } else if (u.indexOf('GetEstadisticasBajas') !== -1 && r.data) {
                // Nota: TotalBajas es PascalCase en la respuesta real (verificado en renderBajas).
                // Las llamadas con corteId (modo historico) tambien pasan por aqui — aceptado para Fase 3;
                // los KPIs reflejaran lo ultimo cargado (ver f3-task-3-report.md).
                kpisVivo.totalBajas = r.data.TotalBajas;
                pintarVivo();
            }
        });
        // Variacion anual: solo si hay tarjetas .kpi-var (gate Razor nivel 4)
        if ($('#seccionKpis .kpi-var').length) {
            $.post('@Url.Action("GetKpisAnioAnterior", "NuevasEstadisticas")', {}, function (r) {
                antCargado = true;
                kpisAnt = (r && r.success && r.encontrado) ? $.extend({ _nombre: r.nombrePeriodo }, r.kpis) : null;
                pintarVariaciones();
            }, 'json').fail(function () { antCargado = true; kpisAnt = null; pintarVariaciones(); });
        }
        // Disparo inicial: GetEstadisticasPorEspecialidad se llama automaticamente via los filtros
        // de cada seccion. Sin una llamada explicita aqui, el resumen inicial renderizado por el servidor
        // no pasa por AJAX, por lo que las tarjetas
        // quedarian en "--". Se hace un $.post inicial aqui para garantizar la alimentacion
        // al cargar por primera vez o cuando no hay filtros guardados.
        if (!$('#seccionKpis .kpi-cifra').filter(function () { return $(this).text() !== '–'; }).length) {
            $.post('@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")', {}, null, 'json');
            // ajaxSuccess lo captura automaticamente arriba — no se necesita callback aqui.
        }
        // 2026-08-01: el disparo inicial de Bajas ya no hace falta aqui — la nueva seccion "Bajas"
        // (al final de la pagina) hace el POST a GetEstadisticasBajas a los 3s y este listener
        // ajaxSuccess toma esa misma respuesta para el KPI.
    });
</script>
<script>
