                <div id="vulnModalError" style="display:none; color:#a33; padding:12px;"></div>
                <table class="table table-striped" id="vulnModalTabla" style="display:none;">
                    <thead><tr><th>Matrícula</th><th>Alumno</th><th>Especialidad</th><th>Clasificado por</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="reprobAlumnoModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:2000;">
        <div style="background:#fff; border-radius:12px; max-width:640px; width:92%; margin:6vh auto 0; max-height:82vh; overflow:auto; box-shadow:0 20px 50px rgba(0,0,0,.35);">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 20px; border-bottom:1px solid #eef0f2;">
                <strong id="reprobAlumnoModalTitulo" style="color:#1f2937;"></strong>
                <button type="button" id="reprobAlumnoModalCerrar" class="btn btn-sm btn-default" title="Cerrar"><i class="fas fa-times"></i></button>
            </div>
            <div id="reprobAlumnoModalCuerpo" style="padding: 14px 20px;"></div>
        </div>
    </div>
    <div id="progRepOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2000;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:12px;max-width:420px;margin:auto;padding:0;box-shadow:0 10px 40px rgba(0,0,0,.25);">
            <div style="background:linear-gradient(135deg,var(--dash-verde),var(--dash-verde-2));color:#fff;border-radius:12px 12px 0 0;padding:12px 16px;font-weight:700;"><i class="far fa-clock"></i> Programar Reporte</div>
            <div style="padding:16px;font-size:13.5px;color:#374151;">
                El reporte ejecutivo se genera automáticamente al cierre de cada cuatrimestre
                (<b>30 de abril</b>, <b>31 de agosto</b> y <b>31 de diciembre</b>) como parte del corte programado.
                La programación personalizada de reportes estará disponible en una versión futura.
            </div>
            <div style="padding:0 16px 16px;text-align:right;"><button type="button" id="progRepCerrar" class="btn btn-sm btn-success">Entendido</button></div>
        </div>
    </div>
    <script>
        $(function () {
            $('#btnProgramarReporte').on('click', function () { $('#progRepOverlay').css('display', 'flex'); });
            $('#progRepOverlay').on('click', function (e) { if (e.target === this) $('#progRepOverlay').hide(); });
            $('#progRepCerrar').on('click', function () { $('#progRepOverlay').hide(); });
        });
    </script>
    <div class="container-fluid mt-4">
        <div class="card shadow-sm">
                    @{
                        var incluirBajasActual = ViewBag.IncluirBajas as bool? ?? false;
                    }
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; padding: 1rem 1.25rem 0; gap: 10px 16px;">
                        <div style="display:flex; flex-direction:column; align-items:flex-start; gap: 8px;">
                            <h2 style="margin: 0;">Estadísticas Detalladas de Seguimiento</h2>
                            @if (ViewBag.CorteVigenteDesde != null)
                            {
                                <span class="corte-badge" title="Ya se hizo un corte en este ciclo: las estadísticas en vivo cuentan la actividad posterior al corte. Lo anterior se consulta con el botón Histórico de cada sección.">
                                    <i class="fas fa-scissors"></i>
                                    <span>Datos desde el corte del <strong>@(((DateTime)ViewBag.CorteVigenteDesde).ToString("dd/MM/yyyy HH:mm"))</strong></span>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @ViewBag.Error
                            </div>
                        }
                        @if (TempData["ExportError"] != null)
                        {
                            <div class="alert alert-danger mt-2">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @TempData["ExportError"]
                            </div>
                        }
                        @if (ViewBag.Error == null)
                        {
                            @* Estado del período: periodo activo + dias restantes; se vuelve aviso al acercarse el cierre *@
                            int diasCierre = ViewBag.DiasRestantesCierre as int? ?? 999;
                            int sinSegBanner = ViewBag.SinSeguimientoTotal as int? ?? 0;
                            string periodoEstado = diasCierre <= 1 ? "danger" : (diasCierre <= 15 ? "warning" : "info");
                            string periodoIcono = diasCierre <= 7 ? "fa-exclamation-triangle" : "fa-calendar-check";
                            int nivelUsuarioBanner = ViewBag.UsuarioNivel as int? ?? 0;
                            <style>
                                .periodo-estado { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px 24px; background:#fff; border:1px solid #e5e7eb; border-left:5px solid #00695C; border-radius:12px; padding:14px 20px; margin-bottom:14px; box-shadow:0 2px 8px rgba(0,0,0,.06); }
                                .periodo-estado .periodo-info { display:flex; flex-direction:column; gap:3px; }
                                .periodo-estado .periodo-label { font-size:12px; letter-spacing:.6px; text-transform:uppercase; color:#6b7280; font-weight:600; }
                                .periodo-estado .periodo-label i { color:#00695C; margin-right:7px; }
                                .periodo-estado .periodo-nombre { font-size:19px; font-weight:700; color:#1f2937; }
                                .periodo-estado .periodo-acciones { display:flex; align-items:center; flex-wrap:wrap; gap:12px 16px; }
                                .periodo-estado .periodo-contador { display:flex; align-items:center; gap:12px; background:linear-gradient(135deg,#00695C,#00897B); color:#fff; padding:9px 18px; border-radius:10px; box-shadow:0 3px 8px rgba(0,105,92,.28); }
                                .periodo-estado .periodo-contador i { color:#A7E3D8; font-size:19px; }
                                .periodo-estado .periodo-dias { font-size:30px; font-weight:800; line-height:1; font-variant-numeric:tabular-nums; }
                                .periodo-estado .periodo-dias-label { font-size:11px; text-transform:uppercase; letter-spacing:.5px; line-height:1.15; opacity:.9; }
                                .periodo-estado.periodo-warning { border-left-color:#e67e22; }
                                .periodo-estado.periodo-warning .periodo-contador { background:linear-gradient(135deg,#e67e22,#d35400); box-shadow:0 3px 8px rgba(230,126,34,.3); }
                                .periodo-estado.periodo-warning .periodo-contador i { color:#fff; }
                                .periodo-estado.periodo-danger { border-left-color:#c0392b; }
                                .periodo-estado.periodo-danger .periodo-contador { background:linear-gradient(135deg,#c0392b,#96281b); box-shadow:0 3px 8px rgba(192,57,43,.3); animation:periodoPulse 2s infinite; }
                                .periodo-estado.periodo-danger .periodo-contador i { color:#fff; }
                                .btn-corte-manual { display:inline-flex; align-items:center; gap:9px; background:#fff; color:#c0392b; border:1.5px solid #E4B7B0; border-radius:10px; padding:10px 18px; font-size:13px; font-weight:600; line-height:1.2; cursor:pointer; transition:background .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease; box-shadow:0 1px 3px rgba(0,0,0,.05); }
                                .btn-corte-manual i { font-size:12.5px; }
                                .btn-corte-manual:hover { background:#c0392b; border-color:#c0392b; color:#fff; box-shadow:0 3px 8px rgba(192,57,43,.3); }
                                .btn-corte-manual:disabled { opacity:.55; cursor:not-allowed; background:#fff; color:#c0392b; border-color:#E4B7B0; box-shadow:none; }
                                /* Modal de confirmacion del corte manual (propio: la vista mezcla BS3/BS5) */
                                .corte-modal-overlay { position:fixed; top:0; right:0; bottom:0; left:0; background:rgba(17,24,39,.55); z-index:2000; display:none; align-items:center; justify-content:center; padding:16px; }
                                .corte-modal { background:#fff; border-radius:14px; max-width:540px; width:100%; box-shadow:0 20px 50px rgba(0,0,0,.35); overflow:hidden; animation:corteModalIn .16s ease-out; }
                                .corte-modal-head { display:flex; align-items:center; gap:11px; padding:15px 22px; background:#fff; border-bottom:1px solid #eef0f2; }
                                .corte-modal-head i { color:#6b7280; font-size:15px; }
                                .corte-modal-head strong { color:#1f2937; font-size:15px; letter-spacing:.2px; }
                                .corte-modal-body { padding:18px 22px 6px; color:#374151; font-size:13.5px; line-height:1.6; }
                                .corte-modal-body p { margin:0 0 12px; }
                                .corte-modal-dato { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
                                .corte-modal-chip { display:inline-flex; align-items:center; gap:7px; background:#f6f7f8; color:#374151; border:1px solid #e5e7eb; border-radius:999px; padding:5px 13px; font-size:12px; font-weight:600; }
                                .corte-modal-chip i { color:#00695C; }
                                .corte-modal-alerta { display:flex; gap:9px; align-items:flex-start; background:#f9fafb; border:1px solid #e5e7eb; color:#4b5563; border-radius:10px; padding:10px 12px; font-size:12.5px; }
                                .corte-modal-alerta i { color:#9ca3af; margin-top:2px; }
                                .corte-modal-foot { display:flex; justify-content:flex-end; gap:10px; padding:14px 22px 16px; background:#f9fafb; border-top:1px solid #eef0f2; }
                                .btn-corte-cancelar { background:#fff; color:#374151; border:1.5px solid #d6dade; border-radius:10px; padding:9px 18px; font-size:13px; font-weight:600; cursor:pointer; transition:background .15s ease; }
                                .btn-corte-cancelar:hover { background:#f3f4f6; }
                                .btn-corte-confirmar { display:inline-flex; align-items:center; gap:8px; background:#c0392b; color:#fff; border:1.5px solid #c0392b; border-radius:10px; padding:9px 18px; font-size:13px; font-weight:700; cursor:pointer; transition:background .15s ease, box-shadow .15s ease; }
                                .btn-corte-confirmar:hover { background:#a93226; box-shadow:0 3px 8px rgba(192,57,43,.35); }
                                @@keyframes corteModalIn { from { transform:translateY(10px) scale(.98); opacity:0 } to { transform:none; opacity:1 } }
                                .periodo-aviso { display:flex; align-items:flex-start; gap:8px; background:#fff8ec; border:1px solid #f6d9a8; color:#8a5a00; border-radius:10px; padding:10px 14px; margin-bottom:14px; font-size:13.5px; }
                                .periodo-aviso i { margin-top:2px; color:#e67e22; }
                                .periodo-estado.periodo-danger ~ .periodo-aviso { background:#fdecea; border-color:#f5c6c0; color:#a12a1c; }
                                .periodo-estado.periodo-danger ~ .periodo-aviso i { color:#c0392b; }
                                @@keyframes periodoPulse { 0%{ box-shadow:0 0 0 0 rgba(192,57,43,.6) } 70%{ box-shadow:0 0 0 10px rgba(192,57,43,0) } 100%{ box-shadow:0 0 0 0 rgba(192,57,43,0) } }
                                @@media (max-width:576px){ .periodo-estado{ justify-content:center; text-align:center } .periodo-estado .periodo-info{ align-items:center } .periodo-estado .periodo-acciones{ justify-content:center } }
                            </style>
                            @* Gestión del ciclo (período, contador, corte, aviso de cierre): SOLO Máster.
                               Los demás niveles solo ven el efecto del corte (badge + datos reiniciados). *@
                            if (nivelUsuarioBanner == 4)
                            {
                            <div class="periodo-estado periodo-@periodoEstado">
                                <div class="periodo-info">
                                    <span class="periodo-label"><i class="fas fa-calendar-alt"></i>Período activo</span>
                                    <span class="periodo-nombre">@ViewBag.PeriodoActivoNombre</span>
                                </div>
                                <div class="periodo-acciones">
                                    <div class="periodo-contador" title="Días restantes para el cierre del cuatrimestre">
                                        <i class="fas @periodoIcono"></i>
                                        <span class="periodo-dias">@diasCierre</span>
                                        <span class="periodo-dias-label">Días<br />restantes</span>
                                    </div>
                                    @* Respaldo manual del corte automatico programado - solo Master *@
                                    @if (nivelUsuarioBanner == 4)
                                    {
                                        <button type="button" id="btnCorteManual" class="btn-corte-manual"
                                                title="Cierra el período ahora. Úselo solo si el corte automático no se ejecutó.">
                                            <i class="fas fa-scissors"></i> CORTE MANUAL
                                        </button>
                                    }
                                </div>
                            </div>
                            if (nivelUsuarioBanner == 4)
                            {
                                <div class="corte-modal-overlay" id="corteModalOverlay">
                                    <div class="corte-modal" role="dialog" aria-modal="true" aria-labelledby="corteModalTitulo">
                                        <div class="corte-modal-head">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            <strong id="corteModalTitulo">Corte manual</strong>
                                        </div>
                                        <div class="corte-modal-body">
                                            <div class="corte-modal-dato">
                                                <span class="corte-modal-chip"><i class="fas fa-calendar-alt"></i> @ViewBag.PeriodoActivoNombre</span>
                                                <span class="corte-modal-chip"><i class="fas fa-hourglass-half"></i> @diasCierre día@(diasCierre == 1 ? "" : "s") restante@(diasCierre == 1 ? "" : "s")</span>
                                            </div>
                                            <p>
                                                Se cerrará el período actual <strong>ahora</strong>: se guardará el snapshot en el historial
                                                y <strong>todas las secciones de estadísticas se reiniciarán a cero</strong>
                                                (solo contarán la actividad posterior al corte).
                                            </p>
                                            @if (diasCierre > 1)
                                            {
                                                <p class="corte-modal-alerta">
                                                    <i class="fas fa-exclamation-triangle"></i>
                                                    <span>
                                                        El período aún no termina. Este botón es un <strong>respaldo</strong> para cuando el corte
                                                        automático de fin de cuatrimestre no se ejecuta; si corta ahora, el automático detectará
                                                        que el período ya tiene corte y no lo duplicará.
                                                    </span>
                                                </p>
                                            }
                                            <p style="color:#374151; font-weight:600;">Esta acción no se puede deshacer.</p>
                                        </div>
                                        <div class="corte-modal-foot">
                                            <button type="button" id="corteModalCancelar" class="btn-corte-cancelar">Cancelar</button>
                                            <button type="button" id="corteModalConfirmar" class="btn-corte-confirmar">
                                                <i class="fas fa-scissors"></i> Sí, hacer el corte
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            if (diasCierre <= 15)
                            {
                                <div class="periodo-aviso">
                                    <i class="fas fa-exclamation-triangle"></i>
