@section scripts {
    @Html.AntiForgeryToken()

    @* Chart.js CDN *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js" integrity="sha384-9MhbyIRcBVQiiC7FSd7T38oJNj2Zh+EfxS7/vjhBi4OOT78NlHSnzM31EZRWR1LZ" crossorigin="anonymous"></script>
    <script>
        // ===== Estilo global de graficas (look ejecutivo tipo Power BI, 2026-07-28) =====
        // Un solo lugar para tipografia, cuadricula, leyendas y tooltips de TODOS los charts.
        (function () {
            if (typeof Chart === 'undefined') return;
            Chart.defaults.font.family = "'Segoe UI', system-ui, -apple-system, sans-serif";
            Chart.defaults.font.size = 11;
            Chart.defaults.color = '#5a6a76';
            Chart.defaults.elements.bar.borderRadius = 3;
            Chart.defaults.elements.arc.borderWidth = 2;
            Chart.defaults.elements.arc.borderColor = '#fff';
            Chart.defaults.elements.line.tension = 0.3;
            Chart.defaults.elements.line.borderWidth = 2;
            Chart.defaults.elements.point.radius = 3;
            Chart.defaults.plugins.legend.labels.usePointStyle = true;
            Chart.defaults.plugins.legend.labels.boxWidth = 7;
            Chart.defaults.plugins.legend.labels.boxHeight = 7;
            Chart.defaults.plugins.legend.labels.padding = 12;
            Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(31,41,55,.95)';
            Chart.defaults.plugins.tooltip.padding = 10;
            Chart.defaults.plugins.tooltip.cornerRadius = 8;
            Chart.defaults.plugins.tooltip.titleFont = { weight: 'bold', size: 12 };
            Chart.defaults.plugins.title.color = '#374151';
            Chart.defaults.plugins.title.font = { size: 12, weight: 'bold' };
            Chart.defaults.scale.grid = Chart.defaults.scale.grid || {};
            Chart.defaults.scale.grid.color = 'rgba(90,106,118,.10)';
            Chart.defaults.scale.grid.drawBorder = false;
        })();
    </script>

    <script>
        // Funciones de exportación a Excel (globales)
        function exportarResumenDetallado() {
            mostrarCargando('Exportando resumen detallado...');
            var especialidadId = $('#especialidadFiltro').val() || null;
            var carreraId = $('#carreraFiltroResumen').val() || null;
            var mes = $('#mesFiltroVulnerabilidad').val() || null;
            var grupoId = $('#grupoFiltroResumen').val() || null;
            var gradoId = $('#gradoFiltroResumen').val() || null;
            var sexo = ($('#sbSexo').length ? ($('#sbSexo').val() || null) : null);
            // Estatus: sbEstatus='1' => incluirBajas=true; el toggle de sección también aplica
            var sbEstatusVal = $('#sbEstatus').length ? ($('#sbEstatus').val() || '') : '';
            var incluirBajasExport = incluirBajasResumen || (sbEstatusVal === '1');

            // Crear formulario para descarga directa
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ExportarEstadisticasDetalladas", "NuevasEstadisticas")';
            form.style.display = 'none';

            function addHiddenR(name, value) {
                if (value === null || value === undefined || value === '') return;
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = name;
                inp.value = value;
                form.appendChild(inp);
            }

            // Agregar token anti-forgery si es necesario
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (token) {
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                form.appendChild(tokenInput);
            }

            addHiddenR('especialidadId', especialidadId);
            addHiddenR('carreraId', carreraId);
            addHiddenR('mes', mes);
            addHiddenR('grupoId', grupoId);
            addHiddenR('gradoId', gradoId);
            addHiddenR('sexo', sexo);

            var bajasInputR = document.createElement('input');
            bajasInputR.type = 'hidden';
            bajasInputR.name = 'incluirBajas';
            bajasInputR.value = incluirBajasExport ? 'true' : 'false';
            form.appendChild(bajasInputR);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);

            // Ocultar cargando después de un breve delay
            setTimeout(function() {
                ocultarCargando();
            }, 1000);
        }

        function exportarVulnerabilidades() {
            mostrarCargando('Exportando vulnerabilidades...');
            var mes = $('#mesFiltroVulnerabilidad').val() || null;

            // Crear formulario para descarga directa
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ExportarVulnerabilidades", "NuevasEstadisticas")';
            form.style.display = 'none';

            // Agregar token anti-forgery si es necesario
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (token) {
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                form.appendChild(tokenInput);
            }

            // Agregar parámetro mes si existe
            if (mes) {
                var mesInput = document.createElement('input');
                mesInput.type = 'hidden';
                mesInput.name = 'mes';
                mesInput.value = mes;
                form.appendChild(mesInput);
            }

            var bajasInputV = document.createElement('input');
            bajasInputV.type = 'hidden';
            bajasInputV.name = 'incluirBajas';
            bajasInputV.value = incluirBajasVulnerabilidad ? 'true' : 'false';
            form.appendChild(bajasInputV);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);

            // Ocultar cargando después de un breve delay
            setTimeout(function() {
                ocultarCargando();
            }, 1000);
        }

        function exportarCierreCuatrimestres() {
            mostrarCargando('Exportando estadísticas por cierre de cuatrimestres...');

            // Crear formulario para descarga directa
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ExportarCierreCuatrimestres", "NuevasEstadisticas")';
            form.style.display = 'none';

            // Agregar token anti-forgery si es necesario
            var token = $('input[name="__RequestVerificationToken"]').val();
