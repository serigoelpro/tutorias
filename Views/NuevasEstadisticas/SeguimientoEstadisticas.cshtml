                                .periodo-estado.periodo-danger .periodo-contador { background:linear-gradient(135deg,#c0392b,#96281b); box-shadow:0 3px 8px rgba(192,57,43,.3); animation:periodoPulse 2s infinite; }
                                .periodo-estado.periodo-danger .periodo-contador i { color:#fff; }
                                .btn-corte-manual { display:inline-flex; align-items:center; gap:9px; background:#fff; color:#c0392b; border:1.5px solid #E4B7B0; border-radius:10px; padding:10px 18px; font-size:13px; font-weight:600; line-height:1.2; cursor:pointer; transition:background .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease; box-shadow:0 1px 3px rgba(0,0,0,.05); }
                                .btn-corte-manual i { font-size:12.5px; }
