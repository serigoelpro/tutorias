                { label: 'Académicos', data: top10.map(function (c) { return c.acad || 0; }), backgroundColor: '#dba13a' },
                { label: 'Personales', data: top10.map(function (c) { return c.pers || 0; }), backgroundColor: '#74628f' }
            ], { indexAxis: 'y', scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true, ticks: { font: { size: 9 } } } }, plugins: { legend: { labels: { font: { size: 10 } } } } });
        }
        // Re-render desde cache cuando la seccion Demografia repinta (toggle tabla/grafica, colapso).
        window.renderDemoExtras = function () {
            renderDemoNivel(demoCache.nivel);
            renderDemoSexoCarrera(demoCache.carreras);
        };
        // Idem para la apilada por carrera de la seccion Vulnerabilidad.
        window.renderVulnCarreraExtra = function () { renderVulnCarrera(demoCache.carreras); };
        // Director (nivel 3): no existe la seccion Carrera ⇒ sin datos por carrera; ocultar esas columnas.
        if (!document.getElementById('tablaCarreras')) { $('#demoSexoCarreraCol').hide(); $('#vulnCarreraCol').hide(); }

        // ── listener ajaxSuccess (independiente del de Fase 3) ───────────────────
        $(document).ajaxSuccess(function (e, xhr, opts) {
            var u = opts.url || '';
            var r = xhr.responseJSON; if (!r || !r.success) return;
            if (u.indexOf('GetEstadisticasPorNivelEstudio') !== -1 && r.data) {
                renderTasasNivel(r.data);
                demoCache.nivel = r.data;
                renderDemoNivel(r.data);
            } else if (u.indexOf('GetEstadisticasPorCarrera') !== -1 && r.data) {
                renderCarrera(r.data);
                demoCache.carreras = r.data;
                renderDemoSexoCarrera(r.data);
                renderVulnCarrera(r.data);
            } else if (u.indexOf('GetEstadisticasMaterias') !== -1 && r.data && r.data.materias) {
                renderMaterias(r.data.materias);
            }
        });
    });
