                                            type: 'bar',
                                            data: { labels: etiquetas, datasets: SERIES.map(function (s) { return { label: s.label, data: conDatos.map(function (p) { return v(p, s); }), backgroundColor: s.color }; }) },
                                            options: { responsive: true, maintainAspectRatio: false, scales: { y: { ticks: { precision: 0 } } }, plugins: { legend: { labels: { font: { size: 10 } } } } }
                                        });
                                        // Dona: agregado de todos los cierres con datos.
                                        var ctxD = document.getElementById('chartCierreDona');
                                        if (ctxD) {
                                            if (_chCierreDona) _chCierreDona.destroy();
                                            var sumas = SERIES.map(function (s) { return conDatos.reduce(function (acc, p) { return acc + v(p, s); }, 0); });
                                            _chCierreDona = new Chart(ctxD, {
                                                type: 'doughnut',
                                                data: { labels: SERIES.map(function (s) { return s.label; }), datasets: [{ data: sumas, backgroundColor: SERIES.map(function (s) { return s.color; }) }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } } }
                                            });
                                        }
                                        // Apiladas 100%: composicion relativa por cierre.
                                        var ctxP = document.getElementById('chartCierrePct');
                                        if (ctxP) {
                                            if (_chCierrePct) _chCierrePct.destroy();
                                            var totales = conDatos.map(function (p) { return SERIES.reduce(function (acc, s) { return acc + v(p, s); }, 0); });
                                            _chCierrePct = new Chart(ctxP, {
                                                type: 'bar',
                                                data: {
                                                    labels: etiquetas,
                                                    datasets: SERIES.map(function (s) {
                                                        return { label: s.label, data: conDatos.map(function (p, i) { return totales[i] ? Math.round(v(p, s) / totales[i] * 1000) / 10 : 0; }), backgroundColor: s.color };
                                                    })
                                                },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return ' ' + c.dataset.label + ': ' + c.parsed.y + '%'; } } } }, scales: { x: { stacked: true }, y: { stacked: true, max: 100, ticks: { callback: function (val) { return val + '%'; } } } } }
                                            });
                                        }
                                    }
                                    function renderChartCarrera(arr) {
                                        var ctx = document.getElementById('chartModoCarrera'); if (!ctx || typeof Chart === 'undefined' || !arr || !arr.length) return;
                                        if (_chCarrera) _chCarrera.destroy();
                                        _chCarrera = new Chart(ctx, {
                                            type: 'bar',
                                            data: { labels: arr.map(function (c) { return c.nombre || '—'; }), datasets: SERIES.map(function (s) { return { label: s.label, data: arr.map(function (c) { return v(c, s); }), backgroundColor: s.color }; }) },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } } }
                                        });
                                    }
                                    var _chMateriasTabla = null;
                                    function renderChartMateriasTabla(materias) {
                                        var ctx = document.getElementById('chartModoMateriasTabla'); if (!ctx || typeof Chart === 'undefined') return;
                                        if (_chMateriasTabla) _chMateriasTabla.destroy();
                                        var nota = document.getElementById('chartNotaMateriasTabla');
                                        if (!materias || !materias.length) { if (nota) nota.textContent = 'Sin datos para graficar.'; return; }
                                        var orden = materias.slice().sort(function (a, b) { return (b.alumnosDistintos || 0) - (a.alumnosDistintos || 0); });
                                        var top = orden.slice(0, 15);
                                        if (nota) nota.textContent = (orden.length > 15 ? ('Top 15 de ' + orden.length + ' materias por alumnos, con su distribución de intentos — cambia a modo tabla para ver todas.') : 'Distribución de intentos de extraordinario por materia.');
                                        _chMateriasTabla = new Chart(ctx, {
                                            type: 'bar',
                                            data: {
                                                labels: top.map(function (m) { return m.nombreMateria + (m.carreraNombre ? ' (' + m.carreraNombre + ')' : ''); }),
                                                datasets: [
                                                    { label: '1er intento', data: top.map(function (m) { return m.intentos1 || 0; }), backgroundColor: '#dba13a' },
                                                    { label: '2do intento', data: top.map(function (m) { return m.intentos2 || 0; }), backgroundColor: '#c67b35' },
                                                    { label: '3+ intentos (crítico)', data: top.map(function (m) { return m.intentos3Mas || 0; }), backgroundColor: '#b3402e' },
                                                    { label: 'Sin intento (arrastre)', data: top.map(function (m) { return m.intentos0 || 0; }), backgroundColor: '#8a97a0' }
                                                ]
                                            },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } } }
                                        });
                                        // Fila de 3 compactas del mockup, del MISMO array de materias.
                                        // Top-10 por tasa de reprobacion (min 10 registros para no premiar materias de 2 alumnos).
                                        var ctxT = document.getElementById('chartMatTasa');
                                        if (ctxT) {
                                            if (_chMatTasa) _chMatTasa.destroy();
                                            var tasas = materias.filter(function (m) { return (m.totalRegistros || 0) >= 10; }).map(function (m) {
                                                return { n: m.nombreMateria, t: Math.round((m.reprobadas || 0) / m.totalRegistros * 1000) / 10 };
                                            }).sort(function (a, b) { return b.t - a.t; }).slice(0, 10);
                                            _chMatTasa = new Chart(ctxT, {
                                                type: 'bar',
                                                data: { labels: tasas.map(function (x) { return x.n; }), datasets: [{ label: 'Tasa', data: tasas.map(function (x) { return x.t; }), backgroundColor: '#b3402e' }] },
                                                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return ' ' + c.parsed.x + '%'; } } } }, scales: { x: { max: 100, ticks: { callback: function (val) { return val + '%'; } } }, y: { ticks: { font: { size: 9 } } } } }
                                            });
                                        }
                                        // Dona de intentos (agregado).
                                        var ctxI = document.getElementById('chartMatIntentos');
                                        if (ctxI) {
                                            if (_chMatIntentos) _chMatIntentos.destroy();
                                            var si = function (k) { return materias.reduce(function (acc, m) { return acc + (m[k] || 0); }, 0); };
                                            _chMatIntentos = new Chart(ctxI, {
                                                type: 'doughnut',
                                                data: { labels: ['Sin intento (arrastre)', '1er intento', '2do intento', '3+ (crítico)'], datasets: [{ data: [si('intentos0'), si('intentos1'), si('intentos2'), si('intentos3Mas')], backgroundColor: ['#8a97a0', '#dba13a', '#c67b35', '#b3402e'] }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } } }
                                            });
                                        }
                                        // Arrastre vs extraordinario (totales).
                                        var ctxR = document.getElementById('chartMatRepExt');
                                        if (ctxR) {
                                            if (_chMatRepExt) _chMatRepExt.destroy();
                                            var totRep = materias.reduce(function (acc, m) { return acc + (m.reprobadas || 0); }, 0);
                                            var totExt = materias.reduce(function (acc, m) { return acc + (m.extraordinarios || 0); }, 0);
                                            _chMatRepExt = new Chart(ctxR, {
                                                type: 'bar',
                                                data: { labels: ['Arrastre (reprobadas)', 'Extraordinario'], datasets: [{ label: 'Registros', data: [totRep, totExt], backgroundColor: ['#b3402e', '#dba13a'] }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { ticks: { precision: 0 } } } }
                                            });
                                        }
                                    }
                                    var _chMatTasa = null, _chMatIntentos = null, _chMatRepExt = null;
                                    var _chComparativo = null;
                                    function renderChartComparativo(d) {
                                        var ctx = document.getElementById('chartModoComparativo'); if (!ctx || typeof Chart === 'undefined' || !d || !d.filas || !d.filas.length) return;
                                        if (_chComparativo) _chComparativo.destroy();
                                        _chComparativo = new Chart(ctx, {
                                            type: 'bar',
                                            data: {
                                                labels: d.filas.map(function (f) { return f.indicador; }),
                                                datasets: [
                                                    { label: d.n1 || 'Período 1', data: d.filas.map(function (f) { return f.c1 || 0; }), backgroundColor: '#1f4e5f' },
                                                    { label: d.n2 || 'Período 2', data: d.filas.map(function (f) { return f.c2 || 0; }), backgroundColor: '#00897B' }
                                                ]
                                            },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { ticks: { precision: 0 } } } }
                                        });
                                    }
                                    function renderChartGrupo(arr) {
                                        var ctx = document.getElementById('chartModoGrupo'); if (!ctx || typeof Chart === 'undefined') return;
                                        if (_chGrupo) _chGrupo.destroy();
                                        var nota = document.getElementById('chartNotaGrupo');
                                        // Nivel 3: la tabla filtra su carrera client-side (DataTables search); la grafica
                                        // debe respetar el mismo filtro para no mostrar grupos de otras carreras.
                                        var carreraCoord = (document.getElementById('buscarCarreraGrupos') || {}).value;
                                        if (arr && arr.length && carreraCoord) {
                                            var cc = carreraCoord.toUpperCase();
                                            arr = arr.filter(function (g) { return ((g.carreraNombre || '').toUpperCase().indexOf(cc) >= 0); });
                                        }
                                        if (!arr || !arr.length) { if (nota) nota.textContent = 'Sin datos de grupos para graficar.'; return; }
                                        var orden = arr.slice().sort(function (a, b) { return (b.totalEstudiantes || 0) - (a.totalEstudiantes || 0); });
                                        var top = orden.slice(0, 15);
                                        if (nota) nota.textContent = orden.length > 15 ? ('Mostrando los 15 grupos con más alumnos de ' + orden.length + ' — cambia a modo tabla para ver todos.') : '';
                                        _chGrupo = new Chart(ctx, {
                                            type: 'bar',
                                            data: { labels: top.map(function (g) { return g.grupoId || ''; }), datasets: SERIES.map(function (s) { return { label: s.label, data: top.map(function (g) { return v(g, s); }), backgroundColor: s.color }; }) },
                                            options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true, ticks: { precision: 0 } }, y: { stacked: true } }, plugins: { legend: { labels: { font: { size: 10 } } } } }
                                        });
                                        // Dona: agregado de los grupos mostrados (respeta el filtro de carrera de arriba).
                                        var ctxD = document.getElementById('chartGrupoDona');
                                        if (ctxD) {
                                            if (_chGrupoDona) _chGrupoDona.destroy();
                                            var sumas = SERIES.map(function (s) { return arr.reduce(function (acc, g) { return acc + v(g, s); }, 0); });
                                            _chGrupoDona = new Chart(ctxD, {
                                                type: 'doughnut',
                                                data: { labels: SERIES.map(function (s) { return s.label; }), datasets: [{ data: sumas, backgroundColor: SERIES.map(function (s) { return s.color; }) }] },
                                                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } } }
                                            });
                                        }
                                        // Top-10 por % de vulnerabilidad (min 10 alumnos para no premiar grupos chiquitos).
                                        var ctxP = document.getElementById('chartGrupoPctVuln');
                                        if (ctxP) {
                                            if (_chGrupoPct) _chGrupoPct.destroy();
                                            var conPct = arr.filter(function (g) { return (g.totalEstudiantes || 0) >= 10; }).map(function (g) {
                                                var vuln = (g.econ || g.vulnerablesEconomicos || 0) + (g.acad || g.vulnerablesAcademicos || 0) + (g.pers || g.vulnerablesPersonales || 0);
                                                return { id: g.grupoId || '', pct: Math.round(vuln / g.totalEstudiantes * 1000) / 10 };
                                            }).sort(function (a, b) { return b.pct - a.pct; }).slice(0, 10);
                                            _chGrupoPct = new Chart(ctxP, {
                                                type: 'bar',
                                                data: { labels: conPct.map(function (x) { return x.id; }), datasets: [{ label: '% vulnerables', data: conPct.map(function (x) { return x.pct; }), backgroundColor: '#b3402e' }] },
                                                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return ' ' + c.parsed.x + '%'; } } } }, scales: { x: { max: 100, ticks: { callback: function (val) { return val + '%'; } } } } }
                                            });
                                        }
                                    }

                                    document.addEventListener('DOMContentLoaded', function () {
                                        if (!window.ModoEstadisticas) return;
                                        if (document.getElementById('chartWrapNivel'))
                                            ModoEstadisticas.registrar('nivel', { original: '#tablaNiveldeEstudio', charts: '#chartWrapNivel', botonHost: '#modoHostNivel', render: renderChartNivel, cargar: function () { if (typeof cargarNivelEstudio === 'function') cargarNivelEstudio(); } });
                                        if (document.getElementById('chartWrapCierre'))
                                            ModoEstadisticas.registrar('cierre', { original: '#tablaCierreCuatrimestres', charts: '#chartWrapCierre', botonHost: '#modoHostCierre', render: renderChartCierre });
                                        if (document.getElementById('chartWrapCarrera'))
                                            ModoEstadisticas.registrar('carrera', { original: '#tablaCarreras_wrapper, #tablaCarreras', charts: '#chartWrapCarrera', botonHost: '#modoHostCarrera', render: renderChartCarrera, cargar: function () { if (typeof cargarCarreras === 'function') cargarCarreras(); } });
                                        if (document.getElementById('chartWrapGrupo'))
                                            ModoEstadisticas.registrar('grupo', { original: '#tablaGrupos_wrapper, #tablaGrupos', charts: '#chartWrapGrupo', botonHost: '#modoHostGrupo', render: renderChartGrupo, cargar: function () { if (typeof window.cargarEstadisticasGrupos === 'function') window.cargarEstadisticasGrupos(); } });
                                        if (document.getElementById('chartWrapComparativo'))
                                            ModoEstadisticas.registrar('comparativo', { original: '#tablaComparativo', charts: '#chartWrapComparativo', botonHost: '#modoHostComparativo', render: renderChartComparativo });
                                        if (document.getElementById('chartWrapMateriasTabla'))
                                            ModoEstadisticas.registrar('materiasTabla', { original: '#wrapTablaMaterias, #filtroMaterias', charts: '#chartWrapMateriasTabla', botonHost: '#modoHostMaterias', render: renderChartMateriasTabla });
                                    });
                                })();
                            </script>

                            @* ===== Fase 3 Task 2: franja de 7 tarjetas KPI ===== *@
                            <section class="data-block" id="seccionKpis">
                                <div class="card-header d-flex justify-content-between align-items-center" style="margin-bottom:10px;">
                                    <h3 class="section-title"><i class="fas fa-gauge-high"></i> Resumen General (@ViewBag.PeriodoActivoNombre)</h3>
                                </div>
                                <div class="kpi-grid">
                                    @{ bool esMasterKpi = (ViewBag.UsuarioNivel as int? ?? 0) == 4; }
                                    <div class="kpi-card" id="kpiTotal">
                                        <i class="fas fa-users kpi-icono"></i>
                                        <div class="kpi-titulo">Total Estudiantes</div>
                                        <div class="kpi-cifra">–</div>
                                        <div class="kpi-pct">100% del total</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="neutral">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiVulnerables">
                                        <i class="fas fa-triangle-exclamation kpi-icono"></i>
                                        <div class="kpi-titulo">Estudiantes Vulnerables</div>
                                        <div class="kpi-cifra">–</div>
                                        <div class="kpi-pct">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiSinSeg">
                                        <i class="fas fa-user-clock kpi-icono"></i>
                                        <div class="kpi-titulo">Sin Seguimiento</div>
                                        <div class="kpi-cifra">–</div>
                                        <div class="kpi-pct">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiAfectados">
                                        <i class="fas fa-user-xmark kpi-icono"></i>
                                        <div class="kpi-titulo">Alumnos con Reprobadas/Extra</div>
                                        <div class="kpi-cifra">–</div>
                                        <div class="kpi-pct">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiReprobadas">
                                        <i class="fas fa-book kpi-icono"></i>
                                        <div class="kpi-titulo">Materias Reprobadas (arrastre)</div>
                                        <div class="kpi-cifra">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiExtra">
                                        <i class="fas fa-book-open kpi-icono"></i>
                                        <div class="kpi-titulo">En Extraordinario</div>
                                        <div class="kpi-cifra">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                    <div class="kpi-card" id="kpiBajas">
                                        <i class="fas fa-user-slash kpi-icono"></i>
                                        <div class="kpi-titulo">Bajas</div>
                                        <div class="kpi-cifra">–</div>
                                        <div class="kpi-pct">–</div>
                                        @if (esMasterKpi) { <div class="kpi-var" data-sentido="down">–</div> }
                                    </div>
                                </div>
                                <div class="kpi-nota">Los porcentajes se calculan sobre el total de estudiantes activos. Las cifras respetan los filtros aplicados.</div>
                            </section>

                            @* ===== Fase 5: Insights Clave ===== *@
                            <section class="data-block" id="seccionInsights">
                                <div class="card-header"><h3 class="section-title"><i class="fas fa-lightbulb"></i> Insights Clave</h3></div>
                                <div class="card-body"><div id="insightsWrap" class="insights-grid"><p class="text-muted small mb-0">Calculando…</p></div></div>
                            </section>

                            @* Resumen detallado en la parte superior *@
                            <section class="data-block">
                                <div class="card-header d-flex justify-content-between align-items-center" style=" margin-bottom: 10px;">
                                    <h3 class="section-title">
                                        <i class="fas fa-chart-pie"></i>
                                        Resumen Detallado
                                    </h3>
                                </div>

                                @* Filtros por especialidad y carrera - Solo visible para Master (nivel 4) *@
                                @{
                                    var usuarioNivel = ViewBag.UsuarioNivel as int? ?? 0;
                                    var esCoordinador = usuarioNivel == 3;
                                    var esMaster = usuarioNivel == 4;
                                }
                                @if (esMaster)
                                {
                                    <div class="card mt-4 mb-3" style="margin-bottom: 10px;">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-5" style="margin-bottom: 10px;">
                                                    <label for="carreraFiltroResumen" class="form-label">Seleccionar Carrera:</label>
                                                    <select id="carreraFiltroResumen" class="form-select">
                                                        <option value="">Todas las carreras</option>
                                                        @if (ViewBag.Carreras != null)
                                                        {
                                                            var carreras = ViewBag.Carreras as Dictionary<int, string>;
                                                            foreach (var carrera in carreras)
                                                            {
                                                                <option value="@carrera.Key">@carrera.Value</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-5" style="margin-bottom: 10px;">
                                                    <label for="especialidadFiltro" class="form-label">Seleccionar Especialidad:</label>
                                                    <select id="especialidadFiltro" class="form-select">
                                                        <option value="">Todas las especialidades</option>
                                                        @if (ViewBag.Especialidades != null)
                                                        {
                                                            var especialidades = ViewBag.Especialidades as List<PlataformaWeb.BecasTransporte.Models.Especialidad>;
                                                            var espCarreraMapRes = ViewBag.EspecialidadCarrera as Dictionary<int, string>;
                                                            foreach (var especialidad in especialidades)
                                                            {
                                                                <option value="@especialidad.Id" data-carrera="@(espCarreraMapRes != null && espCarreraMapRes.ContainsKey(especialidad.Id) ? espCarreraMapRes[especialidad.Id] : "")">@especialidad.Nombre</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-2 d-flex align-items-end">
                                                    <button id="aplicarFiltro" class="btn btn-success me-2">
                                                        <i class="fas fa-search me-1"></i>
                                                        Aplicar
                                                    </button>
                                                    <button id="limpiarFiltro" class="btn btn-utt-outline">
                                                        <i class="fas fa-times me-1"></i>
                                                        Limpiar
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3" style="margin-bottom: 10px;">
                                                    <label for="gradoFiltroResumen" class="form-label">Cuatrimestre (grado):</label>
                                                    <select id="gradoFiltroResumen" class="form-select">
                                                        <option value="">Todos</option>
                                                        @if (ViewBag.FiltroGrados != null)
                                                        {
                                                            foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrados)
                                                            {
                                                                <option value="@g.Key">@g.Value</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3" style="margin-bottom: 10px;">
                                                    <label for="grupoFiltroResumen" class="form-label">Grupo:</label>
                                                    <select id="grupoFiltroResumen" class="form-select">
                                                        <option value="">Todos</option>
                                                        @if (ViewBag.FiltroGrupos != null)
                                                        {
                                                            foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrupos)
                                                            {
                                                                <option value="@g.Key">@g.Value</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-6 d-flex align-items-end" style="margin-bottom: 10px; color:#777; font-size:.85rem;">
                                                    Combinables con carrera/especialidad y con el mes de Vulnerabilidad (aplican con el botón Aplicar).
                                                </div>
                                            </div>
                                            <div id="filtroActivo" class="sga-filter-bar" style="margin-bottom: 10px; margin-top: 10px; display:none;">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <strong>Filtro activo:</strong> <span id="nombreFiltroActivo"></span>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 justify-content-end" style="padding: 8px 12px;">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBajasResumen" onclick="toggleIncluirBajas('Resumen', this)" title="Incluir bajas en el conteo">
                                                <i class="fas fa-user-slash me-1"></i>
                                                Incluir Bajas
                                            </button>
                                            <button type="button" class="btn btn-success btn-sm" onclick="exportarResumenDetallado()">
                                                <i class="fas fa-file-excel me-1"></i>
                                                Exportar a Excel
                                            </button>
                                            <div class="hist-wrap" style="position:relative; display:inline-block;">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHistResumen" title="Ver un corte histórico de esta sección">
                                                    <i class="fas fa-clock-rotate-left me-1"></i> Histórico
                                                </button>
