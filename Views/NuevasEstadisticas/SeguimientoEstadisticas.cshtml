        window.abrirTutor360 = abrirTutor360; // el buscador flotante de tutores (script de la ficha 360) la usa
        // Redimensionable con resize:both; al cerrar vuelve al tamaño por defecto.
        var tutorResetSize = (function () {
            var panel = document.getElementById('tutor360Overlay'), cuerpo = document.getElementById('tutor360Cuerpo');
            if (!panel) return function () { };
            var defW = panel.style.width, defH = panel.style.height;
            if (window.ResizeObserver) {
                new ResizeObserver(function () {
                    if (panel.style.width !== defW || panel.style.height !== defH) cuerpo.style.maxHeight = 'none';
                }).observe(panel);
            }
            return function () { panel.style.width = defW; panel.style.height = defH; cuerpo.style.maxHeight = '78vh'; };
        })();
        function cerrarTutor360() { $('#tutor360Overlay').hide(); tutorResetSize(); }
        $('#tutor360Cuerpo').on('click', '#tutor360ToggleDetalle', function () {
            $('#tutor360Detalle').slideToggle(200);
