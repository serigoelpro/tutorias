                $tbody.html('<tr><td colspan="14" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando grupos...</td></tr>');
                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorGrupo", "NuevasEstadisticas")',
                    type: 'POST',
                    data: {
