            if (!sin.length) {
                h = '<p class="text-muted" style="margin:0;">Todos sus alumnos (' + f.alumnos + ') tienen al menos un seguimiento capturado este cuatrimestre. Última captura: ' + (f.ultimaCaptura || '—') + '.</p>';
            } else {
                h = '<p style="margin:0 0 8px; color:#b3402e;"><strong>' + sin.length + '</strong> alumno' + (sin.length === 1 ? '' : 's') + ' sin seguimiento del cuatrimestre (click para ver su mini-ficha):</p>' +
                    '<div style="border:1px solid #eceff1; border-radius:8px; overflow:hidden;">' +
                    sin.map(function (a, i) {
                        return '<div class="abrir-mini360" data-matricula="' + escC(a.matricula) + '" title="Ver mini-ficha del alumno" style="display:flex; justify-content:space-between; gap:12px; padding:6px 12px; cursor:pointer;' + (i % 2 ? ' background:#fafbfc;' : '') + (i ? ' border-top:1px solid #f1f3f4;' : '') + '">' +
                            '<span>' + escC(a.nombre) + '</span><span class="text-muted">' + escC(a.matricula) + '</span></div>';
