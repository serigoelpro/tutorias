                                                            <strong>@DateTime.Now.Year</strong>
                                                            <small class="text-muted" style="margin-left:8px;">(Año actual)</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 d-flex align-items-end" style="margin-bottom: 10px;">
                                                        <button id="aplicarFiltroVulnerabilidad" class="btn btn-success me-2" style="flex: 1;">
                                                            <i class="fas fa-search me-1"></i>
                                                            Aplicar
                                                        </button>
                                                        <button id="limpiarFiltroVulnerabilidad" class="btn btn-utt-outline" style="flex: 1;">
                                                            <i class="fas fa-times me-1"></i>
                                                            Limpiar
                                                        </button>
                                                    </div>
                                                </div>
                                                <div id="filtroActivoVulnerabilidad" class="alert alert-info" style="margin-top: 10px; margin-bottom: 0; display: none; padding: 8px 12px; border-radius: 6px;">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    <strong>Filtro activo:</strong> <span id="nombreFiltroActivoVulnerabilidad"></span>
                                                </div>
                                            </div>
                                            @* 2026-08-01: la apilada por carrera (unica grafica que quedaba) se movio a la
                                               seccion de arriba (antes "Nivel de Estudio", hoy "Vulnerabilidad"); esta seccion
                                               ya no tiene modo grafica. *@
                                            <div id="contenidoVulnerabilidades">
                                                <div class="row">
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="vulnerables" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@totalVulnerables</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">Total de Vulnerables</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="personales" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@(vulnerabilidades?.VulnerablesPersonales ?? 0)</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">Vulnerables Personales</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="economicos" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@(vulnerabilidades?.VulnerablesEconomicos ?? 0)</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">Vulnerables Económicos</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="academicos" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@(vulnerabilidades?.VulnerablesAcademicos ?? 0)</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">Vulnerables Académicos</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="noVulnerables" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@(vulnerabilidades?.NoVulnerables ?? 0)</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">No Vulnerables</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-6 vuln-card-click" data-vuln-cat="sinInformacion" style="margin-bottom: 10px;">
                                                        <div class="text-center" style="padding: 10px; background-color: #e9f8f4; border-radius: 6px; border-left: 3px solid #009688;">
                                                            <div style="font-size: 1.7rem; font-weight: bold; color: #00695C; line-height: 1.2;">@(vulnerabilidades?.SinSeguimiento ?? 0)</div>
                                                            <div style="font-size: 1rem; font-weight: 600; color: #00695C; margin-top: 4px;">Sin información</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="desgloseFuenteVulnerabilidad" class="text-center" style="margin-top: 8px; padding: 8px; background-color: #f5f5f5; border-radius: 6px; font-size: 0.85rem; color: #555;">
                                                    @{
                                                        bool tieneDesgloseFuente = false;
                                                        int fuenteSeg = 0, fuenteIdent = 0;
                                                        try
                                                        {
                                                            tieneDesgloseFuente = (bool)(ViewBag.TieneDesgloseFuente ?? false);
                                                            if (tieneDesgloseFuente)
                                                            {
                                                                fuenteSeg = (int)(vulnerabilidades?.ClasificadosPorSeguimiento ?? 0);
                                                                fuenteIdent = (int)(vulnerabilidades?.ClasificadosPorIdentificacion ?? 0);
                                                            }
                                                        }
                                                        catch { tieneDesgloseFuente = false; }
                                                    }
                                                    @if (tieneDesgloseFuente)
                                                    {
                                                        <span style="display:inline-flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:center;">
                                                            <span style="font-weight:600; color:#607d8b;">Fuente de clasificación:</span>
                                                            <span style="background:#e9f8f4; color:#00695C; border:1px solid #cfe8e2; border-radius:10px; padding:2px 10px;">Seguimiento del tutor: <strong>@fuenteSeg</strong></span>
                                                            <span style="background:#fff3e0; color:#b26a00; border:1px solid #f0ddc0; border-radius:10px; padding:2px 10px;">Identificación (sin seguimiento): <strong>@fuenteIdent</strong></span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>Desglose de fuente: no disponible en este corte.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            @* 2026-08-01: secciones "Estadísticas por Cierre de Cuatrimestres", "Estadísticas por
                               Carrera" y "Estadísticas por Grupo" ELIMINADAS a pedido del usuario. Sus funciones JS
                               quedan (inofensivas sin su DOM); GetEstadisticasPorCarrera se sigue llamando aparte
                               para alimentar la apilada top-10 de Vulnerabilidad y el hallazgo de carrera. *@
                            @* Sección de Estadísticas Adicionales (Bajas, PATs, Arrastre).
                               2026-08-01: DESACTIVADA a pedido del usuario. Para reactivarla en el
                               futuro basta cambiar el "if (false)" de abajo por "if (true)" (o quitar
                               el if con sus llaves). El JS de la sección sigue en la página y es
                               inofensivo sin su DOM (todo guarded por existencia de elementos). *@
                            if (false)
                            {
                            <section class="data-block">
                                <div class="card-header">
                                    <h3 class="section-title">
                                        <i class="fas fa-chart-pie me-2"></i>
                                        Estadísticas Adicionales
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <div class="d-flex flex-wrap gap-2 justify-content-center" role="group" aria-label="Botones de estadísticas">
                                                @if (ViewBag.EstadisticasBajas != null)
                                                {
                                                    <button type="button" class="btn btn-danger btn-lg estadistica-btn" data-estadistica="bajas">
                                                        <i class="fas fa-user-times me-2"></i>
                                                        Estadísticas de Bajas
                                                    </button>
                                                }
                                                @if (ViewBag.EstadisticasPATs != null)
                                                {
                                                    <button type="button" class="btn btn-info btn-lg estadistica-btn" data-estadistica="pats">
                                                        <i class="fas fa-clipboard-list me-2"></i>
                                                        Estadísticas de PATs
                                                    </button>
                                                }
                                                @if (ViewBag.EstadisticasArrastre != null)
                                                {
                                                    <button type="button" class="btn btn-warning btn-lg estadistica-btn" data-estadistica="arrastre">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        Estadísticas de Arrastre
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @* Estadísticas de Bajas *@
                                    @if (ViewBag.EstadisticasBajas != null)
                                    {
                                        var estadisticasBajas = ViewBag.EstadisticasBajas as Plataforma_Web.Controllers.NuevasEstadisticasController.EstadisticaBaja;
                                        <div id="estadistica-bajas" class="estadistica-contenido" style="display: none;">
                                            <div class="card border-danger">
                                                <div class="card-header d-flex justify-content-between align-items-center" style="margin-bottom: 10px;">
                                                    <h3 class="section-title">
                                                        <i class="fas fa-user-slash me-2"></i>
                                                        Estadísticas de Bajas
                                                    </h3>
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <select id="causaFiltroBajas" class="form-select form-select-sm" style="width:auto; max-width:200px;" title="Filtrar por causa de baja">
                                                            <option value="">Todas las causas</option>
                                                            @if (ViewBag.FiltroCausasBaja != null)
                                                            {
                                                                foreach (var cauB in (List<string>)ViewBag.FiltroCausasBaja)
                                                                {
                                                                    <option value="@cauB">@cauB</option>
                                                                }
                                                            }
                                                        </select>
                                                        <select id="mesFiltroBajas" class="form-select form-select-sm" style="width:auto;" title="Filtrar por mes de la baja">
                                                            <option value="">Todos los meses</option>
                                                            @if (ViewBag.NombresMeses != null)
                                                            {
                                                                foreach (var mesB in (Dictionary<int, string>)ViewBag.NombresMeses)
                                                                {
                                                                    <option value="@mesB.Key">@mesB.Value</option>
                                                                }
                                                            }
                                                        </select>
                                                        @if ((ViewBag.UsuarioNivel as int? ?? 0) == 4)
                                                        {
                                                            <select id="carreraFiltroBajas" class="form-select form-select-sm" style="width:auto; max-width:200px;" title="Filtrar por carrera">
                                                                <option value="">Todas las carreras</option>
                                                                @if (ViewBag.CarrerasMaterias != null)
                                                                {
                                                                    foreach (var carB in (Dictionary<int, string>)ViewBag.CarrerasMaterias)
                                                                    {
                                                                        <option value="@carB.Key">@carB.Value</option>
                                                                    }
                                                                }
                                                            </select>
                                                        }
                                                        <select id="especialidadFiltroBajas" class="form-select form-select-sm" style="width:auto; max-width:240px;" title="Filtrar por especialidad">
                                                            <option value="">Todas las especialidades</option>
                                                            @if (ViewBag.Especialidades != null) {
                                                                var espCarreraMapBajas = ViewBag.EspecialidadCarrera as Dictionary<int, string>;
                                                                foreach (var e in (List<PlataformaWeb.BecasTransporte.Models.Especialidad>)ViewBag.Especialidades) {
                                                                    <option value="@e.Id" data-carrera="@(espCarreraMapBajas != null && espCarreraMapBajas.ContainsKey(e.Id) ? espCarreraMapBajas[e.Id] : "")">@e.Nombre</option>
                                                                }
                                                            }
                                                        </select>
                                                        <select id="gradoFiltroBajas" class="form-select form-select-sm" style="width:auto;" title="Filtrar por cuatrimestre (grado)">
                                                            <option value="">Todos los grados</option>
                                                            @if (ViewBag.FiltroGrados != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrados) { <option value="@g.Key">@g.Value</option> } }
                                                        </select>
                                                        <select id="grupoFiltroBajas" class="form-select form-select-sm" style="width:auto;" title="Filtrar por grupo">
                                                            <option value="">Todos los grupos</option>
                                                            @if (ViewBag.FiltroGrupos != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrupos) { <option value="@g.Key">@g.Value</option> } }
                                                        </select>
                                                        <span id="rotuloHistBajas" class="badge bg-warning text-dark" style="display:none;"></span>
                                                        <div class="hist-wrap" style="position:relative; display:inline-block;">
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHistBajas" title="Ver un corte histórico de esta sección">
                                                                <i class="fas fa-clock-rotate-left me-1"></i> Histórico
                                                            </button>
                                                            <ul class="hist-menu" id="menuHistBajas" style="display:none; position:absolute; left:0; top:100%; z-index:1050; background:#fff; color:#000; border:1px solid #ddd; border-radius:6px; box-shadow:0 4px 12px rgba(0,0,0,.15); list-style:none; margin:4px 0 0; padding:4px 0; min-width:240px; max-height:280px; overflow:auto;"></ul>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <h6 class="mb-3">Resumen General</h6>
                                                            <div class="table-responsive">
                                                                <table class="table table-sm">
                                                                    <tr>
                                                                        <td><strong>Total de Bajas:</strong></td>
                                                                        <td class="text-end"><span id="bajasTotalBadge" class="badge bg-danger">@estadisticasBajas.TotalBajas</span></td>
                                                                    </tr>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="chart-container chart-bajas-horizontal" style="min-height: 380px;">
                                                                <canvas id="graficaBajasPorCausa"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row mt-4">
                                                        @if (esMaster)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="chart-container" style="min-height: 450px;">
                                                                    <canvas id="graficaBajasPorCarrera"></canvas>
                                                                </div>
                                                            </div>
                                                        }
                                                        <div class="@(esMaster ? "col-md-6" : "col-md-6 mx-auto")">
                                                            <div class="chart-container chart-bajas-horizontal" style="min-height: 380px;">
                                                                <canvas id="graficaBajasPorVulnerabilidad"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @* Estadísticas de PATs *@
                                    @if (ViewBag.EstadisticasPATs != null)
                                    {
                                        var estadisticasPATs = ViewBag.EstadisticasPATs as Plataforma_Web.Controllers.NuevasEstadisticasController.EstadisticaPAT;
                                        <div id="estadistica-pats" class="estadistica-contenido" style="display: none;">
                                            <div class="card border-primary">
                                                <div class="card-header">
                                                    <h5 class="mb-0">
                                                        Estadísticas de PATs (Planes de Acción Tutorial)
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <h6 class="mb-3">Resumen General</h6>
                                                            <div class="table-responsive">
                                                                <table class="table table-sm">
                                                                    <tr>
                                                                        <td><strong>Total de PATs:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-primary">@estadisticasPATs.TotalPATs</span></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><strong>Aprobados:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-success">@estadisticasPATs.Aprobados</span></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><strong>En Progreso:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-warning">@estadisticasPATs.EnProgreso</span></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td><strong>Pendientes de Revisión:</strong></td>
                                                                        <td class="text-end"><span class="badge bg-info">@estadisticasPATs.PendientesRevision</span></td>
