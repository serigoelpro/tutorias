            // Función auxiliar para aplicar búsquedas combinadas
            function aplicarBusquedaGrupos() {
                if (!dtGrupos) return;

                var busquedaPrincipal = $('#buscarGrupos').val() || '';
                var busquedaCarrera = $('#buscarCarreraGrupos').val() || '';

                // Aplicar búsqueda exacta en la columna de carrera (índice 1) si hay texto
                // EXCEPCIONES:
                // - "DATOS E INTELIGENCIA ARTIFICIAL" debe buscar "CIENCIA DE DATOS E INTELIGENCIA ARTIFICIAL"
                // - "AERONÁUTICA EN MANUFACTURA" debe buscar "Aeronáutica en Manufactura" (con acento)
                if (busquedaCarrera) {
                    var busquedaNormalizada = busquedaCarrera.trim().toUpperCase();

                    // EXCEPCIÓN 1: Si se busca "DATOS E INTELIGENCIA ARTIFICIAL", buscar "CIENCIA DE DATOS E INTELIGENCIA ARTIFICIAL"
                    if (busquedaNormalizada === 'DATOS E INTELIGENCIA ARTIFICIAL') {
                        // Buscar exactamente "CIENCIA DE DATOS E INTELIGENCIA ARTIFICIAL"
                        var busquedaExacta = '^CIENCIA DE DATOS E INTELIGENCIA ARTIFICIAL$';
                        dtGrupos.column(1).search(busquedaExacta, true, true); // true = regex, true = case insensitive
                    }
                    // EXCEPCIÓN 2: Si se busca "AERONÁUTICA EN MANUFACTURA" (sin acento o con acento), buscar "Aeronáutica en Manufactura" (con acento)
                    else if (busquedaNormalizada === 'AERONÁUTICA EN MANUFACTURA' ||
                             busquedaNormalizada === 'AERONAUTICA EN MANUFACTURA') {
                        // Buscar exactamente "Aeronáutica en Manufactura" (con acento en "Aeronáutica")
                        var busquedaExacta = '^Aeronáutica en Manufactura$';
                        dtGrupos.column(1).search(busquedaExacta, true, true); // true = regex, true = case insensitive
                    } else {
                        // Para todas las demás carreras, búsqueda exacta (coincidencia exacta)
                        // Escapar caracteres especiales de regex y hacer coincidencia exacta
                        var busquedaExacta = '^' + busquedaCarrera.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$';
                        dtGrupos.column(1).search(busquedaExacta, true, true); // true = regex, true = case insensitive
                    }
                } else {
                    dtGrupos.column(1).search('');
                }

                // Aplicar búsqueda global
                dtGrupos.search(busquedaPrincipal).draw();
            }

