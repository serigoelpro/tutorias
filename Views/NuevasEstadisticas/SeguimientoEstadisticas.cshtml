        // Funciones auxiliares para mostrar/ocultar cargando y errores
        function mostrarCargando(mensaje) {
            if (!$('#loadingModal').length) {
                $('body').append(`
                    <div class="modal fade" id="loadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-body text-center">
                                    <div class="spinner-border text-primary mb-3" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                    <p class="mb-0" id="loadingMessage">${mensaje}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `);
            }
            $('#loadingMessage').text(mensaje);
            $('#loadingModal').modal('show');
        }

        function ocultarCargando() {
            $('#loadingModal').modal('hide');
        }

        function mostrarError(mensaje) {
            alert('Error: ' + mensaje);
        }

        // Variables globales para DataTables
        var dtCarreras = null;
        var dtGrupos = null;

        // Estado independiente por tabla (false = bajas excluidas por defecto)
        var incluirBajasResumen = false;
        var incluirBajasNivel = false;
        var incluirBajasVulnerabilidad = false;
        var incluirBajasCierre = false;
        var incluirBajasCarrera = false;

        function toggleIncluirBajas(seccion, btn) {
            var activo;
            switch (seccion) {
                case 'Resumen':
                    incluirBajasResumen = !incluirBajasResumen;
                    activo = incluirBajasResumen;
                    break;
                case 'Nivel':
                    incluirBajasNivel = !incluirBajasNivel;
                    activo = incluirBajasNivel;
                    break;
                case 'Vulnerabilidad':
                    incluirBajasVulnerabilidad = !incluirBajasVulnerabilidad;
                    activo = incluirBajasVulnerabilidad;
                    break;
                case 'Cierre':
                    incluirBajasCierre = !incluirBajasCierre;
                    activo = incluirBajasCierre;
                    break;
                case 'Carrera':
                    incluirBajasCarrera = !incluirBajasCarrera;
                    activo = incluirBajasCarrera;
                    break;
                default:
                    return;
            }

            var $btn = $(btn);
            $btn.toggleClass('btn-warning', activo).toggleClass('btn-outline-secondary', !activo);
            $btn.html('<i class="fas ' + (activo ? 'fa-user-check' : 'fa-user-slash') + ' me-1"></i> ' + (activo ? 'Excluir Bajas' : 'Incluir Bajas'));

            switch (seccion) {
                case 'Resumen':
                    if (window.aplicarFiltroResumen) {
                        window.aplicarFiltroResumen($('#especialidadFiltro').val() || null, $('#carreraFiltroResumen').val() || null);
                    }
                    break;
                case 'Nivel':
                    cargarNivelEstudio();
                    break;
                case 'Vulnerabilidad':
                    var mesV = $('#mesFiltroVulnerabilidad').val();
                    var mesNum = (mesV && mesV !== '') ? parseInt(mesV, 10) : null;
                    if (window.aplicarFiltroVulnerabilidades) {
                        window.aplicarFiltroVulnerabilidades(mesNum, null, null);
                    }
                    break;
                case 'Cierre':
                    if (window.cargarEstadisticasCierreCuatrimestres) {
                        window.cargarEstadisticasCierreCuatrimestres();
                    }
                    break;
                case 'Carrera':
                    cargarCarreras();
                    break;
            }
        }

        // ===== Histórico por sección (dropdown propio, sin dependencia de Bootstrap) =====
        var _cortesHistCache = null;
        function cargarCortesHist(cb) {
            if (_cortesHistCache) { cb(_cortesHistCache); return; }
            $.getJSON('@Url.Action("GetHistoricoCortes", "NuevasEstadisticas")', function (cortes) {
                _cortesHistCache = cortes || [];
                cb(_cortesHistCache);
            }).fail(function () { cb([]); });
        }
        function initHistoricoSeccion(opts) {
            var $btn = $(opts.btn);
            if (!$btn.length) return;
            var $menu = $(opts.menu), $rotulo = $(opts.rotulo);
            $btn.on('click', function (e) {
                e.stopPropagation();
                if ($menu.is(':visible')) { $menu.hide(); return; }
                $('.hist-menu').hide();
                $menu.empty();
                cargarCortesHist(function (cortes) {
                    if (!cortes.length) {
                        $menu.append('<li style="padding:6px 14px; color:#888; white-space:nowrap;">Sin cortes aún</li>');
                    } else {
                        cortes.forEach(function (c) {
                            $('<li style="padding:6px 14px; cursor:pointer; white-space:nowrap;">' + c.nombre + ' <small style="color:#888;">(' + c.fecha + ')</small></li>')
                                .on('mouseenter', function () { $(this).css('background', '#f0f0f0'); })
                                .on('mouseleave', function () { $(this).css('background', ''); })
                                .on('click', function (ev) {
                                    ev.stopPropagation();
                                    $menu.hide();
                                    $rotulo.text('Viendo corte: ' + c.fecha).show();
                                    opts.onCorte(c);
                                }).appendTo($menu);
                        });
                    }
                    var $vivo = $('<li style="border-top:1px solid #eee; margin-top:4px; padding:6px 14px; cursor:pointer; white-space:nowrap; color:#0a7;"><i class="fas fa-bolt me-1"></i>Volver a en vivo</li>')
                        .on('click', function (ev) { ev.stopPropagation(); $menu.hide(); $rotulo.hide(); opts.onVivo(); });
                    $menu.append($vivo);
                    $menu.show();
                });
            });
        }
        $(document).on('click', function () { $('.hist-menu').hide(); });

        function cargarNivelEstudio(corteId, _retry) {
            var $tbody = $('#tbodyNivelEstudio');
            $tbody.html('<tr><td colspan="10" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando...</td></tr>');

            // Filtros (solo en vivo; en historico el snapshot es agregado).
            $('#especialidadFiltroNivel, #carreraFiltroNivel, #gradoFiltroNivel, #grupoFiltroNivel').prop('disabled', !!corteId)
                .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
            $('#especialidadFiltroNivel').attr('title', corteId ? 'Filtro disponible solo en vivo' : 'Filtrar por especialidad');
            $.ajax({
                url: '@Url.Action("GetEstadisticasPorNivelEstudio", "NuevasEstadisticas")',
                type: 'POST',
                data: { incluirBajas: incluirBajasNivel, corteId: corteId || null, especialidadId: (corteId ? null : ($('#especialidadFiltroNivel').val() || null)), carreraId: (corteId ? null : ($('#carreraFiltroNivel').val() || null)), gradoId: (corteId ? null : ($('#gradoFiltroNivel').val() || null)), grupoId: (corteId ? null : ($('#grupoFiltroNivel').val() || null)) },
                success: function(r) {
                    if (!r.success) { $tbody.html('<tr><td colspan="10" class="text-center text-danger">Error: ' + r.error + '</td></tr>'); return; }
                    var d = r.data;
                    if (window.ModoEstadisticas) ModoEstadisticas.datos('nivel', d);
                    // 2026-08-01: se quitó la columna de porcentaje (pedido del usuario); la tabla
                    // vuelve a las 9 columnas del render inicial del servidor.
                    function fila(nombre, n) {
                        return '<tr>' +
                            '<td class="fw-bold">' + nombre + '</td>' +
                            '<td class="text-center">' + n.total + '</td>' +
                            '<td class="text-center">' + n.hombres + '</td>' +
                            '<td class="text-center">' + n.mujeres + '</td>' +
                            '<td class="text-center"><span class="badge bg-danger">' + n.econ + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-warning">' + n.acad + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-secondary">' + n.pers + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-success">' + n.noVul + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-dark">' + n.sinSeg + '</span></td>' +
                            '</tr>';
                    }
                    $tbody.html(fila('TSU', d.tsu) + fila('Ingeniería', d.ingenieria) + fila('Licenciatura', d.licenciatura));
                },
                error: function() {
                    // Reintento unico (arranque en frio de IIS/EF): no mostrar el error de inmediato.
                    if (!_retry) { setTimeout(function () { cargarNivelEstudio(corteId, true); }, 1500); return; }
                    $tbody.html('<tr><td colspan="10" class="text-center text-danger">Error de conexión</td></tr>');
                }
            });
        }

        $(function () { $('#especialidadFiltroNivel, #carreraFiltroNivel, #gradoFiltroNivel, #grupoFiltroNivel').on('change', function () { cargarNivelEstudio(); }); });

        function cargarCarreras(corteId, _retry) {
            if (typeof dtCarreras !== 'undefined' && dtCarreras !== null) {
                dtCarreras.destroy();
                dtCarreras = null;
            }
            var $tbody = $('#tablaCarreras tbody');
            $tbody.html('<tr><td colspan="10" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando...</td></tr>');

            $('#especialidadFiltroCarreras, #gradoFiltroCarreras, #grupoFiltroCarreras').prop('disabled', !!corteId)
                .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
            $.ajax({
                url: '@Url.Action("GetEstadisticasPorCarrera", "NuevasEstadisticas")',
                type: 'POST',
                data: { incluirBajas: incluirBajasCarrera, corteId: corteId || null, especialidadId: (corteId ? null : ($('#especialidadFiltroCarreras').val() || null)), gradoId: (corteId ? null : ($('#gradoFiltroCarreras').val() || null)), grupoId: (corteId ? null : ($('#grupoFiltroCarreras').val() || null)) },
                success: function(r) {
                    if (!r.success) { $tbody.html('<tr><td colspan="10" class="text-center text-danger">Error: ' + r.error + '</td></tr>'); return; }
                    if (window.ModoEstadisticas) ModoEstadisticas.datos('carrera', r.data);
                    var filas = '';
                    var totalAlumnosCarreras = 0;
                    $.each(r.data, function(i, c) { totalAlumnosCarreras += (c.cantidad || 0); });
                    $.each(r.data, function(i, c) {
                        filas += '<tr>' +
                            '<td class="fw-bold">' + (c.nombre || '—') + '</td>' +
                            '<td class="text-center">' + c.cantidad + '</td>' +
                            '<td class="text-center">' + c.hombres + '</td>' +
                            '<td class="text-center">' + c.mujeres + '</td>' +
                            '<td class="text-center"><span class="badge bg-danger">' + c.econ + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-warning">' + c.acad + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-secondary">' + c.pers + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-success">' + c.noVul + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-dark">' + c.sinSeg + '</span></td>' +
                            '<td class="text-center" title="' + c.cantidad + ' de los ' + totalAlumnosCarreras + ' alumnos estudian esta carrera">' + c.porcentaje + '% <small style="color:#888;">(' + c.cantidad + ' de ' + totalAlumnosCarreras + ')</small></td>' +
                            '</tr>';
                    });
                    // Si no hay filas, dejar el tbody VACIO (no una fila colspan): asi DataTables
                    // muestra su propio mensaje "No hay datos" sin romperse con "unknown parameter".
                    if (!filas) { $tbody.empty(); } else { $tbody.html(filas); }
                    // Reinitialize DataTable
                    dtCarreras = $('#tablaCarreras').DataTable({
                        pageLength: 15, lengthChange: false, ordering: true, paging: true, searching: true, dom: 'rtip',
                        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' }
                    });
                },
                error: function() {
                    // Reintento unico (arranque en frio de IIS/EF): no mostrar el error de inmediato.
                    if (!_retry) { setTimeout(function () { cargarCarreras(corteId, true); }, 1500); return; }
                    $tbody.html('<tr><td colspan="10" class="text-center text-danger">Error de conexión</td></tr>');
                }
            });
        }

        $(function () { $('#especialidadFiltroCarreras, #gradoFiltroCarreras, #grupoFiltroCarreras').on('change', function () { cargarCarreras(null); }); });

        $(document).ready(function () {
            // Corte manual de emergencia (solo Master): modal de confirmación propio,
            // armónico con el diseño (la vista mezcla BS3/BS5, no usar modal de Bootstrap).
            var $corteOverlay = $('#corteModalOverlay');
            $('#btnCorteManual').on('click', function () {
                $corteOverlay.css('display', 'flex');
            });
            $('#corteModalCancelar').on('click', function () { $corteOverlay.hide(); });
            $corteOverlay.on('click', function (e) { if (e.target === this) $corteOverlay.hide(); });
            $(document).on('keydown', function (e) { if (e.key === 'Escape') $corteOverlay.hide(); });
            $('#corteModalConfirmar').on('click', function () {
                $corteOverlay.hide();
                var $btn = $('#btnCorteManual').prop('disabled', true);
                $.post('@Url.Action("EjecutarCorteManual", "NuevasEstadisticas")')
                    .done(function (r) {
                        if (r.ok && r.yaExistia) {
                            alert(r.mensaje);
                            $btn.prop('disabled', false);
                        } else if (r.ok) {
                            alert('Corte realizado correctamente: ' + r.nombre + ' (corte #' + r.idCorte + ').\nLa página se recargará con las estadísticas reiniciadas.');
                            location.reload();
                        } else {
                            alert('No se pudo realizar el corte: ' + (r.error || 'error desconocido'));
                            $btn.prop('disabled', false);
                        }
                    })
                    .fail(function () {
                        alert('Error de conexión al realizar el corte.');
                        $btn.prop('disabled', false);
                    });
            });

            // Enlazar tras DOM listo (la sección scripts del layout corre en head antes del body)
            $('#btnExportarModulo').on('click', function () {
                mostrarCargando('Generando ZIP con exportaciones...');

                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("ExportarModuloCompleto", "NuevasEstadisticas")';
                form.style.display = 'none';

                var token = $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);
                }

                function addHidden(name, value) {
                    if (value === null || value === undefined || value === '') return;
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = name;
                    inp.value = value;
                    form.appendChild(inp);
                }

                var camposBool = [
                    { name: 'incluirBajasResumen', val: incluirBajasResumen },
                    { name: 'incluirBajasNivel', val: incluirBajasNivel },
                    { name: 'incluirBajasCierre', val: incluirBajasCierre },
                    { name: 'incluirBajasCarrera', val: incluirBajasCarrera },
                    { name: 'incluirBajasVulnerabilidad', val: incluirBajasVulnerabilidad }
                ];
                camposBool.forEach(function (c) {
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = c.name;
                    inp.value = c.val ? 'true' : 'false';
                    form.appendChild(inp);
                });

                addHidden('mes', $('#mesFiltroVulnerabilidad').val());
                addHidden('especialidadId', $('#especialidadFiltro').val());
                addHidden('carreraIdResumen', $('#carreraFiltroResumen').val());
                addHidden('carreraIdGrupo', $('#carreraFiltro').val());
                addHidden('grupoId', $('#grupoFiltroResumen').val());
                addHidden('gradoId', $('#gradoFiltroResumen').val());
                addHidden('sexo', $('#sbSexo').length ? ($('#sbSexo').val() || '') : '');
                // Si sbEstatus='1' el ZIP del resumen también debe incluir bajas (igual que en pantalla)
                var sbEstatusZip = $('#sbEstatus').length ? ($('#sbEstatus').val() || '') : '';
                if (sbEstatusZip === '1') {
                    // Sobreescribir el campo incluirBajasResumen que ya se agregó arriba
                    var existingBajasR = form.querySelector('input[name="incluirBajasResumen"]');
                    if (existingBajasR) existingBajasR.value = 'true';
                }

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);

                setTimeout(function () {
                    ocultarCargando();
                }, 2000);
            });

            // DataTable para la tabla de carreras (solo si es master)
            @{
                var usuarioNivelJs = ViewBag.UsuarioNivel as int? ?? 0;
                var esMasterJs = usuarioNivelJs == 4;
            }
            @if (esMasterJs)
            {
                <text>
            if ($.fn.dataTable.isDataTable('#tablaCarreras')) { $('#tablaCarreras').DataTable().destroy(); }
                dtCarreras = $('#tablaCarreras').DataTable({
                pageLength: 15,
                lengthChange: false,
                ordering: true,
                paging: true,
                searching: true,
                dom: 'rtip',
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });

            $('#buscarCarreras').on('keyup', function () {
                    if (dtCarreras) {
                dtCarreras.search(this.value).draw();
                    }
            });
                </text>
            }

            // DataTable para la tabla de grupos
            function inicializarDataTableGrupos() {
                if ($.fn.dataTable.isDataTable('#tablaGrupos')) { $('#tablaGrupos').DataTable().destroy(); }
                dtGrupos = $('#tablaGrupos').DataTable({
                    pageLength: 10,
                    lengthChange: false,
                    ordering: true,
                    paging: true,
                    searching: true,
                    dom: 'rtip',
                    responsive: false,
                    scrollX: false,
                    autoWidth: false,
                    columnDefs: [
                        { targets: [0, 5, 8, 9, 10, 12], className: 'text-center' },
                        { targets: [1, 2], className: 'd-none d-md-table-cell' },
                        { targets: [3, 6, 7], className: 'd-none d-sm-table-cell' },
                        { targets: [4, 13], className: 'd-none d-md-table-cell' },
                        { targets: [11], className: 'd-none d-lg-table-cell' }
                    ],
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                    }
                });
                @if (esMasterJs == false && usuarioNivelJs == 3)
                {
                    <text>
                var carreraCoordinador = $('#buscarCarreraGrupos').val();
                if (carreraCoordinador && dtGrupos) {
                    dtGrupos.column(1).search(carreraCoordinador).draw();
                }
                    </text>
                }
            }
            inicializarDataTableGrupos();
            $('#turnoFiltroGrupos, #especialidadFiltroGrupos, #gradoFiltroGrupos').on('change', function () { window.cargarEstadisticasGrupos(null); });

            window.cargarEstadisticasGrupos = function(corteId, _retry) {
                var $tbody = $('#tablaGrupos tbody');
