                        @* Estadísticas de Materias Reprobadas (requerimiento dirección) *@
                        <style>
                            /* Tabla de materias con scroll propio: el encabezado se queda fijo */
                            #wrapTablaMaterias thead th { position: sticky; top: 0; z-index: 2; }
                        </style>
                        <section class="data-block" id="seccionMaterias">
                            <div class="card-header d-flex justify-content-between align-items-center" style="margin-bottom: 10px;">
                                <h3 class="section-title">
                                    <i class="fas fa-book me-2"></i>
                                    Materias Reprobadas y en Extraordinario
                                </h3>
                                <div class="d-flex gap-2 align-items-center">
                                    @{
                                        var nivelUsuarioMaterias = ViewBag.UsuarioNivel as int? ?? 0;
                                    }
                                    @if (nivelUsuarioMaterias == 4)
                                    {
                                        <select id="carreraFiltroMaterias" class="form-select form-select-sm" style="width:auto; max-width:280px;" title="Filtrar por carrera">
                                            <option value="">Todas las carreras</option>
                                            @if (ViewBag.CarrerasMaterias != null)
                                            {
                                                var carrerasMat = ViewBag.CarrerasMaterias as Dictionary<int, string>;
                                                foreach (var cm in carrerasMat)
                                                {
                                                    <option value="@cm.Key" data-nombre="@cm.Value">@cm.Value</option>
                                                }
                                            }
                                        </select>
                                        <select id="agruparPorMaterias" class="form-select form-select-sm" style="width:auto;" title="Al agrupar por carrera, 'Alumnos' suma alumnos por materia (un alumno con varias materias cuenta varias veces)">
                                            <option value="materia">Agrupar: Materia</option>
                                            <option value="carrera">Agrupar: Carrera</option>
                                        </select>
                                    }
                                    <select id="materiaFiltroMaterias" class="form-select form-select-sm" style="width:auto; max-width:220px;" title="Filtrar por materia">
                                        <option value="">Todas las materias</option>
                                        @if (ViewBag.FiltroMaterias != null)
                                        {
                                            foreach (var matF in (List<string>)ViewBag.FiltroMaterias)
                                            {
                                                <option value="@matF">@matF</option>
                                            }
                                        }
                                    </select>
                                    <select id="estadoFiltroMaterias" class="form-select form-select-sm" style="width:auto;" title="Filtrar por estado">
                                        <option value="">Arrastre + Extraordinario</option>
                                        <option value="Reprobada">Solo arrastre</option>
                                        <option value="Extraordinario">Solo extraordinario</option>
                                    </select>
                                    <select id="intentosFiltroMaterias" class="form-select form-select-sm" style="width:auto;" title="Filtrar por número de intentos de extraordinario">
                                        <option value="">Intentos: todos</option>
                                        <option value="0">Sin intento</option>
                                        <option value="1">1er intento</option>
                                        <option value="2">2do intento</option>
                                        <option value="3+">3+ (crítico)</option>
                                    </select>
                                    <select id="especialidadFiltroMaterias" class="form-select form-select-sm" style="width:auto; max-width:240px;" title="Filtrar por especialidad del alumno">
                                        <option value="">Todas las especialidades</option>
                                        @if (ViewBag.Especialidades != null)
                                        {
                                            var espCarreraMapMaterias = ViewBag.EspecialidadCarrera as Dictionary<int, string>;
                                            foreach (var espM in (List<PlataformaWeb.BecasTransporte.Models.Especialidad>)ViewBag.Especialidades)
                                            {
                                                <option value="@espM.Id" data-carrera="@(espCarreraMapMaterias != null && espCarreraMapMaterias.ContainsKey(espM.Id) ? espCarreraMapMaterias[espM.Id] : "")">@espM.Nombre</option>
                                            }
                                        }
                                    </select>
                                    <select id="gradoFiltroMaterias" class="form-select form-select-sm" style="width:auto;" title="Filtrar por cuatrimestre (grado)">
                                        <option value="">Todos los grados</option>
                                        @if (ViewBag.FiltroGrados != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrados) { <option value="@g.Key">@g.Value</option> } }
                                    </select>
                                    <select id="grupoFiltroMaterias" class="form-select form-select-sm" style="width:auto;" title="Filtrar por grupo">
                                        <option value="">Todos los grupos</option>
                                        @if (ViewBag.FiltroGrupos != null) { foreach (var g in (Dictionary<int, string>)ViewBag.FiltroGrupos) { <option value="@g.Key">@g.Value</option> } }
                                    </select>
                                    <span id="rotuloHistMaterias" class="badge bg-warning text-dark" style="display:none;"></span>
                                    <span id="modoHostMaterias"></span>
                                    <div class="hist-wrap" style="position:relative; display:inline-block;">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHistMaterias" title="Ver un corte histórico de esta sección">
                                            <i class="fas fa-clock-rotate-left me-1"></i> Histórico
                                        </button>
                                        <ul class="hist-menu" id="menuHistMaterias" style="display:none; position:absolute; left:0; top:100%; z-index:1050; background:#fff; color:#000; border:1px solid #ddd; border-radius:6px; box-shadow:0 4px 12px rgba(0,0,0,.15); list-style:none; margin:4px 0 0; padding:4px 0; min-width:240px; max-height:280px; overflow:auto;"></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div id="materiasResumen" style="margin-bottom: 10px; color:#555;"></div>
                                <div class="chart-container" style="max-width: 900px; margin: 0 auto 15px auto; min-height: 380px;">
                                    <canvas id="chartMaterias"></canvas>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap;">
                                    <input type="text" id="filtroMaterias" class="form-control" placeholder="@(nivelUsuarioMaterias == 4 ? "Buscar materia o carrera..." : "Buscar materia...")" style="max-width: 320px; display:inline-block;" />
                                    <span id="materiasFiltroInfo" style="color:#777; font-size:0.85rem;"></span>
                                </div>
                                @* Materias en modo grafica: top-15 por alumnos (ancho completo) + fila de 3 compactas del
                                   mockup (top-10 por tasa %, dona de intentos, reprobadas vs extraordinario). *@
                                <div class="modo-chart-wrap" id="chartWrapMateriasTabla" style="max-width:none; height:auto; padding:12px;">
                                    <h4 class="dash-sub">Top 15 Materias por Alumnos (distribución de intentos)</h4>
                                    <div class="dash-canvas-wrap" style="height:420px;"><canvas id="chartModoMateriasTabla"></canvas></div>
                                    <small id="chartNotaMateriasTabla" style="display:block;text-align:center;color:#777;margin:4px 0 12px;"></small>
                                    <div class="dash-graf-row">
                                        <div class="demo-graf-col"><h4 class="dash-sub">Top 10 por Tasa de Reprobación (%)</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartMatTasa"></canvas></div></div>
                                        <div class="demo-graf-col"><h4 class="dash-sub">Distribución por Número de Intento</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartMatIntentos"></canvas></div></div>
                                        <div class="demo-graf-col"><h4 class="dash-sub">Arrastre vs Extraordinario</h4><div class="dash-canvas-wrap" style="height:240px;"><canvas id="chartMatRepExt"></canvas></div></div>
                                    </div>
                                </div>
                                <div class="table-responsive" id="wrapTablaMaterias" style="max-height: 480px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 6px;">
                                    <table class="table table-striped table-hover" id="tablaMaterias" style="margin-bottom:0;">
                                        <thead>
                                            <tr>
                                                <th>Materia</th>
                                                <th>Carrera</th>
                                                <th class="text-center">Alumnos</th>
                                                <th class="text-center">Reprobadas (arrastre)</th>
                                                <th class="text-center">Extraordinario</th>
                                                <th class="text-center">1er intento</th>
                                                <th class="text-center">2do intento</th>
                                                <th class="text-center">3+ intentos</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <h4 class="dash-sub">Mapa de Calor: Materia × Carrera (% de registros reprobados)</h4>
                                <div id="heatMateriaCarrera" class="dash-heat"></div>
                                <div id="materiasNoDisponible" style="display:none; padding: 15px; color: #856404; background: #fff3cd; border-radius: 6px;">
                                    Esta sección no está disponible en este corte (se agregó después de que el corte fue tomado).
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
    </div>
</div>

