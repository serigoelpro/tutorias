                              d.alumnosSinSeguimiento.map(function (a, i) { return '<div style="display:flex; justify-content:space-between; gap:10px; padding:5px 10px;' + (i % 2 ? ' background:#fafbfc;' : '') + '"><span>' + escC(a.nombre) + '</span><span class="text-muted">' + escC(a.matricula) + '</span></div>'; }).join('') + '</div>'
                            : '<p class="text-muted" style="margin:0 0 10px;">Todos sus alumnos tienen seguimiento del cuatrimestre.</p>') +
                        '<h4 class="dash-sub" style="margin-top:14px;">Historial como tutor</h4>' +
                        ((d.historial || []).length
                            ? '<div style="max-height:150px; overflow-y:auto;">' + d.historial.slice(0, 10).map(function (h) { return '<div style="font-size:12.5px; color:#374151; margin-top:3px;"><span style="color:#888;">' + escC(h.periodo) + '</span> · Grupo ' + escC(h.grupo) + ' · ' + escC(h.carrera) + '</div>'; }).join('') + '</div>'
                            : '<p class="text-muted" style="margin:0;">Sin historial.</p>') +
                    '</div></div>' +
                    // Detalle alumno por alumno (colapsado por defecto para no abrumar).
                    '<button type="button" class="btn btn-utt-outline btn-sm" id="tutor360ToggleDetalle" style="width:100%; margin-top:10px;"><i class="fas fa-users me-1"></i> Ver alumnos a detalle (' + ((d.alumnosDetalle || []).length) + ')</button>' +
                    '<div id="tutor360Detalle" style="display:none; margin-top:10px; border:1px solid #eceff1; border-radius:8px; overflow:hidden; max-height:300px; overflow-y:auto;">' +
                    '<table class="table table-striped table-sm" style="margin:0; font-size:12.5px;"><thead><tr><th>Alumno</th><th class="text-center">Clasificación</th><th class="text-center">Últ. seguimiento</th><th class="text-center">Reprobadas</th><th class="text-center">Extraordinario</th></tr></thead><tbody>' +
                    (d.alumnosDetalle || []).map(function (a) {
                        var cCla = colorClasifT(a.clasificacion);
                        return '<tr class="tutor360-alumno" data-idpersona="' + a.idPersona + '" title="Ver mini-ficha del alumno" style="cursor:pointer;">' +
                            '<td>' + escC(a.nombre) + ' <small class="text-muted">(' + escC(a.matricula) + ')</small></td>' +
                            '<td class="text-center"><span style="background:' + cCla + '; color:#fff; border-radius:10px; padding:1px 8px; font-size:11px; white-space:nowrap;">' + escC(a.clasificacion) + '</span></td>' +
                            '<td class="text-center">' + (a.ultimaCaptura || '<span class="text-muted">—</span>') + '</td>' +
                            '<td class="text-center">' + a.reprobadas + '</td>' +
                            '<td class="text-center">' + a.extraordinarios + '</td></tr>';
                    }).join('') + '</tbody></table></div>';
                $('#tutor360Cuerpo').html(html);
            }, 'json').fail(function () { $('#tutor360Cuerpo').html('<p style="color:#b3402e; margin:0;">Error de conexión.</p>'); });
        }
        $('#tablaCumplTutores tbody').on('click', '.tutor360-link', function (e) {
