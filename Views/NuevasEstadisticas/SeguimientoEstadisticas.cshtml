                                            <i class="fas fa-user-slash me-1"></i>
                                            Incluir Bajas
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" onclick="exportarCierreCuatrimestres()">
                                            <i class="fas fa-file-excel me-1"></i>
                                            Exportar a Excel
                                        </button>
                                        <div class="hist-wrap" style="position:relative; display:inline-block;">
