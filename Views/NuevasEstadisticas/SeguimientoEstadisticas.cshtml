                                    '<td class="text-center d-none d-md-table-cell">' + (g.periodo || '') + '</td>' +
                                    '<td class="text-center text-nowrap">' + (g.totalEstudiantes || 0) + '</td>' +
                                    '<td class="text-center d-none d-sm-table-cell">' + (g.totalHombres || 0) + '</td>' +
                                    '<td class="text-center d-none d-sm-table-cell">' + (g.totalMujeres || 0) + '</td>' +
                                    '<td class="text-center text-nowrap"><span class="badge bg-danger">' + (g.bajas || 0) + '</span></td>' +
                                    '<td class="text-center text-nowrap"><span class="badge bg-danger">' + (g.vulnerablesEconomicos || 0) + '</span></td>' +
                                    '<td class="text-center text-nowrap"><span class="badge bg-warning">' + (g.vulnerablesAcademicos || 0) + '</span></td>' +
                                    '<td class="text-center d-none d-lg-table-cell"><span class="badge bg-secondary">' + (g.vulnerablesPersonales || 0) + '</span></td>' +
                                    '<td class="text-center text-nowrap"><span class="badge bg-success">' + (g.noVulnerables || 0) + '</span></td>' +
                                    '<td class="text-center d-none d-md-table-cell"><span class="badge bg-dark">' + (g.sinSeguimiento || 0) + '</span></td>' +
                                    '</tr>';
