            function mostrarErrorTablaCierreCuatrimestres(mensaje) {
                var $tbody = $('#tbodyCierreCuatrimestres');
                $tbody.html('<tr><td colspan="7" class="text-center text-danger py-4"><i class="fas fa-exclamation-triangle me-2"></i>' + mensaje + '</td></tr>');
            }

            function aplicarFiltroResumen(especialidadId, carreraId, grupoId, gradoId, sexo) {
                // Obtener el nombre de la carrera directamente del dropdown antes de hacer la petición
                var nombreCarrera = null;
                if (carreraId) {
                    var carreraOption = $('#carreraFiltroResumen option:selected');
                    nombreCarrera = carreraOption.text();
                }

                // Obtener el nombre de la especialidad directamente del dropdown
                var nombreEspecialidad = null;
                if (especialidadId) {
                    var especialidadOption = $('#especialidadFiltro option:selected');
                    nombreEspecialidad = especialidadOption.text();
                }

                var mesValResumen = $('#mesFiltroVulnerabilidad').val();
                var mesFiltroResumen = (mesValResumen && mesValResumen !== '') ? parseInt(mesValResumen, 10) : null;
                var dataResumen = {
                    especialidadId: especialidadId || null,
                    carreraId: carreraId || null,
                    incluirBajas: incluirBajasResumen
                };
                // Filtros de grupo/grado (direccion 2026-07-16): combinables con especialidad/carrera/mes.
                if (grupoId === undefined) grupoId = $('#grupoFiltroResumen').val() || null;
                if (gradoId === undefined) gradoId = $('#gradoFiltroResumen').val() || null;
                if (grupoId) dataResumen.grupoId = grupoId;
                if (gradoId) dataResumen.gradoId = gradoId;
                if (mesFiltroResumen !== null && mesFiltroResumen !== undefined && !isNaN(mesFiltroResumen)) {
                    dataResumen.mes = mesFiltroResumen;
                }
                // Filtro de sexo (Task 4 2026-07-26): 5to arg opcional; si viene del sidebar se lee aqui.
                if (sexo === undefined || sexo === null) sexo = ($('#sbSexo').length ? ($('#sbSexo').val() || null) : null);
                if (sexo) dataResumen.sexo = sexo;
                // Filtro de estatus vía sidebar: si sbEstatus='1' => incluirBajas=true.
                var sbEstatusVal = $('#sbEstatus').length ? ($('#sbEstatus').val() || '') : '';
                if (sbEstatusVal === '1') dataResumen.incluirBajas = true;
                // Las tarjetas de Vulnerabilidad NO filtran por sexo (GetEstadisticasDetalladas lo ignora),
                // asi que el modal tampoco debe recibirlo o sus conteos no cuadrarian con las tarjetas.
                window._vulnParamsActuales = $.extend({}, dataResumen);
                delete window._vulnParamsActuales.sexo;

                $.ajax({
                    url: '@Url.Action("GetEstadisticasPorEspecialidad", "NuevasEstadisticas")',
                    type: 'POST',
                    data: dataResumen,
                    success: function(response) {
                        if (response.success) {
                            actualizarResumenDetallado(response.data);
                            // Usar los nombres obtenidos del dropdown en lugar de los del servidor
                            mostrarFiltroActivo({
                                especialidadFiltro: nombreEspecialidad,
                                carreraFiltro: nombreCarrera
                            });
                        } else {
                            alert('Error al aplicar el filtro: ' + response.error);
                        }
                    },
                    error: function() {
                        alert('Error al conectar con el servidor');
                    }
                });
            }

            function actualizarResumenDetallado(data) {
                // Modo graficas: guardar/repintar los charts con el MISMO dato de las tarjetas
                if (window.ModoEstadisticas) { ModoEstadisticas.datos('demografia', data); ModoEstadisticas.datos('sitfam', data); }
                // Función auxiliar para calcular porcentaje
                function calcularPorcentaje(valor, total) {
                    return total > 0 ? ((valor / total) * 100).toFixed(1) : '0.0';
                }

                // Actualizar panel de Demografía (eq(0) es Demografía dentro del Resumen Detallado)
                // NOTA: NO actualizar vulnerabilidad aquí porque los filtros de especialidad/carrera NO deben afectarla
                // La vulnerabilidad está en su propia sección separada
                $('.panel-success').eq(0).find('.panel-body').find('.row').eq(0).find('.col-md-3').each(function(index) {
                    var $card = $(this).find('div');
                    var $value = $card.find('div').first();

                    var values = [
                        data.totalEstudiantes || 0,
                        data.totalHombres || 0,
                        data.totalMujeres || 0,
                        data.totalSinSexo || 0
                    ];

                    if (index < values.length) {
                        $value.text(values[index]);
                    }
                });

                // Actualizar panel de Situación Familiar (eq(1) es Situación Familiar dentro del Resumen Detallado)
                // NOTA: Vulnerabilidad NO se actualiza aquí porque está en su propia sección separada con filtros independientes
                $('.panel-success').eq(1).find('.panel-body').find('.row').eq(0).find('.col-md-3').each(function(index) {
                    var $card = $(this).find('div');
                    var $value = $card.find('div').first();

                    var values = [
                        data.embarazadas || 0,
                        data.madres || 0,
                        data.padres || 0,
                        data.alumnosTrabajando || 0
                    ];

                    if (index < values.length) {
                        $value.text(values[index]);
                    }
                });

                // IMPORTANTE: NO actualizar vulnerabilidad aquí porque los filtros de especialidad/carrera NO deben afectarla
                // La vulnerabilidad tiene sus propios filtros independientes (mes, período, año)
            }
            // Exponer a window: el histórico por sección (Task 7) vive en otro <script>/ready y necesita alcanzarla.
            window.actualizarResumenDetallado = actualizarResumenDetallado;


            function mostrarFiltroActivo(data) {
                var filtros = [];
                if (data.especialidadFiltro) {
                    filtros.push('Especialidad: ' + data.especialidadFiltro);
                }
                if (data.carreraFiltro) {
                    filtros.push('Carrera: ' + data.carreraFiltro);
                }
                $('#nombreFiltroActivo').text(filtros.join(' | '));
                $('#filtroActivo').show();
            }

            // Manejo de botones de estadísticas adicionales
            $('.estadistica-btn').click(function() {
                var estadistica = $(this).data('estadistica');
                var seccionActual = $('#estadistica-' + estadistica);
                var estaActivo = $(this).hasClass('active');

                // Si el botón ya está activo, cerrar la sección
                if (estaActivo && seccionActual.is(':visible')) {
                    seccionActual.slideUp(300);
                    $(this).removeClass('active');
                    return;
                }

                // Ocultar todas las secciones
                $('.estadistica-contenido').slideUp(300);

                // Remover clase active de todos los botones
                $('.estadistica-btn').removeClass('active');

                // Agregar clase active al botón clickeado
                $(this).addClass('active');

                // Mostrar la sección correspondiente
                seccionActual.slideDown(300, function() {
                    // Inicializar gráficas solo cuando se muestre la sección
                    inicializarGraficaEspecifica(estadistica);
                });
            });

            // toggleIncluirBajas está en ámbito global; estas funciones solo existían aquí dentro del ready
            window.aplicarFiltroResumen = aplicarFiltroResumen;
            window.aplicarFiltroVulnerabilidades = aplicarFiltroVulnerabilidades;
            window.cargarEstadisticasCierreCuatrimestres = cargarEstadisticasCierreCuatrimestres;

            // ── Modal de detalle de alumnos por categoría de vulnerabilidad ──
            var VULN_CAT_NOMBRES = { economicos:'Vulnerables Económicos', academicos:'Vulnerables Académicos', personales:'Vulnerables Personales', vulnerables:'Total de Vulnerables', noVulnerables:'No Vulnerables', sinInformacion:'Sin Información' };
            var FUENTE_TXT = { seguimiento:'Seguimiento', identificacion:'Identificación' };

            function abrirVulnModal(cat) {
                var params = $.extend({}, window._vulnParamsActuales || {});
                if (params.corteId) { alert('El detalle por alumno solo está disponible en vivo (viendo un corte histórico solo hay conteos).'); return; }
                params.categoria = cat;
                $('#vulnModalTitulo').text(VULN_CAT_NOMBRES[cat] || cat);
                $('#vulnModalBuscar').val('');
                $('#vulnModalTabla').hide().find('tbody').empty();
                $('#vulnModalError').hide(); $('#vulnModalSpinner').show();
                $('#vulnModalOverlay').css('display', 'block');
                $.ajax({
                    url: '@Url.Action("GetAlumnosVulnerabilidad", "NuevasEstadisticas")',
                    type: 'POST', data: params,
                    success: function (r) {
                        $('#vulnModalSpinner').hide();
                        if (!r || !r.success) { $('#vulnModalError').text('No se pudo obtener la lista: ' + ((r && r.error) || 'error')).show(); return; }
                        $('#vulnModalTitulo').text((VULN_CAT_NOMBRES[cat] || cat) + ' — ' + r.total + ' alumno' + (r.total === 1 ? '' : 's'));
                        var html = r.alumnos.map(function (a) {
                            var buscar = ((a.matricula || '') + ' ' + (a.nombre || '')).toLowerCase();
                            return '<tr data-buscar="' + buscar.replace(/"/g, '') + '"><td>' + a.matricula + '</td><td>' + (a.nombre || '') + '</td><td>' + (a.especialidad || '') + '</td><td>' + (FUENTE_TXT[a.fuente] || '—') + '</td></tr>';
                        }).join('');
                        $('#vulnModalTabla tbody').html(html);
                        $('#vulnModalTabla').show();
                    },
                    error: function () { $('#vulnModalSpinner').hide(); $('#vulnModalError').text('Error de conexión. Cierre y vuelva a intentar.').show(); }
                });
            }
            $('#contenidoVulnerabilidades').on('click', '.vuln-card-click', function () { abrirVulnModal($(this).data('vuln-cat')); });
            function cerrarVulnModal() { $('#vulnModalOverlay').hide(); }
            $('#vulnModalCerrar').on('click', cerrarVulnModal);
            $('#vulnModalOverlay').on('click', function (e) { if (e.target === this) cerrarVulnModal(); });
            $(document).on('keydown', function (e) { if (e.key === 'Escape' && $('#vulnModalOverlay').is(':visible')) cerrarVulnModal(); });
            $('#vulnModalBuscar').on('input', function () {
                var q = ($(this).val() || '').toLowerCase().trim();
                $('#vulnModalTabla tbody tr').each(function () { $(this).toggle(!q || ($(this).data('buscar') || '').indexOf(q) >= 0); });
            });
            // ── Fin modal vulnerabilidad ──

        });

        // Función para inicializar gráficas de una sección específica
        function inicializarGraficaEspecifica(estadistica) {
            // Verificar si la gráfica ya fue inicializada
            var canvasId = '';
            var chartExists = false;

            switch(estadistica) {
                case 'bajas':
                    renderBajas(window._bajasServerData);
                    break;
                case 'pats':
                    canvasId = 'graficaPATsPorEstado';
                    if (Chart.getChart(canvasId)) {
                        return; // Ya está inicializada
                    }
                    inicializarGraficasPATs();
                    break;
                case 'arrastre':
                    canvasId = 'graficaArrastrePorEstado';
                    if (Chart.getChart(canvasId)) {
                        return; // Ya está inicializada
                    }
                    inicializarGraficasArrastre();
                    break;
            }
        }

        // Plugin para mostrar porcentajes en gráficas
        Chart.register({
            id: 'percentagePlugin',
            afterDatasetsDraw: function(chart) {
                var ctx = chart.ctx;
                var total = 0;
                chart.data.datasets.forEach(function(dataset) {
                    dataset.data.forEach(function(value) {
                        total += value;
                    });
                });

                chart.data.datasets.forEach(function(dataset, i) {
                    var meta = chart.getDatasetMeta(i);
                    if (chart.config.type === 'doughnut' || chart.config.type === 'pie') {
                        meta.data.forEach(function(element, index) {
                            var value = dataset.data[index];
                            var percentage = total > 0 ? ((value / total) * 100).toFixed(1) + '%' : '0%';
                            var position = element.tooltipPosition();
                            ctx.fillStyle = '#000';
                            ctx.font = 'bold 12px Arial';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.fillText(percentage, position.x, position.y);
                        });
                    }
                });
            }
        });

        // Datos de Bajas del servidor (para renderBajas en vivo)
        window._bajasServerData = @Html.Raw(Json.Encode(ViewBag.EstadisticasBajas));

        // Función para renderizar las gráficas de Bajas con datos arbitrarios (en vivo o histórico)
        function renderBajas(d) {
            d = d || { TotalBajas: 0, BajasPorCausa: {}, BajasPorCarrera: {}, BajasPorVulnerabilidad: {} };
            ['graficaBajasPorCausa','graficaBajasPorCarrera','graficaBajasPorVulnerabilidad'].forEach(function(id){
                var ex = Chart.getChart(id); if (ex) ex.destroy();
            });
            var totalBadge = document.getElementById('bajasTotalBadge');
            if (totalBadge) totalBadge.textContent = (d.TotalBajas != null ? d.TotalBajas : 0);

            // Gráfica de Bajas por Causa
            var ctxBajasCausa = document.getElementById('graficaBajasPorCausa');
            if (ctxBajasCausa && !Chart.getChart(ctxBajasCausa)) {
                // Filtrar solo las categorías que tienen valores mayores a 0
                var labelsBajasCausa = [];
                var dataBajasCausa = [];
                var _causa = d.BajasPorCausa || {};
                Object.keys(_causa).forEach(function(k) { if (_causa[k] > 0) { labelsBajasCausa.push(k); dataBajasCausa.push(_causa[k]); } });

                var pairsCausa = labelsBajasCausa.map(function(l, i) { return { l: l, v: dataBajasCausa[i] }; });
                pairsCausa.sort(function(a, b) { return b.v - a.v; });
                labelsBajasCausa = pairsCausa.map(function(p) { return p.l; });
                dataBajasCausa = pairsCausa.map(function(p) { return p.v; });

                var totalBajasCausa = dataBajasCausa.reduce(function(a, b) { return a + b; }, 0);

                var coloresBajasCausa = [
                    '#9b59b6', '#4BC0C0', '#f54409', '#9966FF', '#FF6384',
                    '#FF9F40', '#3498db', '#df002b', '#2ecc71', '#e74c3c'
                ];
                var bgCausa = labelsBajasCausa.map(function(_, i) {
                    return coloresBajasCausa[i % coloresBajasCausa.length];
                });

                var wrapCausa = ctxBajasCausa.closest('.chart-container');
                if (wrapCausa) {
                    var altCausa = Math.min(Math.max(300, labelsBajasCausa.length * 34 + 110), 960);
                    wrapCausa.style.minHeight = altCausa + 'px';
                }

                new Chart(ctxBajasCausa, {
                    type: 'bar',
                    data: {
                        labels: labelsBajasCausa,
                        datasets: [{
                            label: 'Bajas',
                            data: dataBajasCausa,
                            backgroundColor: bgCausa,
                            borderColor: bgCausa.map(function(c) { return c; }),
                            borderWidth: 1,
                            borderRadius: 4,
                            maxBarThickness: 28
