                                beginAtZero: true,
                                ticks: {
                                    font: {
                                        size: 11
                                    }
                                }
                            },
                            x: {
                                ticks: {
                                    font: {
                                        size: 10
                                    },
                                    maxRotation: 45,
                                    minRotation: 45,
                                    autoSkip: false
                                }
                            }
                        }
                    },
                    plugins: [{
                        id: 'barValuePlugin',
                        afterDatasetsDraw: function(chart) {
                            var ctx = chart.ctx;
                            chart.data.datasets.forEach(function(dataset, i) {
                                var meta = chart.getDatasetMeta(i);
                                meta.data.forEach(function(bar, index) {
                                    var value = dataset.data[index];
                                    var position = bar.tooltipPosition();
                                    ctx.fillStyle = '#000';
                                    ctx.font = 'bold 11px Arial';
                                    ctx.textAlign = 'center';
                                    ctx.textBaseline = 'bottom';
                                    ctx.fillText(value, position.x, position.y - 5);
                                });
                            });
                        }
                    }]
                });
            }

            // Gráfica de Bajas por Vulnerabilidad
            var ctxBajasVuln = document.getElementById('graficaBajasPorVulnerabilidad');
            if (ctxBajasVuln && !Chart.getChart(ctxBajasVuln)) {
                // Filtrar solo las categorías que tienen valores mayores a 0
                var labelsBajasVuln = [];
                var dataBajasVuln = [];
                var _vuln = d.BajasPorVulnerabilidad || {};
                Object.keys(_vuln).forEach(function(k) { if (_vuln[k] > 0) { labelsBajasVuln.push(k); dataBajasVuln.push(_vuln[k]); } });

                var pairsVuln = labelsBajasVuln.map(function(l, i) { return { l: l, v: dataBajasVuln[i] }; });
                pairsVuln.sort(function(a, b) { return b.v - a.v; });
                labelsBajasVuln = pairsVuln.map(function(p) { return p.l; });
                dataBajasVuln = pairsVuln.map(function(p) { return p.v; });

                var totalBajasVuln = dataBajasVuln.reduce(function(a, b) { return a + b; }, 0);

                var coloresBajasVuln = [
                    '#9b59b6', '#f54409', '#3498db', '#7f8c8d', '#2ecc71', '#e74c3c'
                ];
                var bgVuln = labelsBajasVuln.map(function(_, i) {
                    return coloresBajasVuln[i % coloresBajasVuln.length];
                });

                var wrapVuln = ctxBajasVuln.closest('.chart-container');
                if (wrapVuln) {
                    var altVuln = Math.min(Math.max(300, labelsBajasVuln.length * 34 + 110), 960);
                    wrapVuln.style.minHeight = altVuln + 'px';
                }

                new Chart(ctxBajasVuln, {
                    type: 'bar',
                    data: {
                        labels: labelsBajasVuln,
                        datasets: [{
                            label: 'Bajas',
                            data: dataBajasVuln,
                            backgroundColor: bgVuln,
                            borderColor: bgVuln.map(function(c) { return c; }),
                            borderWidth: 1,
                            borderRadius: 4,
                            maxBarThickness: 28
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            title: {
                                display: true,
                                text: 'Bajas por Vulnerabilidad',
                                font: { size: 16, weight: 'bold' }
                            },
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        var value = context.parsed.x;
                                        var pct = totalBajasVuln > 0 ? ((value / totalBajasVuln) * 100).toFixed(1) : '0.0';
                                        return ' ' + value + ' (' + pct + '%)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { precision: 0, font: { size: 11 } },
                                grid: { color: 'rgba(0,0,0,0.06)' }
                            },
                            y: {
                                ticks: {
                                    autoSkip: false,
                                    font: { size: 11 }
                                },
                                grid: { display: false }
                            }
                        }
                    },
                    plugins: [{
                        id: 'horizontalBarValueBajasVuln',
                        afterDatasetsDraw: function(chart) {
                            var ctx = chart.ctx;
                            chart.data.datasets.forEach(function(dataset, i) {
                                var meta = chart.getDatasetMeta(i);
                                meta.data.forEach(function(bar, index) {
                                    var value = dataset.data[index];
                                    if (!value) return;
                                    var pct = totalBajasVuln > 0 ? ((value / totalBajasVuln) * 100).toFixed(1) : '0';
                                    var x = bar.x;
                                    var y = bar.y;
                                    var chartArea = chart.chartArea;
                                    ctx.save();
                                    ctx.fillStyle = '#333';
                                    ctx.font = 'bold 11px Arial';
                                    ctx.textBaseline = 'middle';
                                    var texto = value + ' (' + pct + '%)';
                                    var pad = 6;
                                    if (x + pad + ctx.measureText(texto).width > chartArea.right - 4) {
                                        ctx.textAlign = 'right';
                                        ctx.fillText(texto, x - pad, y);
                                    } else {
                                        ctx.textAlign = 'left';
                                        ctx.fillText(texto, x + pad, y);
                                    }
                                    ctx.restore();
                                });
                            });
                        }
                    }]
                });
            }
        }

        function cargarBajas(corteId) {
            // Filtros solo en vivo (el snapshot historico es agregado).
            $('#causaFiltroBajas, #mesFiltroBajas, #carreraFiltroBajas, #especialidadFiltroBajas, #gradoFiltroBajas, #grupoFiltroBajas').prop('disabled', !!corteId)
                .attr('title', corteId ? 'Filtro disponible solo en vivo' : '');
            $.ajax({
                url: '@Url.Action("GetEstadisticasBajas", "NuevasEstadisticas")',
                type: 'POST',
                data: {
                    corteId: corteId || null,
                    causa: (corteId ? null : ($('#causaFiltroBajas').val() || null)),
                    mes: (corteId ? null : ($('#mesFiltroBajas').val() || null)),
                    carreraId: (corteId ? null : ($('#carreraFiltroBajas').val() || null)),
                    especialidadId: (corteId ? null : ($('#especialidadFiltroBajas').val() || null)),
                    gradoId: (corteId ? null : ($('#gradoFiltroBajas').val() || null)),
                    grupoId: (corteId ? null : ($('#grupoFiltroBajas').val() || null))
                },
                success: function (r) { if (r && r.success) renderBajas(r.data); },
                error: function () { /* dejar las graficas actuales */ }
            });
        }
        $(function () { $('#causaFiltroBajas, #mesFiltroBajas, #carreraFiltroBajas, #especialidadFiltroBajas, #gradoFiltroBajas, #grupoFiltroBajas').on('change', function () { cargarBajas(null); }); });

