            </div>
        </div>
    </div>
    <div class="container body-content ">
        @RenderBody()
        <hr />
    </div>

    <footer class="page-footer font-small blue footer-style">
        <div class="footer-copyright text-center py-3">
            <p>
                Innovación tecnológica impulsada por la Carrera de
                <a href="https://login.uttn.app/Home/Creditos" style="color:white;">
                    Tecnologías de la Información
                </a> y el Departamento de Sistemas
            </p>
            <p>
                DESARROLLO TECNOLÓGICO DE TUTORIAS INSTITUCIONALES.
            </p>
            <p>
                @DateTime.Now.Year | Universidad Tecnológica de Tamaulipas Norte |
                <a href="https://www.uttn.edu.mx/aviso-de-privacidad/" style="color:white;">
                    Aviso de Privacidad
                </a>
            </p>
            <p>&nbsp;</p>
        </div>
    </footer>

    @if (usuario != null)
    {
        <div id="sessionTimer" title="Tiempo restante de sesión">
            <i class="fa-regular fa-clock"></i>
            <span>Sesión: </span>
            <span id="timerDisplay" style="font-weight: bold;">--:--:--</span>
        </div>
    }

    <script>
            let CLAIMS = @Html.Raw(Json.Encode(System.Security.Claims.ClaimsPrincipal.Current.Claims.Select(x => new { x.Type, x.Value })));
    </script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap.min.js"></script>

    <script>
        $(document).ready(function () {
            $('a[href*="ReturnHome"]').on('click', function () {
                sessionStorage.clear();
                localStorage.clear();
                console.log('SessionStorage y LocalStorage limpiados - saliendo a sistema principal');
            });

            $('a[href*="Logout"]').on('click', function () {
                sessionStorage.clear();
                localStorage.clear();
                console.log('SessionStorage y LocalStorage limpiados - cerrando sesión');
            });

            $('.link-entrevistas').on('click', function (e) {
                sessionStorage.clear();
                Object.keys(localStorage).forEach(function (key) {
                    if (key.toLowerCase().includes('entrevista') ||
                        key.toLowerCase().includes('solicitud') ||
                        key.toLowerCase().includes('grupo')) {
                        localStorage.removeItem(key);
                        console.log('LocalStorage - Dato eliminado:', key);
                    }
                });
                console.log('Datos de entrevistas limpiados completamente');
            });

            if (window.location.href.includes('/Entrevistas/Grupo')) {
                sessionStorage.clear();
                console.log('SessionStorage limpiado al cargar página de Entrevistas');
            }

            var expirationString = "@fechaExpiracion";
            if (expirationString && document.getElementById("sessionTimer")) {
                var expirationDate = new Date(expirationString);

                function updateTimer() {
                    var now = new Date();
                    var distance = expirationDate - now;
                    var timerDiv = document.getElementById("sessionTimer");

                    if (distance < 0) {
                        document.getElementById("timerDisplay").innerHTML = "CERRANDO...";
                        timerDiv.classList.add("danger");
                        window.location.href = "@Html.Raw(urlTimeout)";
                        return;
                    }

                    var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    var totalMinutes = (hours * 60) + minutes;

                    var displayString =
                        (hours < 10 ? "0" + hours : hours) + ":" +
                        (minutes < 10 ? "0" + minutes : minutes) + ":" +
                        (seconds < 10 ? "0" + seconds : seconds);

                    document.getElementById("timerDisplay").innerHTML = displayString;

                    if (totalMinutes < 10) {
                        timerDiv.classList.add("danger");
                        timerDiv.classList.remove("warning");
                    } else if (totalMinutes >= 10 && totalMinutes < 30) {
                        timerDiv.classList.add("warning");
                        timerDiv.classList.remove("danger");
                    } else {
                        timerDiv.classList.remove("warning", "danger");
                    }
                }

                setInterval(updateTimer, 1000);
                updateTimer();
            }
        });
    </script>
</body>
</html>