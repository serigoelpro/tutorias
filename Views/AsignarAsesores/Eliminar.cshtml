@model Plataforma_Web.Models.TutoriaGrupal

@{
    ViewBag.Title = "Delete";
}

<h2>Eliminar</h2>

<h3>Estas tu seguro que deseas eliminar este registro?</h3>

<h4><font color="red">
    EL PAT ASOCIADO A ESTE GRUPO ASESORADO TAMBIEN SERA ELIMINADO EN CASO DE EXISTIR
</font></h4>
<div>
    <h4>Grupo asesorado</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Grado)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Grado.Nombre)
        </dd>


        <dt>
            @Html.DisplayNameFor(model => model.Grupo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Grupo.Nombre)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Carrera)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Carrera.Nombre)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Turno)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Turno.Nombre)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <a class="btn btn-primary" href="@Url.Action("Index")"
               role="button">
                <span class="glyphicon glyphicon-arrow-left"></span>
                Regresar

            </a>

            <input type="submit" value="Eliminar" class="btn btn-default" style="background-color:#c51e1e; color:white;" />
        </div>
    }
</div>
