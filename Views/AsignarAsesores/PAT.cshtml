        // Función para cargar turnos reales desde la base de datos
        function cargarTurnosReales() {
            console.log('Iniciando carga de turnos reales...');

            // Obtener solo los PATs visibles en la vista (filtrados/paginados)
            const elements = document.querySelectorAll('.pat-row:not(.hidden), .pat-card:not(.hidden)');
            const patIds = [];

            elements.forEach(element => {
                const deleteButton = element.querySelector('button[onclick*="openDeleteModal"]');
                if (deleteButton) {
                    const onclickValue = deleteButton.getAttribute('onclick');
                    const matches = onclickValue.match(/openDeleteModal\((\d+)/);
                    if (matches && matches[1]) {
                        patIds.push(matches[1]);
                    }
                }
            });

            // Limitar la cantidad de PATs procesados para reducir la carga
            const maxPATs = 30;
            const limitedPatIds = patIds.slice(0, maxPATs);
            console.log(`Procesando ${limitedPatIds.length} PATs visibles para cargar turnos (máximo ${maxPATs}):`, limitedPatIds);

            if (limitedPatIds.length === 0) {
                console.log('No se encontraron PATs visibles para cargar turnos');
                return;
            }

            // Hacer petición AJAX para obtener información de turnos solo de los visibles
            $.ajax({
                url: '@Url.Action("ObtenerTurnosPATs", "AsignarAsesores")',
                type: 'POST',
                data: {
                    patIds: limitedPatIds,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    console.log('Respuesta del servidor recibida:', response);
                    if (response && response.length > 0) {
                        actualizarTurnosEnVista(response);
                        console.log(`Turnos cargados exitosamente para ${response.length} PATs visibles`);
                    } else {
                        console.log('Respuesta vacía del servidor, usando detección inteligente');
                        detectarTurnosInteligente();
                    }
                },
                error: function(xhr, status, error) {
                    console.log('Error al cargar turnos desde BD:', {
                        status: xhr.status,
                        statusText: xhr.statusText,
                        responseText: xhr.responseText,
                        error: error
                    });
                    detectarTurnosInteligente();
                }
            });
        }

