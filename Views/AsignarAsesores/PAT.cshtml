    $.ajax({
        url: '@Url.Action("ObtenerIdsConPendientes", "PATs")',
        type: 'POST',
        data: { patIds: patIds },
        success: function(response) {
            if(response.ids) {
                response.ids.forEach(function(id) {
                    var $row = $('.pat-row[data-pat-id="' + id + '"]');
                    $row.find('.clock-icon-placeholder').html(
                        '<span class="glyphicon glyphicon-time" title="Evidencias pendientes de revisar" style="color: #ffc107; background: #fff3cd; padding: 4px; border-radius: 50%; margin-left: 5px; cursor:help;"></span>'
                    );
                });
            }
        }
    });
}


