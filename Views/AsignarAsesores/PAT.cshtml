@model IEnumerable<Plataforma_Web.Models.PAT>
@Styles.Render("~/ViewsStyles/PAT/ListPAT.css")
@{
    ViewBag.Title = "PAT";
    var _usr = Session["Usuario"] as Plataforma_Web.Models.Usuario;
    bool esDirector = _usr != null && _usr.EsDirector;
}


@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}
<div class="sga-scope">
    <div class="pat-container">
        <!-- Header consistente -->
        <div class="pat-header">
            <h2 class="pat-title">Plan de Acción Tutorial</h2>

            <!-- Buscador + Selector de Vista en la misma línea -->
            <div class="search-and-view-row">
                <div class="search-container">
                    <div class="search-input-wrapper">
                        <span class="search-icon glyphicon glyphicon-search"></span>
                        <input type="text" class="search-input" id="patSearchInput" placeholder="Buscar...">
                        <button type="button" class="search-clear" id="clearSearchBtn" style="display: none;">
                            <span class="glyphicon glyphicon-remove"></span>
                        </button>
                    </div>
                </div>
                <div class="view-selector">
                    <button type="button" class="view-toggle-btn" id="porRevisarBtn" style="background: #17a2b8; color: white;">
                        <span class="glyphicon glyphicon-eye-open"></span>
                        Revisión de PATs
                    </button>
                    <button type="button" class="view-toggle-btn" id="generarExcelBtn" style="background: #28a745; color: white;">
                        <span class="glyphicon glyphicon-download-alt"></span>
                        Generar reportes
                    </button>
                    @if (ViewBag.IdNivel == 4)
                    {
                        <button type="button" class="view-toggle-btn" id="crearPATsBtn" style="background: #ff6b35; color: white;">
                            <span class="glyphicon glyphicon-plus"></span>
                            Crear PATs
                        </button>
                    }
                </div>
            </div>


            <!-- Filtros Multi-Selección -->
            <div class="pat-filters">
                <!-- Filtro Carrera (siempre visible para IdNivel 3 y 4) -->
                @if (ViewBag.IdNivel == 4)
                {
                    <div class="filter-dropdown">
                        <button type="button" class="filter-btn" id="btnCarrera">
                            <span class="filter-label">Carrera</span>
                            <span class="filter-count" id="countCarrera">(Seleccione carrera)</span>
                            <span class="glyphicon glyphicon-chevron-down"></span>
                        </button>
                        <div class="filter-content" id="dropdownCarrera" style="display: none;">
                            <div class="filter-options">
                                <!-- Opción "Todos" -->
                                <div class="checkbox-option select-all-option">
                                    <input type="checkbox" id="carrera_todos" value="" data-filter="carrera" data-action="select-all" checked>
                                    <label for="carrera_todos"><strong>Seleccione carrera</strong></label>
                                </div>
                                <div class="filter-separator"></div>
                                <!-- Las opciones se poblarán dinámicamente -->
                            </div>
                        </div>
                    </div>
                }
                <!-- Filtro Estado -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnEstado">
                        <span class="filter-label">Estado</span>
                        <span class="filter-count" id="countEstado">(4 seleccionados)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownEstado" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="estado_todos" value="" data-filter="estado" data-action="select-all">
                                <label for="estado_todos"><strong>Todos los Estados</strong></label>
                            </div>
                            <div class="filter-separator"></div>

                            <div class="checkbox-option">
                                <input type="checkbox" id="estado_finalizado" value="Aprobado" checked>
                                <label for="estado_finalizado">Aprobado</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="estado_progreso" value="En progreso" checked>
                                <label for="estado_progreso">En progreso</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="estado_revision" value="En revisión" checked>
                                <label for="estado_revision">En revisión</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="estado_rechazado" value="Rechazado" checked>
                                <label for="estado_rechazado">Rechazado</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="estado_inactivo" value="Inactivo">
                                <label for="estado_inactivo">Inactivo</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filtro Grado -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnGrado">
                        <span class="filter-label">Grado</span>
                        <span class="filter-count" id="countGrado">(Todos)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownGrado" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="grado_todos" value="" data-filter="grado" data-action="select-all" checked>
                                <label for="grado_todos"><strong>Todos los Grados</strong></label>
                            </div>
                            <div class="filter-separator"></div>
                            <!-- Las opciones se poblarán dinámicamente como checkboxes -->
                        </div>
                    </div>
                </div>

                <!-- Filtro Grupo -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnGrupo">
                        <span class="filter-label">Grupo</span>
                        <span class="filter-count" id="countGrupo">(Todos)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownGrupo" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="grupo_todos" value="" data-filter="grupo" data-action="select-all" checked>
                                <label for="grupo_todos"><strong>Todos los Grupos</strong></label>
                            </div>
                            <div class="filter-separator"></div>
                            <!-- Las opciones se poblarán dinámicamente como checkboxes -->
                        </div>
                    </div>
                </div>

                <!-- Filtro Período -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnPeriodo">
                        <span class="filter-label">Período</span>
                        <span class="filter-count" id="countPeriodo">(Todos)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownPeriodo" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="periodo_todos" value="" data-filter="periodo" data-action="select-all" checked>
                                <label for="periodo_todos"><strong>Todos los Períodos</strong></label>
                            </div>
                            <div class="filter-separator"></div>
                            <!-- Las opciones se poblarán dinámicamente como checkboxes -->
                        </div>
                    </div>
                </div>

                <!-- Filtro Año -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnAno">
                        <span class="filter-label">Año</span>
                        <span class="filter-count" id="countAno">(Todos)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownAno" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="ano_todos" value="" data-filter="ano" data-action="select-all" checked>
                                <label for="ano_todos"><strong>Todos los Años</strong></label>
                            </div>
                            <div class="filter-separator"></div>
                            <!-- Las opciones se poblarán dinámicamente como checkboxes -->
                        </div>
                    </div>
                </div>

                <!-- Filtro Turno -->
                <div class="filter-dropdown">
                    <button type="button" class="filter-btn" id="btnTurno">
                        <span class="filter-label">Turno</span>
                        <span class="filter-count" id="countTurno">(Todos)</span>
                        <span class="glyphicon glyphicon-chevron-down"></span>
                    </button>
                    <div class="filter-content" id="dropdownTurno" style="display: none;">
                        <div class="filter-options">
                            <!-- Opción "Todos" -->
                            <div class="checkbox-option select-all-option">
                                <input type="checkbox" id="turno_todos" value="" data-filter="turno" data-action="select-all" checked>
                                <label for="turno_todos"><strong>Todos los Turnos</strong></label>
                            </div>
                            <div class="filter-separator"></div>
                            <!-- Opciones específicas de turno -->
                            <div class="checkbox-option">
                                <input type="checkbox" id="turno_matutino" value="MATUTINO">
                                <label for="turno_matutino">Matutino</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="turno_vespertino" value="VESPERTINO">
                                <label for="turno_vespertino">Vespertino</label>
                            </div>
                            <div class="checkbox-option">
                                <input type="checkbox" id="turno_despresurizado" value="DESPRESURIZADO">
                                <label for="turno_despresurizado">Despresurizado</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Botones de Ordenamiento Alfabético -->
                <div style="display: inline-block; margin-right: 8px;">
                    <button type="button" class="btn btn-default" id="btnOrdenarAZ" style="padding: 8px 12px;" title="Ordenar A-Z">
                        <span class="glyphicon glyphicon-sort-by-alphabet"></span>
                        A-Z
                    </button>
                    <button type="button" class="btn btn-default" id="btnOrdenarZA" style="padding: 8px 12px; margin-left: 4px;" title="Ordenar Z-A">
                        <span class="glyphicon glyphicon-sort-by-alphabet-alt"></span>
                        Z-A
                    </button>
                </div>

                <!-- Botón para limpiar filtros -->
                <button type="button" id="clearFiltersBtn" class="btn btn-default clear-filters-btn">
                    <span class="glyphicon glyphicon-remove"></span>
                    Limpiar
                </button>
            </div>
        </div>

        <!-- Indicadores de filtros activos -->
        <div id="activeFiltersDisplay" class="active-filters-container" style="display: none;">
            <h4>Filtros activos:</h4>
            <div id="activeFiltersList"></div>
        </div>
        <div class="row" style="margin: 15px 0;">
            <div class="col-md-12">
                <div class="panel panel-default" style="border-left: 4px solid #1ab192; box-shadow: 0 2px 5px rgba(0,0,0,0.05); background-color: #1ab192; color: white;">
                    <div class="panel-body" id="resumen-pats-container" style="padding: 15px;">

                        @if (ViewBag.IdNivel == 4 && ViewBag.EstadisticasDetalladas != null)
                        {
                            <div style="font-size: 16px; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.3); padding-bottom: 5px;">
                                <strong>PATs Totales: @ViewBag.TotalGlobal</strong>
                            </div>
                            <div style="display: flex; flex-wrap: wrap; gap: 15px; font-size: 13px;">
                                @foreach (var item in (Dictionary<string, int>)ViewBag.EstadisticasDetalladas)
                                {
                                    <span style="background: rgba(0,0,0,0.1); padding: 3px 8px; border-radius: 4px;">
                                        <strong>@item.Key:</strong> @item.Value
                                    </span>
                                }
                            </div>
                        }
                        else if (ViewBag.ResumenCoordinador != null)
                        {
                            <div style="font-size: 18px;">
                                <strong>@ViewBag.ResumenCoordinador</strong>
                            </div>
                        }
                        else
                        {
                            <span id="stats-fallback">Cargando estadísticas...</span>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- Vista de Tabla -->
    <div class="table-responsive" id="patTableContainer">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Grupo</th>
                    <th>Turno</th>
                    <th>Tutor</th>
                    @if (ViewBag.IdNivel == 4)
                    {
                        <th>Carrera</th>
                    }
                    <th>Período</th>
                    <th>Año</th>
                    <th>Alumnos</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="patTableBody">
                @{

                    var nombresTurno = ViewBag.NombresTurno as Dictionary<int, string> ?? new Dictionary<int, string>();
                    // ====================================================
                    // OPTIMIZACIÓN: Calcular una sola vez valores repetitivos
                    // ====================================================
                    var tiempo = DateTime.Now;
                    var periodoActual = 0;
                    if (tiempo.Month >= 1 && tiempo.Month <= 4) { periodoActual = 1; }
                    else if (tiempo.Month >= 5 && tiempo.Month <= 8) { periodoActual = 2; }
                    else { periodoActual = 3; }
                    var añoActual = tiempo.Year;


                    // Cerca de la línea 60
                    Func<int, int, bool, int, string> DeterminarEstadoTexto = (idPeriodo, fechaYear, estado, estadoRevision) =>
                    {
                        if (idPeriodo != periodoActual || fechaYear != añoActual)
                            return "Inactivo";
                        else if (estado == true) // Si la planeación está "En progreso"
                        {
                            if (estadoRevision == 1) return "En revisión";
                            if (estadoRevision == 2) return "Aprobado"; // Esto ya coincide
                            if (estadoRevision == 3) return "Rechazado";
                            return "En progreso"; // Default (EstadoRevision == 0)
                        }
                        else // Si la planeación está "Finalizada" (estado == false)
                        {
                            return "Cerrado"; // <-- CAMBIA "Finalizado" POR "Aprobado"
                        }
                    };
                    Func<int, int, bool, int, string> DeterminarEstadoClase = (idPeriodo, fechaYear, estado, estadoRevision) =>
                    {
                        if (idPeriodo != periodoActual || fechaYear != añoActual)
                            return "status-inactive"; // Rojo (Inactivo)
                        else if (estado == true) // Si la planeación está "En progreso"
                        {
                            if (estadoRevision == 1) return "status-review";  // <-- NUEVO: Azul para En Revisión
                            if (estadoRevision == 2) return "status-active";  // Verde (Aprobado)
                            if (estadoRevision == 3) return "status-inactive"; // Rojo (Rechazado)
                            return "status-pending"; // Amarillo (En progreso, sin enviar)
                        }
                        else // Si la planeación está Cerrada (estado == false)
                        {
                            return "status-active";  // <-- VUELVE A VERDE para Cerrado
                        }
                    };

                }

                @foreach (var item in Model)
                {
                    string nombreTurnoReal = nombresTurno.ContainsKey(item.IdEntrevistaInicial) ? nombresTurno[item.IdEntrevistaInicial] : "Sin turno";
                    // Usar la misma lógica optimizada del primer foreach
                    string estadoPAT = DeterminarEstadoTexto(item.IdPeriodo, item.Fecha.Year, item.estado, item.EstadoRevision);
                    string claseEstado = DeterminarEstadoClase(item.IdPeriodo, item.Fecha.Year, item.estado, item.EstadoRevision);


                    <tr class="pat-row"
                        data-pat-id="@item.IdEntrevistaInicial"
                        data-carrera="@item.Carrera.Nombre"
                        data-tutor="@item.Tutor"
                        data-periodo="@item.Periodo.Nombre"
                        data-grado="@item.TutoriaGrupal"
                        data-grupo="@item.TutoriaGrupal"
                        data-ano="@item.Fecha.Year"
                        data-estado="@estadoPAT"
                        data-turno="@nombreTurnoReal"
                        data-alumnos="@item.CantidadAlumno">
                        <td class="group-cell">
                            <div class="table-cell-content">
                                @item.TutoriaGrupal
                            </div>
                        </td>
                        <td>@nombreTurnoReal</td>
                        <td>@item.Tutor</td>
                        @if (ViewBag.IdNivel == 4)
                        {
                            <td>@item.Carrera.Nombre</td>
                        }
                        <td>@item.Periodo.Nombre</td>
                        <td>@item.Fecha.Year</td>
                        <td><span class="students-badge">@item.CantidadAlumno</span></td>
                        <td>
                            <span class="status-badge @claseEstado">
                                @estadoPAT
                            </span>

                            @* LÓGICA MODIFICADA: Si está cerrado, muestra palomita. Si no, deja el espacio para el reloj de pendientes *@
                            @if (item.estado == false)
                            {
                                <span class="glyphicon glyphicon-ok-circle" title="PAT completado" style="color: #28a745; margin-left: 5px; font-size: 14px; cursor: help;"></span>
                            }
                            else
                            {
                                <span class="clock-icon-placeholder"></span>
                            }
                        </td>
                        <td>
                            <!-- Acciones -->
                            <a href="@Url.Action("PatDetalles", new { id = item.IdEntrevistaInicial, returnUrl = Request.Url.ToString() })" class="btn-action btn-view">
                                <span class="glyphicon glyphicon-eye-open action-icon"></span>
                                Ver
                            </a>
                            <a href="@Url.Action("PatReporte", new { id = item.IdEntrevistaInicial, returnUrl = Request.Url.ToString() })" class="btn-action btn-report">
                                <span class="glyphicon glyphicon-th-list action-icon"></span>
                                Reporte
                            </a>
                            @if (!esDirector)
                            {
                            <button type="button" class="btn-action btn-delete" onclick="openDeleteModal(@item.IdEntrevistaInicial, '@Html.Raw(Html.Encode(item.Carrera.Nombre))', '@Html.Raw(Html.Encode(item.Tutor))', '@Html.Raw(Html.Encode(item.Periodo.Nombre))', '@Html.Raw(Html.Encode(item.TutoriaGrupal))', '@item.Fecha.ToString("dd/MM/yyyy")', @item.Fecha.Year, '@estadoPAT')">
                                <span class="glyphicon glyphicon-trash action-icon"></span>
                                Eliminar
                            </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mensaje de sin resultados -->
    <div class="empty-state" id="patNoResults" style="display: none;">
        <div class="empty-icon">
            <span class="glyphicon glyphicon-search"></span>
        </div>
        <h3 class="empty-title">No hay PATs disponibles</h3>
        <p class="empty-message">
            No hay PATs que coincidan con los filtros aplicados.
            Intente cambiar los criterios de búsqueda o filtros.
        </p>
    </div>

    <!-- Paginación -->
    <div class="pagination-section" style="margin-top: 30px; margin-bottom: 20px;">
        <div class="simple-pagination" id="simplePagination" style="display: none;">
            <div class="pagination-info">
                <span id="paginationInfo">Mostrando 1-30 de 150 elementos</span>
            </div>
            <div class="pagination-nav">
                <button type="button" id="prevPageBtn" class="btn btn-default pagination-btn">
                    <span class="glyphicon glyphicon-chevron-left"></span>
                    Anterior
                </button>
                <span class="current-page">
                    Página <span id="currentPageNum">1</span> de <span id="totalPagesNum">5</span>
                </span>
                <button type="button" id="nextPageBtn" class="btn btn-default pagination-btn">
                    Siguiente
                    <span class="glyphicon glyphicon-chevron-right"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Botón regresar arriba -->
    <span class="ir-arriba icon-arrow-up2">
        <span class="glyphicon glyphicon-chevron-up"></span>
    </span>

    <!-- Modal de Eliminación de PAT -->
    <div id="deleteModal" class="modal-overlay" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">Eliminar PAT</h3>
            </div>
            <div class="modal-body">
                <div class="warning-message">
                    <div class="warning-text">
                        <p><strong>¿Está seguro que desea eliminar este PAT?</strong></p>
                        <p class="warning-note">
                            <strong style="color: #dc3545;">
                                La tutoría grupal asociada a este PAT también se eliminará.
                            </strong>
                        </p>
                    </div>
                </div>
                <div class="delete-details">
                    <div class="detail-row">
                        <span class="detail-label">Carrera:</span>
                        <span id="deleteCarrera" class="detail-value"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Tutor:</span>
                        <span id="deleteTutor" class="detail-value"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Período:</span>
                        <span id="deletePeriodo" class="detail-value"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Grupo:</span>
                        <span id="deleteGrupo" class="detail-value"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Estado:</span>
                        <span id="deleteEstado" class="detail-value"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Fecha de creación:</span>
                        <span id="deleteFecha" class="detail-value"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="closeDeleteModal()">
                    <span class="glyphicon glyphicon-remove"></span> Cancelar
                </button>
                @if (!esDirector)
                {
                <form id="deleteForm" method="post" style="display: inline;" onsubmit="return handleDeletePAT(event)">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-action btn-danger">
                        <span class="glyphicon glyphicon-trash"></span> Eliminar
                    </button>
                </form>
                }
            </div>
        </div>
    </div>

    <!-- Modal de Crear PATs -->
    @if (ViewBag.IdNivel == 4)
    {
        <div id="crearPATsModal" class="modal-overlay" style="display: none;">
            <div class="modal-container" style="max-width: 800px;">
                <div class="modal-header">
                    <h3 class="modal-title">
                        <span class="glyphicon glyphicon-plus"></span>
                        Crear PATs para Tutores
                    </h3>
                    <button type="button" class="modal-close" onclick="closeCrearPATsModal()">
                        <span class="close-icon">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Filtro de Carrera -->
                    <div class="row" style="margin-bottom: 16px;">
                        <div class="col-md-4">
                            <label for="filtro-carrera-crear" style="font-weight:600;">Filtrar por carrera:</label>
                            <select id="filtro-carrera-crear" class="form-control">
                                <option value="">Todas las carreras</option>
                            </select>
                        </div>
                    </div>

                    <div id="loading-tutores" style="text-align: center; padding: 20px;">
                        <span class="glyphicon glyphicon-refresh glyphicon-spin"></span>
                        Cargando tutores disponibles...
                    </div>
                    <div id="tutores-container" style="display: none;">
                        <div class="info-periodo" style="background: #e7f3ff; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                            <h5 style="margin: 0 0 8px 0; color: #1976d2;">
                                <span class="glyphicon glyphicon-info-sign"></span>
                                Información del Período Actual
                            </h5>
                            <p style="margin: 0; color: #424242;" id="info-periodo-texto"></p>
                        </div>
                        <div id="sin-tutores" style="display: none; text-align: center; padding: 20px;">
                            <span class="glyphicon glyphicon-ok-circle" style="font-size: 48px; color: #4caf50; margin-bottom: 16px; display: block;"></span>
                            <h4 style="color: #4caf50; margin-bottom: 8px;">¡Excelente!</h4>
                            <p style="color: #666;">Todos los tutores con grupos asignados ya tienen sus PATs creados para el período actual.</p>
                        </div>
                        <div id="lista-tutores">
                            <h5 style="margin-bottom: 16px; color: #333;">
