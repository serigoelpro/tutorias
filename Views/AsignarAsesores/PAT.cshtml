<script>
        // Variables para ordenamiento
        let ordenActual = null; // 'asc', 'desc', o null

        // ====================================================
        // Variables globales para filtros persistentes
        // ====================================================

        // Recuperar filtros desde URL o localStorage al cargar la página
        let currentSearch = '';
        let activeFilters = {
            carrera: [],
            grado: [],
            grupo: [],
            periodo: [],
            ano: [],
            estado: [],
            turno: []
        };
        let currentView = 'table'; // Solo vista de tabla

        // Variables para paginación
        let currentPage = 1;
        let itemsPerPage = 30;
        let totalItems = 0;
        let totalPages = 0;
        let filteredItems = [];

        // Variables para ordenamiento
        let currentSort = {
            column: null,
            direction: 'neutral' // 'asc', 'desc', 'neutral'
        };

        function sortTable(column) {
            const tableBody = document.getElementById('patTableBody');
            const rows = Array.from(tableBody.querySelectorAll('.pat-row'));
            let direction = 'asc';
            if (currentSort.column === column) {
                direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            }
            currentSort = { column, direction };

            rows.sort((a, b) => {
                let aValue = a.dataset[column] || '';
                let bValue = b.dataset[column] || '';

                // Eliminar espacios iniciales/finales antes de comparar
                aValue = aValue.trim().toLowerCase();
                bValue = bValue.trim().toLowerCase();

                // Comparación especial para año y alumnos (numérico)
                if (column === 'ano' || column === 'alumnos') {
                    aValue = parseInt(aValue) || 0;
                    bValue = parseInt(bValue) || 0;
                }

                if (aValue < bValue) return direction === 'asc' ? -1 : 1;
                if (aValue > bValue) return direction === 'asc' ? 1 : -1;
                return 0;
            });

            // Limpiar el tbody y agregar las filas ordenadas
            rows.forEach(row => tableBody.appendChild(row));

            // Actualizar indicadores visuales
            document.querySelectorAll('.sort-indicator').forEach(ind => ind.className = 'sort-indicator neutral');
            document.querySelectorAll('.sortable-header').forEach(h => h.classList.remove('sorting'));
            const indicator = document.getElementById('sort-' + column);
            const header = document.querySelector('[data-sort="' + column + '"]');
            if (indicator) indicator.className = 'sort-indicator ' + direction;
            if (header) header.classList.add('sorting');
        }

        // ====================================================
        // Funciones de persistencia de filtros
        // ====================================================

        function saveFiltersToURL() {
            const params = new URLSearchParams();

            // Guardar búsqueda
            if (currentSearch.trim()) {
                params.set('search', currentSearch);
            }

            // Guardar filtros activos
            Object.keys(activeFilters).forEach(filterType => {
                if (activeFilters[filterType].length > 0) {
                    params.set(filterType, activeFilters[filterType].join(','));
                }
            });

            // Guardar vista actual
            params.set('view', currentView);

            // Guardar página actual
            if (currentPage > 1) {
                params.set('page', currentPage);
            }

            // Actualizar URL sin recargar la página
            const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState({}, '', newUrl);
        }

        function loadFiltersFromURL() {
            const urlParams = new URLSearchParams(window.location.search);

            // Cargar búsqueda
            currentSearch = urlParams.get('search') || '';

            // Cargar filtros
            Object.keys(activeFilters).forEach(filterType => {
                const paramValue = urlParams.get(filterType);
                if (paramValue) {
                    activeFilters[filterType] = paramValue.split(',').filter(v => v.trim());
                }
            });

            // Cargar vista
            currentView = urlParams.get('view') || 'table';

            // Cargar página
            currentPage = parseInt(urlParams.get('page')) || 1;
        }

        function applyFiltersFromURL() {
            // Aplicar búsqueda
            const searchInput = document.getElementById('patSearchInput');
            if (searchInput && currentSearch) {
                searchInput.value = currentSearch;
                const clearBtn = document.getElementById('clearSearchBtn');
                if (clearBtn) {
                    clearBtn.style.display = 'block';
                }
            }

            // Aplicar filtros a checkboxes
            Object.keys(activeFilters).forEach(filterType => {
                const values = activeFilters[filterType];

                // Primero desmarcar todos los checkboxes de este filtro
                const allCheckboxes = document.querySelectorAll(`input[type="checkbox"][id^="${filterType}_"]:not([data-action="select-all"])`);
                allCheckboxes.forEach(cb => cb.checked = false);

                // Marcar los checkboxes correspondientes a los valores activos
                values.forEach(value => {
                    const checkbox = document.querySelector(`input[type="checkbox"][value="${value}"]`);
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                });

                // Determinar si marcar "Todos"
                const selectAllCheckbox = document.querySelector(`[data-filter="${filterType}"][data-action="select-all"]`);
                if (selectAllCheckbox) {
                    if (filterType === 'estado') {
                        // Para estado, "Todos" está marcado si están los 3 valores
                        selectAllCheckbox.checked = values.length === 5 &&
                            values.includes('Aprobado') &&
                            values.includes('En progreso') &&
                            values.includes('En revisión') &&
                            values.includes('Rechazado') &&
                            values.includes('Inactivo');
                    } else {
                        // Para otros filtros, "Todos" está marcado si no hay valores específicos
                        selectAllCheckbox.checked = values.length === 0;
                    }
                }

                // Actualizar botón de filtro
                updateFilterButton(filterType, values, values.length);
            });

            // Aplicar vista
            switchView(currentView);

            // Aplicar filtros y paginación
            filterAndSearchPATs();
        }

        // ====================================================
        // Funciones del selector de vista
        // ====================================================

        function switchView(viewType) {
            console.log('Vista fija en tabla');
            currentView = 'table';

            const tableContainer = document.getElementById('patTableContainer');

            console.log('Elemento encontrado:', {
                tableContainer: !!tableContainer
            });

            if (tableContainer) {
                tableContainer.style.display = 'block';
                console.log('Vista tabla activada');
            }

            // Reaplicar filtros
            setTimeout(() => {
                applyFiltersToCurrentView();
                // Recargar turnos después para asegurar consistencia
                cargarTurnosReales();
                saveFiltersToURL();
            }, 100);
        }

        function applyFiltersToCurrentView() {
            applyFiltersToTable();
        }

        function applyFiltersToTable() {
            const rows = document.querySelectorAll('.pat-row');
            const filtered = [];

            rows.forEach(row => {
                let showRow = true;

                // Aplicar filtro de búsqueda
                if (currentSearch.trim()) {
                    const searchText = currentSearch.toLowerCase();
                    const rowText = (
                        (row.dataset.carrera || '') + ' ' +
                        (row.dataset.tutor || '') + ' ' +
                        (row.dataset.grupo || '') + ' ' +
                        (row.dataset.periodo || '') + ' ' +
                        (row.dataset.ano || '') + ' ' +
                        (row.dataset.estado || '') + ' ' +
                        (row.dataset.turno || '')
                    ).toLowerCase();

                    if (!rowText.includes(searchText)) {
                        showRow = false;
                    }
                }

                // Aplicar filtros de dropdowns
                if (showRow) {
                    // ✅ CORRECCIÓN: Filtro carrera
                    if (activeFilters.carrera.length > 0 && showRow) {
                        const rowCarrera = row.dataset.carrera || '';
                        // Si hay filtros activos de carrera, debe coincidir con alguno
                        if (!activeFilters.carrera.includes(rowCarrera)) {
                            showRow = false;
                        }
                    }

                    // Filtro grado
                    if (activeFilters.grado.length > 0 && showRow) {
                        const gradoMatch = (row.dataset.grado || '').match(/\d+/);
                        const rowGrado = gradoMatch ? gradoMatch[0] : '';
                        if (!activeFilters.grado.includes(rowGrado)) {
                            showRow = false;
                        }
                    }

                    // Filtro grupo
                    if (activeFilters.grupo.length > 0 && showRow) {
                        const rowGrupo = row.dataset.grupo || '';
                        if (!activeFilters.grupo.includes(rowGrupo)) {
                            showRow = false;
                        }
                    }

                    // Filtro período
                    if (activeFilters.periodo.length > 0 && showRow) {
                        const rowPeriodo = row.dataset.periodo || '';
                        if (!activeFilters.periodo.includes(rowPeriodo)) {
                            showRow = false;
                        }
                    }

                    // Filtro año
                    if (activeFilters.ano.length > 0 && showRow) {
                        const rowAno = row.dataset.ano || '';
                        if (!activeFilters.ano.includes(rowAno)) {
                            showRow = false;
                        }
                    }

                    // Filtro estado
                    if (activeFilters.estado.length > 0 && showRow) {
                        const rowEstado = row.dataset.estado || '';
                        if (!activeFilters.estado.includes(rowEstado)) {
                            showRow = false;
                        }
                    }

                    // Filtro turno
                    if (activeFilters.turno.length > 0 && showRow) {
                        const rowTurno = row.dataset.turno || '';
                        if (!activeFilters.turno.includes(rowTurno)) {
                            showRow = false;
                        }
                    }
                }

                if (showRow) {
                    filtered.push(row);
                }
            });

            // Aplicar paginación a tabla
            applyPaginationToTable(filtered);
        }

        function applyPaginationToTable(filteredRows) {
            filteredItems = filteredRows;
            totalItems = filteredRows.length;
            totalPages = Math.ceil(totalItems / itemsPerPage);

            // Ajustar página actual si es necesario
            if (currentPage > totalPages && totalPages > 0) {
                currentPage = totalPages;
            }
            if (currentPage < 1) {
                currentPage = 1;
            }

            // Ocultar todas las filas primero
            const allRows = document.querySelectorAll('.pat-row');
            allRows.forEach(row => {
                row.style.display = 'none';
                row.classList.add('hidden');
            });

            // Mostrar solo las filas de la página actual
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const rowsToShow = filteredRows.slice(startIndex, endIndex);

            rowsToShow.forEach(row => {
                row.style.display = 'table-row';
                row.classList.remove('hidden');
            });

            // Actualizar controles de paginación
            updatePaginationControls();
            updateResultsDisplay();
        }

        // ====================================================
        // FUNCIONES PARA OPCIÓN "TODOS"
        // ====================================================

        function handleSelectAllChange(checkbox) {
            const filterType = checkbox.dataset.filter;
            const dropdownId = 'dropdown' + filterType.charAt(0).toUpperCase() + filterType.slice(1);
            const dropdown = document.getElementById(dropdownId);
            const otherCheckboxes = dropdown.querySelectorAll('input[type="checkbox"]:not([data-action="select-all"])');

            if (checkbox.checked) {
                // Si "Todos" se marca, desmarcar todos los demás
                otherCheckboxes.forEach(cb => {
                    cb.checked = false;
                    // Remover del filtro activo
                    const index = activeFilters[filterType].indexOf(cb.value);
                    if (index > -1) {
                        activeFilters[filterType].splice(index, 1);
                    }
                });

                // Si es "Ninguna carrera", el filtro debe ocultar todas las carreras
                // pero para los demás filtros, limpiar el filtro (mostrar todos)
                activeFilters[filterType] = [];
                updateFilterButton(filterType, [], 0);
            } else {
                // Si "Todos" se desmarca, no hacer nada especial
                // El usuario puede seleccionar elementos individuales
            }

            filterAndSearchPATs();
        }


        function handleIndividualFilterChange(checkbox) {
            const filterType = getFilterTypeFromCheckbox(checkbox.id);
            const value = checkbox.value;
            const selectAllCheckbox = document.querySelector(`[data-filter="${filterType}"][data-action="select-all"]`);

            if (checkbox.checked) {
                // Desmarcar "Todos" si se selecciona un elemento individual
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }

                // Para el caso de carrera, deseleccionar todas las demás carreras
                if (filterType === 'carrera') {
                    const carreraCheckboxes = document.querySelectorAll(`input[type="checkbox"][id^="carrera_"]:not([data-action="select-all"])`);
                    carreraCheckboxes.forEach(cb => {
                        if (cb !== checkbox) {
                            cb.checked = false;
                            const cbValue = cb.value;
                            const cbIndex = activeFilters[filterType].indexOf(cbValue);
                            if (cbIndex > -1) {
                                activeFilters[filterType].splice(cbIndex, 1);
                            }
                        }
                    });
                }

                // Agregar al filtro activo
                if (!activeFilters[filterType].includes(value)) {
                    activeFilters[filterType].push(value);
                }
            } else {
                // Remover del filtro activo
                const index = activeFilters[filterType].indexOf(value);
                if (index > -1) {
                    activeFilters[filterType].splice(index, 1);
                }

                // Si no hay filtros individuales, marcar "Todos"
                if (activeFilters[filterType].length === 0 && selectAllCheckbox) {
                    selectAllCheckbox.checked = true;

                    // Para el caso específico de carrera, siempre asegurar que "Ninguna carrera" esté seleccionado
                    // cuando no hay otras carreras seleccionadas
                    if (filterType === 'carrera') {
                        document.getElementById('carrera_todos').checked = true;
                    }
                }
            }

            updateFilterButton(filterType, activeFilters[filterType], activeFilters[filterType].length);
            filterAndSearchPATs();
        }

        // ====================================================
        // FUNCIONES PRINCIPALES (MODIFICADAS)
        // ====================================================

        function filterAndSearchPATs(preserveSort = false) {
            // Resetear a primera página cuando se cambian filtros
            currentPage = 1;

            // Resetear ordenamiento cuando se aplican filtros (a menos que se preserve explícitamente)
            if (!preserveSort) {
                resetSorting();
            }

            // Aplicar filtros según la vista actual
            applyFiltersToCurrentView();

            // Actualizar display de filtros activos
            updateActiveFiltersDisplay();

            // Guardar filtros en URL
            saveFiltersToURL();



            console.log(`Paginación: Página ${currentPage}/${totalPages}, Total filtrado: ${totalItems}, Por página: ${itemsPerPage}`);
        }

        // Función para resetear el ordenamiento
        function resetSorting() {
            currentSort = {
                column: null,
                direction: 'neutral'
            };

            // Resetear indicadores de tabla y headers
            const allIndicators = document.querySelectorAll('.sort-indicator');
            const allHeaders = document.querySelectorAll('.sortable-header');
            allIndicators.forEach(ind => {
                ind.className = 'sort-indicator neutral';
            });
            allHeaders.forEach(h => {
                h.classList.remove('sorting');
            });

            // Resetear botones de cards
            const allButtons = document.querySelectorAll('.sort-btn');
            allButtons.forEach(btn => {
                btn.classList.remove('active');
                btn.querySelector('.sort-icon').textContent = '⇅';
            });
        }

        function updateResultsDisplay() {
            // Mostrar mensaje de sin resultados si es necesario
            const emptyState = document.getElementById('patNoResults');
            if (emptyState) {
                if (filteredItems.length === 0) {
                    emptyState.style.display = 'block';
                } else {
                    emptyState.style.display = 'none';
                }
            }

            // Destacar texto de búsqueda solo en elementos visibles
            if (currentSearch.trim() && currentSearch.length >= 2) {
                highlightSearchText();
            } else {
                removeHighlight();
            }
        }

        // ====================================================
        // FUNCIONES AUXILIARES (SIN CAMBIOS MAYORES)
        // ====================================================

        function updatePaginationControls() {
            const simplePagination = document.getElementById('simplePagination');
            const paginationInfo = document.getElementById('paginationInfo');
            const currentPageNum = document.getElementById('currentPageNum');
            const totalPagesNum = document.getElementById('totalPagesNum');
            const prevBtn = document.getElementById('prevPageBtn');
            const nextBtn = document.getElementById('nextPageBtn');

            if (!simplePagination) return;

            // Mostrar paginación solo si hay más de 30 elementos
            if (totalItems > itemsPerPage) {
                simplePagination.style.display = 'block';
            } else {
                simplePagination.style.display = 'none';
                return;
            }

            // Actualizar información
            const startItem = totalItems === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
            const endItem = Math.min(currentPage * itemsPerPage, totalItems);

            if (paginationInfo) {
                paginationInfo.textContent = `Mostrando ${startItem}-${endItem} de ${totalItems} elementos`;
            }

            if (currentPageNum) {
                currentPageNum.textContent = currentPage;
            }

            if (totalPagesNum) {
                totalPagesNum.textContent = totalPages;
            }

            // Actualizar estado de botones
            if (prevBtn) {
                prevBtn.disabled = currentPage === 1;
            }

            if (nextBtn) {
                nextBtn.disabled = currentPage === totalPages || totalPages === 0;
            }
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            applyFiltersToCurrentView();
            saveFiltersToURL();
            // scrollToTop();
        }

        function scrollToTop() {
            const container = document.getElementById('patTableContainer');
            if (container) {
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // ====================================================
        // FUNCIONES DEL MODAL (SIN CAMBIOS)
        // ====================================================

        function openDeleteModal(id, carrera, tutor, periodo, grupo, fecha, year, estado) {
            document.getElementById('deleteForm').action = '@Url.Action("EliminarPAT")/' + id;
            document.getElementById('deleteCarrera').textContent = carrera;
