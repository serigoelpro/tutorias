        function formatearFecha(fechaString) {
            if (!fechaString) return 'Fecha no disponible';

            try {
                // Intentar parsear la fecha de diferentes formatos
                var fecha = new Date(fechaString);

                // Verificar si la fecha es válida
                if (isNaN(fecha.getTime())) {
                    // Intentar con formato específico si el parsing automático falló
                    if (fechaString.includes('T')) {
                        // Formato ISO
                        fecha = new Date(fechaString);
                    } else {
                        // Otros formatos
                        fecha = new Date(Date.parse(fechaString));
                    }
                }

                // Verificar nuevamente si la fecha es válida
                if (isNaN(fecha.getTime())) {
                    console.error('Fecha inválida:', fechaString);
                    return 'Fecha inválida';
                }

                var opciones = {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    timeZone: 'America/Mexico_City'
                };
                return fecha.toLocaleDateString('es-ES', opciones);
            } catch (e) {
                console.error('Error al formatear fecha:', e, fechaString);
                return 'Error en fecha';
            }
        }

        // ====================================================
        // EXPORTACIÓN DE REPORTES CON FILTROS ACTIVOS
        // ====================================================

        // Mapa Nombre → IdCarrera inyectado desde el servidor (sólo disponible si la vista
        // viene del action PAT()). Si no hay mapa, el filtro de carrera no se envía como Id.
        window.CarrerasMap = @Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.CarrerasMap ?? new System.Collections.Generic.Dictionary<string, int>()));

        // Mapa nombre del período → IdPeriodo. Coincide con la convención del modelo.
        var PERIODO_NOMBRE_A_ID = {
            "ENERO - ABRIL": 1,
            "MAYO - AGOSTO": 2,
            "SEPTIEMBRE - DICIEMBRE": 3
        };

        // Init del modal "Generar reportes": prellena Año y Cuatris en base al estado actual
        // del listado. Al cerrar el modal no persistimos selección (siempre se reinicia al
        // cuatri actual + año actual por petición del usuario).
        function inicializarScopeReportes() {
            var anioActualReal = new Date().getFullYear();
            var mesActualReal = new Date().getMonth() + 1;
            var periodoActualReal = (mesActualReal <= 4) ? 1 : (mesActualReal <= 8) ? 2 : 3;

            // 1) Construir lista de años candidatos:
            //    - Los seleccionados en filtros si hay al menos uno marcado distinto de "todos"
            //    - Si no, todos los años que existan en el listado renderizado
            var aniosSeleccionados = (activeFilters && Array.isArray(activeFilters.ano)) ? activeFilters.ano.slice() : [];
            var aniosCandidatos;
            if (aniosSeleccionados.length > 0) {
                aniosCandidatos = aniosSeleccionados.map(function (a) { return parseInt(a, 10); }).filter(function (a) { return !isNaN(a); });
            } else {
                var setAnios = new Set();
                $('.pat-row').each(function () {
                    var a = parseInt($(this).data('ano'), 10);
                    if (!isNaN(a)) setAnios.add(a);
                });
                aniosCandidatos = Array.from(setAnios).sort(function (a, b) { return b - a; });
                if (aniosCandidatos.length === 0) aniosCandidatos = [anioActualReal];
            }

            // 2) Poblar el dropdown de Año
            var $sel = $('#reporte-anio');
            $sel.empty();
            aniosCandidatos.forEach(function (a) {
                $sel.append('<option value="' + a + '">' + a + '</option>');
            });

            // 3) Si hay exactamente 1 año marcado, preseleccionar y deshabilitar el select.
            //    Si hay 0 o >1, dejar habilitado, default = año actual si está disponible, si no
            //    el más reciente de la lista.
            if (aniosSeleccionados.length === 1) {
                $sel.val(aniosSeleccionados[0]);
                $sel.prop('disabled', true);
                $('#reporte-anio-hint').text('(tomado del filtro activo)');
            } else {
                $sel.prop('disabled', false);
                var defaultAnio = aniosCandidatos.indexOf(anioActualReal) >= 0 ? anioActualReal : aniosCandidatos[0];
                $sel.val(defaultAnio);
                if (aniosSeleccionados.length === 0) {
                    $('#reporte-anio-hint').text('Filtro de año vacío. Selecciona un año.');
                } else {
                    $('#reporte-anio-hint').text('Tienes ' + aniosSeleccionados.length + ' años marcados en el filtro. Elige el año a exportar.');
                }
            }

            // 4) Default de cuatris: SIEMPRE prellenar con el cuatri actual (no recordar
            //    selección previa). Si el usuario quiere otro cuatri, lo marca antes de descargar.
            $('.reporte-cuatri').prop('checked', false);
            $('.reporte-cuatri[value="' + periodoActualReal + '"]').prop('checked', true);
        }

        // Construye el query string desde el modal + filtros activos del listado.
        // Aplica regla: si NO hay cuatris marcados pero hay 1 año marcado, se envían los 3 cuatris.
        function construirQueryReportes() {
            var anio = parseInt($('#reporte-anio').val(), 10);
            if (isNaN(anio)) return null;

            var cuatris = $('.reporte-cuatri:checked').map(function () { return parseInt(this.value, 10); }).get();
            if (cuatris.length === 0) cuatris = [1, 2, 3];

            var params = { anio: anio, periodos: cuatris.join(',') };

            if (activeFilters) {
                // Carrera: tomar la primera marcada (el filtro permite sólo una) y mapear a Id.
                if (Array.isArray(activeFilters.carrera) && activeFilters.carrera.length > 0) {
                    var carreraNombre = activeFilters.carrera[0];
                    if (window.CarrerasMap && window.CarrerasMap.hasOwnProperty(carreraNombre)) {
                        params.carrera = window.CarrerasMap[carreraNombre];
                    }
                }
                // Estado
                if (Array.isArray(activeFilters.estado) && activeFilters.estado.length > 0) {
                    params.estados = activeFilters.estado.join(',');
                }
                // Grado: viene como número en data-grado-match; IdGrado del servidor coincide con el número.
                if (Array.isArray(activeFilters.grado) && activeFilters.grado.length > 0) {
                    params.grados = activeFilters.grado.join(',');
                }
                // Grupo (nomenclatura "TI6C")
                if (Array.isArray(activeFilters.grupo) && activeFilters.grupo.length > 0) {
                    params.grupos = activeFilters.grupo.join(',');
                }
                // Turno
                if (Array.isArray(activeFilters.turno) && activeFilters.turno.length > 0) {
                    params.turnos = activeFilters.turno.join(',');
                }
            }
            if (typeof currentSearch === 'string' && currentSearch.trim().length > 0) {
                params.search = currentSearch.trim();
            }
            return params;
        }

