    var alertHtml = '<div class="alert-message" style="position: fixed; top: 20px; right: 20px; z-index: 9999; padding: 16px 20px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); max-width: 400px; backdrop-filter: blur(10px);">';
    alertHtml += '<div style="display: flex; align-items: center; gap: 12px;">';
    alertHtml += '<i class="glyphicon ' + iconClass + '" style="font-size: 18px;"></i>';
    alertHtml += '<span style="font-weight: 500;">' + mensaje + '</span>';
    alertHtml += '</div>';
    alertHtml += '</div>';
    if (tipo === 'success') {
        $(alertHtml).css({
            'background': 'linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%)',
            'color': '#155724',
            'border': '1px solid #28a745'
        }).appendTo('body');
