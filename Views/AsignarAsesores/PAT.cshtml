function ordenarPATsVistaPrincipal(direccion) {
    console.log('Ordenando PATs:', direccion);
    ordenActual = direccion;

    // Actualizar estilos de botones
    $('#btnOrdenarAZ').removeClass('active btn-primary').addClass('btn-default');
    $('#btnOrdenarZA').removeClass('active btn-primary').addClass('btn-default');

    if (direccion === 'asc') {
        $('#btnOrdenarAZ').removeClass('btn-default').addClass('btn-primary active');
    } else if (direccion === 'desc') {
        $('#btnOrdenarZA').removeClass('btn-default').addClass('btn-primary active');
    }

    // Obtener todas las filas visibles
    const tbody = document.querySelector('#patTableBody');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('.pat-row'));

    // Ordenar las filas por el nombre del tutor
    rows.sort((a, b) => {
        const tutorA = (a.dataset.tutor || '').toLowerCase();
        const tutorB = (b.dataset.tutor || '').toLowerCase();

        if (direccion === 'asc') {
            return tutorA.localeCompare(tutorB, 'es');
        } else {
            return tutorB.localeCompare(tutorA, 'es');
        }
    });

    rows.forEach(row => tbody.appendChild(row));

    filterAndSearchPATs();
}


let ordenModalActual = null;

function ordenarPATsModal(direccion) {
    console.log('Ordenando PATs del modal:', direccion);
    ordenModalActual = direccion;

    // Actualizar estilos de botones
    $('#btnOrdenarModalAZ').removeClass('active btn-primary').addClass('btn-default');
    $('#btnOrdenarModalZA').removeClass('active btn-primary').addClass('btn-default');

    if (direccion === 'asc') {
        $('#btnOrdenarModalAZ').removeClass('btn-default').addClass('btn-primary active');
    } else if (direccion === 'desc') {
        $('#btnOrdenarModalZA').removeClass('btn-default').addClass('btn-primary active');
    }

    // Obtener las filas actuales de la tabla
    const tbody = $('#revision-pats-tbody');
    const rows = Array.from(tbody.find('tr').get());

    // Si no hay filas para ordenar, salir
    if (rows.length === 0) return;

    // Ordenar las filas por el nombre del tutor
    rows.sort((a, b) => {
        const tutorA = ($(a).find('.tutor-cell').text() || '').toLowerCase().trim();
        const tutorB = ($(b).find('.tutor-cell').text() || '').toLowerCase().trim();

        if (direccion === 'asc') {
            return tutorA.localeCompare(tutorB, 'es');
        } else {
            return tutorB.localeCompare(tutorA, 'es');
        }
    });

    // Limpiar el tbody y agregar las filas ordenadas
    tbody.empty();
    rows.forEach(row => tbody.append(row));
}

function cargarPATsPendientesRevision() {
    console.log('=== INICIO cargarPATsPendientesRevision ===');

    $('#revision-pats-loading').show();
    $('#revision-pats-content').hide();
    $('#revision-pats-tbody').empty();

    $.ajax({
        url: '@Url.Action("ObtenerPATsPendientesRevision", "PATs")',
        type: 'GET',
        dataType: 'json',
        success: function(response) {
            console.log('Respuesta recibida:', response);
            $('#revision-pats-loading').hide();

            // Manejar errores en la respuesta
            if (response.error) {
                console.error('Error en respuesta:', response.error);
                $('#revision-pats-tbody').html(
                    '<tr><td colspan="4" class="text-center">' +
                    '<div class="alert alert-danger">' +
                    '<i class="glyphicon glyphicon-exclamation-sign"></i> ' +
                    response.error +
                    '</div>' +
                    '</td></tr>'
                );
                $('#revision-pats-content').show();
                return;
            }

            // La respuesta es un array directo de PATs
            var pats = Array.isArray(response) ? response : [];
            console.log('PATs pendientes encontrados:', pats.length);

            if (pats.length === 0) {
                $('#revision-pats-tbody').html(
                    '<tr><td colspan="4" class="text-center" style="padding: 40px;">' +
                    '<i class="glyphicon glyphicon-ok-circle" style="font-size: 48px; color: #4caf50; margin-bottom: 16px; display: block;"></i>' +
                    '<h4 style="color: #4caf50; margin-bottom: 8px;">¡Excelente!</h4>' +
                    '<p style="color: #666;">No hay PATs pendientes de revisión en este momento.</p>' +
                    '</td></tr>'
                );
            } else {
                var html = '';
                pats.forEach(function(pat) {
                    var patId = pat.Id || pat.id || 0;
                    var grupo = pat.Grupo || 'Sin grupo';
                    var carrera = pat.Carrera || 'Sin carrera';
                    var tutor = pat.Tutor || 'Sin tutor';

                    html += '<tr data-pat-id="' + patId + '">';
                    html += '<td class="grupo-cell">' + grupo + '</td>';
                    html += '<td class="carrera-cell">' + carrera + '</td>';
                    html += '<td class="tutor-cell">' + tutor + '</td>';
                    html += '<td class="actions-cell">';
                    html += '<div class="btn-group btn-group-sm" role="group">';

                    // Botón Ver
                    html += '<button type="button" class="btn btn-info btn-action" onclick="verPATRevision(' + patId + ')" title="Ver PAT">';
                    html += '<span class="glyphicon glyphicon-eye-open"></span> Ver';
                    html += '</button>';

                    @if (!esDirector) { <text>
                    // Botón Aprobar
                    html += '<button type="button" class="btn btn-info btn-action" onclick="aprobarPATRevision(' + patId + ')" title="Aprobar PAT">';
                    html += '<span class="glyphicon glyphicon-ok"></span> Aprobar';
                    html += '</button>';

                    // Botón Rechazar
                    html += '<button type="button" class="btn btn-danger btn-action" onclick="rechazarPATRevision(' + patId + ')" title="Rechazar PAT">';
                    html += '<span class="glyphicon glyphicon-remove"></span> Rechazar';
                    html += '</button>';

                    // Botón Comentar
                    html += '<button type="button" class="btn btn-warning btn-action" onclick="abrirModalComentarioPAT(' + patId + ', \'' + grupo.replace(/'/g, "\\'") + '\')" title="Agregar comentario">';
                    html += '<span class="glyphicon glyphicon-comment"></span> Comentar';
                    html += '</button>';
                    </text> }

                    // Botón Ver Comentarios
                    html += '<button type="button" class="btn btn-info btn-action" onclick="verComentariosAnteriores(' + patId + ', \'' + grupo.replace(/'/g, "\\'") + '\')" title="Ver comentarios anteriores">';
                    html += '<span class="glyphicon glyphicon-list-alt"></span> Comentarios';
                    html += '</button>';

                    html += '</div>';
                    html += '</td>';
                    html += '</tr>';
                });
                $('#revision-pats-tbody').html(html);
            }

            $('#revision-pats-content').show();
            console.log('=== FIN cargarPATsPendientesRevision (éxito) ===');
        },
        error: function(xhr, status, error) {
            console.error('=== ERROR en cargarPATsPendientesRevision ===');
            console.error('Status:', status);
            console.error('Error:', error);
            console.error('Response:', xhr.responseText);

            $('#revision-pats-loading').hide();
            $('#revision-pats-tbody').html(
                '<tr><td colspan="4" class="text-center">' +
                '<div class="alert alert-danger">' +
                '<i class="glyphicon glyphicon-exclamation-sign"></i> ' +
                'Error al cargar PATs pendientes. Por favor, inténtelo de nuevo.' +
                '</div>' +
                '</td></tr>'
            );
            $('#revision-pats-content').show();
        }
    });
}

function verPATRevision(patId) {
    console.log('Abriendo PAT:', patId);
    var url = '@Url.Action("PatDetalles", "AsignarAsesores")/' + patId;
    window.open(url, '_blank');
}

function aprobarPATRevision(patId) {
    if (!confirm('¿Está seguro que desea aprobar este PAT?')) return;

    var btn = $('tr[data-pat-id="' + patId + '"] .btn-success'); // Ajustar selector si es necesario
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<i class="glyphicon glyphicon-refresh glyphicon-spin"></i> ...');

    $.ajax({
        url: '@Url.Action("AprobarPAT", "PATs")',
        type: 'POST',
        data: {
            id: patId,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
            if (response && response.success) {
                mostrarMensaje('PAT aprobado correctamente', 'success');

                // CORRECCIÓN PUNTO 3:
                // 1. Eliminar la fila visualmente al instante
                $('tr[data-pat-id="' + patId + '"]').fadeOut(300, function() {
                    $(this).remove();
                    // Verificar si quedan filas
                    if($('#revision-pats-tbody tr').length === 0) {
                        cargarPATsPendientesRevision(); // Recargar para mostrar mensaje "Excelente"
                    }
                });

                // 2. Actualizar tabla principal de fondo sin recargar página
                // Cambiamos el estado en la fila de la tabla principal si existe
                var filaPrincipal = $('.pat-row[data-pat-id="' + patId + '"]');
                if(filaPrincipal.length) {
                    filaPrincipal.data('estado', 'Aprobado');
                    filaPrincipal.find('.status-badge')
                        .removeClass('status-review status-pending status-inactive')
                        .addClass('status-active')
                        .text('Aprobado');
                }

                // Opcional: Recargar filtro principal
                // filterAndSearchPATs(true);

            } else {
                mostrarMensaje(response.message || 'Error al aprobar', 'error');
                btn.prop('disabled', false).html(originalHtml);
            }
        },
        error: function() {
            btn.prop('disabled', false).html(originalHtml);
            mostrarMensaje('Error de conexión', 'error');
        }
    });
}

// Hacer lo mismo para rechazarPATRevision
function rechazarPATRevision(patId) {
    if (!confirm('¿Rechazar PAT? El tutor deberá corregirlo.')) return;

    var btn = $('tr[data-pat-id="' + patId + '"] .btn-danger');
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<i class="glyphicon glyphicon-refresh glyphicon-spin"></i> ...');

    $.ajax({
        url: '@Url.Action("RechazarPAT", "PATs")',
        type: 'POST',
        data: {
            id: patId,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(response) {
            if (response && response.success) {
                mostrarMensaje('PAT rechazado', 'success');

                // 1. Eliminar fila visualmente
                $('tr[data-pat-id="' + patId + '"]').fadeOut(300, function() {
                    $(this).remove();
                    if($('#revision-pats-tbody tr').length === 0) {
                        cargarPATsPendientesRevision();
                    }
                });

                // 2. Actualizar tabla principal
                var filaPrincipal = $('.pat-row[data-pat-id="' + patId + '"]');
                if(filaPrincipal.length) {
                    filaPrincipal.data('estado', 'Rechazado');
                    filaPrincipal.find('.status-badge')
                        .removeClass('status-review status-active status-pending')
                        .addClass('status-inactive') // O el color que uses para rechazado
                        .text('Rechazado');
                }
            } else {
                mostrarMensaje(response.message || 'Error al rechazar', 'error');
                btn.prop('disabled', false).html(originalHtml);
            }
        },
        error: function() {
            btn.prop('disabled', false).html(originalHtml);
            mostrarMensaje('Error de conexión', 'error');
        }
    });
}

