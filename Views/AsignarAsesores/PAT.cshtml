        // Función de detección inteligente de turnos (backup)
        function detectarTurnosInteligente() {
            const elements = document.querySelectorAll('.pat-card, .pat-row');
            let detectados = 0;

            elements.forEach(function(element) {
                const grupo = element.dataset.grupo || '';
                let turnoDetectado = 'Sin turno';

                // Lógica inteligente para detectar turno
                if (grupo) {
                    const grupoUpper = grupo.toUpperCase();

                    // Patrones para Matutino
                    if (grupoUpper.startsWith('M') ||
                        grupoUpper.includes('MAT') ||
                        grupoUpper.includes('MAÑANA')) {
                        turnoDetectado = 'Matutino';
                        detectados++;
                    }
                    // Patrones para Vespertino
                    else if (grupoUpper.startsWith('I') ||
                             grupoUpper.includes('VESP') ||
                             grupoUpper.includes('TARDE')) {
                        turnoDetectado = 'Vespertino';
                        detectados++;
                    }
                    // Patrones para Despresurizado
                    else if (grupoUpper.startsWith('D') ||
                             grupoUpper.includes('DESP') ||
                             grupoUpper.includes('NOCHE') ||
                             grupoUpper.includes('NOCT')) {
                        turnoDetectado = 'Despresurizado';
                        detectados++;
                    }
                    // Intentar detectar por patrones numéricos
                    else if (/^[A-Z]*[1-9]/.test(grupoUpper)) {
                        // Si es un patrón típico como "ABC123", asumir Matutino por defecto
                        turnoDetectado = 'Matutino';
                        detectados++;
                    }
                }

                // Actualizar elemento
                if (element.classList.contains('pat-card')) {
                    const turnoElement = element.querySelector('.turno-name');
                    if (turnoElement) {
                        turnoElement.textContent = turnoDetectado;
                    }
                } else if (element.classList.contains('pat-row') && element.cells && element.cells[1]) {
                    element.cells[1].textContent = turnoDetectado;
                }

                element.dataset.turno = turnoDetectado;
            });

            if (detectados > 0) {
                console.log(`Detección inteligente completada: ${detectados} turnos detectados`);
            }
        }

