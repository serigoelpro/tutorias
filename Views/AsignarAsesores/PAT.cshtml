        // ====================================================
        // FUNCIONES DEL MODAL CREAR PATs
        // ====================================================

        function openCrearPATsModal() {
            document.getElementById('crearPATsModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            cargarTutoresSinPAT();
        }

        function closeCrearPATsModal() {
            document.getElementById('crearPATsModal').style.display = 'none';
            document.body.style.overflow = 'auto';
            // Limpiar contenido
            document.getElementById('loading-tutores').style.display = 'block';
            document.getElementById('tutores-container').style.display = 'none';
            document.getElementById('modal-footer-tutores').style.display = 'none';
            // Resetear filtro de carrera
            $('#filtro-carrera-crear').val('').empty().append('<option value="">Todas las carreras</option>');
            // Limpiar datos globales
            window._tutoresSinPAT = null;
        }

        function cargarTutoresSinPAT() {
            // Mostrar loading
            document.getElementById('loading-tutores').style.display = 'block';
            document.getElementById('tutores-container').style.display = 'none';

            $.get('@Url.Action("ObtenerTutoresSinPAT", "AsignarAsesores")', function(response) {
                document.getElementById('loading-tutores').style.display = 'none';
                document.getElementById('tutores-container').style.display = 'block';

                if (response.success) {
                    // Mostrar información del período
                    document.getElementById('info-periodo-texto').textContent =
                        `Creando PATs para el período: ${response.periodoActual} ${response.añoActual}`;

                    if (response.tutores && response.tutores.length > 0) {
                        // Guardar tutores globalmente para filtrado
                        window._tutoresSinPAT = response.tutores;

                        // Poblar filtro de carreras
                        poblarFiltroCarrerasCrear(response.tutores);

                        // Mostrar lista de tutores
                        mostrarListaTutoresFiltrados();
                        document.getElementById('modal-footer-tutores').style.display = 'block';
                    } else {
                        // No hay tutores sin PAT
                        document.getElementById('sin-tutores').style.display = 'block';
                        document.getElementById('lista-tutores').style.display = 'none';
                    }
                } else {
                    alert('Error al cargar tutores: ' + (response.message || 'Error desconocido'));
                    closeCrearPATsModal();
                }
            }).fail(function() {
                alert('Error de conexión al cargar tutores');
                closeCrearPATsModal();
            });
        }

        // Poblar filtro de carreras para crear PATs
        function poblarFiltroCarrerasCrear(tutores) {
            var carreras = [];
            tutores.forEach(function(tutor) {
                if (Array.isArray(tutor.Grupos)) {
                    tutor.Grupos.forEach(function(grupo) {
                        var nombreCarrera = grupo.NombreCarrera || (grupo.Carrera && grupo.Carrera.Nombre) || grupo.Carrera;
                        if (nombreCarrera && carreras.indexOf(nombreCarrera) === -1) {
                            carreras.push(nombreCarrera);
                        }
                    });
                }
            });

            var select = $('#filtro-carrera-crear');
            select.empty();
            select.append('<option value="">Todas las carreras</option>');
            carreras.sort().forEach(function(carrera) {
                select.append('<option value="' + carrera + '">' + carrera + '</option>');
            });

            // Evento de filtro
            select.off('change').on('change', function() {
                mostrarListaTutoresFiltrados();
            });
        }

        // Mostrar lista de tutores filtrada por carrera
        function mostrarListaTutoresFiltrados() {
            var tutores = window._tutoresSinPAT || [];
            var filtroCarrera = $('#filtro-carrera-crear').val() || '';

            var tutoresFiltrados = tutores;
            if (filtroCarrera) {
                tutoresFiltrados = tutores.filter(function(tutor) {
                    return tutor.Grupos.some(function(grupo) {
                        return grupo.NombreCarrera === filtroCarrera;
                    });
                });
            }

            mostrarListaTutores(tutoresFiltrados);
        }

        function mostrarListaTutores(tutores) {
            const tutoresList = document.getElementById('tutores-list');
            const filtroCarrera = $('#filtro-carrera-crear').val() || '';
            let html = '';

            tutores.forEach(function(tutor, index) {
                // Filtrar grupos según carrera seleccionada
                let gruposMostrar = tutor.Grupos;
                if (filtroCarrera) {
                    gruposMostrar = tutor.Grupos.filter(g => g.NombreCarrera === filtroCarrera);
                }

                const grupos = gruposMostrar.map(g => `${g.NombreGrupo} (${g.NombreCarrera})`).join(', ');

                html += `
                    <div class="tutor-item" style="padding: 12px; border-bottom: 1px solid #eee; ${index % 2 === 0 ? 'background: #f9f9f9;' : ''}">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <input type="checkbox" class="tutor-checkbox" value="${tutor.IdTutor}" id="tutor_${tutor.IdTutor}" style="margin: 0;">
                            <label for="tutor_${tutor.IdTutor}" style="flex: 1; margin: 0; font-weight: normal; cursor: pointer;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <div style="font-weight: 600; color: #333; margin-bottom: 4px;">
                                            <span class="glyphicon glyphicon-user" style="margin-right: 6px; color: #1976d2;"></span>
                                            ${tutor.NombreTutor}
                                        </div>
                                        <div style="font-size: 12px; color: #666; margin-bottom: 4px;">
                                            <span class="glyphicon glyphicon-envelope" style="margin-right: 4px;"></span>
                                            ${tutor.Email}
                                        </div>
                                        <div style="font-size: 12px; color: #888;">
                                            <span class="glyphicon glyphicon-education" style="margin-right: 4px;"></span>
                                            Grupos: ${grupos}
                                        </div>
                                    </div>
                                    <div style="text-align: center; margin-left: 12px;">
                                        <div style="background: #ff6b35; color: white; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px;">
                                            ${filtroCarrera ? gruposMostrar.length : tutor.CantidadGrupos}
                                        </div>
                                        <div style="font-size: 10px; color: #666; margin-top: 2px;">PATs</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                `;
            });

            tutoresList.innerHTML = html;

            // Agregar evento para "Seleccionar todos"
            document.getElementById('selectAllTutores').onchange = function() {
                const checkboxes = document.querySelectorAll('.tutor-checkbox');
                checkboxes.forEach(cb => cb.checked = this.checked);
            };
        }

        function crearPATsSeleccionados() {
            const checkboxes = document.querySelectorAll('.tutor-checkbox:checked');

            if (checkboxes.length === 0) {
                alert('Por favor, seleccione al menos un tutor para crear PATs.');
                return;
            }

            const tutorIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
            const btnCrear = document.getElementById('btnCrearPATs');

            // Deshabilitar botón y mostrar loading
            btnCrear.disabled = true;
            btnCrear.innerHTML = '<span class="glyphicon glyphicon-refresh glyphicon-spin"></span> Creando...';

            // Crear FormData
            const formData = new FormData();
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            tutorIds.forEach(function(id, index) {
                formData.append(`tutorIds[${index}]`, id);
            });

            $.ajax({
                url: '@Url.Action("CrearPATsManuales", "AsignarAsesores")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        alert(`¡Éxito! ${response.message}`);
                        closeCrearPATsModal();
                        // Recargar la página para mostrar los nuevos PATs
                        location.reload();
                    } else {
                        alert('Error: ' + (response.message || 'No se pudieron crear los PATs'));
                    }
                },
                error: function() {
                    alert('Error de conexión al crear PATs');
                },
                complete: function() {
                    // Rehabilitar botón
                    btnCrear.disabled = false;
                    btnCrear.innerHTML = '<span class="glyphicon glyphicon-plus"></span> Crear PATs';
                }
            });
        }

        // ====================================================
        // FUNCIONES DE DROPDOWNS Y FILTROS (MODIFICADAS)
        // ====================================================

        function toggleDropdown(filterId) {
            const dropdown = document.getElementById('dropdown' + filterId);
            const allDropdowns = document.querySelectorAll('.filter-content');

            // Cerrar todos los otros dropdowns
            allDropdowns.forEach(d => {
                if (d !== dropdown) {
                    d.style.display = 'none';
                }
            });

            // Toggle del dropdown actual
            if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                dropdown.style.display = 'block';
            } else {
                dropdown.style.display = 'none';
            }
        }

        function closeAllDropdowns() {
            const allDropdowns = document.querySelectorAll('.filter-content');
            allDropdowns.forEach(d => {
                d.style.display = 'none';
            });
        }

        function updateFilterButton(filterType, selectedValues, count) {
            const button = document.getElementById('btn' + filterType.charAt(0).toUpperCase() + filterType.slice(1));
            const countSpan = document.getElementById('count' + filterType.charAt(0).toUpperCase() + filterType.slice(1));

            if (countSpan) {
                if (count === 0) {
                    // Si es filtro de carrera, mostrar "Ninguna", de lo contrario "Todos"
                    countSpan.textContent = filterType === 'carrera' ? '(Seleccione carrera)' : '(Todos)';
                } else if (count === 1) {
                    countSpan.textContent = `(${selectedValues[0]})`;
                } else {
                    countSpan.textContent = `(${count} seleccionados)`;
                }
            }
        }

        function updateActiveFiltersDisplay() {
            const activeFiltersContainer = document.getElementById('activeFiltersDisplay');
            const activeFiltersList = document.getElementById('activeFiltersList');

            if (!activeFiltersContainer || !activeFiltersList) return;

            // Verificar si hay filtros activos (excluyendo valores vacíos)
            const hasActiveFilters = activeFilters.carrera.length > 0 ||
                activeFilters.grado.length > 0 ||
                activeFilters.grupo.length > 0 ||
                activeFilters.periodo.length > 0 ||
                activeFilters.ano.length > 0 ||
                activeFilters.turno.length > 0 ||
                (activeFilters.estado.length > 0 && activeFilters.estado.length < 5);

            if (!hasActiveFilters) {
                activeFiltersContainer.style.display = 'none';
                return;
            }

            activeFiltersContainer.style.display = 'block';
            activeFiltersList.innerHTML = '';

            const filterNames = {
                'carrera': 'Carrera',
                'grado': 'Grado',
                'grupo': 'Grupo',
                'periodo': 'Período',
                'ano': 'Año',
                'estado': 'Estado',
                'turno': 'Turno'
            };

            Object.keys(activeFilters).forEach(filterType => {
                // Solo mostrar si hay valores específicos y no están todos seleccionados
                if (activeFilters[filterType].length > 0) {
                    if (filterType === 'estado' && activeFilters[filterType].length === 5) {
                        return; // No mostrar si están todos los estados seleccionados
                    }

                    // Filtrar valores vacíos antes de mostrar
                    const validValues = activeFilters[filterType].filter(value => value && value.trim() !== '');

                    if (validValues.length > 0) {
                        const filterDiv = document.createElement('div');
                        filterDiv.className = 'active-filter-item';
                        filterDiv.innerHTML = `
                    <strong>${filterNames[filterType]}:</strong>
                    ${validValues.map(value =>
                            `<span class="filter-value-tag">${value}
                            <button type="button" onclick="removeFilterValue('${filterType}', '${value}')" class="remove-filter-btn">×</button>
                        </span>`
                        ).join(' ')}
                `;
                        activeFiltersList.appendChild(filterDiv);
                    }
                }
            });
        }

        function removeFilterValue(filterType, value) {
            const index = activeFilters[filterType].indexOf(value);
            if (index > -1) {
                activeFilters[filterType].splice(index, 1);
            }

            // Desmarcar checkbox correspondiente por value
            const checkbox = document.querySelector(`input[type="checkbox"][value="${value}"]`);
            if (checkbox) {
                checkbox.checked = false;
            }

            // Si no quedan filtros, marcar "Todos"
            if (activeFilters[filterType].length === 0) {
                const selectAllCheckbox = document.querySelector(`[data-filter="${filterType}"][data-action="select-all"]`);
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = true;
                }
            }

            updateFilterButton(filterType, activeFilters[filterType], activeFilters[filterType].length);
            filterAndSearchPATs();
        }

        function getFilterTypeFromCheckbox(checkboxId) {
            if (checkboxId.startsWith('carrera_')) return 'carrera';
            if (checkboxId.startsWith('estado_')) return 'estado';
            if (checkboxId.startsWith('grado_')) return 'grado';
            if (checkboxId.startsWith('grupo_')) return 'grupo';
            if (checkboxId.startsWith('periodo_')) return 'periodo';
            if (checkboxId.startsWith('ano_')) return 'ano';
            if (checkboxId.startsWith('turno_')) return 'turno';
            return null;
        }



        // ====================================================
        // FUNCIONES DE POBLACIÓN DE DROPDOWNS (MODIFICADAS)
        // ====================================================

        function getUniqueFilterValues(filter) {
            const elements = document.querySelectorAll('.pat-row');
            const values = new Set();

            elements.forEach(element => {
                const value = element.dataset[filter];
                if (value && value.trim()) {
                    if (filter === 'grado') {
                        const gradoMatch = value.match(/\d+/);
                        if (gradoMatch) {
                            values.add(gradoMatch[0]);
                        }
                    } else {
                        values.add(value.trim());
                    }
                }
            });

            let sortedValues = Array.from(values);

            if (filter === 'grado') {
                sortedValues.sort((a, b) => {
                    const numA = parseInt(a) || 0;
                    const numB = parseInt(b) || 0;
                    return numA - numB;
                });
            } else if (filter === 'ano') {
                sortedValues.sort((a, b) => {
                    const numA = parseInt(a) || 0;
                    const numB = parseInt(b) || 0;
                    return numB - numA;
                });
            } else if (filter === 'grupo') {
                sortedValues.sort((a, b) => {
                    return obtenerClaveOrdenamientoGrupo(a).localeCompare(obtenerClaveOrdenamientoGrupo(b));
                });
            } else {
                sortedValues.sort();
            }

            return sortedValues;
        }

        function obtenerClaveOrdenamientoGrupo(nombreGrupo) {
            if (!nombreGrupo) return "999Z";

            try {
                const match = nombreGrupo.match(/(\d+)([A-Z]+)$/);
                if (match) {
                    const grado = parseInt(match[1]);
                    const letra = match[2];
                    return `${grado.toString().padStart(3, '0')}${letra}`;
                }

                const gradoMatch = nombreGrupo.match(/\d+/);
                const letraMatch = nombreGrupo.match(/[A-Z]+/);
                const gradoFallback = gradoMatch ? parseInt(gradoMatch[0]) : 999;
                const letraFallback = letraMatch ? letraMatch[0] : "Z";
                return `${gradoFallback.toString().padStart(3, '0')}${letraFallback}`;
            } catch {
                return "999Z";
            }
        }

        function populateDropdowns() {
            const filterTypes = [];
            const btnCarrera = document.getElementById('btnCarrera');
            if (btnCarrera) {
                filterTypes.push('carrera');
            }
            filterTypes.push('grado', 'grupo', 'periodo', 'ano');

            filterTypes.forEach(filterType => {
                const dropdown = document.getElementById('dropdown' + filterType.charAt(0).toUpperCase() + filterType.slice(1));
                if (dropdown) {
                    const optionsContainer = dropdown.querySelector('.filter-options');
                    const values = getUniqueFilterValues(filterType);

                    // Buscar el separador y agregar opciones después de él
                    const separator = optionsContainer.querySelector('.filter-separator');
                    if (separator) {
                        // Remover opciones existentes después del separador
                        let nextElement = separator.nextElementSibling;
                        while (nextElement) {
                            const elementToRemove = nextElement;
                            nextElement = nextElement.nextElementSibling;
                            elementToRemove.remove();
                        }

                        // Agregar nuevas opciones
                        values.forEach(value => {
                            const optionDiv = document.createElement('div');
                            optionDiv.className = 'checkbox-option';

                            const checkboxId = `${filterType}_${value.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_]/g, '')}`;
                            optionDiv.innerHTML = `
                        <input type="checkbox" id="${checkboxId}" value="${value}">
                        <label for="${checkboxId}">${value}</label>
                    `;

                            optionsContainer.appendChild(optionDiv);
                        });
                    }
                }
            });
        }

        // ====================================================
        // FUNCIONES DE RESALTADO DE TEXTO (SIN CAMBIOS)
        // ====================================================

        function highlightSearchText() {
            if (!currentSearch.trim() || currentSearch.length < 2) return;

            const elements = document.querySelectorAll('.pat-row:not(.hidden)');

            elements.forEach(element => {
                const textElements = element.querySelectorAll('.tutor-cell, .career-cell, .group-cell, .period-cell');

                textElements.forEach(el => {
                    const originalText = el.getAttribute('data-original-text') || el.textContent;
                    el.setAttribute('data-original-text', originalText);

                    const regex = new RegExp(`(${escapeRegExp(currentSearch)})`, 'gi');
                    if (regex.test(originalText)) {
                        el.innerHTML = originalText.replace(regex, '<mark style="background-color: #fff3cd; padding: 2px 4px; border-radius: 3px; font-weight: bold;">$1</mark>');
                    }
                });
            });
        }

        function removeHighlight() {
            const elements = document.querySelectorAll('.pat-row');

            elements.forEach(element => {
                const textElements = element.querySelectorAll('.tutor-cell, .career-cell, .group-cell, .period-cell');

                textElements.forEach(el => {
                    const originalText = el.getAttribute('data-original-text');
                    if (originalText) {
                        el.textContent = originalText;
                        el.removeAttribute('data-original-text');
                    }
                });
            });
        }

    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

