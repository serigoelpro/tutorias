                else if (primeraLetra === 'D') turnoEsperado = 'Despresurizado';

                resultados.push({
                    elemento: index + 1,
                    grupo: grupo,
                    primeraLetra: primeraLetra,
                    turnoActual: turnoActual,
                    turnoEsperado: turnoEsperado,
                    coincide: turnoActual === turnoEsperado,
                    tipo: element.classList.contains('pat-card') ? 'Card' : 'Row'
                });

                stats[turnoActual] = (stats[turnoActual] || 0) + 1;
            });

            // Mostrar casos problemáticos
            const problemáticos = resultados.filter(r => !r.coincide && r.primeraLetra !== 'N/A');
            if (problemáticos.length > 0) {
                console.log('🔴 CASOS PROBLEMÁTICOS (turno no coincide con primera letra):');
                problemáticos.forEach(p => {
