    // --- 1. NUEVA FUNCIÓN PARA APLICAR FILTROS POR DEFECTO ---
    function applyDefaultFilters() {
        var fechaHoy = new Date();
        var anoActual = fechaHoy.getFullYear().toString();
        var mesActual = fechaHoy.getMonth() + 1;
        var periodoActual = "";

        // Determinar nombre del periodo actual (Igual que en BD)
        if (mesActual >= 1 && mesActual <= 4) periodoActual = "ENERO - ABRIL";
        else if (mesActual >= 5 && mesActual <= 8) periodoActual = "MAYO - AGOSTO";
        else periodoActual = "SEPTIEMBRE - DICIEMBRE";

        // A. Resetear visualmente todos los checkboxes primero
        $('input[type="checkbox"]').prop('checked', false);

        // B. Marcar Año Actual
        var checkAno = $('input[type="checkbox"][value="' + anoActual + '"]');
        if (checkAno.length) checkAno.prop('checked', true);

        // C. Marcar Periodo Actual
        $('input[type="checkbox"][id^="periodo_"]').each(function () {
            if ($(this).val().toUpperCase() === periodoActual) {
                $(this).prop('checked', true);
            }
        });

        // D. Marcar Estados Activos (Todos EXCEPTO Inactivo)
        $('#estado_finalizado').prop('checked', true); // Aprobado
        $('#estado_progreso').prop('checked', true);   // En progreso
        $('#estado_revision').prop('checked', true);   // En revisión
        $('#estado_rechazado').prop('checked', true);  // Rechazado

        // Inactivo y "Todos" se quedan desmarcados
        $('#estado_inactivo').prop('checked', false);
        $('#estado_todos').prop('checked', false);

        // E. Actualizar variable global de filtros
        activeFilters = {
            carrera: [],
            grado: [],
            grupo: [],
            periodo: [periodoActual],
            ano: [anoActual],
            estado: ['Aprobado', 'En progreso', 'En revisión', 'Rechazado', 'Cerrado'], // <--- Agregado Cerrado
            turno: []
        };

        // F. Actualizar textos de botones
        updateFilterButton('estado', activeFilters.estado, 4);
        updateFilterButton('ano', activeFilters.ano, 1);
        updateFilterButton('periodo', activeFilters.periodo, 1);
        updateFilterButton('carrera', [], 0);
        updateFilterButton('grado', [], 0);
        updateFilterButton('grupo', [], 0);
        updateFilterButton('turno', [], 0);

        // G. Ejecutar filtro
        filterAndSearchPATs();
    }

