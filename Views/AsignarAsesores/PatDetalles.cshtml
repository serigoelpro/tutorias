    // Función para ver evidencia en modal
    function verEvidenciaModal(url, evidenciaId, actividadId, estadoActual) {
        // 1. Bloquear el scroll de la página de fondo
        $('body').css('overflow', 'hidden');

        // 2. Construir la URL forzando la página 1
        // Primero limpiamos cualquier fragmento anterior (#)
        var cleanUrl = url.split('#')[0];

        // Agregamos los parámetros: page=1 (fuerza inicio) y view=FitH (ajuste ancho)
        var finalUrl = cleanUrl + "#page=1&view=FitH";

        // 3. Limpiar el iframe primero para asegurar que el navegador no use caché de posición
        var $iframe = $('#iframe-evidencia');
        $iframe.attr('src', '');

        // Pequeño retardo técnico para asegurar que el navegador procese el src vacío
        setTimeout(function () {
            $iframe.attr('src', finalUrl);
        }, 50);

        // 4. Generar los botones de acción (Tu lógica original)
        var botonesHtml = '';
        botonesHtml += '<button type="button" class="btn btn-default" onclick="closeModalEvidenciaPDF()">Cerrar</button>';

        if (estadoActual == 1) { // Aprobado -> Opción Rechazar
            botonesHtml += `<button type="button" class="btn btn-danger" onclick="cambiarEstadoEvidenciaDesdeModal('${evidenciaId}', 2, ${actividadId})"><i class="glyphicon glyphicon-remove"></i> Cambiar a RECHAZADO</button>`;
        } else if (estadoActual == 2) { // Rechazado -> Opción Aprobar
            botonesHtml += `<button type="button" class="btn btn-success" onclick="cambiarEstadoEvidenciaDesdeModal('${evidenciaId}', 1, ${actividadId})"><i class="glyphicon glyphicon-ok"></i> Cambiar a APROBADO</button>`;
        } else { // Pendiente -> Ambos
            botonesHtml += `<button type="button" class="btn btn-danger" onclick="cambiarEstadoEvidenciaDesdeModal('${evidenciaId}', 2, ${actividadId})"><i class="glyphicon glyphicon-remove"></i> RECHAZAR</button>`;
            botonesHtml += `<button type="button" class="btn btn-success" onclick="cambiarEstadoEvidenciaDesdeModal('${evidenciaId}', 1, ${actividadId})"><i class="glyphicon glyphicon-ok"></i> APROBAR</button>`;
        }

        $('#footer-acciones-evidencia').html(botonesHtml);
        $('#modal-ver-evidencia-pdf').fadeIn(300);
    }

    // Función auxiliar para cerrar y recargar tras aprobar/rechazar
    function cambiarEstadoEvidenciaDesdeModal(evidenciaId, nuevoEstado, actividadId) {
        // Llamamos a tu función original de cambio de estado
        cambiarEstadoEvidencia(evidenciaId, nuevoEstado, actividadId);

        // Cerramos el modal automáticamente para que el usuario vea el cambio en la tabla
        closeModalEvidenciaPDF();
    }

    function closeModalEvidenciaPDF() {
        // 1. Limpiar el src para que la próxima vez cargue desde cero
        $('#modal-ver-evidencia-pdf iframe').attr('src', '');

        // 2. Cerrar modal
        $('#modal-ver-evidencia-pdf').fadeOut(300);

        // 3. Restaurar el scroll de la página de fondo
        $('body').css('overflow', '');
