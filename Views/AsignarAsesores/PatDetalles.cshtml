}

// Función para subir evidencia
function subirEvidenciaActividad(actividadId, semana) {
    var patId = @Model.IdEntrevistaInicial;
    var tutorId = @Model.IdTutor;
    var periodo = '@Model.Periodo?.Nombre';
    var ano = '@Model.Fecha.Year';
    var grupo = '@Model.TutoriaGrupal';
    var fileInput = document.getElementById('file-evidencia-' + actividadId);
    var status = $('#status-evidencia-' + actividadId);

    // Detectar tipo de tutoria desde la fila
    var tipoTutoria = 'grupal'; // Por defecto grupal, ya que solo se muestra en filas TG
    var row = $(fileInput).closest('tr');
    if (row.data('tipo') === 'individual') {
        tipoTutoria = 'individual';
    }

    if (!fileInput || !fileInput.files.length) {
        status.text('Seleccione un PDF.');
        return;
    }

    var file = fileInput.files[0];
    if (file.type !== 'application/pdf') {
        status.text('Solo se permite PDF.');
        return;
    }

    var formData = new FormData();
    formData.append('patId', patId);
    formData.append('ActividadId', actividadId);
    formData.append('semana', semana);
    formData.append('tutorId', tutorId);
    formData.append('periodo', periodo);
    formData.append('ano', ano);
    formData.append('grupo', grupo);
    formData.append('tipoTutoria', tipoTutoria);
    formData.append('pdf', file);

    status.text('Subiendo...');

    $.ajax({
        url: baseUrl + 'PATsEvidences/Subir',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (resp) {
            if (resp.success) {
                status.text('¡Subido!');

                // Limpiar el input
                fileInput.value = '';
                $('#btn-subir-evidencia-' + actividadId).hide();

                // Recargar evidencias
                cargarEvidenciasPorActividadTabla();

                // Mostrar mensaje de éxito
                if (typeof mostrarMensaje === 'function') {
                    mostrarMensaje('Evidencia subida correctamente', 'info');
                }
            } else {
                status.text(resp.message || 'Error al subir.');
            }
        },
        error: function () {
            status.text('Error de conexión.');
        }
    });
}

