    function mostrarMensaje(mensaje, tipo) {
        $('.alert-message').remove();

        // CORRECCIÓN: Añadido 'info' y 'glyphicon-info-sign'
        var alertClass = tipo === 'success' ? 'status-active' : (tipo === 'info' ? 'status-info' : 'status-inactive');
        var iconClass = tipo === 'success' ? 'glyphicon-ok-circle' : (tipo === 'info' ? 'glyphicon-info-sign' : 'glyphicon-exclamation-sign');

        var alertHtml = '<div class="alert-message" style="position: fixed; top: 20px; right: 20px; z-index: 9999; padding: 16px 20px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); max-width: 400px; backdrop-filter: blur(10px);">';
        alertHtml += '<div style="display: flex; align-items: center; gap: 12px;">';
        alertHtml += '<i class="glyphicon ' + iconClass + '" style="font-size: 18px;"></i>';
        alertHtml += '<span style="font-weight: 500;">' + mensaje + '</span>';
        alertHtml += '</div></div>';

        if (tipo === 'success') { // Verde
            $(alertHtml).css({ 'background': 'linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%)', 'color': '#155724', 'border': '1px solid #28a745' }).appendTo('body');
        } else if (tipo === 'info') { // <-- NUEVO BLOQUE AZUL
            $(alertHtml).css({
                'background': 'linear-gradient(135deg, #d1ecf1 0%, #b6dff1 100%)',
                'color': '#0c5460',
                'border': '1px solid #17a2b8'
            }).appendTo('body');
        } else { // Rojo
            $(alertHtml).css({ 'background': 'linear-gradient(135deg, #f8d7da 0%, #f1b6bb 100%)', 'color': '#721c24', 'border': '1px solid #dc3545' }).appendTo('body');
        }

        setTimeout(function () {
            $('.alert-message').fadeOut(300, function () { $(this).remove(); });
        }, 3000);
    }



