                if (actividadesProcessadas[actividadId]) {
                    console.log('Actividad ' + actividadId + ' ya procesada, saltando...');

                    return; // Saltar esta actividad, ya fue procesada
                }

                var $radioRealizado = $(this).find('input[name="realizado_' + actividadId + '"]:checked');
                var comentario = $(this).find('.comentarios-input').val();

                // --- INICIO DE LA CORRECCIÓN ---

                // Esta es la lógica corregida
                if ($radioRealizado.length === 0) {
                    // Si no hay radio buttons (ej.oculto por lógica), no es un error
            // Pero si la celda es visible, SÍ es un error
            if ($(this).find('.realizado-cell').length > 0 && $(this).is(':visible')) {
                mostrarMensaje('Debe seleccionar Sí/No para todas las actividades visibles', 'error');
                hayErrores = true;
                return false;
            }
        }
                // --- FIN DE LA CORRECCIÓN ---

                if (actividadId) {
            var realizadoVal = ($radioRealizado.length > 0) ?
                $radioRealizado.val() === 'true' : $(this).data('realizado');
            comentarios.push({
                IdActividad: actividadId,
                RealizoActividad: realizadoVal,
                Comentarios: comentario || ''

            });

            // NUEVO: Marcar esta actividad como procesada
            actividadesProcessadas[actividadId] = true;
        }
    });

    if (hayErrores) return;
    if (comentarios.length === 0) {
        mostrarMensaje('No hay actividades para guardar', 'error');
        return;
    }

    // Log para depuración (OPCIONAL - puede removerse después)
    console.log('Total actividades procesadas:', Object.keys(actividadesProcessadas).length);
    console.log('Comentarios a enviar:', comentarios.length);

    var dataToSend = { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() };
    for (var i = 0; i < comentarios.length; i++) {
        dataToSend['comentarios[' + i + '].IdActividad'] = comentarios[i].IdActividad;
        dataToSend['comentarios[' + i + '].RealizoActividad'] = comentarios[i].RealizoActividad;
        dataToSend['comentarios[' + i + '].Comentarios'] = comentarios[i].Comentarios;
    }

    $.ajax({
        url: baseUrl + 'PATs/EditarVariosComentarios',
        type: 'POST',
        data: dataToSend,
        success: function (response) {



            if (response.success) {
                // <-- LUGAR CORRECTO
                hayCambiosSinGuardar = false;

                mostrarMensaje('Comentarios y estados actualizados correctamente', 'success');

                // --- INICIO DE LA CORRECCIÓN ---
                // Recargar la página después de 1 seg para ver los cambios
                setTimeout(function () { location.reload(); }, 1000);
                // --- FIN DE LA CORRECCIÓN ---

            } else {

                mostrarMensaje('Error al guardar: ' + (response.message || 'Error desconocido'), 'error');
            }


        },
        error: function (xhr, status, error) {
            mostrarMensaje('Error de conexión al guardar los comentarios', 'error');
        }
    });
 });


        $(document).off('click', '#btn-cancelar-final').on('click', '#btn-cancelar-final', function () {
            modoEdicionNotas = false;
            hayCambiosSinGuardar = false;

            $('.activity-row').each(function () {
                var actividadId = $(this).data('actividad-id');
                if (datosOriginales[actividadId]) {
                    var comentariosCell = $(this).find('.comentarios-cell');
                    comentariosCell.find('.comentarios-input').hide().val(datosOriginales[actividadId].comentarios);
                    comentariosCell.find('.comentarios-display').show();
                }
                $(this).find('.realizado-radio').remove();
                $(this).find('.realizado-texto').show();
            });

            $('.evidencia-cell .evidencia-input').hide(); // Ocultar evidencia
            $('#btn-guardar-comentarios-todas, #btn-cancelar-final').hide();
            $('#btn-comentar-todas').show();
            // --- INICIO DEL NUEVO CÓDIGO ---
            $('.btn-guardar-nota-individual').hide();
            // --- FIN DEL NUEVO CÓDIGO ---
        });

        // ========================================================================
        // EDICIÓN MASIVA DE ACTIVIDADES (PAT EN PROGRESO)
        // ========================================================================

        $(document).off('click', '#btn-editar-todas').on('click', '#btn-editar-todas', function () {
            if (!modoEdicionActividades) {
                modoEdicionActividades = true;
                hayCambiosSinGuardar = true;
                $('#btn-editar-todas').hide();
                $('#btn-guardar-todas, #btn-cancelar-todas').show();
                $('#btn-agregar-semana').show();
                $('#btn-eliminar-semana').show();

                $('.activity-row').each(function () {
                    var actividadCell = $(this).find('.actividad-cell');
                    var texto = actividadCell.find('.actividad-display').text().trim();
                    actividadCell.find('.actividad-display').hide();
                    actividadCell.find('.actividad-input').val(texto).show(); // Usar .actividad-input
                });

                $('.realizado-cell, .comentarios-cell').css('opacity', '0.5');
            }
        });

        $(document).on('click', '#btn-cancelar-todas', function () {
            if (!modoEdicionActividades) return; // Solo si estamos en modo edición de actividades

            modoEdicionActividades = false;
            hayCambiosSinGuardar = false;
            $('#btn-guardar-todas, #btn-cancelar-todas').hide();
            $('#btn-editar-todas').show();
            $('#btn-agregar-semana').hide();
            $('#btn-eliminar-semana').hide();

            $('.activity-row').each(function () {
                var actividadCell = $(this).find('.actividad-cell');
                var input = actividadCell.find('.actividad-input');
                var display = actividadCell.find('.actividad-display');
                if (input.length) {
                    input.hide();
                    display.show(); // No es necesario restaurar texto, solo ocultar/mostrar
                }
            });

            $('.realizado-cell, .comentarios-cell').css('opacity', '1');
        });

        $(document).on('click', '#btn-guardar-todas', function () {
            var actividades = [];
            $('.activity-row').each(function () {
                var idActividad = $(this).attr('data-actividad-id');
                var actividadInput = $(this).find('.actividad-cell .actividad-input');
                if (actividadInput.is(':visible')) { // Solo guardar si está en modo edición


                    actividades.push({
                        IdActividad: idActividad,
                        Actividad: actividadInput.val()
                    });

                }
            });

            if (actividades.length === 0) {
                mostrarMensaje('No hay actividades para guardar', 'error');
                return;
            }

            var dataToSend = {};


            dataToSend['__RequestVerificationToken'] = $('input[name="__RequestVerificationToken"]').val();
            for (var i = 0; i < actividades.length; i++) {
                dataToSend['actividades[' + i + '].IdActividad'] = actividades[i].IdActividad;
                dataToSend['actividades[' + i + '].Actividad'] = actividades[i].Actividad;
            }

            $.ajax({
                url: '/PATs/EditarVariasActividades',
                type: 'POST',
                data: dataToSend,
                success: function (response) {


                    if (response.success) {
                        // <-- LUGAR CORRECTO
                        hayCambiosSinGuardar = false;

                        mostrarMensaje('Actividades actualizadas correctamente', 'success');

                        // --- INICIO DE LA CORRECCIÓN ---
                        // Recargar la página después de 1 seg para ver los cambios
                        setTimeout(function () { location.reload(); }, 1000);
                        // --- FIN DE LA CORRECCIÓN ---

                    } else {

                        mostrarMensaje('Error al guardar actividades: ' + (response.message || 'Error desconocido'), 'error');
                    }

                },
                error: function () {
                    mostrarMensaje('Error de conexión al guardar actividades', 'error');

                }
            });
        });

        // ========================================================================
        // MODAL: ELIMINAR SEMANA
        // ========================================================================

        $(document).on('click', '#btn-eliminar-semana', function () {
            cargarSemanasParaEliminar();
            $('#modal-eliminar-semana').fadeIn(300);
        });

        // ========================================================================
        // COMENTARIOS DE REVISIÓN
        // ========================================================================

        $(document).on('submit', '#form-agregar-comentario-revision', function (e) {
            e.preventDefault();
            var comentario = $('#comentario-nuevo').val().trim();
            if (!comentario) {
                mostrarMensaje('El comentario no puede estar vacío', 'error');
                return;
            }
            var patId = @Model.IdEntrevistaInicial;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $('#btn-agregar-comentario-revision').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("AgregarNota", "PATsNota")',
                type: 'POST',
                data: { idPat: patId, nota: comentario, __RequestVerificationToken: token },
                success: function (response) {
                    $('#btn-agregar-comentario-revision').prop('disabled', false);
                    if (response.success) {
                        $('#comentario-nuevo').val('');
                        cargarNotasRevision(patId);
                    } else {
                        mostrarMensaje(response.message || 'No se pudo agregar el comentario', 'error');
                    }
                },
                error: function () {
                    $('#btn-agregar-comentario-revision').prop('disabled', false);
                    mostrarMensaje('Error de conexión al agregar el comentario', 'error');
                }
            });
        });

        $(document).on('click', '.btn-eliminar-comentario', function () {
            var notaId = $(this).data('notaid');
            if (!notaId) return;
            if (!confirm('¿Seguro que deseas eliminar este comentario?')) return;
            var patId = @Model.IdEntrevistaInicial;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("EliminarNota", "PATsNota")',
                type: 'POST',
                data: { notaId: notaId, __RequestVerificationToken: token },
                success: function (response) {
                    if (response.success) {
                        cargarNotasRevision(patId);
                    } else {
                        mostrarMensaje(response.message || 'No se pudo eliminar el comentario', 'error');
                    }
                },
                error: function () {
                    mostrarMensaje('Error de conexión al eliminar el comentario', 'error');
                }
            });
        });

    }); // <-- FIN DEL ÚNICO $(document).ready()
</script>
