                        <div class="text-danger" id="actividad-grupal-error"></div>
                    </div>

                    <!-- Actividad Individual -->
                    <div class="form-group">
                        <label for="actividad-individual">Actividad Individual:</label>
                        <textarea id="actividad-individual" class="form-control" rows="3" placeholder="Ingrese la actividad individual"></textarea>
                        <div class="text-danger" id="actividad-individual-error"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" id="btn-agregar-semana" onclick="agregarSemana()">Agregar Semana</button>
                    <button type="button" class="btn btn-secondary" onclick="closeModal('modal-agregar-semana')">Cancelar</button>
                </div>
            </div>
        </div>


        <!-- Modal para Eliminar Semana -->
        <div class="modal-overlay" id="modal-eliminar-semana" style="display: none;">
            <div class="modal-container" style="max-width: 500px;">
                <div class="modal-header">
                    <h3 class="modal-title">
                        <i class="glyphicon glyphicon-trash"></i> Eliminar Semana
                    </h3>
                    <button type="button" class="modal-close" onclick="closeModal('modal-eliminar-semana')">
                        <span class="close-icon">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="semana-eliminar-select">Seleccione la semana a eliminar:</label>
                        <select id="semana-eliminar-select" class="form-control">
                            <option value="">Seleccione una semana</option>
                            <!-- Opciones llenadas por JS -->
                        </select>
                        <div class="text-danger" id="semana-eliminar-error"></div>
                    </div>
                    <div class="alert alert-warning" style="margin-top: 12px;">
                        Al eliminar una semana, se eliminarán ambas actividades asociadas. Podrá volver a agregar la semana después.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" onclick="eliminarSemana()">Eliminar</button>
                    <button type="button" class="btn btn-secondary" onclick="closeModal('modal-eliminar-semana')">Cancelar</button>
                </div>
            </div>
        </div>


        <!-- Modal para ver notas de revisión -->
        <!-- Modal para ver notas de revisión (single instance, fixed markup) -->
        <div class="modal fade" id="modal-notas-revision" tabindex="-1" role="dialog" aria-labelledby="modalNotasRevisionTitle" aria-modal="true" aria-hidden="false" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="modalNotasRevisionTitle">
                            <i class="glyphicon glyphicon-list-alt" style="margin-right: 8px; color: #337ab7;"></i>
                            Comentarios de revisión
                        </h4>
                    </div>
                    <div class="modal-body">
                        <div style="margin-bottom: 20px; padding: 12px; background-color: #f8f9fa; border-radius: 6px; border-left: 4px solid #337ab7;">
                            <strong>PAT del grupo:</strong> <span id="grupo-notas-revision">@Model.TutoriaGrupal</span>
                        </div>
                        <div id="loading-notas-revision" style="text-align: center; padding: 40px; display: none;">
                            <i class="glyphicon glyphicon-refresh glyphicon-spin" style="font-size: 24px; color: #337ab7;"></i>
                            <p style="margin-top: 12px; color: #6c757d;">Cargando comentarios de revisión...</p>
                        </div>
                        <div id="notas-revision-lista">
                            <!-- Aquí se cargarán los comentarios dinámicamente -->
                        </div>
                        <div id="agregar-comentario-revision">
                            <form id="form-agregar-comentario-revision" autocomplete="off">
                                <div class="form-group">
                                    <label for="comentario-nuevo">Agregar comentario:</label>

                                    <textarea class="form-control" id="comentario-nuevo" rows="4" maxlength="500" placeholder="Escribe tu comentario..."></textarea>
                                </div>

                                <div style="text-align: center; margin-top: 15px;">
                                    <button type="submit" class="btn btn-success" id="btn-agregar-comentario-revision">
                                        <span class="glyphicon glyphicon-plus"></span> Agregar comentario
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div id="sin-notas-revision" style="text-align: center; padding: 40px; color: #6c757d; display: none;">
                        <i class="glyphicon glyphicon-info-sign" style="font-size: 32px; margin-bottom: 12px;"></i>
                        <p><strong>No hay comentarios de revisión</strong></p>
                        <p>Aún no se han agregado comentarios de revisión a este PAT.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModalNotasRevision()">
                        <i class="glyphicon glyphicon-remove" style="margin-right: 6px;"></i>
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>

