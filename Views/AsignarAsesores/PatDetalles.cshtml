@model Plataforma_Web.Models.PAT
@Styles.Render("~/ViewsStyles/PAT/ListPAT.css")
@using Plataforma_Web.Models

@{
    PAT pat = ViewBag.PAT as PAT;
    ViewBag.Title = "Details";
}

@Html.AntiForgeryToken()


@section Styles{

    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />


    <style>
        /* Cambia el color del texto de la semana en el modal */
        #proxima-semana-display {
            color: #1ab192 !important; /* <-- Verde. El !important asegura que sobreescriba el estilo en línea */
        }

        /* Opcional: Si quieres cambiar también el color del badge de semana en la tabla */
        /* .semana-badge {
            color: #28a745;
        } */


        .btn-action[disabled] {
            opacity: 0.65; /* Semi-transparente */
            cursor: not-allowed !important;
        }


        /* --- INICIO: SOLICITUD 1 (MAYÚSCULAS) --- */
        .pat-table th,
        .btn-action,
        .modal-title,
        .group-label,
        .activity-filter-btn,
        .diagnostico-header div,
        .vulnerabilidades-header div,
        .detail-label,
        .filter-label {
            text-transform: uppercase;
        }
            /* --- FIN: SOLICITUD 1 (MAYÚSCULAS) --- */

            /* Específicamente para el botón de aprobado */
            .btn-action[style*="background: #28a745"][disabled] {
                background: #28a745 !important;
                color: white !important;
                opacity: 0.65;
                box-shadow: none;
            }

            /* Para botón enviado a revisión */
            .btn-action[style*="background: #ffc107"][disabled] {
                background: #ffc107 !important;
                color: #212529 !important;
                opacity: 0.65;
                box-shadow: none;
            }

            /* Para botón rechazado */
            .btn-action[style*="background: #dc3545"][disabled] {
                background: #dc3545 !important;
                color: white !important;
                opacity: 0.65;
                box-shadow: none;
            }

        /* CORRECCIÓN PUNTO 1: Aplicar mayúsculas SOLO al contenido del PAT, protegiendo el menú */
        .pat-container,
        .pat-container h3,
        .pat-container h4,
        .pat-container div,
        .pat-container span,
        .pat-container input,
        .pat-container textarea,
        .pat-container button,
        .modal-container * {
            text-transform: uppercase !important;
        }

        /* Forzar que la barra de navegación y el sidebar se vean normales */
        /* Ajusta las clases .navbar, .main-header según tu layout maestro */
        .navbar, .navbar *,
        .main-header, .main-header *,
        .sidebar, .sidebar *,
        .sidebar-menu, .sidebar-menu * {
            text-transform: none !important;
        }

        /* El resto de tus estilos... */
        #proxima-semana-display {
            color: #1ab192 !important;
        }

        #modal-notas-revision #comentario-nuevo.form-control {
            min-height: unset !important;
            max-height: unset !important;
            font-size: 14px !important;
            padding: 6px 12px !important;
            line-height: 1.42857143 !important;
            height: auto !important;
            max-width: 100% !important;
            width: 100% !important;
            box-sizing: border-box !important;
            display: block !important;
        }

        #modal-notas-revision #comentario-nuevo.form-control {
            min-height: unset !important;
            max-height: unset !important;
            font-size: 14px !important;
            padding: 6px 12px !important;
            line-height: 1.42857143 !important;
            height: auto !important;
            max-width: 100% !important;
            width: 100% !important;
            box-sizing: border-box !important;
            display: block !important;
        }

        .pat-left-column {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
        }

        .pat-layout-wrapper {
            overflow: visible !important;
        }

        #modal-editar-vulnerabilidades .form-group textarea.form-control {
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
        }

        #modal-agregar-semana .form-group textarea.form-control {
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
        }

        .sga-scope .sga-filter-bar {
            border: 1px solid #cfe8e2;
            color: var(--primary);
            background: #e9f8f4;
            border-radius: 10px;
            font-weight: 600;
            padding: 10px 15px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px 10px;
        }

            .sga-scope .sga-filter-bar strong {
                margin-right: 5px;
            }

            .sga-scope .sga-filter-bar .btn-utt-outline {
                padding: 4px 10px;
                font-size: 0.9rem;
            }

        #barraFiltrosActivos {
            display: block !important;
            font-size: 14px !important;
            line-height: 1.6 !important;
        }

            #barraFiltrosActivos p,
            #barraFiltrosActivos strong {
                font-size: 14px !important;
            }

            #barraFiltrosActivos p {
                margin: 0 0 10px 0;
            }
    </style>

}

<div class="sga-scope">
    <div class="pat-container" style="margin-top:20px">
        <div class="row" style="margin-bottom: 15px;">
            <div class="col-md-12">
                <a class="btn btn-primary" href="@Url.Action("PAT")" role="button">
                    <span class="glyphicon glyphicon-arrow-left"></span>
                    Regresar
                </a>
            </div>
        </div>
        <!-- Nueva estructura de dos columnas -->
        <div class="pat-layout-wrapper">
            <!-- Columna izquierda: Diagnóstico y Vulnerabilidades -->
            <div class="pat-left-column">
                <!-- Sección: Diagnóstico del Grupo -->
                <div class="pat-card diagnostico-card" style="margin-bottom: 16px; background: #f8f9fa; box-shadow: 0 2px 4px rgba(26,177,146,0.08);">
                    <div class="diagnostico-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <div style="font-size: 18px; color: #2c3e50; font-weight: 700;">
                            <i class="glyphicon glyphicon-stats" style="margin-right: 8px; color: #1ab192;"></i>
                            Diagnóstico del Grupo
                        </div>
                        <span class="students-count" style="font-size: 1.2rem; font-weight: 700; color: #2c3e50;">
                            (@Html.DisplayFor(model => model.CantidadAlumno) alumnos)
                        </span>
                    </div>

                    <div class="diagnostico-details" style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                        <div class="detail-item">
                            <span class="detail-label" style="font-size: 13px; color: #6c757d; font-weight: 600; text-transform: uppercase; display: block;">
                                Grupo
                            </span>
                            <span class="detail-value" style="font-size: 15px; font-weight: 600; color: #2c3e50;">
                                @Html.DisplayFor(model => model.Grupo)
                            </span>
                        </div>

                        <div class="detail-item">
                            <span class="detail-label" style="font-size: 13px; color: #6c757d; font-weight: 600; text-transform: uppercase; display: block;">
                                Período
                            </span>
                            <span class="detail-value" style="font-size: 15px; font-weight: 600; color: #2c3e50;">
                                @Html.DisplayFor(model => model.Periodo.Nombre) @Model.Fecha.Year
                            </span>
                        </div>

                        <div class="detail-item">
                            <span class="detail-label" style="font-size: 13px; color: #6c757d; font-weight: 600; text-transform: uppercase; display: block;">
                                Tutor
                            </span>
                            <span class="detail-value" style="font-size: 15px; font-weight: 600; color: #2c3e50;">
                                @Html.DisplayFor(model => model.Tutor)
                            </span>
                        </div>

                        <div class="detail-item">
                            <span class="detail-label" style="font-size: 13px; color: #6c757d; font-weight: 600; text-transform: uppercase; display: block;">
                                Carrera
                            </span>
                            <span class="detail-value" style="font-size: 15px; font-weight: 600; color: #2c3e50;">
                                @Html.DisplayFor(model => model.Carrera.Nombre)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Sección: Vulnerabilidades -->
                <div class="pat-card vulnerabilidades-card" style="margin-bottom: 16px; background: #f8f9fa; box-shadow: 0 2px 4px rgba(26,177,146,0.08);">
                    <div class="vulnerabilidades-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <div style="font-size: 18px; color: #2c3e50; font-weight: 700;">
                            <i class="glyphicon glyphicon-warning-sign" style="margin-right: 8px; color: #ff9f43;"></i>
                            Vulnerabilidades
                        </div>
                        <span style="font-size: 13px; font-weight: 600; color: #20c997; background: #e7faf5; padding: 4px 10px; border-radius: 16px; display: inline-block; letter-spacing: 0.5px; box-shadow: 0 2px 10px rgba(26,177,146,0.06);">
                            Total: @(Model.VunerableEconomico + Model.VunerablePersonal + Model.VunerableAcademico + (ViewBag.NoVulnerablesCount ?? 0) + (ViewBag.CantidadBajas ?? 0))
                        </span>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 12px;">
                        <!-- Económicos -->
                        <button type="button" class="vulnerability-btn btn-action vuln-compact" data-target="economico" style="background: linear-gradient(135deg, #ff9f43 0%, #ff8c00 100%); color: white; border: none; cursor: pointer; transition: all 0.3s ease; padding: 6px 4px; border-radius: 8px; min-height: 40px;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
                                <div class="vuln-icon" style="background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; width: 18px; height: 18px;">
                                    <i class="glyphicon glyphicon-usd" style="font-size: 10px;"></i>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 13px; font-weight: 700; line-height: 1;">@Html.DisplayFor(model => model.VunerableEconomico)</div>
                                    <div style="font-size: 8px; font-weight: 600; text-transform: uppercase; opacity: 0.9;">Económicos</div>
                                </div>
                            </div>
                        </button>

                        <!-- Personal -->
                        <button type="button" class="vulnerability-btn btn-action vuln-compact" data-target="personal" style="background: linear-gradient(135deg, #ee5a52 0%, #dc3545 100%); color: white; border: none; cursor: pointer; transition: all 0.3s ease; padding: 6px 4px; border-radius: 8px; min-height: 40px;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
                                <div class="vuln-icon" style="background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; width: 18px; height: 18px;">
                                    <i class="glyphicon glyphicon-user" style="font-size: 10px;"></i>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 13px; font-weight: 700; line-height: 1;">@Html.DisplayFor(model => model.VunerablePersonal)</div>
                                    <div style="font-size: 8px; font-weight: 600; text-transform: uppercase; opacity: 0.9;">Personal</div>
                                </div>
                            </div>
                        </button>

                        <!-- Académico -->
                        <button type="button" class="vulnerability-btn btn-action vuln-compact" data-target="academico" style="background: linear-gradient(135deg, #3742fa 0%, #2d3cdf 100%); color: white; border: none; cursor: pointer; transition: all 0.3s ease; padding: 6px 4px; border-radius: 8px; min-height: 40px;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
                                <div class="vuln-icon" style="background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; width: 18px; height: 18px;">
                                    <i class="glyphicon glyphicon-folder-close" style="font-size: 10px;"></i>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 13px; font-weight: 700; line-height: 1;">@Html.DisplayFor(model => model.VunerableAcademico)</div>
                                    <div style="font-size: 8px; font-weight: 600; text-transform: uppercase; opacity: 0.9;">Académico</div>
                                </div>
                            </div>
                        </button>

                        <button type="button" class="vulnerability-btn btn-action btn-info vuln-compact" data-target="no-vulnerable">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
                                <div class="vuln-icon" style="background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px;">
                                    <i class="glyphicon glyphicon-thumbs-up" style="font-size: 12px;"></i>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 14px; font-weight: 700; line-height: 1;">@ViewBag.NoVulnerablesCount</div>
                                    <div style="font-size: 9px; font-weight: 600; text-transform: uppercase; opacity: 0.9;">No vulnerables</div>
                                </div>
                            </div>
                        </button>

                        <button type="button" class="vulnerability-btn btn-action vuln-compact" data-target="bajas" style="background: #6c757d; color: white; cursor: pointer;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
                                <div class="vuln-icon" style="background: rgba(255,255,255,0.2); border-radius: 50%; width: 18px; height: 18px; display:flex; justify-content:center; align-items:center;">
                                    <i class="glyphicon glyphicon-remove-circle" style="font-size: 10px;"></i>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 13px; font-weight: 700; line-height: 1;">@ViewBag.CantidadBajas</div>
                                    <div style="font-size: 8px; font-weight: 600; opacity: 0.9;">BAJAS</div>
                                </div>
                            </div>
                        </button>
                    </div>
                    @if (Model.estado == true && (Model.EstadoRevision == 0 || Model.EstadoRevision == 3))
                    {
                        <button type="button" id="btn-editar-vulnerabilidades" class="btn-action btn-view" style="width: 100%; justify-content: center; padding: 8px; font-size: 12px;">
                            <span class="action-icon glyphicon glyphicon-pencil"></span>
                            Agregar comentario
                        </button>
                    }
                </div>
            </div>


            <!-- Columna derecha: Plan de Acción y demás contenido -->
            <div class="pat-right-column">
                <!-- Sección: Plan de Acción -->
                @if (ViewBag.Actividades != null)
                {
                    <div class="row">
                        <div class="col-md-12">
                            <div class="pat-card">
                                <!-- Header de acciones y filtros -->
                                <div class="card-header-info">
                                    <div class="group-section" style="display: flex; align-items: center; gap: 12px;">
                                        <div class="group-label">Plan de Acción</div>
                                        @{
                                            var tiempo = DateTime.Now;
                                            int periodoActual = (tiempo.Month >= 1 && tiempo.Month <= 4) ? 1 : (tiempo.Month >= 5 && tiempo.Month <= 8) ? 2 : 3;
                                            string estadoPAT = "";
                                            string claseEstado = "";
                                            if (Model.IdPeriodo != periodoActual || Model.Fecha.Year != tiempo.Year)
                                            {
                                                estadoPAT = "Inactivo";
                                                claseEstado = "status-inactive";
                                            }
                                            else if (Model.estado == true)
                                            {
                                                if (Model.EstadoRevision == 2) // Si está aprobado por el coordinador
                                                {
                                                    estadoPAT = "Aprobado";
                                                    claseEstado = "status-active"; // Clase para color verde
                                                }
                                                else if (Model.EstadoRevision == 1)
                                                {
                                                    estadoPAT = "En Revisión";
                                                    claseEstado = "status-review"; // <-- NUEVO: Azul
                                                }
                                                else
                                                {
                                                    estadoPAT = "Planeación en progreso";
                                                    claseEstado = "status-pending"; // Amarillo
                                                }
                                            }
                                            else // Estado es false (Cerrado)
                                            {
                                                estadoPAT = "PAT Cerrado"; // <-- Cambiado texto
                                                claseEstado = "status-active"; // <-- VUELVE A VERDE
                                            }
                                        }
                                        <span class="status-badge @claseEstado" style="font-size: 14px; display: flex; align-items: center; gap: 6px;">
                                            @if (estadoPAT == "Aprobado")
                                            {<i class="glyphicon glyphicon-ok-circle" style="color: #28a745;"></i>}
                                            @if (estadoPAT == "En progreso")
                                            {<i class="glyphicon glyphicon-time" style="color: #ffc107;"></i>}
                                            @if (estadoPAT == "Inactivo")
                                            {<i class="glyphicon glyphicon-ban-circle" style="color: #dc3545;"></i>}
                                            <span>@estadoPAT</span>
                                        </span>
                                    </div>
                                    <div class="plan-actions" style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                                        <!-- Botón para cambiar estado y EstadoRevision -->
                                        <button type="button" id="btn-cambiar-estado" class="btn-action btn-warning" onclick="$('#modal-cambiar-estado').fadeIn(300);">
                                            <span class="glyphicon glyphicon-retweet"></span>
                                            &nbsp;Cambiar estado
                                        </button>

                                        <!-- Modal para cambiar estado y EstadoRevision -->
                                        <div class="modal-overlay" id="modal-cambiar-estado" style="display:none; z-index:9999;">
                                            <div class="modal-container" style="max-width:400px;">
                                                <div class="modal-header">
                                                    <h3 class="modal-title">
                                                        <span class="glyphicon glyphicon-retweet" style="margin-right:8px;"></span>
                                                        Cambiar estado PAT
                                                    </h3>
                                                    <button type="button" class="modal-close" onclick="$('#modal-cambiar-estado').fadeOut(300);">
                                                        <span class="close-icon">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <form id="form-cambiar-estado">
                                                        <div class="form-group">
                                                            <label for="nuevo-revision">Estado de revisión:</label>
                                                            <select id="nuevo-revision" class="form-control">
                                                                <option value="0" @(Model.EstadoRevision == 0 ? "selected" : "")>Sin enviar a revisión</option>
                                                                <option value="1" @(Model.EstadoRevision == 1 ? "selected" : "")>Enviado a revisión</option>
                                                                <option value="2" @(Model.EstadoRevision == 2 ? "selected" : "")>Aprobado</option>
                                                                <option value="3" @(Model.EstadoRevision == 3 ? "selected" : "")>Rechazado</option>
                                                            </select>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="nuevo-estado">Estado general (Solo cambiar estado a "Cerrado" al final del cuatrimestre)</label>
                                                            <select id="nuevo-estado" class="form-control">
                                                                <option value="true" @(Model.estado ? "selected" : "")>En progreso</option>
                                                                <option value="false" @(!Model.estado ? "selected" : "")>Cerrado</option>
                                                            </select>
                                                        </div>

                                                        <div style="text-align:right; margin-top: 18px;">
                                                            <button type="button" class="btn btn-secondary" onclick="$('#modal-cambiar-estado').fadeOut(300);" style="margin-right:10px;">Cancelar</button>
                                                            <button type="submit" class="btn btn-success">Guardar</button>
                                                        </div><br>

                                                        <div class="sga-filter-bar" id="barraFiltrosActivos" style="margin-bottom: 20px;">
                                                            <strong>Descripción de estados:</strong><br>

                                                            <strong>Estado de revisión:</strong>
                                                            <p>1. Sin enviar a revisión: el PAT sigue siendo armado por el tutor.</p>
                                                            <p>
                                                                2. Enviado a revisión: el PAT bloquea su capacidad de edición y aparece en la sección "Revisión de PATs" del coordinador.
                                                            </p>
                                                            <p>
                                                                3. Aprobado: el PAT es aprobado y ahora el tutor puede marcar la realizacion de las tutorias, asi como poner sus notas y subir sus evidencias.
                                                            </p>
                                                            <p>4. Rechazado: el tutor puede editarlo de nuevo y reenviarlo a revisión.</p>

                                                            <br>
                                                            <strong>Estado general aprobado:</strong>
                                                            <p>1. Cerrado: significa que el PAT ha sido aprobado y finalizado completamente por lo que se bloquearan las opciones de edición en el PAT.</p>


                                                            <br>
                                                            <strong>Nota: Un PAT inactivo no se puede activar porque depende del periodo en curso.</strong>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Botón para cambiar estado y EstadoRevision -->
                                        @if (Model.estado == true)
                                        {
                                            if (Model.EstadoRevision == 0 || Model.EstadoRevision == 3)
                                            {
                                                <button type="button" id="btn-editar-todas" class="btn-action btn-view">
                                                    <span class="action-icon glyphicon glyphicon-pencil"></span>
                                                    Editar PAT
                                                </button>
                                                <button type="button" id="btn-eliminar-semana" class="btn-action btn-danger" style="margin-left: 8px;">
                                                    <span class="action-icon glyphicon glyphicon-trash"></span>
                                                    Eliminar semana
                                                </button>
                                            }
                                            <button type="button" id="btn-agregar-semana" class="btn-action btn-view" style="display: none;" onclick="openModalAgregarSemana()">
                                                <span class="action-icon glyphicon glyphicon-plus"></span>
                                                Agregar Semana
                                            </button>
                                            <button type="button" id="btn-guardar-todas" class="btn-action btn-report" style="display: none;">
                                                <span class="action-icon glyphicon glyphicon-floppy-disk"></span>
                                                Guardar
                                            </button>
                                            <button type="button" id="btn-cancelar-todas" class="btn-action" style="display: none; background: #6c757d; color: white;">
                                                <span class="action-icon glyphicon glyphicon-remove"></span>
                                                Cancelar
                                            </button>
                                            if (Model.EstadoRevision == 1)
                                            {
                                                <button type="button" class="btn-action" style="background: #ffc107; color: #212529; cursor: not-allowed;" disabled>
                                                    <span class="action-icon glyphicon glyphicon-time"></span>
                                                    Enviado a revisión
                                                </button>
                                            }
                                            else if (Model.EstadoRevision == 2)
                                            {
                                                <button type="button" class="btn-action" style="background: #28a745; color: white; cursor: not-allowed;" disabled>
                                                    <span class="action-icon glyphicon glyphicon-ok"></span>
                                                    Aprobado
                                                </button>

                                                <button type="button" id="btn-comentar-todas" class="btn-action btn-view">
                                                    <span class="action-icon glyphicon glyphicon-comment"></span>
                                                    Adjuntar evidencia
                                                </button>
                                                <button type="button" id="btn-guardar-comentarios-todas" class="btn-action btn-report" style="display: none;">
                                                    <span class="action-icon glyphicon glyphicon-floppy-disk"></span>
                                                    Guardar
                                                </button>
                                                <button type="button" id="btn-cancelar-final" class="btn-action" style="display: none; background: #6c757d; color: white;">
                                                    <span class="action-icon glyphicon glyphicon-remove"></span>
                                                    Cancelar
                                                </button>
                                            }
                                            else if (Model.EstadoRevision == 3)
                                            {
                                                <button type="button" class="btn-action" style="background: #dc3545; color: white; cursor: not-allowed;" disabled>
                                                    <span class="action-icon glyphicon glyphicon-remove"></span>
                                                    Rechazado
                                                </button>
                                            }
                                            <button type="button" id="btn-ver-comentarios-revision" class="btn-action btn-view" onclick="verNotasRevision()">
                                                <span class="action-icon glyphicon glyphicon-list-alt"></span>
                                                Agregar comentario
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" id="btn-comentar-todas" class="btn-action btn-view">
                                                <span class="action-icon glyphicon glyphicon-comment"></span>
                                                Añadir notas
                                            </button>
                                            <button type="button" id="btn-guardar-comentarios-todas" class="btn-action btn-report" style="display: none;">
                                                <span class="action-icon glyphicon glyphicon-floppy-disk"></span>
                                                Guardar
                                            </button>
                                            <button type="button" id="btn-cancelar-final" class="btn-action" style="display: none; background: #6c757d; color: white;">
                                                <span class="action-icon glyphicon glyphicon-remove"></span>
                                                Cancelar
                                            </button>
                                            <button type="button" id="btn-ver-comentarios-revision" class="btn-action btn-view" onclick="verNotasRevision()">
                                                <span class="action-icon glyphicon glyphicon-list-alt"></span>
                                                Comentarios por revisar
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Filtros de actividades -->
                                <div class="activity-filters-row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 15px;">
                                    <div style="display: flex; gap: 5px;">
                                        <button type="button" id="filter-all" class="activity-filter-btn active" data-filter="all">
                                            TODAS
                                        </button>
                                        <button type="button" id="filter-individual" class="activity-filter-btn" data-filter="individual">
                                            INDIVIDUAL
                                        </button>
                                        <button type="button" id="filter-grupal" class="activity-filter-btn" data-filter="grupal">
                                            GRUPAL
                                        </button>
                                    </div>

                                    @if (Model.estado == false || Model.EstadoRevision == 2)
                                    {
                                        <div id="evidence-stats" style="font-size: 12px; display: flex; gap: 8px; align-items: center;">
                                            <strong style="color: #666; text-transform: uppercase;">Evidencias:</strong>
                                            <span class="label label-success" style="padding: 6px 10px; display: flex; align-items: center;">
                                                <i class="glyphicon glyphicon-ok" style="margin-right: 4px;"></i>
                                                Aprobadas: <span id="count-aprobadas" style="font-weight: bold; margin-left: 3px;">0</span>/<span id="count-total">0</span>
                                            </span>
                                            <span class="label label-danger" style="padding: 6px 10px; display: flex; align-items: center;">
                                                <i class="glyphicon glyphicon-remove" style="margin-right: 4px;"></i>
                                                Rechazadas: <span id="count-rechazadas" style="font-weight: bold; margin-left: 3px;">0</span>
                                            </span>
                                        </div>
                                    }
                                </div>

                                <div class="pat-table-container">
                                    <div class="table-responsive">
                                        <table class="pat-table tabla-unificada">
                                            <thead>
                                                <tr>
                                                    <th style="width: .2%; padding-right: 4px; text-align: center;">Semana</th>
                                                    <th style="width: .8%; padding-left: 4px; text-align: center;">Tipo</th>
                                                    <th style="width: 20%; text-align: center;">Actividades</th>

                                                    @if (Model.estado != true || Model.EstadoRevision == 2)
                                                    {
                                                        <th style="width: .8%; text-align: center;">Realizado</th>
                                                        <th style="width: 10%; text-align: center;">Notas</th>
                                                    }
                                                    @if (Model.estado == false || Model.EstadoRevision == 2)
                                                    {
                                                        <th style="width: 12%; text-align: center;">Evidencias</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in (ViewBag.Actividades as IEnumerable<Plataforma_Web.Models.ClasesPAT.ActividadesSemanal>))
                                                {
                                                    string tipoClase = item.Tipo.Nombre == "Tutoria Individual" ? "individual" : "grupal";
                                                    <tr class="activity-row @tipoClase" data-actividad-id="@item.IdActividad" data-tipo="@tipoClase" data-semana="@item.Semana.Nombre" data-realizado="@(item.RealizoActividad.ToString().ToLower())">
                                                        <td class="group-cell" style="text-align: center;">
                                                            <span class="semana-badge">@item.Semana.Nombre</span>
                                                        </td>
                                                        <td class="group-cell" style="text-align: center;">
                                                            @if (item.Tipo.Nombre == "Tutoria Individual")
                                                            {<span class="status-badge-small status-individual">TI</span> }
                                                            else
                                                            { <span class="status-badge-small status-grupal">TG</span>}
                                                        </td>
                                                        <td class="actividad-cell">
                                                            <div class="actividad-display">@item.Actividad</div>
                                                            <input type="text" class="form-control actividad-input" value="@item.Actividad" maxlength="500" style="display: none;" />
                                                        </td>

                                                        @if (Model.estado != true || Model.EstadoRevision == 2)
                                                        {
                                                            <td class="realizado-cell" style="text-align: center;">
                                                                <span class="realizado-texto">
                                                                    @if (item.RealizoActividad == true)
                                                                    {<span class="status-badge-small status-realizado">Sí</span> }
                                                                    else if (item.RealizoActividad == false)
                                                                    { <span class="status-badge-small status-no-realizado">No</span> }
                                                                    else
                                                                    { <span class="status-badge-small status-sin-datos">Sin datos</span>}
                                                                </span>
                                                            </td>
                                                            <td class="comentarios-cell">
                                                                <div class="comentarios-display">@(item.Comentarios ?? "")</div>
                                                                <textarea class="form-control comentarios-input" rows="2" style="display: none; border-radius: 8px; border: 2px solid #e9ecef; padding: 8px 12px; resize: vertical; min-height: 38px; max-height: 60px;">@(item.Comentarios ?? "")</textarea>
                                                                <button type="button" class="btn btn-success btn-xs btn-guardar-nota-individual" style="display:none; margin-top: 5px; width: 100%;">
                                                                    <span class="glyphicon glyphicon-floppy-disk"></span> Guardar Nota
                                                                </button>
                                                            </td>
                                                        }
                                                        @if (Model.estado == false || Model.EstadoRevision == 2)
                                                        {
                                                            <td class="evidencia-cell" style="text-align: center;">
                                                                @if (tipoClase == "grupal") // <-- SOLO GRUPAL
                                                                {
                                                                    <div id="evidencia-list-@item.IdActividad">
                                                                    </div>
                                                                    <input type="file" accept="application/pdf" style="display:none;" class="evidencia-input" id="file-evidencia-@item.IdActividad" />

                                                                    <button type="button" class="btn btn-success btn-xs" id="btn-subir-evidencia-@item.IdActividad" style="display:none;">Subir PDF</button>
                                                                    <span class="evidencia-upload-status" id="status-evidencia-@item.IdActividad" style="margin-left:6px; color:#888;"></span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color: #999;"></span>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>


        <!-- Modal para editar vulnerabilidades -->
        <div class="modal-overlay" id="modal-editar-vulnerabilidades" style="display: none;">
            <div class="modal-container" style="max-width: 620px;">
                <div class="modal-header">
                    <h3 class="modal-title">
                        <i class="glyphicon glyphicon-pencil" style="margin-right: 8px;"></i>
                        Editar vulnerabilidades
                    </h3>
                    <button type="button" class="modal-close" onclick="cerrarModalVulnerabilidades()">
                        <span class="close-icon">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("Edit", "PATs", FormMethod.Post, new { id = "form-vulnerabilidades" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.IdEntrevistaInicial)
                        @Html.HiddenFor(model => model.estado)
                        @Html.HiddenFor(model => model.IdPeriodo)
                        @Html.HiddenFor(model => model.IdTutoriaGrupal)
                        @Html.HiddenFor(model => model.IdCarrera)
                        @Html.HiddenFor(model => model.IdTutor)
                        @Html.HiddenFor(model => model.Fecha)
                        @Html.HiddenFor(model => model.CantidadAlumno)
                        @Html.HiddenFor(model => model.VunerableAcademico)
                        @Html.HiddenFor(model => model.VunerableEconomico)
                        @Html.HiddenFor(model => model.VunerablePersonal)
                        <input type="hidden" name="returnTo" value="AsignarAsesoresPatDetalles" />

                        <div class="form-group col-md-12">
                            @Html.LabelFor(model => model.DescripcionEconomico, htmlAttributes: new { @class = "control-label" })
                            <div>
                                @Html.TextAreaFor(model => model.DescripcionEconomico, new { @class = "form-control", rows = 4 })
                                @Html.ValidationMessageFor(model => model.DescripcionEconomico, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            @Html.LabelFor(model => model.DescripcionPersonal, htmlAttributes: new { @class = "control-label" })
                            <div>
                                @Html.TextAreaFor(model => model.DescripcionPersonal, new { @class = "form-control", rows = 4 })
                                @Html.ValidationMessageFor(model => model.DescripcionPersonal, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            @Html.LabelFor(model => model.DescripcionAcademico, htmlAttributes: new { @class = "control-label" })
                            <div>
                                @Html.TextAreaFor(model => model.DescripcionAcademico, new { @class = "form-control", rows = 4 })
                                @Html.ValidationMessageFor(model => model.DescripcionAcademico, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div style="text-align: right; margin-top: 20px;">
                            <button type="button" class="btn btn-secondary" onclick="cerrarModalVulnerabilidades()" style="margin-right: 10px;">Cancelar</button>
                            <button type="submit" class="btn btn-success">Guardar</button>
                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- Modal para Agregar Semana -->
        <div class="modal-overlay" id="modal-agregar-semana" style="display: none;">
            <div class="modal-container" style="max-width: 600px;">
                <div class="modal-header">
                    <h3 class="modal-title">
                        <i class="glyphicon glyphicon-plus"></i> Agregar Semana
                    </h3>
                    <button type="button" class="modal-close" onclick="closeModal('modal-agregar-semana')">
                        <span class="close-icon">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Selección de Semana -->
                    <div class="form-group">
                        <span class="control-label" style="font-weight: 600;">Se agregará la siguiente semana:</span>
                        <h4 id="proxima-semana-display" style="font-weight: 700; color: #337ab7;">Calculando...</h4>

