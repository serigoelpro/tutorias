function cambiarEstadoEvidencia(evidenciaId, nuevoEstado, actividadId) {
    var token = $('input[name="__RequestVerificationToken"]').val();
    var urlAccion = (nuevoEstado == 1) ? '@Url.Action("AprobarEvidencia", "PATsEvidences")' : '@Url.Action("RechazarEvidencia", "PATsEvidences")';
    var textoAccion = (nuevoEstado == 1) ? "APROBAR" : "RECHAZAR";

    if (!confirm('¿ESTÁ SEGURO QUE DESEA ' + textoAccion + ' ESTA EVIDENCIA?')) {
        return;
    }

    $.ajax({
        url: urlAccion,
        type: 'POST',
        data: { evidenciaId: evidenciaId, __RequestVerificationToken: token },
        success: function (response) {
            if (response.success) {
                mostrarMensaje('ESTADO DE EVIDENCIA ACTUALIZADO', 'success');
                cargarEvidenciasPorActividadTabla(); // Recargar la lista de evidencias
            } else {
                mostrarMensaje('ERROR AL ACTUALIZAR: ' + (response.message || 'ERROR'), 'error');
            }
        },
        error: function () {
            mostrarMensaje('ERROR DE CONEXIÓN AL ACTUALIZAR LA EVIDENCIA', 'error');
        }
    });
}
