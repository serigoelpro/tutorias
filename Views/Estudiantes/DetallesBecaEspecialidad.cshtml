@model IEnumerable<PlataformaWeb.BecasTransporte.Models.Estudiante>
@using Plataforma_Web.Models;

@{
    ViewBag.Title = "DetallesBeca";
    List<SelectListItem> Especialidades = ViewBag.Especialidades as List<SelectListItem>;


}


@if (ViewBag.Mensaje != null)
{
    <div class="col-md-12 text-center">
        <br />
        <br />
        <div class="alert alert-info">@ViewBag.Mensaje</div>
        <a class="btn btn-default" href="@Url.Action("Estadisticas", "Estudiantes")"><span class="glyphicon glyphicon-arrow-left"></span> Regresar</a>
    </div>
}
else
{
    <div class="row">
        <h2 class="col-md-6">
            Detalles de Becas
            <a class="btn btn-default" href="@Url.Action("Estadisticas", "Estudiantes")"><span class="glyphicon glyphicon-arrow-left"></span> Regresar</a>
        </h2>


        <h2 class="col-md-6">Total Por Carrera: <strong>@ViewBag.montoTotalPorCuatrimestre</strong></h2>

    </div>
    <ul class="nav nav-tabs">
        <li role="presentation"><a href="@Url.Action("DetallesBeca", "Estudiantes")">Becas Por Grupos</a></li>
        <li role="presentation"><a href="@Url.Action("DetallesBecaGrado", "Estudiantes")">Becas Por Grado</a></li>
        <li role="presentation" class="active"><a href="#">Becas Por Especialidad</a></li>
    </ul>
    <br />
    <div class="row">
        @if (Especialidades != null)
        {
            <div class="col-md-12">
                <p>Especialidades</p>
                @foreach (var especialidad in Especialidades)
                    {
                    <a href="@Url.Action("_GraficasEspecialidad", "Estudiantes", new { id = Convert.ToInt32(especialidad.Value) })" class="btn btn-primary btn-sm">@especialidad.Text</a>
                }
                
            </div>
        }
    </div>
    <div class="row">
        @Html.Partial("_GraficasEspecialidad")
    </div>

}

