

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load('current', { 'packages': ['corechart'] });
    google.charts.setOnLoadCallback(dibujarGraficaBecas);
    //google.charts.setOnLoadCallback(dibujarGraficaTransportes);


    function dibujarGraficaBecas() {

        var data = google.visualization.arrayToDataTable(@Html.Action("GraficoBecaPorGrado", "Estudiantes"));

        var options = {

            title: 'Alumnos Con Beca Por Grado.',
            colors: ['#5cb85c', '#999999']

        };

        var chart = new google.visualization.PieChart(document.getElementById('GraficaBecas'));

        chart.draw(data, options);
    }

    @*function dibujarGraficaTransportes() {
        var data = google.visualization.arrayToDataTable(@Html.Action("GraficoTransporte", "Estudiantes"));

        var options = {
            title: 'Cantidad de alumnos que usan transporte por grupo.'
        };

        var chart = new google.visualization.PieChart(document.getElementById('GraficaTransporte'));

        chart.draw(data, options);

    }*@
</script>
@{
    List<SelectListItem> becas = Session["ListaBecas"] as List<SelectListItem>;
    List<SelectListItem> cantidadAlumnos = Session["ListaCantidadAlumnos"] as List<SelectListItem>;
    List<SelectListItem> Montos = Session["ListaMontoBecas"] as List<SelectListItem>;
    List<SelectListItem> ListaAlumnos = Session["ListaAlumnos"] as List<SelectListItem>;

}

@if (Session["Grado"] != null)
{
    var Grado = Session["Grado"] as string;
    var CarreraDetalle = Session["CarreraDetalles"] as string;
    var TotalAlumnosPorGrado = (int)Session["TotalAlumnos"];
    var CantidadAlumnosConBeca = (int)Session["AlumnosConBeca"];
    var AlumnosSinBeca = (int)Session["AlumnosSinBeca"];
    var monTotalCuatrimestrePorGrado = (string)Session["MontoTotalPorCuatrimestrePorGrado"];


    <h2 class="text-center">@Grado</h2>
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h2 class="text-center">Gráfica</h2>
            </div>

            <div class="panel-body">
                <div class="row">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-12">

                                <center>
                                    <div id="GraficaBecas" style="width: 100%; height: 100%;"></div>
                                </center>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="text-center">

                    <div class="text-center">
                        <h3>Cantidad Por Grado: <strong>@monTotalCuatrimestrePorGrado</strong></h3>
                    </div>

                </div>
            </div>

            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6 text-center">
                        <h4>Carrera <span class="label label-default">@CarreraDetalle</span></h4>
                        <br />
                        <div class="row">
                            <h4>
                            </h4>
                        </div>
                    </div>
                    <div class="col-md-6 text-center">
                        <br />
                        <h4>Alumnos Por Grado: <span class="label label-default">@TotalAlumnosPorGrado</span></h4>
                        <h4>Alumnos Con Beca: <span class="label label-success">@CantidadAlumnosConBeca</span> </h4>
                        <h4>Alumnos Sin Beca: <span class="label label-default">@AlumnosSinBeca</span></h4>

                    </div>

                </div>
                <div class="row">
                    <br />
                    <center>
                        <button class="btn btn-primary" type="button" data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                            Ver Más
                        </button>
                    </center>
                    <br />
                    <div class="collapse container" id="collapseExample">
                        <div class="well">

                            <div class="text-center">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>

                                                <th class="text-center">
                                                    Beca
                                                </th>
                                                <th class="text-center">
                                                    Cantidad De Alumnos
                                                </th>
                                                <th class="text-center">
                                                    Monto
                                                </th>
                                                <th class="text-center">
                                                    Detalles
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in becas)
                                            {
                                                <tr>
                                                    <td>
                                                        @item.Text
                                                    </td>
                                                    <td>
                                                        @cantidadAlumnos.FirstOrDefault(x => x.Value == item.Value).Text
                                                    </td>
                                                    <td>
                                                        @Montos.FirstOrDefault(x => x.Value == item.Value).Text
                                                    </td>
                                                    <td>
                                                        <!-- Button trigger modal -->
                                                        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#@item.Text">
                                                            Detalles
                                                        </button>
                                                        <!-- Modal -->
                                                        <div class="modal fade" id="@item.Text" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                                            <div class="modal-dialog" role="document">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                        <h4 class="modal-title" id="myModalLabel">Alumnos Con Beca @becas.FirstOrDefault(x => x.Value == item.Value).Text</h4>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        @{
                                                                            if (ListaAlumnos.FirstOrDefault(x => x.Value == item.Value).Text != "NULL")
                                                                            {
                                                                                string[] Nombres = ListaAlumnos.FirstOrDefault(x => x.Value == item.Value).Text.Split('*');
                                                                                foreach (string nombre in Nombres)
                                                                                {
                                                                                    <P>@nombre</P>
                                                                                }
                                                                            }

                                                                        }
                                                                    </div>

                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </td>
                                                </tr>

                                                                            }
                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
            </div>
        </div>
    </div>

    Session["Grado"] = null;
}
else
{
    <br />
    <br />
    <br />
    <br />

    <div class="col-md-12 text-center">
        <div class="alert alert-info">Por favor seleccione un grado disponible.</div>
        <br />
        <br />
        <br />
        <br />

    </div>

}
