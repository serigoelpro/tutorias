<script>
    var parametrosCarrera = {
        idCarrera: '@jsIdCarrera' !== '' ? parseInt('@jsIdCarrera') : 0,
        soloCriticos: @Html.Raw(jsSoloCriticos.ToString().ToLower()),
        idEspecialidad: @Html.Raw(jsIdEspecialidad?.ToString() ?? "null"),
        idGrado: @Html.Raw(jsIdGrado?.ToString() ?? "null"),
        totalRegistros: parseInt('@modeloSeguro.Count') || 0,
        hayDatos: @Html.Raw(hayDatos.ToString().ToLower()),
        urlBase: '@Url.Action("ArrastrePorCarrera", "ConsultaArrastreCoordinador")'
    };
    var tableCarrera = null;

    $(document).ready(function () {
        console.log('Inicializando vista de Arrastre por Carrera con DataTables');
        console.log('Parámetros:', parametrosCarrera);

        $('[title]').tooltip({
            placement: 'top',
            container: 'body',
            delay: { show: 500, hide: 100 },
            animation: true
        });
        $('.dropdown-toggle').dropdown();

        $('.career-dropdown').on('focus', function() {
            $(this).closest('.career-selector-section').addClass('focused');
        }).on('blur', function() {
            $(this).closest('.career-selector-section').removeClass('focused');
        });

        tableCarrera = $('#tablaArrastreCarreraId').DataTable({
            "language": {
                "url": "https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-MX.json"
            },
            "pageLength": 25,
            "order": [[8, "asc"]], // Dias Restantes
            "responsive": false,
            "autoWidth": false,
            "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
            "drawCallback": function(settings) {
                actualizarEstadisticasDT(this.api());
            }
        });

        // Lógica para permitir "deseleccionar" un botón de estado
        $('.controles-filtro-carrera .btn').on('click', function(e) {
            var $label = $(this);
            var $radio = $label.find('input[type="radio"]');
            var filtro = $radio.val();

            // Si el botón ya estaba activo, lo apagamos (toggle off)
            if ($label.hasClass('active')) {
                e.preventDefault(); // Evitamos que Bootstrap lo vuelva a prender

                setTimeout(function() {
                     $label.removeClass('active');
                     $radio.prop('checked', false);

                     tableCarrera.column(7).search('').draw();
                }, 10);
                return;
            }

            // Si el botón NO estaba activo, permitimos que Bootstrap lo prenda,
            // y aplicamos el filtro en la tabla
            tableCarrera.column(7).search('');

            if(filtro === 'fuera-tiempo') {
                 tableCarrera.column(7).search('F. TIEMPO').draw();
            } else if(filtro === 'critico') {
                 tableCarrera.column(7).search('CRÍTICO').draw();
            } else if(filtro === 'medio') {
                 tableCarrera.column(7).search('MEDIO').draw();
            } else if(filtro === 'en-tiempo') {
                 tableCarrera.column(7).search('EN TIEMPO').draw();
            }
        });

        window.mostrarTodosCarrera = function() {
            $('input[name="filtro-estado-carrera"]').prop('checked', false);
            $('.btn-group label.btn').removeClass('active');
            tableCarrera.search('').columns().search('').draw();
        };

        window.limpiarTodosFiltrosCarrera = mostrarTodosCarrera;

        window.resetearOrdenamientoCarrera = function() {
            tableCarrera.order([8, 'asc']).draw();
        };

        if (parametrosCarrera.totalRegistros > 0) {
            animarEstadisticasCarrera();
        }

        console.log('Vista de carrera lista con DataTables');
    });

    function actualizarEstadisticasDT(api) {
        var filasVisibles = api.rows({ search: 'applied' }).nodes();
        var totalVisible = filasVisibles.length;

        if (totalVisible === 0) {
            $('#stat-alumnos-carrera, #stat-materias-carrera, #stat-intentos-carrera, #stat-fuera-tiempo-carrera, #stat-criticos-carrera').text('0');
            $('#count-fuera-tiempo-carrera, #count-criticos-carrera, #count-medios-carrera, #count-en-tiempo-carrera, #count-unicos-carrera').text('0');
            $('#numero-registros-carrera, #footer-registros-carrera, #footer-alumnos-carrera').text('0');
            $('#badge-tabla-carrera').text('0 materias');
            return;
        }

        var alumnosUnicos = new Set();
        var fueraTiempo = 0, criticos = 0, medios = 0, enTiempo = 0;
        var totalIntentos = 0;

        $(filasVisibles).each(function() {
            var $fila = $(this);
            alumnosUnicos.add($fila.data('matricula'));

            var estadoTiempo = ($fila.data('estado-tiempo') || '').toString().toLowerCase();
            if (estadoTiempo === 'fuera de tiempo') fueraTiempo++;
            else if (estadoTiempo === 'crítico') criticos++;
            else if (estadoTiempo === 'medio') medios++;
            else enTiempo++;

            totalIntentos += parseInt($fila.data('intentos')) || 0;
        });

        var promedioIntentos = totalVisible > 0 ? (totalIntentos / totalVisible).toFixed(1) : '0.0';

        $('#stat-alumnos-carrera').text(alumnosUnicos.size);
        $('#stat-materias-carrera').text(totalVisible);
        $('#stat-intentos-carrera').text(promedioIntentos);
        $('#stat-fuera-tiempo-carrera').text(fueraTiempo);
        $('#stat-criticos-carrera').text(criticos);

        $('#count-fuera-tiempo-carrera').text(fueraTiempo);
        $('#count-criticos-carrera').text(criticos);
        $('#count-medios-carrera').text(medios);
        $('#count-en-tiempo-carrera').text(enTiempo);
        $('#count-unicos-carrera').text(alumnosUnicos.size);

        $('#badge-tabla-carrera').text(totalVisible + ' materias');
        $('#numero-registros-carrera').text(totalVisible);

        $('#footer-registros-carrera').text(totalVisible);
        $('#footer-alumnos-carrera').text(alumnosUnicos.size);
    }

    function cambiarCarrera(idCarrera) {
        console.log('=== CAMBIANDO CARRERA ===');
        console.log('ID recibido:', idCarrera);

        // Si es nulo o indefinido lo ignoramos
        if (idCarrera === undefined || idCarrera === null) {
            console.log('ID inválido, manteniendo carrera actual');
            return;
        }

        // Permitimos el vacío '' explícitamente porque es "Selecciona una carrera..." (Global)
        var carreraAEnviar = idCarrera === '' ? '0' : idCarrera;

        if (parseInt(carreraAEnviar) === parametrosCarrera.idCarrera) {
            console.log('Ya está viendo esta carrera');
            mostrarNotificacionCarrera('Ya estás viendo esta carrera', 'info');
            return;
        }

        console.log('Cambiando a carrera:', carreraAEnviar);

        $('.career-dropdown').prop('disabled', true);
        $('#modalCargaCarrera').modal({
            backdrop: 'static',
            keyboard: false
        });
        var nuevaUrl = parametrosCarrera.urlBase + '?idCarrera=' + encodeURIComponent(carreraAEnviar);

        setTimeout(function () {
            window.location.href = nuevaUrl;
        }, 800);
    }

    function aplicarFiltros() {
        console.log('Aplicando filtros adicionales...');

        // ✅ CORREGIDO: Coordinadores siempre usan su carrera del servidor
        var esCoordinador = @Html.Raw(esCoordinador.ToString().ToLower());
        var idCarrera;

        if (esCoordinador) {
            // Coordinador: SIEMPRE usar la carrera asignada por el servidor
            idCarrera = parametrosCarrera.idCarrera;
        } else {
            // Master: tomar del dropdown (respeta el 0 para vista global)
            var idCarreraDropdown = $('.career-dropdown').val();
            idCarrera = idCarreraDropdown;

            if (idCarrera === undefined || idCarrera === null) {
                 idCarrera = parametrosCarrera.idCarrera;
            }
            if (idCarrera === '') {
                 idCarrera = '0'; // Vacío significa seleccionar todos (solo Master)
            }
        }

        var idEspecialidad = $('#selectEspecialidad').val();
        var idGrado = $('#selectGrado').val();
        var incluirBajas = $('#checkIncluirBajas').is(':checked');
        var soloExtraordinarios = $('#checkSoloExtraordinarios').is(':checked');

        var url = parametrosCarrera.urlBase + '?idCarrera=' + idCarrera;
        if (idEspecialidad && idEspecialidad !== '') {
            url += '&idEspecialidad=' + idEspecialidad;
        }

        if (idGrado && idGrado !== '') {
            url += '&idGrado=' + idGrado;
        }

        if (parametrosCarrera.soloCriticos) {
            url += '&soloCriticos=true';
        }

        if (incluirBajas) {
            url += '&incluirBajas=true';
        }

        if (soloExtraordinarios) {
            url += '&soloExtraordinarios=true';
        }

        window.location.href = url;
    }

    function imprimirTablaCarrera() {
        console.log('Imprimiendo tabla de carrera');
        var titulo = '@ViewBag.NombreCarrera - Arrastre por Carrera';
        var contenidoTabla = document.querySelector('.tabla-carrera-principal table');
        if (!contenidoTabla) {
            mostrarNotificacionCarrera('No hay tabla disponible para imprimir', 'warning');
            return;
        }

        var ventanaImpresion = window.open('', '_blank', 'width=1400,height=900,scrollbars=yes');
        if (!ventanaImpresion) {
            mostrarNotificacionCarrera('Error: Las ventanas emergentes están bloqueadas', 'danger');
            return;
        }

        var fechaActual = new Date();
        var fechaFormateada = fechaActual.toLocaleDateString('es-ES');
        var horaFormateada = fechaActual.toLocaleTimeString('es-ES');
        var filasVisibles = $('.fila-carrera-filtrable:visible').length;
        var busquedaActiva = $('#busquedaGeneralCarrera').val().trim();
        var filtroActivo = window.filtroCarreraActivo;

        var infoFiltros = '';
        if (busquedaActiva) {
            infoFiltros += '<br><strong>Búsqueda aplicada:</strong> "' + busquedaActiva + '"';
        }
        if (filtroActivo) {
            infoFiltros += '<br><strong>Filtro activo:</strong> ' + filtroActivo;
        }

        ventanaImpresion.document.write(
            '<!DOCTYPE html>' +
            '<html lang="es">' +
            '<head>' +
                '<title>Consulta de Arrastre - ' + titulo + '</title>' +
                '<meta charset="utf-8">' +
                '<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">' +
                '<style>' +

                    'body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; font-size: 11px; margin: 15px; line-height: 1.3; }' +
                    '.page-header { color: #2c3e50; border-bottom: 4px solid #1abc9c; padding-bottom: 20px; margin-bottom: 35px; }' +
                    '.page-header h2 { margin-top: 0; color: #2c3e50; font-size: 24px; }' +
                    '.page-header ' +
                    'h4 { color: #1abc9c; font-size: 16px; }' +
                    '.table { font-size: 10px; border-collapse: collapse; width: 100%; }' +
                    '.table thead th { background-color: #1abc9c !important; color: white !important; -webkit-print-color-adjust: exact;' +
                    'text-align: center; padding: 8px 4px; font-size: 9px; }' +
                    '.fila-fuera-de-tiempo { background-color: rgba(231, 76, 60, 0.15) !important;' +
                    '-webkit-print-color-adjust: exact; }' +
                    '.fila-crítico { background-color: rgba(243, 156, 18, 0.15) !important;' +
                    '-webkit-print-color-adjust: exact; }' +
                    '.fila-medio { background-color: rgba(241, 196, 15, 0.15) !important;' +
                    '-webkit-print-color-adjust: exact; }' +
                    '.fila-en-tiempo { background-color: rgba(39, 174, 96, 0.15) !important;' +
                    '-webkit-print-color-adjust: exact; }' +
                    '.controles-tabla, .btn-group-vertical { display: none;' +
                    '}' +
                    '.table td { padding: 4px 3px;' +
                    'border: 1px solid #ddd; font-size: 9px; }' +
                    '.text-center { text-align: center;' +
                    '}' +
                    '.texto-destacado-carrera { background-color: yellow !important;' +
                    '-webkit-print-color-adjust: exact; }' +
                    '@@media print { body { margin: 8px;' +
                    '} .table { font-size: 8px; } .no-print { display: none;' +
                    '} }' +
                    '.footer { margin-top: 25px;' +
                    'text-align: center; color: #7f8c8d; font-size: 9px; border-top: 1px solid #ddd; padding-top: 10px;' +
                    '}' +
                '</style>' +
            '</head>' +
            '<body>' +
                '<div class="page-header">' +
                    '<h2>Consulta de Arrastre por Carrera</h2>' +
                    '<h4>' + titulo + '</h4>' +

                    '<div style="margin-top: 15px;">' +
                        '<strong>Generado:</strong> ' + fechaFormateada + ' a las ' + horaFormateada + '<br>' +
                        '<strong>Registros mostrados:</strong> ' + filasVisibles + ' de ' + parametrosCarrera.totalRegistros + ' total<br>' +
                        '<strong>Alumnos únicos visibles:</strong> ' +
                        ($('#stat-alumnos-carrera').text() || 'N/A') +
                        infoFiltros +
                    '</div>' +
                '</div>' +
                '<div style="overflow-x: auto;">' +
                    contenidoTabla.outerHTML +
                '</div>' +

                '<div class="footer">' +
                    '<strong>Sistema de Control Académico</strong> - Consulta por Carrera<br>' +
                    'Este reporte contiene información confidencial del sistema académico' +
                '</div>' +
            '</body>' +
            '</html>'
        );
        ventanaImpresion.document.close();

        setTimeout(function() {
            ventanaImpresion.focus();
            ventanaImpresion.print();
        }, 1500);
        mostrarNotificacionCarrera('Ventana de impresión abierta exitosamente', 'info');
    }

    function mostrarNotificacionCarrera(mensaje, tipo, duracion) {
        var config = {
            'success': { icono: 'fa-check-circle', color: '#27ae60' },
            'info': { icono: 'fa-info-circle', color: '#3498db' },
            'warning': { icono: 'fa-exclamation-triangle', color: '#f39c12' },
            'danger': { icono: 'fa-exclamation-circle', color: '#e74c3c' }
        };
        var tipoConfig = config[tipo] || config['info'];
        duracion = duracion || 5000;
        var notificacion = $(
            '<div class="notification-carrera animate__animated animate__slideInRight"' +
                 'style="position: fixed; top: 20px; right: 20px; z-index: 10000;' +
                        'background: white; min-width: 350px; max-width: 450px;' +
                        'box-shadow: 0 10px 30px rgba(0,0,0,0.2); border-radius: 6px;' +

                        'border-left: 4px solid ' + tipoConfig.color + '; padding: 15px 20px;' +
                        'display: flex; align-items: flex-start; font-family: "Segoe UI", sans-serif;">' +
                '<i class="fa ' + tipoConfig.icono + '"' +
                   'style="font-size: 20px; color: ' + tipoConfig.color + '; margin-right: 12px; margin-top: 2px;"></i>' +

                '<div style="flex: 1;">' +
                    '<div style="font-weight: 600; color: #2c3e50; margin-bottom: 4px; font-size: 0.95em;">' +
                        'Carrera - ' + tipo.charAt(0).toUpperCase() + tipo.slice(1) +
                    '</div>' +
                    '<div style="color: #7f8c8d;' +
                    'font-size: 0.9em; line-height: 1.4;">' +
                        mensaje +
                    '</div>' +
                '</div>' +
                '<button type="button" class="close-carrera-notification"' +
                        'style="background: none;' +
                        'border: none; color: #bdc3c7;' +
                               'font-size: 18px;' +
                               'cursor: pointer; margin-left: 10px; padding: 0;">' +
                    '&times;' +
                '</button>' +
            '</div>'
        );

        notificacion.find('.close-carrera-notification').click(function() {
            cerrarNotificacionCarrera(notificacion);
        });

        $('body').append(notificacion);

        setTimeout(function() {
            if (notificacion.is(':visible')) {
                cerrarNotificacionCarrera(notificacion);
            }
        }, duracion);
    }

    function cerrarNotificacionCarrera($notificacion) {
        $notificacion.removeClass('animate__slideInRight')

                    .addClass('animate__slideOutRight');

        setTimeout(function() {
            $notificacion.remove();
        }, 300);
    }

    function animarEstadisticasCarrera() {
        $('.stat-number').each(function() {
            var $numero = $(this);
            var valorFinal = parseInt($numero.text()) || parseFloat($numero.text()) || 0;
            var contador = 0;
            var incremento = valorFinal / 40;

            var animacion = setInterval(function() {

                contador += incremento;
                if (contador >= valorFinal) {
                    contador = valorFinal;
                    clearInterval(animacion);
                }

                if (Number.isInteger(valorFinal)) {
                    $numero.text(Math.floor(contador));
                } else {
                    $numero.text(contador.toFixed(1));
                }
            }, 40);
        });
    }

    function limpiarTodosFiltrosCarrera() {
        console.log('Limpiando todos los filtros desde vista principal');

        $('#busquedaGeneralCarrera').val('');

        $('.fila-carrera-filtrable').removeClass('filtered-out').show();

        $('.texto-destacado-carrera').contents().unwrap();

        $('[data-filtro-carrera]').removeClass('active');

        $('#selectEspecialidad').val('');
        $('#selectGrado').val('');

        $('#indicadorBusquedaCarrera').hide();
        $('#resultadosBusquedaCarrera').hide();

        if (typeof window.busquedaCarreraActiva !== 'undefined') {
            window.busquedaCarreraActiva = '';
        }
        if (typeof window.filtroCarreraActivo !== 'undefined') {
            window.filtroCarreraActivo = null;
        }

        setTimeout(function () {
            actualizarEstadisticasDinamicas();
            actualizarIndicadorFiltroCarrera('todos', $('.fila-carrera-filtrable:visible').length);
        }, 100);
        mostrarNotificacionCarrera('Todos los filtros y búsquedas han sido eliminados', 'success');
    }

    $('#modalCargaCarrera').on('hidden.bs.modal', function() {
        $('.career-dropdown').prop('disabled', false);
        $('.loading-title').text('Cargando carrera...');
        $('.loading-description').text('Por favor espere mientras se cargan los datos de la carrera.');
    });
    console.log('Vista de Consulta de Arrastre por Carrera con búsqueda completa lista');
</script>