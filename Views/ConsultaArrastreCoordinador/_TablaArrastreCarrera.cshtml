@model IEnumerable<PlataformaWeb.Models.Materias.ArrastreCarreraDto>
@using PlataformaWeb.Models.Materias

@{
    var modeloSeguro = Model ?? new List<ArrastreCarreraDto>();

    var listaAlumnos = new List<ArrastreCarreraDto>();
    foreach (var item in modeloSeguro)
    {
        listaAlumnos.Add(item);
    }

    var hayDatos = listaAlumnos.Count > 0;

    var totalRegistros = listaAlumnos.Count;
    var totalAlumnosUnicos = 0;
    var totalIntentos = 0;
    var totalFueraDeTiempo = 0;
    var promedioIntentos = 0.0;

    // 1. CALCULO DE MATERIAS POR ALUMNO
    // Creamos un diccionario para contar las materias de cada alumno
    // (Asumimos que esta vista solo trae materias de arrastre)
    var conteoMateriasPorAlumno = new Dictionary<int, int>();
    foreach (var item in modeloSeguro)
    {
        if (conteoMateriasPorAlumno.ContainsKey(item.IdPersona))
        {
            conteoMateriasPorAlumno[item.IdPersona]++;
        }
        else
        {
            conteoMateriasPorAlumno.Add(item.IdPersona, 1);
        }
    }

    var alumnosVistos = new List<int>();
    var especialidadesVistas = new List<string>();

    foreach (var alumno in listaAlumnos)
    {
        var yaContado = false;
        foreach (var id in alumnosVistos)
        {
            if (id == alumno.IdPersona)
            {
                yaContado = true;
                break;
            }
        }
        if (!yaContado)
        {
            alumnosVistos.Add(alumno.IdPersona);
            totalAlumnosUnicos++;
        }

        var especialidadYaContada = false;
        foreach (var esp in especialidadesVistas)
        {
            if (esp == alumno.NombreEspecialidad)
            {
                especialidadYaContada = true;
                break;
            }
        }
        if (!especialidadYaContada && !string.IsNullOrEmpty(alumno.NombreEspecialidad))
        {
            especialidadesVistas.Add(alumno.NombreEspecialidad);
        }

        totalIntentos += alumno.IntentosExtraordinarios;
        if (alumno.DiasRestantes <= 0)
        {
            totalFueraDeTiempo++;
        }
    }

    if (totalRegistros > 0)
    {
        promedioIntentos = (double)totalIntentos / totalRegistros;
    }

    var totalEspecialidades = especialidadesVistas.Count;
}
<div class="sga-scope">

    @if (hayDatos)
    {
        <div class="row" style="margin-bottom: 15px;">
            <div class="col-md-12">
                <div class="controles-filtro-carrera pull-right">
                    <div class="btn-toolbar">
                        <div class="btn-group btn-group-sm" data-toggle="buttons">
                            <label class="btn btn-danger" data-filtro-carrera="fuera-tiempo" title="Fuera de tiempo (días restantes <= 0)">
                                <input type="radio" name="filtro-estado-carrera" value="fuera-tiempo">
                                <i class="glyphicon glyphicon-ban-circle"></i> Fuera de Tiempo
                            </label>
                            <label class="btn btn-warning" data-filtro-carrera="critico" title="Crítico (1-60 días restantes)">
                                <input type="radio" name="filtro-estado-carrera" value="critico">
                                <i class="glyphicon glyphicon-exclamation-sign"></i> Crítico
                            </label>
                            <label class="btn btn-warning-light" data-filtro-carrera="medio" title="Medio (61-180 días restantes)">
                                <input type="radio" name="filtro-estado-carrera" value="medio">
                                <i class="glyphicon glyphicon-time"></i> Medio
                            </label>
                            <label class="btn btn-success" data-filtro-carrera="en-tiempo" title="En Tiempo (más de 180 días)">
                                <input type="radio" name="filtro-estado-carrera" value="en-tiempo">
                                <i class="glyphicon glyphicon-ok-circle"></i> En Tiempo
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tabla-carrera-principal">
            <table class="table table-striped table-hover" style="width:100%" id="tablaArrastreCarreraId">
                <thead>
                    <tr class="active">
                        <th style="width:8%">Matricula</th>
                        <th style="width:16%">Nombre del Alumno</th>
                        <th style="width:18%">Especialidad</th>
                        <th style="width:8%">Grado y Grupo</th>
                        <th style="width:18%">Materia de Arrastre</th>
                        <th class="text-center" style="width:6%">Cuatri</th>
                        <th class="text-center" style="width:6%">Intentos</th>
                        <th class="text-center" style="width:8%">Estado</th>
                        <th class="text-center" style="width:7%">Dias Rest.</th>
                        <th class="text-center" style="width:5%">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-carrera-body-filtrable">
                    @foreach (var alumno in listaAlumnos)
                    {
                        var estadoTiempoClass = alumno.EstadoTiempo.ToLower().Replace(" ", "-");
                        var filaColorClass = "fila-" + estadoTiempoClass;

                        // 2. ASIGNACION DE CLASE DE BORDE
                        var bordeClass = "";
                        var conteo = 0;
                        if (conteoMateriasPorAlumno.TryGetValue(alumno.IdPersona, out conteo))
                        {
                            if (conteo >= 3)
                            {
                                bordeClass = "borde-rojo-carrera"; // 3+ materias
                            }
                            else if (conteo == 2)
                            {
                                bordeClass = "borde-naranja-carrera"; // 2 materias
                            }
                            else if (conteo == 1)
                            {
                                bordeClass = "borde-amarillo-carrera"; // 1 materia
                            }
                        }

                        // 3. APLICACION DE LA NUEVA CLASE EN LA FILA
                        <tr class="@filaColorClass fila-carrera-filtrable @bordeClass"
                            data-criticidad="@alumno.NivelCriticidad"
                            data-tipo="@(alumno.NivelCriticidad == 1 ? "criticos" : alumno.NivelCriticidad == 2 ? "medios" : "recientes")"
                            data-matricula="@(alumno.Matricula ?? "").ToLower()"
                            data-nombre="@(alumno.NombreAlumno ?? "").ToLower()"
                            data-especialidad="@(alumno.NombreEspecialidad ?? "").ToLower()"
                            data-grado-grupo="@(alumno.GradoGrupo ?? "").ToLower()"
                            data-materia="@(alumno.MateriaArrastre ?? "").ToLower()"
                            data-cuatrimestre="@alumno.CuatrimestreMateria"
                            data-cuatrimestre-texto="@(alumno.CuatrimestreTexto ?? "").ToLower()"
                            data-intentos="@alumno.IntentosExtraordinarios"
                            data-estado-tiempo="@alumno.EstadoTiempo"
                            data-dias-restantes="@alumno.DiasRestantes"
                            data-fuera-tiempo="@(alumno.DiasRestantes <= 0 ?
"true" : "false")"
                            data-materia-activa="@(alumno.MateriaEstaActiva.ToString().ToLower())"
                            data-contenido-busqueda="@((alumno.Matricula ?? "") + " " + (alumno.NombreAlumno ?? "") + " " + (alumno.NombreEspecialidad ?? "") + " " + (alumno.GradoGrupo ?? "") + " " + (alumno.MateriaArrastre ?? "") + " " + (alumno.CuatrimestreTexto ?? "")).ToLower()"
                            data-tutor="@(alumno.TutorAsignado ?? "").ToLower()"
                            data-observaciones="@(alumno.Observaciones ?? "").ToLower()">

                            <td data-label="Matrícula">
                                <strong class="matricula-highlight-carrera @(!alumno.EstadoAlumno ? "text-danger" : "")">@alumno.Matricula</strong>
                                @if (!alumno.EstadoAlumno)
                                {
                                    <br><small class="label label-danger"><i class="glyphicon glyphicon-ban-circle"></i> Baja</small>
                                }
                            </td>
                            <td data-label="Nombre">
                                <div class="alumno-info-carrera">

                                    <strong class="nombre-highlight-carrera">@alumno.NombreAlumno</strong>
                                    @if (!string.IsNullOrEmpty(alumno.TutorAsignado) && alumno.TutorAsignado != "Sin tutor")
                                    {

                                        <br><small class="text-info tutor-highlight-carrera">
                                            <i class="glyphicon glyphicon-user"></i> @alumno.TutorAsignado
                                        </small>

                                    }
                                </div>
                            </td>
                            <td data-label="Especialidad">
                                <div class="especialidad-info-carrera">
                                    <span class="especialidad-badge especialidad-highlight-carrera">
                                        <i class="glyphicon glyphicon-tag"></i>
                                        @(alumno.NombreEspecialidad ??
"Sin especialidad")
                                    </span>
                                    @if (!string.IsNullOrEmpty(alumno.NombreTurno))
                                    {

                                        <br><small class="text-muted turno-highlight-carrera">@alumno.NombreTurno</small>
                                    }
                                </div>

                            </td>
                            <td data-label="Grado-Grupo">
                                <div class="grado-grupo-info">

                                    <span class="grado-grupo-texto grado-grupo-highlight-carrera">@alumno.GradoGrupo</span>
                                    @if (alumno.Año > 0)
                                    {

                                        <br><small class="text-muted">@alumno.Año</small>
                                    }
                                </div>
                            </td>

                            <td data-label="Materia">
                                <div class="materia-info-carrera">
                                    <span class="materia-nombre-carrera materia-highlight-carrera">@alumno.MateriaArrastre</span>


                                    @if (!alumno.MateriaEstaActiva)
                                    {
                                        <br><small class="label label-warning">

                                            <i class="glyphicon glyphicon-eye-close"></i> Materia Desactivada
                                        </small>
                                    }


                                    @if (!string.IsNullOrEmpty(alumno.Observaciones))
                                    {

                                        <br><small class='text-info observaciones-carrera observaciones-highlight-carrera'>
                                            <i class='glyphicon glyphicon-comment'></i> @alumno.Observaciones
                                        </small>

                                    }
                                </div>
                            </td>
                            <td data-label="Cuatrimestre" class="text-center">

                                <span class="label label-cuatri-carrera-@alumno.CuatrimestreMateria cuatrimestre-highlight-carrera">
                                    @alumno.CuatrimestreTexto
                                </span>

                            </td>

                            <td data-label="Intentos" class="text-center">
                                @Html.Raw(alumno.IntentosExtraordinarios > 0 ?
    "<span class='badge badge-intentos-" + (alumno.IntentosExtraordinarios >= 3 ? "danger" : "warning") + "'>" + alumno.IntentosExtraordinarios + "</span>" :
                                    "<span class='text-muted'>-</span>")
                            </td>

                            <td data-label="Estado"
                                class="text-center">
                                <span class="label label-estado-@estadoTiempoClass">@alumno.EstadoTiempo</span>
                                @if (alumno.FechaInicioArrastre.HasValue)
                                {

                                    <br><small class='text-muted'>Inicio: @alumno.FechaInicioArrastre.Value.ToString("dd/MM/yyyy")</small>
                                }
                            </td>

                            <td data-label="Días" class="text-center">

                                @if (alumno.DiasRestantes > 0)
                                {
                                    <span class="badge badge-tiempo-carrera-@(alumno.DiasRestantes <= 60 ?
"danger" : alumno.DiasRestantes <= 180 ? "warning" : "info")">
                                        @alumno.DiasRestantes días
                                    </span>

                                    if (alumno.FechaLimiteArrastre.HasValue)
                                    {
                                        <br><small class='text-muted'>Límite: @alumno.FechaLimiteArrastre.Value.ToString("dd/MM/yyyy")</small>

                                    }
                                }
                                else
                                {

                                    <span class="label label-danger">Vencido</span>
                                    if (Math.Abs(alumno.DiasRestantes) > 0)
                                    {

                                        <br><small class='text-danger'>@Math.Abs(alumno.DiasRestantes) días atrás</small>
                                    }
                                }

                            </td>
                            <td data-label="Acciones" class="text-center">
                                <div class="btn-group-vertical btn-group-xs">

                                    <a href="@Url.Action("Index", "MateriasAlumno", new { id = alumno.IdPersona })"
                                       class="btn btn-primary btn-xs" title="Ver materias del alumno">
                                        <i class="glyphicon glyphicon-list-alt"></i>
                                    </a>
                                    <a href="@Url.Action("Index", "Individuals", new { id = alumno.IdPersona })"
                                       class="btn btn-info btn-xs" title="Seguimiento individual">
                                        <i class="glyphicon glyphicon-user"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-danger btn-xs"
                                            title="Eliminar este registro de materia"
                                            onclick="confirmarEliminarMateria(
                                                @alumno.IdMateria,
                                                @alumno.IdPersona,
                                                '@Html.Raw(alumno.NombreAlumno?.Replace("'", "\\'"))',
                                                '@Html.Raw(alumno.MateriaArrastre?.Replace("'", "\\'"))',
                                                '@alumno.CuatrimestreTexto',
                                                '@alumno.EstadoMateriaAlumno',
                                                '@(alumno.EstadoMateriaAlumno == "Extraordinario" || alumno.EstadoMateriaAlumno == "Reprobada" ? "true" : "false")')">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

                <tbody id="mensaje-sin-resultados-carrera" style="display: none;">

                    <tr>
                        <td colspan="10" class="sin-resultados-carrera">
                            <div class="mensaje-sin-resultados-container">
                                <div class="sin-resultados-icon">

                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <div class="sin-resultados-content">

                                    <h4 class="sin-resultados-title">Sin resultados encontrados</h4>
                                    <p class="sin-resultados-description" id="descripcion-sin-resultados">
                                        No se encontraron registros que coincidan con los criterios de búsqueda o filtros aplicados.
                                    </p>
                                    <div class="sin-resultados-suggestions">
                                        <p><strong>Sugerencias:</strong></p>

                                        <ul>
                                            <li>Verifique la ortografía de los términos de búsqueda</li>
                                            <li>Pruebe con palabras clave más generales</li>

                                            <li>Elimine algunos filtros para ampliar la búsqueda</li>
                                        </ul>

                                    </div>
                                    <div class="sin-resultados-actions">
                                        <button type="button" class="btn btn-primary btn-sm" onclick="limpiarTodosFiltrosCarrera()">

                                            <i class="glyphicon glyphicon-refresh"></i> Limpiar Filtros
                                        </button>

                                        <button type="button" class="btn btn-default btn-sm" onclick="mostrarTodosCarrera()">
                                            <i class="glyphicon glyphicon-list"></i> Mostrar Todos
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {

        <div class="alert alert-info alert-carrera-vacio text-center">
            <div class="empty-icon-carrera">
                <i class="glyphicon glyphicon-info-sign fa-3x"></i>
            </div>
            <h4>Sin datos de arrastre en esta carrera</h4>
            <p>No hay alumnos con materias de arrastre para mostrar en la carrera seleccionada.</p>
            <div class="empty-actions-carrera">
                <button type="button" class="btn btn-primary" onclick="cambiarCarrera('')">

                    <i class="glyphicon glyphicon-repeat"></i> Cambiar Carrera
                </button>
            </div>
        </div>
    }

    <!-- ===== MODAL ELIMINAR MATERIA (coordinador) ===== -->
    <div class="modal fade" id="modalEliminarMateriaCoord" tabindex="-1" role="dialog" aria-labelledby="modalEliminarMateriaCoordLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background:#e74c3c; color:white;">
                    <button type="button" class="close" data-dismiss="modal" style="color:white;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="modalEliminarMateriaCoordLabel">
                        <i class="glyphicon glyphicon-trash"></i> Eliminar registro de materia
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <strong><i class="glyphicon glyphicon-exclamation-sign"></i> Atención:</strong>
                        Esta acción es <strong>permanente e irreversible</strong>. Se eliminarán también
                        las calificaciones por unidad e historial de intentos asociados a este registro.
                    </div>
                    <table class="table table-condensed">
                        <tr><th style="width:35%">Alumno</th><td id="elim-coord-alumno"></td></tr>
                        <tr><th>Materia</th><td id="elim-coord-materia"></td></tr>
                        <tr><th>Cuatrimestre</th><td id="elim-coord-cuatri"></td></tr>
                        <tr><th>Estado</th><td id="elim-coord-estado"></td></tr>
                    </table>
                    <p class="text-center text-muted" style="font-size:12px;">
                        ¿Confirmas que deseas eliminar <strong>definitivamente</strong> este registro?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="glyphicon glyphicon-remove"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarEliminarCoord">
                        <i class="glyphicon glyphicon-trash"></i> Eliminar definitivamente
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- ===== FIN MODAL ELIMINAR ===== -->

    <div class="modal fade" id="modalBusquedaAvanzadaCarrera" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">

                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">
                        <i class="glyphicon glyphicon-search"></i> Búsqueda Avanzada por Carrera
                    </h4>

                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">

                                <label>Matrícula:</label>
                                <input type="text" class="form-control" id="busquedaMatricula" placeholder="Ej: 123456">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Nombre del Alumno:</label>
                                <input type="text" class="form-control" id="busquedaNombre" placeholder="Ej: Juan Pérez">

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-group">
                                <label>Especialidad:</label>
                                <input type="text" class="form-control" id="busquedaEspecialidad" placeholder="Ej: Informática">

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Grado y Grupo:</label>

                                <input type="text" class="form-control" id="busquedaGradoGrupo" placeholder="Ej: 1° - A">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Materia de Arrastre:</label>

                                <input type="text" class="form-control" id="busquedaMateria" placeholder="Ej: Matemáticas">
                            </div>
                        </div>
                        <div class="col-md-6">

                            <div class="form-group">
                                <label>Cuatrimestre:</label>
                                <select class="form-control" id="busquedaCuatrimestre">
                                    <option value="">
                                        Todos
                                        los cuatrimestres
                                    </option>
                                    <option value="1">1er Cuatrimestre</option>
                                    <option value="2">2do Cuatrimestre</option>

                                    <option value="3">3er Cuatrimestre</option>
                                    <option value="4">4to Cuatrimestre</option>
                                    <option value="5">5to Cuatrimestre</option>

                                    <option value="6">6to Cuatrimestre</option>
                                    <option value="7">7mo Cuatrimestre</option>
                                    <option value="8">8vo Cuatrimestre</option>

                                    <option value="9">9no Cuatrimestre</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning" onclick="limpiarBusquedaAvanzada()">
                        <i class="glyphicon glyphicon-refresh"></i> Limpiar
                    </button>

                    <button type="button" class="btn btn-primary" onclick="aplicarBusquedaAvanzada()">
                        <i class="glyphicon glyphicon-search"></i> Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --carrera-primary: #1abc9c;
        --carrera-secondary: #3498db;
        --carrera-success: #27ae60;
        --carrera-warning: #f39c12;
        --carrera-danger: #e74c3c;
        --carrera-info: #17a2b8;
        --carrera-amarillo: #f1c40f;
    }

    /* ===== COLORES DE FILA SEGÚN ESTADO DE TIEMPO (como grupo) ===== */
    .fila-fuera-de-tiempo {
        background-color: rgba(231, 76, 60, 0.08) !important;
        /* border-left: 4px solid #e74c3c !important; */ /* <- REMOVIDO */
    }

        .fila-fuera-de-tiempo:hover {
            background-color: rgba(231, 76, 60, 0.15) !important;
        }

    .fila-crítico {
        background-color: rgba(243, 156, 18, 0.08) !important;
        /* border-left: 4px solid #f39c12 !important; */ /* <- REMOVIDO */
    }

        .fila-crítico:hover {
            background-color: rgba(243, 156, 18, 0.15) !important;
        }

    .fila-medio {
        background-color: rgba(241, 196, 15, 0.05) !important;
        /* border-left: 4px solid #f1c40f !important; */ /* <- REMOVIDO */
    }

        .fila-medio:hover {
            background-color: rgba(241, 196, 15, 0.12) !important;
        }

    .fila-en-tiempo {
        background-color: rgba(39, 174, 96, 0.05) !important;
        /* border-left: 4px solid #27ae60 !important; */ /* <- REMOVIDO */
    }

        .fila-en-tiempo:hover {
            background-color: rgba(39, 174, 96, 0.12) !important;
        }

    /* 4. NUEVOS ESTILOS DE BORDE POR CONTEO DE MATERIAS */
    .borde-rojo-carrera {
        border-left: 5px solid var(--carrera-danger) !important; /* 3+ materias */
    }

    .borde-naranja-carrera {
        border-left: 5px solid var(--carrera-warning) !important; /* 2 materias */
    }

    .borde-amarillo-carrera {
        border-left: 5px solid var(--carrera-amarillo) !important; /* 1 materia */
    }


    /* ===== LABELS DE ESTADO (colores actualizados) ===== */
    .label-estado-fuera-de-tiempo {
        background-color: #e74c3c !important;
        color: white !important;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 3px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .label-estado-crítico {
        background-color: #f39c12 !important;
        color: white !important;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 3px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .label-estado-medio {
        background-color: #f1c40f !important;
        color: #333 !important;
        font-weight: 600;
        padding: 4px 8px;
