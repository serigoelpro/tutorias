<script>
    // ======================================================
    // ELIMINAR MATERIA — vista coordinador/master
    // ======================================================
    var _elimCoordIdMateria = null;
    var _elimCoordIdPersona = null;

    function confirmarEliminarMateria(idMateria, idPersona, alumno, materia, cuatri, estado, tieneInfo) {
        _elimCoordIdMateria = idMateria;
        _elimCoordIdPersona = idPersona;

        $('#elim-coord-alumno').text(alumno);
        $('#elim-coord-materia').text(materia);
        $('#elim-coord-cuatri').text(cuatri + '° Cuatrimestre');
        $('#elim-coord-estado').text(estado);

        $('#modalEliminarMateriaCoord').modal('show');
    }

    $('#btnConfirmarEliminarCoord').on('click', function () {
        var $btn = $(this);
        $btn.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh"></span> Eliminando...');

        $.ajax({
            url: '@Url.Action("EliminarMateriaAlumno", "MateriasAlumno")',
            type: 'POST',
            data: {
                idMateria: _elimCoordIdMateria,
                idPersona: _elimCoordIdPersona
            },
            success: function (result) {
                $('#modalEliminarMateriaCoord').modal('hide');
                if (result.success) {
                    setTimeout(function () { location.reload(); }, 800);
                } else {
                    alert('Error: ' + result.message);
                    $btn.prop('disabled', false).html('<i class="glyphicon glyphicon-trash"></i> Eliminar definitivamente');
                }
            },
            error: function () {
                $('#modalEliminarMateriaCoord').modal('hide');
                alert('Error de conexión al intentar eliminar.');
                $btn.prop('disabled', false).html('<i class="glyphicon glyphicon-trash"></i> Eliminar definitivamente');
            }
        });
    });
</script>

