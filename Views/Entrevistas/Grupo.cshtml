@{
    var jsPath = "~/ViewScripts/Entrevistas/MainGrupos.js";
    var stamp = System.IO.File.GetLastWriteTimeUtc(Server.MapPath(jsPath)).Ticks;
}
<script src="@Url.Content(jsPath)?v=@stamp"></script>

<script>
    var esDirector = (function () { var el = document.getElementById('esDirector'); return !!(el && el.dataset && el.dataset.esdirector === '1'); })();

    $('.notification-bell').click(function (e) {
        e.stopPropagation();
        $('.notification-dropdown').toggleClass('active');
        loadNotifications();
    });

    $(document).click(function () {
        $('.notification-dropdown').removeClass('active');
    });

    function loadNotifications() {
        $.get('/Asesor/GetUnreadNotifications', function (data) {
            const notificationList = $('.notification-list');
            notificationList.empty();

            if (data.length === 0) {
                notificationList.append('<div class="notification-empty">No hay notificaciones nuevas</div>');
                return;
            }

            data.forEach(function (notification) {
                const fecha = new Date(notification.FechaEnvio);
                const hora = fecha.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const fechaStr = fecha.toLocaleDateString() + ' ' + hora;

                var accionesNotif = esDirector ? '' : `<button class="notification-btn btn-mark-read" onclick="markAsRead(${notification.IdNotificacion})">
                            <i class="fas fa-check"></i> Marcar como leída
                        </button>
                        <button class="notification-btn btn-delete" onclick="deleteNotification(${notification.IdNotificacion})">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>`;

                const item = `
            <li class="notification-item" data-id="${notification.IdNotificacion}">
                <img src="/Asesor/ObtenerFoto?id=${notification.IdEstudiante}"
                     alt="${notification.NombreEstudiante}"
                     class="notification-avatar"
                     onerror="this.src='/css/estudiantes/default.png'">
                <div class="notification-content">
                    <div class="notification-title">
                        <i class="fas fa-exclamation-circle"></i> Solicitud de canalización
                    </div>
                    <div class="notification-message">
                        <strong>${notification.NombreEstudiante}</strong>: ${notification.Mensaje}
                    </div>
                    <span class="notification-time">${fechaStr}</span>
                    <div class="notification-actions">
                        ${accionesNotif}
                    </div>
                </div>
            </li>
          `;
                notificationList.append(item);
            });
        }).fail(function (xhr, status, error) {
            console.error('Error loading notifications:', status, error, xhr.responseText);
            $('.notification-list').empty().append('<div class="notification-empty">Error al cargar notificaciones</div>');
        });
    }

    function updateNotificationCount() {
        $.get('/Asesor/GetUnreadNotificationCount')
            .done(function (count) {
                const badge = $('.notification-badge');
                if (count > 0) {
                    badge.text(count).show();
                } else {
                    badge.hide();
                }
            })
            .fail(function (xhr, status, error) {
                console.error('Error in updateNotificationCount:', status, error, xhr.responseText);
            });
    }

    updateNotificationCount();
    setInterval(updateNotificationCount, 30000);

    function markAsRead(id) {
        $.post('/Asesor/MarkNotificationAsRead', { id: id }, function () {
            $(`.notification-item[data-id="${id}"]`).remove();
            updateNotificationCount();
            if ($('.notification-list').children().length === 0) {
                $('.notification-list').append('<div class="notification-empty">No hay notificaciones nuevas</div>');
            }
        }).fail(function (xhr, status, error) {
            console.error('Error marking notification as read:', status, error, xhr.responseText);
        });
    }

    function deleteNotification(id) {
        $.post('/Asesor/DeleteNotification', { id: id }, function () {
            $(`.notification-item[data-id="${id}"]`).remove();
            updateNotificationCount();
            if ($('.notification-list').children().length === 0) {
                $('.notification-list').append('<div class="notification-empty">No hay notificaciones nuevas</div>');
            }
        }).fail(function (xhr, status, error) {
            console.error('Error deleting notification:', status, error, xhr.responseText);
        });
    }
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
    // 0 = Cards (cuadrícula), 1 = Tabla
    function setToggleIcon() {
        const vt = Number(sessionStorage.getItem('viewTypeData') ?? 0);
        const icon = document.getElementById('iconToggleView');
        const btn = document.getElementById('btnToggleView');
        if (!icon || !btn) return;

        // Ícono según LA VISTA ACTUAL
        // cuadrícula -> glyphicon-th | tabla -> glyphicon-th-list
        icon.className = 'glyphicon ' + (vt === 1 ? 'glyphicon-th-list' : 'glyphicon-th');
        btn.title = vt === 1 ? 'Vista: Tabla' : 'Vista: Cuadrícula';
    }

    async function toggleViewAndIcon() {
        // Cambia la vista (tu función existente)
        await switchViewToTable();
        // Actualiza el ícono según la nueva vista
        setToggleIcon();
    }

    // Click del botón
    document.getElementById('btnToggleView').addEventListener('click', toggleViewAndIcon);

    // Poner el ícono correcto al cargar la página (según lo que haya en sessionStorage)
    document.addEventListener('DOMContentLoaded', setToggleIcon);

    // Cuando generas un enlace para ver detalles de un alumno
    function verDetallesAlumno(idPersona) {
        // Generar token en el servidor
        $.ajax({
            url: '@Url.Action("GenerarTokenAcceso", "Entrevistas")',
            type: 'POST',
            data: { idPersona: idPersona },
            success: function(response) {
                if (response.success) {
                    window.location.href = '@Url.Action("Detalles", "Entrevistas")' +
                        '?idPersona=' + idPersona + '&token=' + response.token;
                }
            }
        });
    }

    // Mostrar botón de exportación cuando hay grupo seleccionado (solo para nivel 3 y 4)
    (function(){
        var select = document.getElementById('groupSelect');
        var btn = document.getElementById('btnExportGrupoExcel');
        if (!btn) return; // Si no existe el botón (usuario nivel 1 o 2), salir
        function updateExportBtn(){
            var val = select && select.value && !isNaN(parseInt(select.value)) ? parseInt(select.value) : 0;
            if (val > 0 || val === -1) {
// 1. Mostramos el botón
                btn.style.display = 'inline-block';

                // 2. CORRECCIÓN: Usamos onclick para redireccionar
                // (Los botones no tienen href, así que hacemos esto:)
                var urlDescarga = '@Url.Action("ExportarGrupoDetallesExcel","Entrevistas")' + '?idGrupo=' + val;

                btn.onclick = function() {
                    window.location.href = urlDescarga;
                };
            } else {
                btn.style.display = 'none';
                btn.removeAttribute('href');
            }
        }
        if (select) {
            select.addEventListener('change', updateExportBtn);
            setTimeout(updateExportBtn, 0);
        }
        // tooltip
        if (window.jQuery && $('#btnExportGrupoExcel').tooltip) {
            $('#btnExportGrupoExcel').tooltip();
        }
    })();

    // Lógica para abrir/cerrar el Menú 1 (Gestión)
    function toggleMenuGestion(e) {
        e.stopPropagation(); // Evita que se cierre inmediatamente
        var menuGestion = document.getElementById('menu-gestion');
        var menuReportes = document.getElementById('menu-reportes');

        // Cierra el otro menú si está abierto
        if (menuReportes) menuReportes.style.display = 'none';

        // Toggle del actual
        if (menuGestion.style.display === 'none' || menuGestion.style.display === '') {
            menuGestion.style.display = 'block';
        } else {
            menuGestion.style.display = 'none';
        }
    }

    // Lógica para abrir/cerrar el Menú 2 (Reportes)
    function toggleMenuReportes(e) {
        e.stopPropagation();
        var menuGestion = document.getElementById('menu-gestion');
        var menuReportes = document.getElementById('menu-reportes');

        // Cierra el otro menú si está abierto
        if (menuGestion) menuGestion.style.display = 'none';

        // Toggle del actual
        if (menuReportes.style.display === 'none' || menuReportes.style.display === '') {
            menuReportes.style.display = 'block';
        } else {
            menuReportes.style.display = 'none';
        }
    }

    // Cerrar ambos menús al hacer clic fuera
    $(document).click(function (event) {
        // Si el clic NO fue dentro de los menús, ciérralos
        if (!$(event.target).closest('.menu-acciones-standalone').length &&
            !$(event.target).closest('.btn-menu-trigger-green').length) {
            $('.menu-acciones-standalone').hide();
        }
    });

    // Función para abrir el Modal de Ayuda Bonito
    function mostrarAyudaRapida() {
        $('#modalAyudaRapida').modal('show');
    }

</script>