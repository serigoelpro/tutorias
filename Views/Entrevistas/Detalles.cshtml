@model Plataforma_Web.Models.EntrevistaInicial
@using Plataforma_Web.Models.PrimeraEntrevista
@{
    // Obtener datos personales desde el ViewBag
    DatosPersonales datos = ViewBag.datos as DatosPersonales;

    // Variable segura para el ID de persona
    int idPersonaActual = (datos != null) ? datos.IdPersona : 0;

    // Título de la vista
    ViewBag.Title = "Ver Detalles";

    // Token seguro
    string token = ViewBag.Token as string ?? "";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .navegacion-entrevistas button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .navegacion-entrevistas button:not(:disabled):hover {
        transform: scale(1.05);
        transition: transform 0.2s;
    }

    .btn-navegando {
        pointer-events: none;
        opacity: 0.6;
    }

    #btnAnterior, #btnSiguiente,
    a.btn-primary[href*="Grupo"] {
        background-color: #09a787 !important;
        border-color: #09a787 !important;
        color: white !important;
    }

        #btnAnterior:hover:not(:disabled),
        #btnSiguiente:hover:not(:disabled),
        a.btn-primary[href*="Grupo"]:hover {
            background-color: #078c71 !important;
            border-color: #078c71 !important;
        }

        #btnAnterior:focus, #btnSiguiente:focus,
        a.btn-primary[href*="Grupo"]:focus {
            background-color: #078c71 !important;
            border-color: #078c71 !important;
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(9, 167, 135, 0.5) !important;
        }
</style>

@* MENSAJE DE ERROR SI NO HAY TOKEN VÁLIDO *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible" role="alert" style="margin: 20px;">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <strong>¡Error!</strong> @TempData["Error"]
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.AntiForgeryToken()
    @Html.Hidden("token", token)

    <div id="studentId" data-id="@(Model?.IdPersona ?? 0)"></div>
    <div id="entrevistaId" data-id="@(Model?.IdEntrevistaInicial ?? 0)"></div>

    <h2>Ver Detalles</h2>
    <br />
