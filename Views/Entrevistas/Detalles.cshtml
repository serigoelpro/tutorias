<script src="~/ViewScripts/Entrevista/EntrevistaDetalles.js?v=3"></script>
<script>
    $(document).ready(function () {
        // USANDO LA VARIABLE DE RAZOR SEGURA
        var currentIdPersona = @idPersonaActual;

        // 1. Verificar si tenemos un ID de persona válido
        if (currentIdPersona <= 0) {
            console.error('El IdPersona es inválido (datos fue null en ViewBag).');
            $('#posicionActual').text('ID Inválido');
            $('#btnAnterior, #btnSiguiente').prop('disabled', true);
            return;
        }

        try {
            // 2. LLAMADA AJAX para obtener los IDs de navegación
            $.ajax({
                type: 'POST',
                url: '@Url.Action("ObtenerNavegacionEntrevistas", "Entrevistas")',
                data: { idPersona: currentIdPersona },
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        // Actualizar la posición
                        $('#posicionActual').text(response.posicion + ' de ' + response.total);

                        // --- Botón ANTERIOR ---
                        if (response.idAnterior) {
                            $('#btnAnterior')
                                .data('id', response.idAnterior)
                                .data('token', response.tokenAnterior)
                                .prop('disabled', false);
                        } else {
                            $('#btnAnterior').prop('disabled', true);
                        }

                        // --- Botón SIGUIENTE ---
                        if (response.idSiguiente) {
                            $('#btnSiguiente')
                                .data('id', response.idSiguiente)
                                .data('token', response.tokenSiguiente)
                                .prop('disabled', false);
                        } else {
                            $('#btnSiguiente').prop('disabled', true);
                        }
                    } else {
                        console.error('Error lógico al obtener navegación:', response.message);
                        $('#posicionActual').text('Error');
                        $('#btnAnterior, #btnSiguiente').prop('disabled', true);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error de red/servidor en la llamada AJAX:', error);
                    $('#posicionActual').text('Error AJAX');
                    $('#btnAnterior, #btnSiguiente').prop('disabled', true);
                }
            });

            // 3. FUNCIÓN DE NAVEGACIÓN
            function navegar(idDestino, token) {
                if (idDestino && token) {
                    $('.navegacion-entrevistas button').addClass('btn-navegando');

                    var url = '@Url.Action("Detalles", "Entrevistas")' +
                        '?idPersona=' + idDestino +
                        '&token=' + encodeURIComponent(token);

                    window.location.href = url;
                }
            }

            // 4. EVENTOS CLICK de los botones
            $('#btnAnterior').click(function (e) {
                e.preventDefault();
                var idAnterior = $(this).data('id');
                var tokenAnterior = $(this).data('token');
                navegar(idAnterior, tokenAnterior);
            });

            $('#btnSiguiente').click(function (e) {
                e.preventDefault();
                var idSiguiente = $(this).data('id');
                var tokenSiguiente = $(this).data('token');
                navegar(idSiguiente, tokenSiguiente);
            });

        } catch (ex) {
            console.error('Error en inicialización de navegación:', ex);
            $('#posicionActual').text('Error JS');
            $('#btnAnterior, #btnSiguiente').prop('disabled', true);
        }
    });
</script>