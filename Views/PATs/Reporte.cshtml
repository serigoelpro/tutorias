@Styles.Render("~/ViewsStyles/PAT/ListPAT.css")
@{
    ViewBag.Title = "Reporte Entrevista";
}

<h2>Reporte</h2>

<style>
    iframe {
        width: 100%;
        border: 1px solid #969696;
    }

    

    /* --- AGREGAR ESTO PARA MAYÚSCULAS EN LA VISTA --- */
    body, h2, h4, .page-header, .alert, .btn, a {
        text-transform: uppercase !important;
    }
</style>

<div class="page-header">
    <h4>Reporte de Plan de Acción Tutorial     | F-PSE-DICA-14/R01</h4>
</div>


<hr />
@using ReportViewerForMvc;

@if (ViewBag.ReportViewer != null)
{
    <div class="alert alert-info" role="alert">
        Por favor espere a que cargue completamente el reporte.
        Para imprimir haga clic en el icono de la impresora en el panel del reporte.
    </div>
    <div class="row">
        <div class="col-md-1"> </div>
        <div class="col-md-10">
            @Html.ReportViewer(ViewBag.ReportViewer as Microsoft.Reporting.WebForms.ReportViewer)
        </div>
        <div class="col-md-1"> </div>
    </div>
}

<a class="btn btn-primary" href="@Url.Action("Index")"
   role="button">
    <span class="glyphicon glyphicon-arrow-left"></span>
    Regresar

</a>

