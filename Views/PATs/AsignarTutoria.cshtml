@model PlataformaWeb.Models.ClasesPAT.ActividadSemanalAux
@{
   ViewBag.Title = "Asignar";
}

<h2>Crear</h2>

<script src="~/Script/Preguntas.js"></script>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()


<div class="form-horizontal">
    <h4>Agregar actividad</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group col-md-12">
        @Html.LabelFor(model => model.IdSemana, htmlAttributes: new { @class = "control-label" })
        <div class="">
            @Html.DropDownList("IdSemana", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.IdSemana, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group col-md-12">

        <div class="">
            <h3>Tutoría Grupal</h3>
        </div>
    </div>
    <div class="form-group col-md-12">
        @Html.LabelFor(model => model.Actividad1, htmlAttributes: new { @class = "control-label" })
        <div class="">
            @Html.TextAreaFor(m => m.Actividad1, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Actividad1, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group col-md-12">

        <div class="">
            <h3>Tutoría Individual</h3>
        </div>
    </div>
    <div class="form-group col-md-12">
        @Html.LabelFor(model => model.Actividad2, htmlAttributes: new { @class = "control-label" })
        <div class="">
            @Html.TextAreaFor(m => m.Actividad2, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Actividad2, "", new { @class = "text-danger" })
        </div>
    </div>



    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-default">Crear</button>
            @*<input type="submit" value="Crear" class="btn btn-default" />*@
        </div>
    </div>
</div>
}

    <div>
        <a class="btn btn-primary" href="@Url.Action("Details",new {id=ViewBag.id })"
           role="button">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Regresar

        </a>
    </div>

	
<script>
    // Prevent double submits
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', (e) => {
            // Prevent if already submitting
            if (form.classList.contains('is-submitting')) {
                e.preventDefault();
            }

            // Add class to hook our visual indicator on
            form.classList.add('is-submitting');
        });
    });
</script>
