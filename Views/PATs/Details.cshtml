        // FUNCIONES DE GUARDADO
        // ==========================================

            function guardarActividades() {
                var actividades = [];
                var hayErrores = false;

                $('[data-actividad-id]').each(function () {
                    var actividadId = $(this).data('actividad-id');
                    var $actividadInput = $(this).find('.actividad-input');

                    if ($actividadInput.length === 0) {

                        return true;
                    }

                    var actividad = $actividadInput.val();
                    if (!actividad || actividad.trim() === '') {
                        mostrarMensaje('Todas las actividades deben tener contenido',
                            'error');
                        hayErrores = true;
                        return false;
                    }

                    actividades.push({

                        IdActividad: actividadId,
                        Actividad: actividad.trim()
                    });
                });
                if (hayErrores) return;
                if (actividades.length === 0) {
                    mostrarMensaje('No se encontraron actividades para actualizar', 'error');
                    return;
                }

                // Preparar datos para envío
                var dataToSend = {};
                dataToSend['__RequestVerificationToken'] = $('input[name="__RequestVerificationToken"]').val();

                for (var i = 0; i < actividades.length; i++) {
                    dataToSend['actividades[' + i + '].IdActividad'] = actividades[i].IdActividad;
                    dataToSend['actividades[' + i + '].Actividad'] = actividades[i].Actividad;
                }

                $.ajax({
                    url: baseUrl + 'PATs/EditarVariasActividades',
                    type: 'POST',
                    data: dataToSend,

                    success: function (response) {
                        if (response.success) {
                            hayCambiosSinGuardar = false;
                            window.patTieneCambiosSinGuardar = false; // <-- AÑADIR ESTA LÍNEA
                            mostrarMensaje('Actividades actualizadas correctamente', 'success');
                    // ...
                            // Recargar la página después de 1 seg para ver los cambios
                            setTimeout(function () { location.reload(); }, 1000);
                            // --- FIN DE LA CORRECCIÓN ---

                        } else {
                            mostrarMensaje('Error al guardar: ' + (response.message || 'Error desconocido'), 'error');
                        }
                    },
                    error: function (xhr, status, error) {
                        mostrarMensaje('Error de conexión al guardar las actividades', 'error');
                    }
                });
            }

            function guardarComentarios() {
                var comentarios = [];
                var hayErrores = false;

                $('[data-actividad-id]').each(function () {
                    var actividadId = $(this).data('actividad-id');
                    var $radioRealizado = $(this).find('input[name="realizado_' + actividadId + '"]:checked');
                    var $comentarioInput = $(this).find('.comentarios-input');

                    if
                        ($radioRealizado.length === 0) {
                        mostrarMensaje('Debe seleccionar Sí/No para todas las actividades', 'error');
                        hayErrores = true;
                        return false;

                    }

                    var realizado = $radioRealizado.val();
                    var comentario = '';

                    if ($comentarioInput.length > 0) {
                        comentario
                            = $comentarioInput.val() || '';
                        comentario = comentario.trim();
                    }

                    comentarios.push({
                        IdActividad: actividadId,

                        RealizoActividad: realizado === 'true',
                        Comentarios: comentario
                    });
                });

                if (hayErrores) return;

                // Preparar datos para envío
                var dataToSend = {};
                dataToSend['__RequestVerificationToken'] = $('input[name="__RequestVerificationToken"]').val();

                for (var i = 0; i < comentarios.length; i++) {
                    dataToSend['comentarios[' + i + '].IdActividad'] = comentarios[i].IdActividad;
                    dataToSend['comentarios[' + i + '].RealizoActividad'] = comentarios[i].RealizoActividad;
                    dataToSend['comentarios[' + i + '].Comentarios'] = comentarios[i].Comentarios;
                }

                $.ajax({
                    url: baseUrl + 'PATs/EditarVariosComentarios',
                    type: 'POST',
                    data: dataToSend,

                    success: function (response) {
                        if (response.success) {
                            hayCambiosSinGuardar = false;
                            window.patTieneCambiosSinGuardar = false; // <-- AÑADIR ESTA LÍNEA
                            mostrarMensaje('Comentarios actualizados correctamente', 'success');
                    // ...

                            // --- INICIO DE LA CORRECCIÓN ---
                            // Recargar la página después de 1 seg para ver los cambios
                            setTimeout(function () { location.reload(); }, 1000);
                            // --- FIN DE LA CORRECCIÓN ---

                        } else {
                            mostrarMensaje('Error al guardar comentarios: ' + (response.message
                                || 'Error desconocido'), 'error');
                        }
                    },
                    error: function (xhr, status, error) {
                        mostrarMensaje('Error de conexión al guardar los comentarios', 'error');
                    }
                });
            }



