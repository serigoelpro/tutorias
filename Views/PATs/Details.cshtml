            // ✅ DEBE ESTAR FUERA DE $(document).ready()
            // ✅ DEBE ESTAR FUERA DE $(document).ready()
            function mostrarMensaje(mensaje, tipo) {
                // Remover mensajes previos
                $('.alert-message').remove();

                // CORRECCIÓN: Añadido 'info' y 'glyphicon-info-sign'
                var alertClass = tipo === 'success' ? 'status-active' : (tipo === 'info' ? 'status-info' : 'status-inactive');
                var iconClass = tipo === 'success' ? 'glyphicon-ok-circle' : (tipo === 'info' ? 'glyphicon-info-sign' : 'glyphicon-exclamation-sign');

                var alertHtml = '<div class="alert-message" style="position: fixed; top: 20px; right: 20px; z-index: 9999; padding: 16px 20px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); max-width: 400px; backdrop-filter: blur(10px);">';
                alertHtml += '<div style="display: flex; align-items: center; gap: 12px;">';
                alertHtml += '<i class="glyphicon ' + iconClass + '" style="font-size: 18px;"></i>';
                alertHtml += '<span style="font-weight: 500;">' + mensaje + '</span>';
                alertHtml += '</div>';
                alertHtml += '</div>';

                if (tipo === 'success') { // Verde
                    $(alertHtml).css({
                        'background': 'linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%)',
                        'color': '#155724',
                        'border': '1px solid #28a745'
                    }).appendTo('body');
                } else if (tipo === 'info') { // <-- NUEVO BLOQUE AZUL
                    $(alertHtml).css({
                        'background': 'linear-gradient(135deg, #d1ecf1 0%, #b6dff1 100%)',
                        'color': '#0c5460',
                        'border': '1px solid #17a2b8'
                    }).appendTo('body');
                } else { // Rojo
                    $(alertHtml).css({
                        'background': 'linear-gradient(135deg, #f8d7da 0%, #f1b6bb 100%)',
                        'color': '#721c24',
                        'border': '1px solid #dc3545'
                    }).appendTo('body');
                }

                setTimeout(function () {
                    $('.alert-message').fadeOut(300, function () {
                        $(this).remove();
                    });
                }, 3000);
            }

            function closeModal(modalId) {
                $('#' + modalId).fadeOut(300);

                // Limpiar campos al cerrar
                if (modalId === 'modal-agregar-semana') {
                    $('#actividad-grupal').val('');
                    $('#actividad-individual').val('');
                    $('#semana-error').text('');
                    $('#actividad-grupal-error').text('');
                    $('#actividad-individual-error').text('');
                }
            }

            function openModalAgregarSemana() {
                $('#semana-error').text('');
                $('#actividad-grupal-error').text('');
                $('#actividad-individual-error').text('');
                $('#actividad-grupal').val('');
                $('#actividad-individual').val('');

                // ✅ NUEVA LÓGICA: Buscar el primer hueco en lugar de siguiente a la máxima
                var semanasExistentes = [];

                $('.activity-row').each(function () {
                    try {
                        var semanaBadge = $(this).find('.semana-badge').text().trim();
                        if (semanaBadge) {
                            var numeroSemana = parseInt(semanaBadge.replace('Semana', '').trim());
                            if (!isNaN(numeroSemana) && semanasExistentes.indexOf(numeroSemana) === -1) {
                                semanasExistentes.push(numeroSemana);
                            }
                        }
                    } catch (e) {
                        console.warn("Error al parsear semana:", e);
                    }
                });

                // Ordenar las semanas
                semanasExistentes.sort(function (a, b) { return a - b; });

                console.log("Semanas existentes:", semanasExistentes);

                // Buscar el primer hueco del 1 al 16
                var proximaSemana = null;
                for (var i = 1; i <= 16; i++) {
                    if (semanasExistentes.indexOf(i) === -1) {
                        proximaSemana = i;
                        break;
                    }
                }

                if (proximaSemana === null) {
                    mostrarMensaje('Ya se han agregado las 16 semanas.', 'error');
                    return;
                }

                console.log("Próxima semana a agregar:", proximaSemana);

                $('#proxima-semana-display').text("Semana " + proximaSemana);
                $('#proxima-semana-hidden').val(proximaSemana);
                $('#modal-agregar-semana').fadeIn(300);
            }

            function agregarSemana() {
    var semanaSeleccionada = document.getElementById('proxima-semana-hidden').value;
    var actividadGrupal = document.getElementById('actividad-grupal').value;
    var actividadIndividual = document.getElementById('actividad-individual').value;

    // Limpiar errores previos
    document.getElementById('semana-error').textContent = '';
    document.getElementById('actividad-grupal-error').textContent = '';
    document.getElementById('actividad-individual-error').textContent = '';

    // Validaciones
    if (!semanaSeleccionada || parseInt(semanaSeleccionada) <= 0) {
        document.getElementById('semana-error').textContent = "Error al determinar la semana. Recargue la página.";
        return;
    }
    if (!actividadGrupal || actividadGrupal.trim() === '') {
        document.getElementById('actividad-grupal-error').textContent = "Por favor, ingrese la actividad grupal.";
        return;
    }
    if (!actividadIndividual || actividadIndividual.trim() === '') {
        document.getElementById('actividad-individual-error').textContent = "Por favor, ingrese la actividad individual.";
        return;
    }

    var idPat = @Model.IdEntrevistaInicial;

    // ✅ Deshabilitar botón durante la petición
    var btnAgregar = document.querySelector('#modal-agregar-semana .btn-primary');
    if (btnAgregar) {
        btnAgregar.disabled = true;
        btnAgregar.innerHTML = '<i class="glyphicon glyphicon-refresh glyphicon-spin"></i> Agregando...';
    }

    $.ajax({
        url: '@Url.Action("AsignarSemana", "PATs")',
        method: 'POST',
        data: {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            idPat: idPat,
            idSemana: parseInt(semanaSeleccionada),
            actividadGrupal: actividadGrupal.trim(),
            actividadIndividual: actividadIndividual.trim()
        },
        success: function(response) {
            console.log('Respuesta del servidor:', response); // ✅ Debug

            if (response.success) {
                closeModal('modal-agregar-semana');
                mostrarMensaje('Semana agregada exitosamente', 'success');

                // --- PEGAR O ASEGURAR ESTO AQUÍ ---
                setTimeout(function () { location.reload(); }, 1000);
                // ----------------------------------
            } else {
                mostrarMensaje('Error al agregar la semana: ' + (response.message || 'Error desconocido'), 'error');
            }
        },
        error: function(xhr, status, error) {
            console.error("AJAX Error:", error);
            console.error("Response:", xhr.responseText); // ✅ Debug
            mostrarMensaje('Error de conexión al agregar la semana', 'error');
        },
        complete: function() {
            // ✅ Rehabilitar botón
            if (btnAgregar) {
                btnAgregar.disabled = false;
                btnAgregar.innerHTML = 'Agregar Semana';
            }
        }
    });
}

