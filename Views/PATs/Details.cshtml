        // Función para filtrar actividades por tipo
        function agruparColumnaSemana() {
            // 1. Para cada semana, obtiene las filas visibles, toma la .group-cell y la pone en la primera visible
            let semanas = {};

            // Recolecta todas las filas visibles agrupadas por semana
            $('.pat-table tbody tr:visible').each(function () {
                let semana = $(this).data('semana');
                if (!semanas[semana]) semanas[semana] = [];
                semanas[semana].push($(this));
            });

            // Para cada semana
            Object.keys(semanas).forEach(function (semana) {
                let filas = semanas[semana];
                if (filas.length === 0) return;

                // Busca la celda de semana en cualquier fila de esa semana (puede estar oculta)
                let $celdaSemana = null;
                $('.pat-table tbody tr[data-semana="' + semana + '"]').each(function () {
                    let $cell = $(this).find('.group-cell');
                    if ($cell.length) {
                        $celdaSemana = $cell;
                        return false; // rompe el each
                    }
                });

                // Elimina cualquier .group-cell visible en las filas
                filas.forEach(function ($fila) {
                    $fila.find('.group-cell').remove();
                });

                // Si existe una celda de semana...
                if ($celdaSemana) {
                    // Ajusta el rowspan y la pone como primera celda de la primera fila visible
                    $celdaSemana.attr('rowspan', filas.length);
                    filas[0].prepend($celdaSemana.show());
                }
            });
        }






        // Filtros de actividades (TI/TG) - Unificado con PatDetalles.cshtml
        $('.activity-filter-btn').click(function () {
            $('.activity-filter-btn').removeClass('active');
            $(this).addClass('active');
