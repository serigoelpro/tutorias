// Acción para el nuevo botón "Guardar Nota" individual
$(document).on('click', '.btn-guardar-nota-individual', function() {
    var $thisButton = $(this);
    var $row = $thisButton.closest('tr');
    var actividadId = $row.data('actividad-id');
    var $radioChecked = $row.find('input[name="realizado_' + actividadId + '"]:checked');
    var realizado = $radioChecked.val() === 'true';
    var comentarios = $row.find('.comentarios-input').val().trim();
    var token = $('input[name="__RequestVerificationToken"]').val();

    // Validar que el radio esté seleccionado
    if ($radioChecked.length === 0) {
        mostrarMensaje('Debe seleccionar "Sí" o "No" para esta actividad.', 'error');
        return;
    }

    $thisButton.prop('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-spin"></span> Guardando...');

    $.ajax({
        url: '@Url.Action("GuardarNotaActividad", "PATs")',
        type: 'POST',
        data: {
            __RequestVerificationToken: token,
            IdActividad: actividadId,
            Comentarios: comentarios,
            RealizoActividad: realizado
        },
        success: function(response) {
            if (response.success) {
                mostrarMensaje('Nota guardada', 'success');
                $thisButton.hide(); // Ocultar el botón después de guardar

                // Actualizar el texto estático (display) para que coincida con lo guardado
                $row.find('.comentarios-display').text(comentarios);
                $row.find('.realizado-texto').html(realizado ? '<span class="status-badge-small status-realizado">Sí</span>' : '<span class="status-badge-small status-no-realizado">No</span>');

                // Actualizar el data-realizado en la fila
                $row.attr('data-realizado', realizado.toString());
            } else {
                mostrarMensaje(response.message || 'Error al guardar', 'error');
            }
        },
        error: function() {
            mostrarMensaje('Error de conexión al guardar la nota.', 'error');
        },
        complete: function() {
            $thisButton.prop('disabled', false).html('<span class="glyphicon glyphicon-floppy-disk"></span> Guardar Nota');
        }
    });
});
