        console.log('- btn-editar-actividades-final:', $('#btn-editar-actividades-final').length > 0);
        console.log('- btn-comentar-todas:', $('#btn-comentar-todas').length > 0);
        console.log('- vulnerability-btn:', $('.vulnerability-btn').length);

        console.log('Elementos de actividades:');
        console.log('- Filas de actividades:', $('[data-actividad-id]').length);
        console.log('- Inputs de actividad:', $('.actividad-input').length);
        console.log('- Textos de actividad:', $('.actividad-texto').length);
        console.log('- Inputs de notas:', $('.comentarios-input').length);
        console.log('- Radio buttons:', $('input[type="radio"]').length);

        // Verificar estructura HTML específica
        if ($('#btn-editar-todas').length === 0 && $('#btn-editar-actividades-final').length === 0 && $('#btn-comentar-todas').length === 0) {
            console.error('ADVERTENCIA: No se encontraron botones de edición');
        }

        if ($('[data-actividad-id]').length === 0) {
            console.error('ADVERTENCIA: No se encontraron filas de actividades');
