        $('#btn-finalizar-pat').off('click').on('click', function () {
    // Obtener las actividades existentes
    var semanasExistentes = @Html.Raw(Json.Encode(ViewBag.Actividades));
    var semanasPresentes = [];
    var semanasFaltantes = [];

    // Obtener las semanas que están presentes
    semanasExistentes.forEach(function(actividad) {
        if (semanasPresentes.indexOf(actividad.IdSemana) === -1) {
            semanasPresentes.push(actividad.IdSemana);
        }
    });

    // Verificar qué semanas faltan del 1 al 14
    for (var i = 1; i <= 14; i++) {
        if (semanasPresentes.indexOf(i) === -1) {
            semanasFaltantes.push(i);
        }
    }

    // Si faltan semanas del 1 al 14
    if (semanasFaltantes.length > 0) {
        $('#advertencia-semanas').show();
        $('#semanas-faltantes').text('Semanas faltantes: ' + semanasFaltantes.join(', '));
        return;
    }

    // Ocultar advertencia si todas las semanas están completas
    $('#advertencia-semanas').hide();

    // Si todas las semanas 1-14 están completas, proceder con la finalización
    var $form = $('#form-finalizar-pat');
    var data = $form.serialize();

    $('#btn-finalizar-pat').prop('disabled', true).html('<i class="glyphicon glyphicon-refresh glyphicon-spin"></i> Finalizando...');
            $.ajax({
                url: $form.attr('action'),
                type: $form.attr('method'),
                data: data,
                success: function (response) {
                    if (response && response.success) {
                        closeModal('modal-finalizar-pat');
                        mostrarMensaje('PAT finalizado correctamente', 'success');
                        setTimeout(function () {
                            // En lugar de location.reload(), recargar solo el contenido del PAT
                            recargarPATActual();
                        }, 1000);
                    } else {
                        mostrarMensaje(response && response.message ? response.message : 'Error al finalizar el PAT.', 'error');
                    }
                },
                error: function () {
                    mostrarMensaje('Error de conexión al finalizar el PAT.', 'error');
                },
                complete: function () {
                    $('#btn-finalizar-pat').prop('disabled', false).html('<i class="glyphicon glyphicon-ok" style="margin-right: 6px;"></i> Finalizar PAT');
                }
            });
        });

        // Manejar el botón "Enviar a revisión" usando delegación de eventos y clase
        $(document).on('click', '#btn-enviar-revision, #btn-reenviar-revision', function (e) {
            e.preventDefault();
            $('#modal-enviar-revision').fadeIn(300);
        });

        $(document).on('click', '#btn-confirmar-enviar-revision', function () {
            $(this).prop('disabled', true);
            // Obtener el PAT ID desde el campo hidden para asegurar el contexto correcto
            var patId = $('input[name="id"]').val() || @Model.IdEntrevistaInicial;
            $.ajax({
                url: baseUrl + 'PATs/EnviarRevision',
                type: 'POST',
                data: { id: patId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (resp) {
                    if (resp.success) {
                        location.reload();
                    } else {
                        alert(resp.message || 'Ocurrió un error al enviar a revisión.');
                        $('#modal-enviar-revision').fadeOut(200);
                    }
                },
                error: function () {
                    alert('Ocurrió un error al enviar a revisión.');
                    $('#modal-enviar-revision').fadeOut(200);
                },
                complete: function () {
                    $('#btn-confirmar-enviar-revision').prop('disabled', false);
                }
            });
        });
        });
        // Botón ir arriba



        // ==========================================
        // DEBUG Y VERIFICACIÓN
        // ==========================================
        console.log('=== INICIALIZACIÓN COMPLETADA ===');
        console.log('jQuery cargado:', typeof $ !== 'undefined');
        console.log('Base URL construida:', baseUrl);
        console.log('PAT Estado:', patEstado);
