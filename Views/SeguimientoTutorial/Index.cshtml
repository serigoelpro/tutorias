@model List<PlataformaWeb.Models.SeguimientoTutorialViewModel>

@{
    ViewBag.Title = "Seguimiento Tutorial";
}

<!-- Estilos CSS -->
<style>
    .info-section {
        padding: 20px;
        margin: 20px 0;
        border-radius: 8px;
        border-left: 4px solid;
    }

    .totales-generales {
        background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7));
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 15px;
        padding: 20px;
        margin: 20px 0;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }

    .paginacion-secciones {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        text-align: center;
    }

    .paginacion-interna {
        background: #e9ecef;
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 10px;
        margin: 15px 0;
        text-align: center;
    }

    .btn-seccion {
        background: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        margin: 0 5px;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .btn-seccion:hover {
            background: #0056b3;
            color: white;
            text-decoration: none;
        }

        .btn-seccion.active {
            background: #28a745;
        }

    .btn-pagina {
        background: #6c757d;
        color: white;
        border: none;
        padding: 6px 12px;
        margin: 0 2px;
        border-radius: 3px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .btn-pagina:hover {
            background: #545b62;
            color: white;
            text-decoration: none;
        }

        .btn-pagina.active {
            background: #28a745;
        }

    .info-paginacion {
        background: #d1ecf1;
        border: 1px solid #bee5eb;
        border-radius: 6px;
        padding: 10px;
        margin: 10px 0;
        text-align: center;
        font-size: 14px;
    }

    .table-container {
        margin: 20px 0;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin: 10px 0;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 6px 12px;
            margin: 0 2px;
            border: 1px solid #dee2e6;
            border-radius: 3px;
            background: #fff;
            color: #007bff;
            cursor: pointer;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: #e9ecef;
                border-color: #adb5bd;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background: #007bff;
                color: white;
                border-color: #007bff;
            }

    .total-item {
        text-align: center;
        padding: 10px;
        background-color: rgba(255,255,255,0.8);
        border-radius: 6px;
        margin: 5px 0;
    }

    .total-label {
        display: block;
        font-size: 0.9em;
        color: #666;
        margin-bottom: 5px;
    }

    .total-value {
        display: block;
        font-size: 1.5em;
        font-weight: bold;
        color: #28a745;
    }

    .table-responsive {
        margin-top: 20px;
    }

    .table th {
        background-color: #f8f9fa;
        border-top: 2px solid #dee2e6;
        font-weight: 600;
        text-align: center;
        vertical-align: middle;
        padding: 12px 8px;
        font-size: 0.9em;
    }

    .table td {
        text-align: center;
        vertical-align: middle;
        padding: 10px 8px;
        border: 1px solid #dee2e6;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .table tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }

    .fa-plus-circle {
        margin-right: 5px;
    }

    .search-section {
        background-color: #e3f2fd;
        border-left-color: #2196f3;
    }

    .pagination-section {
        background-color: #fff3e0;
        border-left-color: #ff9800;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4">Seguimiento Tutorial</h1>

            @if (ViewBag.NivelUsuario == 4)
            {
                <span class="badge badge-success">Vista Master</span>
            }
            else if (ViewBag.NivelUsuario == 3)
            {
                <span class="badge badge-info">Vista Coordinador</span>
            }
            else if (ViewBag.NivelUsuario == 2)
            {
                <span class="badge badge-warning">Vista Tutor</span>
            }

            <p class="text-muted">Reporte completo de seguimiento tutorial</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @ViewBag.Error
            @if (!string.IsNullOrEmpty(ViewBag.ErrorDetalle))
            {
                <br /><small><strong>Detalle:</strong> @ViewBag.ErrorDetalle</small>
            }
        </div>
    }

    <!-- Información de debugging -->
    <div class="info-section" style="background-color:#fff3cd;border-left-color:#ffc107;">
        <h4><i class="fas fa-bug"></i> Información de Debugging:</h4>
        <ul>
            <li><strong>Nivel de usuario:</strong> @ViewBag.NivelUsuario</li>
            <li><strong>Usuario:</strong> @ViewBag.NombreUsuario</li>
            @if (ViewBag.NivelUsuario == 3)
            {
                <li><strong>Carrera del coordinador:</strong> @ViewBag.CarreraCoordinador</li>
            }
            <li><strong>Total de registros en el modelo:</strong> @(Model?.Count ?? 0)</li>
            <li><strong>Total de registros en la base de datos:</strong> @ViewBag.TotalRegistros</li>
            <li><strong>Registros mostrados:</strong> @ViewBag.RegistrosMostrados</li>
            @if (!string.IsNullOrEmpty(ViewBag.DebugInfo))
            {
                <li><strong>Estado del enriquecimiento:</strong> <span style="color: #28a745; font-weight: bold;">@ViewBag.DebugInfo</span></li>
            }
        </ul>
    </div>

    <!-- Información de paginación -->
    <div class="info-paginacion">
        <strong>Paginación por Secciones:</strong>
        Mostrando registros @ViewBag.PrimerRegistro a @ViewBag.UltimoRegistro de @ViewBag.TotalRegistros totales
        <br />
        <small>Sección @ViewBag.SeccionActual de @ViewBag.TotalSecciones | Página @ViewBag.PaginaActual de @ViewBag.TotalPaginasEnSeccion</small>
        <br />
        <small><strong>Nueva configuración:</strong> 100 registros por sección (2 páginas × 50 registros)</small>
    </div>

    <!-- Navegación por Secciones (100 registros) -->
    <div class="paginacion-secciones">
        <h5><i class="fas fa-layer-group"></i> Navegación por Secciones</h5>
        <p class="text-muted">Cada sección contiene hasta 100 registros</p>

        @if (ViewBag.TotalSecciones > 1)
        {
            <!-- Botón Primera Sección -->
            if (ViewBag.SeccionActual > 1)
            {
                <a href="@Url.Action("Index", new { seccion = 1, pagina = 1 })" class="btn-seccion">
                    <i class="fas fa-angle-double-left"></i> Primera
                </a>
            }

            <!-- Botón Sección Anterior -->
            if (ViewBag.SeccionActual > 1)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual - 1, pagina = 1 })" class="btn-seccion">
                    <i class="fas fa-angle-left"></i> Anterior
                </a>
            }

            <!-- Número de Sección Actual -->
            <span class="btn-seccion active">Sección @ViewBag.SeccionActual</span>

            <!-- Botón Siguiente Sección -->
            if (ViewBag.SeccionActual < ViewBag.TotalSecciones)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual + 1, pagina = 1 })" class="btn-seccion">
                    Siguiente <i class="fas fa-angle-right"></i>
                </a>
            }

            <!-- Botón Última Sección -->
            if (ViewBag.SeccionActual < ViewBag.TotalSecciones)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.TotalSecciones, pagina = 1 })" class="btn-seccion">
                    Última <i class="fas fa-angle-double-right"></i>
                </a>
            }
        }
        else
        {
            <span class="text-muted">Solo hay una sección disponible</span>
        }
    </div>

    <!-- Navegación por Páginas Internas (50 registros) -->
    <div class="paginacion-interna">
        <h6><i class="fas fa-file-alt"></i> Páginas de la Sección Actual</h6>
        <p class="text-muted">Cada página muestra hasta 50 registros (2 páginas por sección)</p>

        @if (ViewBag.TotalPaginasEnSeccion > 1)
        {
            <!-- Botón Primera Página -->
            if (ViewBag.PaginaActual > 1)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual, pagina = 1 })" class="btn-pagina">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            }

            <!-- Botón Página Anterior -->
            if (ViewBag.PaginaActual > 1)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual, pagina = ViewBag.PaginaActual - 1 })" class="btn-pagina">
                    <i class="fas fa-angle-left"></i>
                </a>
            }

            <!-- Números de Página -->
            {
                int inicioPagina = Math.Max(1, ViewBag.PaginaActual - 1);
                int finPagina = Math.Min(ViewBag.TotalPaginasEnSeccion, ViewBag.PaginaActual + 1);

                for (int i = inicioPagina; i <= finPagina; i++)
                {
                    if (i == ViewBag.PaginaActual)
                    {
                        <span class="btn-pagina active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual, pagina = i })" class="btn-pagina">@i</a>
                    }
                }
            }

            <!-- Botón Siguiente Página -->
            if (ViewBag.PaginaActual < ViewBag.TotalPaginasEnSeccion)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual, pagina = ViewBag.PaginaActual + 1 })" class="btn-pagina">
                    <i class="fas fa-angle-right"></i>
                </a>
            }

            <!-- Botón Última Página -->
            if (ViewBag.PaginaActual < ViewBag.TotalPaginasEnSeccion)
            {
                <a href="@Url.Action("Index", new { seccion = ViewBag.SeccionActual, pagina = ViewBag.TotalPaginasEnSeccion })" class="btn-pagina">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            }
        }
        else
        {
            <span class="text-muted">Solo hay una página en esta sección</span>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Totales de la Sección Actual -->
        <div class="info-section" style="background-color:#d4edda;border-left-color:#28a745;">
            <h4><i class="fas fa-calculator"></i> Totales de la Sección Actual:</h4>
            <div class="row">
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Total Estudiantes:</span>
                        <span class="total-value">@Model.Sum(x => x.Total)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Hombres:</span>
                        <span class="total-value">@Model.Sum(x => x.H)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Mujeres:</span>
                        <span class="total-value">@Model.Sum(x => x.M)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Total Vulnerables:</span>
                        <span class="total-value">@Model.Sum(x => x.Vulnerable_Economico + x.Vulnerable_Personal + x.Vulnerable_Academico)</span>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Vulnerables Económicos:</span>
                        <span class="total-value">@Model.Sum(x => x.Vulnerable_Economico_H + x.Vulnerable_Economico_M)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Vulnerables Personales:</span>
                        <span class="total-value">@Model.Sum(x => x.Vulnerable_Personal_H + x.Vulnerable_Personal_M)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Vulnerables Académicos:</span>
                        <span class="total-value">@Model.Sum(x => x.Vulnerable_Academico_H + x.Vulnerable_Academico_M)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">No Vulnerables:</span>
                        <span class="total-value">@Model.Sum(x => x.No_Vulnerables_H + x.No_Vulnerables_M)</span>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Padres de Familias:</span>
                        <span class="total-value">@Model.Sum(x => x.Padres_Familias)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Alumnos Trabajando:</span>
                        <span class="total-value">@Model.Sum(x => x.Trabajan_H + x.Trabajan_M)</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="total-item">
                        <span class="total-label">Alumnos Becados:</span>
                        <span class="total-value">@Model.Sum(x => x.Becados_H + x.Becados_M)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Datos -->
        <div class="table-container">
            <table id="tablaSeguimiento" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Grupo</th>
                        <th>Nombre del Tutor</th>
                        <th>Período</th>
                        <th>Año</th>
                        <th>Total</th>
                        <th>H</th>
                        <th>M</th>
                        <th>Vulnerable Económico H</th>
                        <th>Vulnerable Económico M</th>
                        <th>Vulnerable Personal H</th>
                        <th>Vulnerable Personal M</th>
                        <th>Vulnerable Académico H</th>
                        <th>Vulnerable Académico M</th>
                        <th>No Vulnerables H</th>
                        <th>No Vulnerables M</th>
                        <th>Padres de Familias</th>
                        <th>Alumnos Trabajando H</th>
                        <th>Alumnos Trabajando M</th>
                        <th>Alumnos Becados H</th>
                        <th>Alumnos Becados M</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><i class="fas fa-plus-circle text-success"></i> @item.Grupo</td>
                            <td>@item.NombreTutor</td>
                            <td>@item.NombrePeriodo</td>
                            <td>@item.Año</td>
                            <td>@item.Total</td>
                            <td>@item.H</td>
                            <td>@item.M</td>
                            <td>@item.Vulnerable_Economico_H</td>
                            <td>@item.Vulnerable_Economico_M</td>
                            <td>@item.Vulnerable_Personal_H</td>
                            <td>@item.Vulnerable_Personal_M</td>
                            <td>@item.Vulnerable_Academico_H</td>
                            <td>@item.Vulnerable_Academico_M</td>
                            <td>@item.No_Vulnerables_H</td>
                            <td>@item.No_Vulnerables_M</td>
                            <td>@item.Padres_Familias</td>
                            <td>@item.Trabajan_H</td>
                            <td>@item.Trabajan_M</td>
                            <td>@item.Becados_H</td>
                            <td>@item.Becados_M</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No se encontraron datos</h4>
            <p>No hay registros de seguimiento tutorial disponibles en la base de datos.</p>
            <hr>
            <p class="mb-0">Si esperabas ver datos, verifica que:</p>
            <ul>
                <li>La base de datos contenga registros</li>
                <li>Los filtros de usuario sean correctos</li>
                <li>La conexión a la base de datos esté funcionando</li>
            </ul>
        </div>
    }

    <!-- Cómo usar este reporte -->
    <div class="info-section" style="background-color:#d1ecf1;border-left-color:#17a2b8;">
        <h4><i class="fas fa-info-circle"></i> Cómo usar este reporte:</h4>
        <ul>
            <li><strong>Navegación por Secciones:</strong> Usa los botones azules para cambiar entre secciones de 100 registros</li>
            <li><strong>Paginación Interna:</strong> Usa los botones grises para navegar entre las 2 páginas de cada sección</li>
            <li><strong>Búsqueda:</strong> Utiliza la barra de búsqueda de la tabla para encontrar tutores, grupos o períodos específicos</li>
            <li><strong>Ordenamiento:</strong> Puedes ordenar cualquier columna haciendo clic en el encabezado</li>
            <li><strong>Rendimiento:</strong> Solo se cargan 100 registros por sección para máxima velocidad</li>
        </ul>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS y JS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css">

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Configuración de DataTables optimizada para paginación del servidor
            $('#tablaSeguimiento').DataTable({
                pageLength: 50, // Mostrar 50 registros por página (coincide con la paginación del servidor)
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
                },
                scrollX: true,
                ordering: true,
                searching: true,
                info: true,
                lengthChange: false, // No permitir cambiar el número de registros por página
                dom: '<"top"f>rt<"bottom"i>', // Solo búsqueda, tabla, información
                responsive: true,
                columnDefs: [
                    { targets: [0, 1, 2, 3], orderable: true },
                    { targets: '_all', orderable: false } // Las columnas numéricas no se ordenan
                ]
            });
        });
    </script>
}
