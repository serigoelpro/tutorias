                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, usableWidth, 12, 'F'); doc.rect(leftMargin, y, usableWidth, 12); doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.text('Explique las características que consideró en base a la entrevista inicial realizada al alumno canalizado para asignar el tipo de vulnerabilidad:', leftMargin + 2, y + 5, { maxWidth: usableWidth - 4 }); y += 12; const motiveLines = doc.splitTextToSize(data.motivoCanalizacion, usableWidth - 4); const motiveHeight = 25; doc.rect(leftMargin, y, usableWidth, motiveHeight); doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.text(motiveLines, leftMargin + 2, y + 5); y += motiveHeight + 5;
