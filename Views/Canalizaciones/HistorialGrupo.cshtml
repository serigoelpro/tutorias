@model List<Plataforma_Web.Controllers.CanalizacionesController.CanalizacionNotaViewModel>
@{
    ViewBag.Title = "Historial de Canalizaciones";
    var usuario = Session["Usuario"] as Plataforma_Web.Models.Usuario;
}

<head>
    @* Scripts necesarios para la funcionalidad del PDF *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    @* Estilos AÑADIDOS para el modal de la vista previa del PDF *@
    <style>
        .swal2-popup .pdf-preview-container {
            border: 1px solid #ccc;
            font-family: Arial, sans-serif;
            color: black;
            font-size: 9pt;
            text-align: left;
        }

            .swal2-popup .pdf-preview-container div {
                box-sizing: border-box;
            }


        .table-sortable th {
            cursor: pointer;
            position: relative;
            padding-right: 20px;
        }

            .table-sortable th:hover {
                background-color: #34495e;
            }

            .table-sortable th::after {
                content: '\f0dc';
                font-family: 'Font Awesome 5 Free';
                font-weight: 900;
                position: absolute;
                right: 8px;
                color: #999;
                opacity: 0.5;
            }

            .table-sortable th.asc::after {
                content: '\f0de';
                color: #fff;
                opacity: 1;
            }

            .table-sortable th.desc::after {
                content: '\f0dd';
                color: #fff;
                opacity: 1;
            }


            .table-sortable th.no-sort {
                cursor: default;
            }

                .table-sortable th.no-sort::after {
                    content: none;
                }
    </style>
</head>


<h2 class="page-title">
    Historial de Canalizaciones del Grupo:
    <strong>@(ViewBag.GrupoNombre ?? "Mi Grupo")</strong>
</h2>
<p class="text-muted mb-4">
    Aquí se muestra un registro de todas las canalizaciones que se han realizado para los estudiantes de tu grupo asignado.
</p>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover custom-table table-sortable" id="tablaCanalizaciones">
            <thead class="table-dark">
                <tr>
                    <th data-type="date" style="cursor: pointer;">Fecha <i class="fas fa-sort"></i></th>
                    <th>Estudiante</th>
                    <th>Carrera</th>
                    <th>Tipo de Canalización</th>
                    <th>Vulnerabilidades Detectadas</th>
                    <th class="no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@HttpUtility.HtmlDecode(item.NombreEstudiante)</td>
                        <td>@HttpUtility.HtmlDecode(item.Carrera)</td>
                        <td>@HttpUtility.HtmlDecode(item.Tipo)</td>
                        <td class="notes-cell">@HttpUtility.HtmlDecode(item.MotivoCanalizacion)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-info btn-preview"
                                    title="Generar PDF de esta canalización"
                                    data-carrera="@item.Carrera"
                                    data-especialidad="@item.Especialidad"
                                    data-nombre="@item.NombreEstudiante"
                                    data-matricula="@item.Matricula"
                                    data-grupo="@item.Grupo"
                                    data-turno="@item.Turno"
                                    data-email="@item.Email"
                                    data-celular="@item.Celular"
                                    data-tutor-fullname="@item.TutorFullName"
                                    data-tutor-username="@item.CorreoTutor"
                                    data-psicologo="@item.NombrePsicologo"
                                    data-tipo-canalizacion="@item.Tipo"
                                    data-notas="@item.MotivoCanalizacion"
                                    data-fecha-registro="@item.Fecha.ToString("dd/MM/yyyy HH:mm")">
                                <i class="fas fa-print"></i> Imprimir
                            </button>

                            <button type="button" class="btn btn-sm btn-danger btn-delete"
                                    data-id="@item.Id"
                                    title="Eliminar registro">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">Sin Registros</h4>
        <p>No se han encontrado canalizaciones registradas para este grupo todavía.</p>
    </div>
}

<style>
    .page-title {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 2rem;
        border-bottom: 2px solid #3498db;
        padding-bottom: 0.5rem;
    }

    .custom-table {
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .table-dark {
        background-color: #2c3e50;
    }

        .table-dark th {
            color: #fff;
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

    .table-hover tbody tr:hover {
        background-color: #f1f8ff;
        transition: background-color 0.3s ease;
    }

    .notes-cell {
        max-width: 300px;
        word-wrap: break-word;
        white-space: normal;
    }

    .alert {
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .btn-preview {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {

            $(document).on('click', '.table-sortable th', function () {
                var th = $(this);
                if (th.hasClass('no-sort')) return; // No ordenar columna de acciones

                var table = th.closest('table');
                var tbody = table.find('tbody');
                var rows = tbody.find('tr').toArray();
                var columnIndex = th.index();
                var isAsc = !th.hasClass('asc'); // Alternar orden
                var type = th.data('type') || 'string'; // Tipo de dato

                table.find('th').removeClass('asc desc');
                th.addClass(isAsc ? 'asc' : 'desc');

                rows.sort(function (a, b) {
                    var valA = $(a).find('td').eq(columnIndex).text().trim();
                    var valB = $(b).find('td').eq(columnIndex).text().trim();

                    if (type === 'date') {
                        var dateA = parseCustomDate(valA);
                        var dateB = parseCustomDate(valB);
                        return isAsc ? dateA - dateB : dateB - dateA;
                    }

                    if ($.isNumeric(valA) && $.isNumeric(valB)) {
                        return isAsc ? valA - valB : valB - valA;
                    }

                    return isAsc ? valA.localeCompare(valB, undefined, { sensitivity: 'base' }) : valB.localeCompare(valA, undefined, { sensitivity: 'base' });
                });

                $.each(rows, function (index, row) {
                    tbody.append(row);
                });
            });

            function parseCustomDate(dateString) {
                if (!dateString) return 0;
                try {
                    var partesEspacio = dateString.split(' ');
                    if (partesEspacio.length < 2) return 0; // Validación extra

                    var fechaPartes = partesEspacio[0].split('/');
                    var horaPartes = partesEspacio[1].split(':');

                    var fechaObjeto = new Date(
                        fechaPartes[2],
                        fechaPartes[1] - 1,
                        fechaPartes[0],
                        horaPartes[0],
                        horaPartes[1]
                    );
                    return fechaObjeto.getTime();
                } catch (e) {
                    return 0;
                }
            } // <--- ¡AQUÍ FALTABA ESTA LLAVE EN TU CÓDIGO ANTERIOR!


            function decodeHtml(html) {
                if (!html) return "";
                const txt = document.createElement("textarea");
                txt.innerHTML = html;
                return txt.value;
            }

            $('.custom-table').on('click', '.btn-delete', function () {
                const id = $(this).data('id');
                const row = $(this).closest('tr');

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "Esta acción eliminará la canalización permanentemente.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarCanalizacion", "Canalizaciones")',
                            type: 'POST',
                            data: { id: id },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('¡Eliminado!', response.message, 'success');
                                    row.fadeOut(500, function() { $(this).remove(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error', 'Error de conexión.', 'error');
                            }
                        });
                    }
                });
            });


            $('.custom-table').on('click', '.btn-preview', function () {
                const button = $(this);
                const canalizacionData = {
                    carrera: decodeHtml(button.data('carrera') || 'No disponible').toUpperCase(),
                    nombre: decodeHtml(button.data('nombre') || 'No disponible').toUpperCase(),
                    matricula: decodeHtml(button.data('matricula') || 'No disponible').toUpperCase(),
                    grupo: decodeHtml(button.data('grupo') || 'No disponible').toUpperCase(),
                    turno: decodeHtml(button.data('turno') || 'No disponible').toUpperCase(),
                    email: decodeHtml(button.data('email') || 'No disponible'),
                    celular: decodeHtml(button.data('celular') || 'No disponible').toUpperCase(),
                    tutorFullName: decodeHtml(button.data('tutor-fullname') || 'No disponible').toUpperCase(),
                    tutorUsername: decodeHtml(button.data('tutor-username') || 'No disponible'),
                    psicologoNombre: decodeHtml(button.data('psicologo') || 'NO ASIGNADO').toUpperCase(),
                    tipoCanalizacion: decodeHtml(button.data('tipo-canalizacion') || 'No seleccionado'),
                    motivoCanalizacion: decodeHtml(button.data('notas') || 'Sin motivo especificado.').toUpperCase(),
                    fechaRegistro: decodeHtml(button.data('fecha-registro') || 'Fecha no disponible')
                };
                generatePreview(canalizacionData);
            });

            function generatePreview(modelData) {
                try {
                    const check = (type) => modelData.tipoCanalizacion.toLowerCase().includes(type.toLowerCase()) ? '☒' : '☐';
                    const borderStyle = '0.5pt solid black';
                    const labelBg = '#F0F0F0';

                    const previewHTML = `
                        <div class="pdf-preview-container" style="padding: 12.7mm 19mm; background: white;">
                            <div style="width: 177.9mm;">
                                <div style="display: flex; height: 16mm; margin-bottom: 5mm;">
                                    <div style="width: 50mm; border: ${borderStyle}; display: flex; align-items: center; justify-content: center;">
                                        <img src="/Imagenes/ImagenesPagina/UT-Bis.png" style="width: 35mm; height: 14mm;" alt="Logo"/>
                                    </div>
                                    <div style="flex-grow: 1; border: ${borderStyle}; border-left: none; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: bold; font-size: 13pt; text-align: center;">
                                        <span>FORMATO DE CANALIZACIÓN A LOS SERVICIOS</span><span>PSICOPEDAGÓGICOS</span>
                                    </div>
                                </div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Programa Educativo:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.carrera}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Nombre del alumno:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.nombre}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 25mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Matrícula:</div> <div style="width: 35mm; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.matricula}</div> <div style="width: 30mm; background: ${labelBg}; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Grado y grupo:</div> <div style="width: 35mm; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.grupo}</div> <div style="width: 18mm; background: ${labelBg}; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Turno:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.turno}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Correo institucional:</div> <div style="width: 53mm; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.email}</div> <div style="width: 40mm; background: ${labelBg}; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Número de celular:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.celular}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Nombre del tutor:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.tutorFullName}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Correo institucional:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.tutorUsername}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 22mm;"> <div style="width: 38mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center; justify-content: center; text-align: center;">Canalización por identificación de vulnerabilidad:</div> <div style="flex-grow: 1; display: flex; font-size: 9pt;"> <div style="flex: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; display: flex; align-items: center; justify-content: center;">${check('Personal')} Personal</div> <div style="flex: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; display: flex; align-items: center; justify-content: center;">${check('Académica')} Académica</div> <div style="flex: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; display: flex; align-items: center; justify-content: center;">${check('Socioeconómica')} Socioeconómica</div> <div style="flex: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; display: flex; align-items: center; justify-content: center; text-align: center; flex-direction: column; line-height: 1.2;"><div>${check('Iniciativa')} Ninguna,</div><div>iniciativa propia.</div></div> </div> </div> <div style="height: 5mm;"></div>
                                <div> <div style="background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center; min-height: 12mm;">Explique las características que consideró en base a la entrevista inicial realizada al alumno canalizado para asignar el tipo de vulnerabilidad:</div> <div style="border-left: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; min-height: 25mm; white-space: pre-wrap; word-wrap: break-word;">${modelData.motivoCanalizacion}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 45mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Psicólogo asignado:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.psicologoNombre}</div> </div> <div style="height: 5mm;"></div>
                                <div style="display: flex; height: 8mm;"> <div style="width: 60mm; background: ${labelBg}; border: ${borderStyle}; padding: 2mm; font-weight: bold; display: flex; align-items: center;">Fecha y hora de la primera cita:</div> <div style="flex-grow: 1; border-top: ${borderStyle}; border-right: ${borderStyle}; border-bottom: ${borderStyle}; padding: 2mm; display: flex; align-items: center;">${modelData.fechaRegistro}</div> </div> <div style="height: 15mm;"></div>
                                <div style="height: 5mm;"></div> <div style="text-align: right; font-size: 11pt;">F-PSE-DICA-12/R02</div>
                            </div>
                        </div>`;

                    Swal.fire({
                        title: 'Vista previa del documento',
                        html: previewHTML,
                        width: '850px',
                        showCancelButton: true,
                        confirmButtonText: 'Generar PDF',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#007bff',
                        cancelButtonColor: '#6c757d'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            generatePDF(modelData);
                        }
                    });
                } catch (error) {
                    console.error('Error al generar la vista previa:', error);
                    Swal.fire('Error', 'Ocurrió un error al generar la vista previa.', 'error');
                }
            }

            function generatePDF(data) {
                try {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'letter' });
                    const leftMargin = 19; const topMargin = 12.7; const usableWidth = 215.9 - (leftMargin * 2); let y = topMargin;
                    const headerHeight = 16; const logoBoxWidth = 50; const titleFontSize = 13;

                    doc.rect(leftMargin, y, logoBoxWidth, headerHeight); const imageWidth = 35; const imageHeight = 14; const imageX = leftMargin + (logoBoxWidth - imageWidth) / 2; const imageY = y + (headerHeight - imageHeight) / 2; doc.addImage('/Imagenes/ImagenesPagina/UT-Bis.png', 'PNG', imageX, imageY, imageWidth, imageHeight); doc.setFontSize(titleFontSize); doc.setFont('helvetica', 'bold'); const titleX = leftMargin + logoBoxWidth; const titleWidth = usableWidth - logoBoxWidth; doc.rect(titleX, y, titleWidth, headerHeight); const titleLine1 = 'FORMATO DE CANALIZACIÓN A LOS SERVICIOS'; const titleLine2 = 'PSICOPEDAGÓGICOS'; doc.text(titleLine1, titleX + (titleWidth / 2), y + 7, { align: 'center' }); doc.text(titleLine2, titleX + (titleWidth / 2), y + 12, { align: 'center' }); y += headerHeight + 5;

                    const drawRow = (label, value, labelWidth, valueWidth, rowHeight = 8) => { doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, labelWidth, rowHeight, 'F'); doc.rect(leftMargin, y, labelWidth, rowHeight); doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.text(label, leftMargin + 2, y + 5.5); doc.rect(leftMargin + labelWidth, y, valueWidth, rowHeight); doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.text(value || '', leftMargin + labelWidth + 2, y + 5.5, { maxWidth: valueWidth - 4 }); y += rowHeight; };

                    drawRow('Programa Educativo:', data.carrera, 45, usableWidth - 45); y += 5;
                    drawRow('Nombre del alumno:', data.nombre, 45, usableWidth - 45); y += 5;
                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 25, 8, 'F'); doc.rect(leftMargin, y, 25, 8); doc.setFont('helvetica', 'bold'); doc.text('Matrícula:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 25, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.matricula, leftMargin + 27, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 60, y, 30, 8, 'F'); doc.rect(leftMargin + 60, y, 30, 8); doc.setFont('helvetica', 'bold'); doc.text('Grado y grupo:', leftMargin + 62, y + 5.5); doc.rect(leftMargin + 90, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.grupo, leftMargin + 92, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 125, y, 18, 8, 'F'); doc.rect(leftMargin + 125, y, 18, 8); doc.setFont('helvetica', 'bold'); doc.text('Turno:', leftMargin + 127, y + 5.5); doc.rect(leftMargin + 143, y, usableWidth - 143, 8); doc.setFont('helvetica', 'normal'); doc.text(data.turno, leftMargin + 145, y + 5.5); y += 8; y += 5;
                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 45, 8, 'F'); doc.rect(leftMargin, y, 45, 8); doc.setFont('helvetica', 'bold'); doc.text('Correo institucional:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 45, y, 53, 8); doc.setFont('helvetica', 'normal'); doc.text(data.email, leftMargin + 47, y + 5.5, { maxWidth: 51 }); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 98, y, 40, 8, 'F'); doc.rect(leftMargin + 98, y, 40, 8); doc.setFont('helvetica', 'bold'); doc.text('Número de celular:', leftMargin + 100, y + 5.5); doc.rect(leftMargin + 138, y, usableWidth - 138, 8); doc.setFont('helvetica', 'normal'); doc.text(data.celular, leftMargin + 140, y + 5.5); y += 8 + 5;
                    drawRow('Nombre del tutor:', data.tutorFullName, 45, usableWidth - 45); y += 5;
                    drawRow('Correo institucional:', data.tutorUsername, 45, usableWidth - 45); y += 5;

