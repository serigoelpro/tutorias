                drawRow('Programa Educativo:', data.carrera, 45, usableWidth - 45); y += 5;
                drawRow('Nombre del alumno:', data.nombre, 45, usableWidth - 45); y += 5;
                doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 25, 8, 'F'); doc.rect(leftMargin, y, 25, 8); doc.setFont('helvetica', 'bold'); doc.text('Matrícula:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 25, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.matricula, leftMargin + 27, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 60, y, 30, 8, 'F'); doc.rect(leftMargin + 60, y, 30, 8); doc.setFont('helvetica', 'bold'); doc.text('Grado y grupo:', leftMargin + 62, y + 5.5); doc.rect(leftMargin + 90, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.grupo, leftMargin + 92, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 125, y, 18, 8, 'F'); doc.rect(leftMargin + 125, y, 18, 8); doc.setFont('helvetica', 'bold'); doc.text('Turno:', leftMargin + 127, y + 5.5); doc.rect(leftMargin + 143, y, usableWidth - 143, 8); doc.setFont('helvetica', 'normal'); doc.text(data.turno, leftMargin + 145, y + 5.5); y += 8; y += 5;
                doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 45, 8, 'F'); doc.rect(leftMargin, y, 45, 8); doc.setFont('helvetica', 'bold'); doc.text('Correo institucional:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 45, y, 53, 8); doc.setFont('helvetica', 'normal'); doc.text(data.email, leftMargin + 47, y + 5.5, { maxWidth: 51 }); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 98, y, 40, 8, 'F'); doc.rect(leftMargin + 98, y, 40, 8); doc.setFont('helvetica', 'bold'); doc.text('Número de celular:', leftMargin + 100, y + 5.5); doc.rect(leftMargin + 138, y, usableWidth - 138, 8); doc.setFont('helvetica', 'normal'); doc.text(data.celular, leftMargin + 140, y + 5.5); y += 8 + 5;
                drawRow('Nombre del tutor:', data.tutorFullName, 45, usableWidth - 45); y += 5;
                drawRow('Correo institucional:', data.tutorUsername, 45, usableWidth - 45); y += 5;
                const vulnHeight = 22; const labelColWidth = 38; const options = [{ key: 'Personal', text: 'Personal' }, { key: 'Académica', text: 'Académica' }, { key: 'Socioeconómica', text: 'Socioeconómica' }, { key: 'Iniciativa', text: 'Ninguna, iniciativa propia.' }]; const optionColWidth = (usableWidth - labelColWidth) / options.length; doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, labelColWidth, vulnHeight, 'F'); doc.rect(leftMargin, y, labelColWidth, vulnHeight); doc.setFont('helvetica', 'bold'); const labelText = 'Canalización por identificación de vulnerabilidad:'; const labelLines = doc.splitTextToSize(labelText, labelColWidth - 4); const labelBlockHeight = labelLines.length * 4; const labelY = y + (vulnHeight / 2) - (labelBlockHeight / 2) + 3; doc.text(labelLines, leftMargin + 2, labelY); let currentX = leftMargin + labelColWidth; doc.setFont('helvetica', 'normal'); doc.setFontSize(9); options.forEach(option => {
                    const isSelected = data.tipoCanalizacion.toLowerCase().includes(option.key.toLowerCase()); doc.rect(currentX, y, optionColWidth, vulnHeight); const checkboxSize = 3; const checkboxX = currentX + 3; const checkboxY = y + (vulnHeight / 2) - (checkboxSize / 2); doc.rect(checkboxX, checkboxY, checkboxSize, checkboxSize); if (isSelected) { doc.line(checkboxX, checkboxY, checkboxX + checkboxSize, checkboxY + checkboxSize); doc.line(checkboxX, checkboxY + checkboxSize, checkboxX + checkboxSize, checkboxY); } const textX = checkboxX + checkboxSize + 1.5; const textMaxWidth = optionColWidth - (textX - currentX) - 2; const textLines = doc.splitTextToSize(option.text, textMaxWidth); const textBlockHeight = textLines.length * 3.5; const textY = y + (vulnHeight / 2) - (textBlockHeight / 2) + 2.5; doc.text(textLines, textX, textY); currentX += optionColWidth;
                }); y += vulnHeight + 5;
                doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, usableWidth, 12, 'F'); doc.rect(leftMargin, y, usableWidth, 12); doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.text('Explique las características que consideró en base a la entrevista inicial realizada al alumno canalizado para asignar el tipo de vulnerabilidad:', leftMargin + 2, y + 5, { maxWidth: usableWidth - 4 }); y += 12; const motiveLines = doc.splitTextToSize(data.motivoCanalizacion, usableWidth - 4); const motiveHeight = 25; doc.rect(leftMargin, y, usableWidth, motiveHeight); doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.text(motiveLines, leftMargin + 2, y + 5); y += motiveHeight + 5;
