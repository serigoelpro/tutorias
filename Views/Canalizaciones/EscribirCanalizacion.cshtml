            function generatePDF(data) {
                try {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF({
                        orientation: 'portrait',
                        unit: 'mm',
                        format: 'letter'
                    });

                    const leftMargin = 19;
                    const topMargin = 12.7;
                    const usableWidth = 215.9 - (leftMargin * 2);
                    let y = topMargin;

                    const headerHeight = 16; const logoBoxWidth = 50; const titleFontSize = 13;
                    doc.rect(leftMargin, y, logoBoxWidth, headerHeight); const imageWidth = 35; const imageHeight = 14; const imageX = leftMargin + (logoBoxWidth - imageWidth) / 2; const imageY = y + (headerHeight - imageHeight) / 2; doc.addImage('/Imagenes/ImagenesPagina/UT-Bis.png', 'PNG', imageX, imageY, imageWidth, imageHeight); doc.setFontSize(titleFontSize); doc.setFont('helvetica', 'bold'); const titleX = leftMargin + logoBoxWidth; const titleWidth = usableWidth - logoBoxWidth; doc.rect(titleX, y, titleWidth, headerHeight); const titleLine1 = 'FORMATO DE CANALIZACIÓN A LOS SERVICIOS'; const titleLine2 = 'PSICOPEDAGÓGICOS'; doc.text(titleLine1, titleX + (titleWidth / 2), y + 7, { align: 'center' }); doc.text(titleLine2, titleX + (titleWidth / 2), y + 12, { align: 'center' }); y += headerHeight + 5;

                    const drawRow = (label, value, labelWidth, valueWidth, rowHeight = 8) => { doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, labelWidth, rowHeight, 'F'); doc.rect(leftMargin, y, labelWidth, rowHeight); doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.text(label, leftMargin + 2, y + 5.5); doc.rect(leftMargin + labelWidth, y, valueWidth, rowHeight); doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.text(value, leftMargin + labelWidth + 2, y + 5.5, { maxWidth: valueWidth - 4 }); y += rowHeight; };

                    drawRow('Programa Educativo:', data.carrera, 45, usableWidth - 45); y += 5;
                    drawRow('Nombre del alumno:', data.nombre, 45, usableWidth - 45); y += 5;
                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 25, 8, 'F'); doc.rect(leftMargin, y, 25, 8); doc.setFont('helvetica', 'bold'); doc.text('Matrícula:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 25, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.matricula, leftMargin + 27, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 60, y, 30, 8, 'F'); doc.rect(leftMargin + 60, y, 30, 8); doc.setFont('helvetica', 'bold'); doc.text('Grado y grupo:', leftMargin + 62, y + 5.5); doc.rect(leftMargin + 90, y, 35, 8); doc.setFont('helvetica', 'normal'); doc.text(data.grupo, leftMargin + 92, y + 5.5); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 125, y, 18, 8, 'F'); doc.rect(leftMargin + 125, y, 18, 8); doc.setFont('helvetica', 'bold'); doc.text('Turno:', leftMargin + 127, y + 5.5); doc.rect(leftMargin + 143, y, usableWidth - 143, 8); doc.setFont('helvetica', 'normal'); doc.text(data.turno, leftMargin + 145, y + 5.5); y += 8; y += 5;
                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, 45, 8, 'F'); doc.rect(leftMargin, y, 45, 8); doc.setFont('helvetica', 'bold'); doc.text('Correo institucional:', leftMargin + 2, y + 5.5); doc.rect(leftMargin + 45, y, 53, 8); doc.setFont('helvetica', 'normal'); doc.text(data.email, leftMargin + 47, y + 5.5, { maxWidth: 51 }); doc.setFillColor(240, 240, 240); doc.rect(leftMargin + 98, y, 40, 8, 'F'); doc.rect(leftMargin + 98, y, 40, 8); doc.setFont('helvetica', 'bold'); doc.text('Número de celular:', leftMargin + 100, y + 5.5); doc.rect(leftMargin + 138, y, usableWidth - 138, 8); doc.setFont('helvetica', 'normal'); doc.text(data.celular, leftMargin + 140, y + 5.5); y += 8 + 5;
                    drawRow('Nombre del tutor:', data.tutorFullName, 45, usableWidth - 45); y += 5;
                    drawRow('Correo institucional:', data.tutorUsername, 45, usableWidth - 45); y += 5;

                    const vulnHeight = 22; const labelColWidth = 38; const options = [{ key: 'Personal', text: 'Personal' }, { key: 'Académica', text: 'Académica' }, { key: 'Socioeconómica', text: 'Socioeconómica' }, { key: 'Iniciativa', text: 'Ninguna, iniciativa propia.' }]; const optionColWidth = (usableWidth - labelColWidth) / options.length; doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, labelColWidth, vulnHeight, 'F'); doc.rect(leftMargin, y, labelColWidth, vulnHeight); doc.setFont('helvetica', 'bold'); const labelText = 'Canalización por identificación de vulnerabilidad:'; const labelLines = doc.splitTextToSize(labelText, labelColWidth - 4); const labelBlockHeight = labelLines.length * 4; const labelY = y + (vulnHeight / 2) - (labelBlockHeight / 2) + 3; doc.text(labelLines, leftMargin + 2, labelY); let currentX = leftMargin + labelColWidth; doc.setFont('helvetica', 'normal'); doc.setFontSize(9); options.forEach(option => { const isSelected = data.tipoCanalizacion.toLowerCase().includes(option.key.toLowerCase()); doc.rect(currentX, y, optionColWidth, vulnHeight); const checkboxSize = 3; const checkboxX = currentX + 3; const checkboxY = y + (vulnHeight / 2) - (checkboxSize / 2); doc.rect(checkboxX, checkboxY, checkboxSize, checkboxSize); if (isSelected) { doc.line(checkboxX, checkboxY, checkboxX + checkboxSize, checkboxY + checkboxSize); doc.line(checkboxX, checkboxY + checkboxSize, checkboxX + checkboxSize, checkboxY); } const textX = checkboxX + checkboxSize + 1.5; const textMaxWidth = optionColWidth - (textX - currentX) - 2; const textLines = doc.splitTextToSize(option.text, textMaxWidth); const textBlockHeight = textLines.length * 3.5; const textY = y + (vulnHeight / 2) - (textBlockHeight / 2) + 2.5; doc.text(textLines, textX, textY); currentX += optionColWidth;
                    }); y += vulnHeight + 5;

                    doc.setFillColor(240, 240, 240); doc.rect(leftMargin, y, usableWidth, 12, 'F'); doc.rect(leftMargin, y, usableWidth, 12); doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.text('Explique las características que consideró en base a la entrevista inicial realizada al alumno canalizado para asignar el tipo de vulnerabilidad:', leftMargin + 2, y + 5, { maxWidth: usableWidth - 4 }); y += 12; const motiveLines = doc.splitTextToSize(data.motivoCanalizacion, usableWidth - 4); const motiveHeight = 25; doc.rect(leftMargin, y, usableWidth, motiveHeight); doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.text(motiveLines, leftMargin + 2, y + 5); y += motiveHeight + 5;

                    drawRow('Psicólogo asignado:', data.psicologoNombre, 45, usableWidth - 45);
                    y += 5;

                    drawRow('Fecha y hora de registro:', data.fechaRegistro, 60, usableWidth - 60);
                    y += 15;

                    // --- SECCIÓN DE FIRMAS ---
                    const sigY = y;
                    const sigWidth = 57.5;
                    const sigHeight = 12;
                    const sigGap = (usableWidth - (sigWidth * 3)) / 2;

                    const drawSignatureBox = (x, y_pos, label) => {
                        doc.setFillColor(240, 240, 240);
                        doc.rect(x, y_pos, sigWidth, sigHeight, 'F');
                        doc.rect(x, y_pos, sigWidth, sigHeight);
                        const centerY = y_pos + sigHeight / 2;
                        doc.setFont('helvetica', 'bold');
                        doc.setFontSize(10);
                        doc.text(label, x + sigWidth / 2, centerY - 1.5, { align: 'center' });
                        doc.setFont('helvetica', 'italic');
                        doc.setFontSize(7.5);
                        doc.text('Nombre y firma autógrafa', x + sigWidth / 2, centerY + 3.5, { align: 'center' });
                    };

                    const firstBoxX = leftMargin;
                    const secondBoxX = leftMargin + sigWidth + sigGap;
                    const thirdBoxX = leftMargin + sigWidth * 2 + sigGap * 2;

                    drawSignatureBox(firstBoxX, sigY, 'TUTOR:');
                    drawSignatureBox(secondBoxX, sigY, 'ALUMNO:');
                    drawSignatureBox(thirdBoxX, sigY, 'PSICÓLOGO:');

                    const lineY = sigY + sigHeight + 20;
                    doc.setLineWidth(0.2);
                    doc.line(firstBoxX, lineY, firstBoxX + sigWidth, lineY);
                    doc.line(secondBoxX, lineY, secondBoxX + sigWidth, lineY);
                    doc.line(thirdBoxX, lineY, thirdBoxX + sigWidth, lineY);
                    y = lineY + 5;

                    const pageHeight = doc.internal.pageSize.getHeight(); const bottomMargin = 12.7; doc.setFont('helvetica', 'normal'); doc.setFontSize(11); doc.text('F-PSE-DICA-12/R02', leftMargin + usableWidth, pageHeight - bottomMargin, { align: 'right' });

                    const safeNombre = data.nombre.replace(/[^a-zA-Z0-9_-]/g, '_');
                    doc.save(`Canalizacion_${safeNombre}.pdf`);

                } catch (error) {
                    console.error('Error al generar el PDF:', error);
                    Swal.fire('Error', 'Ocurrió un error al generar el PDF.', 'error');
                }
            }

            $('#IdTipoCanalizacion').trigger('change');

        });
    </script>
