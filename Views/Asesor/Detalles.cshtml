<!-- Script para manejar lógica de vulnerabilidad (Mostrar/Ocultar dropdowns) -->
<script type="text/javascript">
    $(document).ready(function () {
        var $ddlVulnerable = $('#IdVulnerable');
        var $ddlTipo = $('#IdEleccionVunerabilidad');

        function toggleVulnerabilityOptions() {
            // Asumimos que la opción "Sí" contiene "SI" en su texto (ignorando mayúsculas/espacios)
            var textoSeleccionado = $ddlVulnerable.find('option:selected').text().toUpperCase().trim();
            var isVulnerable = textoSeleccionado === 'SI' || textoSeleccionado === 'YES'; // Por si acaso
            var $container = $ddlTipo.closest('p');

            if (isVulnerable) {
                // MOSTRAR: Si es vulnerable, mostramos las opciones
                $container.show();
                $ddlTipo.attr('required', 'required'); // Restaurar validación

                // Filtrar opciones: Ocultar "NO VULNERABLE" si existe en la lista
                // Esto es para cumplir con "arroje solo esas 3 opciones"
                $ddlTipo.find('option').each(function () {
                    var text = $(this).text().toUpperCase().trim();
                    if (text === 'NO VULNERABLE') {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });

                // Si la selección actual estaba oculta (ej. era No Vulnerable), limpiamos o seleccionamos la primera visible
                if ($ddlTipo.find('option:selected').css('display') === 'none') {
                    $ddlTipo.val('');
                }
            } else {
                // OCULTAR: Si no es vulnerable
                $container.hide();
                $ddlTipo.removeAttr('required'); // Quitar validación para permitir guardar
                $ddlTipo.val(''); // Limpiar valor

                // Intentar poner "No vulnerable" si existe, por consistencia visual
                // El backend ya maneja null como "No vulnerable", así que enviar vacío está bien.
                var $noVulnOption = $ddlTipo.find('option').filter(function () {
                    return $(this).text().toUpperCase().trim() === 'NO VULNERABLE';
                });
                if ($noVulnOption.length > 0) $noVulnOption.prop('selected', true);
            }
        }

        $ddlVulnerable.change(toggleVulnerabilityOptions);

        // Ejecutar al cargar la página para establecer estado inicial
        toggleVulnerabilityOptions();
    });
</script>