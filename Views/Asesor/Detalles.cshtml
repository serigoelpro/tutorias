@model Plataforma_Web.Models.EntrevistaInicial
@using Plataforma_Web.Models.PrimeraEntrevista
@{
    // CORRECCIÓN CLAVE CONTRA EL NULLREFERENCE EXCEPTION:
    // 1. Asignación del objeto 'datos'
    Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales datos = ViewBag.datos as Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales;

    // 2. Variable segura para el ID de persona
    int idPersonaActual = 0;

    // Solo si el objeto 'datos' se cargó correctamente, obtenemos el IdPersona
    if (datos != null)
    {
        idPersonaActual = datos.IdPersona;
    }
    AspectosAcademicos academicos = ViewBag.academicos as AspectosAcademicos;
    AspectosEconomicos economicos = ViewBag.economicos as AspectosEconomicos;
    AspectosPersonales personales = ViewBag.personales as AspectosPersonales;
    ViewBag.Title = "Editar Detalles";
}

<!-- SweetAlert CSS/JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .navegacion-entrevistas button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .navegacion-entrevistas button:not(:disabled):hover {
        transform: scale(1.05);
        transition: transform 0.2s;
    }

    .btn-navegando {
        pointer-events: none;
        opacity: 0.6;
    }

    #btnAnterior, #btnSiguiente,
    a.btn-primary[href*="Grupo"] {
        background-color: #09a787 !important;
        border-color: #09a787 !important;
        color: white !important;
    }

        #btnAnterior:hover:not(:disabled),
        #btnSiguiente:hover:not(:disabled),
        a.btn-primary[href*="Grupo"]:hover {
            background-color: #078c71 !important;
            border-color: #078c71 !important;
        }

        #btnAnterior:focus, #btnSiguiente:focus,
        a.btn-primary[href*="Grupo"]:focus {
            background-color: #078c71 !important;
            border-color: #078c71 !important;
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(9, 167, 135, 0.5) !important;
        }
</style>

@using (Html.BeginForm())

{
    @Html.AntiForgeryToken()

    <h2>Editar Detalles</h2>
    <br />
    <div class="d-flex align-items-center mb-3">
        <a class="btn btn-primary" role="button" href="@Url.Action("Grupo", "Entrevistas")">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Regresar
        </a>
        <div class="btn-group navegacion-entrevistas" role="group" style="margin-left: 15px;">

            <button type="button" id="btnAnterior" class="btn btn-info" disabled>
                <span class="glyphicon glyphicon-chevron-left"></span>
            </button>

            <button type="button" id="posicionActual" class="btn btn-default" disabled
                    title="Posición en el grupo">
                Cargando...
            </button>

            <button type="button" id="btnSiguiente" class="btn btn-info" disabled>
                <span class="glyphicon glyphicon-chevron-right"></span>
            </button>
        </div>
    </div>

    <div class="container-fluid" style="margin-top:30px">
        <section class="content">
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-default" style="background-color:white;">
                        <div class="panel-heading" style="text-align:center;">
                            <div class="row">
                                <div class="col-md-12">
                                    @if (datos.IdGrado == 1)
                                    {
                                        <h2>Entrevista Inicial</h2>
                                    }
                                    else
                                    {
                                        <h2>Entrevista de Seguimiento - @datos.Grado.Nombre &deg;</h2>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="panel-body"></div>
                        <div class="row">
                            <div class="col-md-12 col-md-push-1">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Matrícula</label>
                                                    <br />
                                                    @datos.Matricula
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Nombre completo</label>
                                                    <br />
                                                    @datos.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Edad</label>
                                                    <br />
                                                    @datos.Edad AÑOS
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Sexo</label>
                                                    <br />
                                                    @if (datos.Sexo != null)
                                                    {
                                                        @datos.Sexo
                                                    }
                                                    else
                                                    {
                                                        <label class="text-danger">Sin actualizar</label>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Grado</label>
                                                    <br />
                                                    @datos.Grado.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Grupo</label>
                                                    <br />
                                                    @datos.Grupo.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Carrera</label>
                                                    <br />
                                                    @if (datos.CarreraNom != null)
                                                    {
                                                        @datos.CarreraNom
                                                    }
                                                    else
                                                    {
                                                        @datos.Carrera.Nombre
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Área</label>
                                                    <br />
                                                    @if (datos.Especialidad != null)
                                                    {
                                                        if (datos.Especialidad == "")
                                                        {
                                                            <div>N/A</div>
                                                        }
                                                        else
                                                        {
                                                            @datos.Especialidad
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <label class="text-danger">Sin actualizar</label>
                                                    }
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Turno</label>
                                                    <br />
                                                    @datos.Turno.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Teléfono celular</label>
                                                    <br />
                                                    @datos.Celular
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Teléfono de casa</label>
                                                    <br />
                                                    @datos.Telefono
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Teléfono de emergencia</label>
                                                    <br />
                                                    @datos.TelEmergencia
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">

                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Correo electrónico</label>
                                                    <br />
                                                    @datos.Email
                                                </div>
                                            </div>

                                            <div class="col-md-3">
                                                <div class="form-group">

                                                    @if (datos.Sexo == "HOMBRE")
                                                    {
                                                        <label>¿Está casado?</label>
                                                    }
                                                    else
                                                    {
                                                        <label>¿Está casada?</label>
                                                    }

                                                    <br />
                                                    @personales.Respuesta4.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>¿Tiene hijos?</label>
                                                    <br />
                                                    @personales.Respuesta5.Nombre
                                                </div>
                                            </div>
                                            @if (datos.Sexo == "MUJER")
                                            {
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label>¿Está embarazada?</label>
                                                        <br />
                                                        @personales.Respuesta11.Nombre
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label>Fotografía</label>
                                                    <br />
                                                    @if (datos.Foto == "")
                                                    {
                                                        <p>Imagen Inexistente</p>
                                                    }
                                                    else
                                                    {
                                                        <img src="@datos.Foto" style="width:100%;height:100%;">
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="row">
                                <div class="col-md-12">&nbsp;</div>
                            </div>
                        </div>
                    </div>

                    <!-- Aspectos Económicos -->
                    <div class="panel panel-default" style="background-color:white;">
                        <div class="panel-heading" style="text-align:center;">
                            <div class="row">
                                <div class="col-md-12">
                                    <h2>Aspectos Económicos</h2>
                                </div>
                            </div>
                        </div>
                        <div class="panel-body"></div>
                        <div class="row">
                            <div class="col-md-12 col-md-push-1">
                                <div class="row">


                                    @if (economicos.IdCiudad == 1)
                                    {
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>¿Reside en esta ciudad?</label>
                                                <br />
                                                @economicos.Respuesta1.Nombre
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>¿Reside en esta ciudad?</label>
                                                <br />
                                                @economicos.Respuesta1.Nombre
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Especifique en qué ciudad reside</label>
                                                <br />
                                                @economicos.Ciudad
                                            </div>
                                        </div>
                                    }
                                    @if (economicos.IdTipoFamiliar == 1)
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>¿Con quién vive actualmente?</label>
                                                <br />
                                                @economicos.Respuesta16.Nombre
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Especifique con quién vive</label>
                                                <br />
                                                @economicos.Familiar
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>¿Con quién vive actualmente?</label>
                                                <br />
                                                @economicos.Respuesta16.Nombre
                                            </div>
                                        </div>
                                    }

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>¿Trabaja?</label>
                                            <br />
                                            @economicos.Respuesta2.Nombre
                                        </div>
                                    </div>
                                </div>
                                <div class="row">

                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>¿A qué se dedica el papá?</label>
                                            <br />
                                            @economicos.OcupacionPapa
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>¿A qué se dedica la mamá?</label>
                                            <br />
                                            @economicos.OcupacionMama
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Cantidad de hermanos</label>
                                            <br />
                                            @economicos.CantidadHermano
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Ingreso mensual aproximado por miembro</label>
                                                <br />
                                                @economicos.Respuesta17.Nombre
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    @if (datos.IdGrado != 1)
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>¿Cuántas personas viven en casa? (Incluyéndole)</label>
                                                <br />
                                                @economicos.CantidadPersonas
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>¿Cuántas personas trabajan? (Incluyéndole)</label>
                                                <br />
                                                @economicos.CantidadTrabajan
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>¿Considera que necesita beca o algún tipo de apoyo?</label>
                                                <br />
                                                @economicos.Respuesta18.Nombre
                                            </div>
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="row">
                                <div class="col-md-12">&nbsp;</div>
                            </div>
                        </div>
                    </div>

                    <!-- Aspectos Académicos -->
                    <div class="panel panel-default" style="background-color:white;">
                        <div class="panel-heading" style="text-align:center;">
                            <div class="row">
                                <div class="col-md-12">
                                    <h2>Aspectos Académicos</h2>
                                </div>
                            </div>
                        </div>
                        <div class="panel-body"></div>
                        <div class="row">
                            <div class="col-md-12 col-md-push-1">
                                @if (datos.IdGrado == 1)
                                {
                                    <div class="row">
                                        @if (academicos.IdListaBachillerato == 1)
                                        {
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>¿De qué bachillerato egresó?</label>
                                                    <br />
                                                    @academicos.Respuesta12.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Bachillerato específico</label>
                                                    <br />
                                                    @academicos.Bachillerato
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Especialidad en el bachillerato</label>
                                                    <br />
                                                    @academicos.Especialidad
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>¿De qué bachillerato egresó?</label>
                                                    <br />
                                                    @academicos.Respuesta12.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Especialidad en el bachillerato</label>
                                                    <br />
                                                    @academicos.Especialidad
                                                </div>
                                            </div>
                                        }

                                    </div>

                                }
                                <div class="row">
                                    @if (datos.IdGrado == 1)
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Promedio general (Bachillerato)</label>
                                                <br />
                                                @academicos.Promedio
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Promedio general (Universidad)</label>
                                                <br />
                                                @academicos.Promedio
                                            </div>
                                        </div>
                                    }

                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>¿Cuenta con equipo de cómputo para estudiar?</label>
                                            <br />
                                            @academicos.Respuesta13.Nombre
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Tipo de dispositivo específico</label>
                                            <br />
                                            @academicos.Respuesta14.Nombre
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>¿Cuenta con servicio de conexión a internet?</label>
                                            <br />
                                            @academicos.Respuesta15.Nombre
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @if (datos.IdGrado != 1)
                                    {
                                        <div class="row">
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>¿Cómo es el rendimiento en clase?</label>
                                                    <br />
                                                    @academicos.RendimientoClase
                                                </div>
                                            </div>

                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>¿Cómo es la experiencia con los profesores?</label>
                                                    <br />
                                                    @academicos.ExperienciaProfe
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>¿Qué materias reprobó el periodo anterior?</label>
                                                    <br />
                                                    @academicos.MateriasRepro
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>¿Qué materia se le dificulta más actualmente?</label>
                                                    <br />
                                                    @academicos.MateriasDif
                                                </div>
                                            </div>
                                        </div>

                                    }
                                </div>

                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="row">
                                <div class="col-md-12">&nbsp;</div>
                            </div>
                        </div>
                    </div>

                    <!-- Aspectos Personales -->
