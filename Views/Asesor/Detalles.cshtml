                    text: mensaje,
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#28a745',
                    timer: 3000,
                    timerProgressBar: true
                });
            } else if (mensaje.indexOf("Error") > -1 || mensaje.indexOf("error") > -1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error al guardar',
                    text: mensaje,
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#dc3545'
                });
            } else {
                Swal.fire({
                    icon: 'info',
                    title: 'Información',
                    text: mensaje,
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#007bff'
                });
            }
        });
