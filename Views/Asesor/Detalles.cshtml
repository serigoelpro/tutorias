<!-- CONFIRMACIÓN ANTES DE GUARDAR -->
<script type="text/javascript">
    $(document).ready(function () {
        $('form').on('submit', function (e) {
            var vulnerable = $('#IdVulnerable').val();
            var eleccion = $('#IdEleccionVunerabilidad').val();

            if (vulnerable && eleccion) {
                e.preventDefault();

                Swal.fire({
                    title: '¿Confirmar guardado?',
                    html: '<strong>Vulnerable:</strong> ' + $('#IdVulnerable option:selected').text() + '<br><strong>Tipo:</strong> ' + $('#IdEleccionVunerabilidad option:selected').text(),
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#007bff',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, guardar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#btnGuardar').prop('disabled', true).text('Guardando...');
                        $('form')[0].submit();
                    }
                });
            }
        });
    });
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#btnDesbloquear').click(function () {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "El alumno podrá editar nuevamente su entrevista.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f0ad4e',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, desbloquear',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Desbloquear", "Asesor")',
                        type: 'POST',
                        data: { id: @datos.IdPersona },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    '¡Desbloqueado!',
                                    response.message,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error',
                                    response.message,
                                    'error'
                                );
                            }
                        },
                        error: function () {
                             Swal.fire(
                                'Error',
                                'Hubo un problema al procesar la solicitud.',
                                'error'
                            );
                        }
                    });
                }
            })
        });
    });
</script>

