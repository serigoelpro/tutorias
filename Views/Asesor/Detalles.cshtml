                            <div class="row">
                                <div class="col-md-12">
                                    <h2>Aspectos Personales</h2>
                                </div>
                            </div>
                        </div>
                        <div class="panel-body"></div>
                        <div class="row">
                            <div class="col-md-12 col-md-push-1">
                                @if (datos.IdGrado == 1)
                                {
                                    <div class="row">

                                        @if (personales.IdEnfermedad == 1)
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Padece alguna enfermedad?</label>
                                                    <br />
                                                    @personales.Respuesta6.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Enfermedad o alergia específica</label>
                                                    <br />
                                                    @personales.Especifica
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Padece alguna enfermedad?</label>
                                                    <br />
                                                    @personales.Respuesta6.Nombre
                                                </div>
                                            </div>
                                        }

                                        @if (personales.IdFuma == 1)
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Fuma?</label>
                                                    <br />
                                                    @personales.Respuesta7.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Cantidad y frecuencia</label>
                                                    <br />
                                                    @personales.CantidadFuma
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Fuma?</label>
                                                    <br />
                                                    @personales.Respuesta7.Nombre
                                                </div>
                                            </div>
                                        }
                                        @if (personales.IdBebida == 1)
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Ingiere bebidas alcohólicas?</label>
                                                    <br />
                                                    @personales.Respuesta8.Nombre
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Cantidad y frecuencia</label>
                                                    <br />
                                                    @personales.CantidadBedida
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>¿Ingiere bebidas alcohólicas?</label>
                                                    <br />
                                                    @personales.Respuesta8.Nombre
                                                </div>
                                            </div>
                                        }
                                        <div class="col-md-2">
