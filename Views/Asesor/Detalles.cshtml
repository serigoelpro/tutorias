<script type="text/javascript">
    $(document).ready(function () {
        // Define los colores del semáforo según el nivel de desempeño
        var coloresSemaforo = {
            // Autoestima
            'Autoestima baja': '#dc3545',           // Rojo
            'Autoestima media': '#ffc107',          // Naranja
            'Autoestima elevada': '#28a745',        // Verde

            // Tamizaje
            'Sin riesgo': '#28a745',                    // Verde
            'Riesgo moderado': '#ffc107',               // Naranja
            'Riesgo alto': '#dc3545',                   // Rojo

            // Pensamiento Abstracto
            'Limítrofe / Promedio Bajo': '#dc3545',     // Rojo
            'Promedio': '#ffc107',                      // Naranja
            'Superior': '#28a745',                      // Verde


            // Economico
            'Ingreso suficiente': '#28a745',            // Verde
            'Dificultad económica': '#ffc107',          // Naranja
            'Problema económico': '#dc3545',            // Rojo

            // Academico
            'Sin materias': '#28a745',                  // Verde
            '1-3 materias reprobadas': '#ffc107',       // Naranja
            'Más de 3 materias reprobadas': '#dc3545',  // Rojo

            // Personal
            'Sin problemas': '#28a745',                 // Verde
            'Incomodidad leve': '#ffc107',              // Naranja
            'Afectación emocional': '#dc3545',          // Rojo
        };

        // Función para actualizar el color del semáforo
        function actualizarSemaforo(dropdown) {
            var textoSeleccionado = $(dropdown).find('option:selected').text();
            var area = $(dropdown).data('area');
            var semaforoId = '#semaforo-' + area;

            if (textoSeleccionado && textoSeleccionado !== 'Seleccione nivel de desempeño') {
                var color = coloresSemaforo[textoSeleccionado];
                if (color) {
                    $(semaforoId).css('background-color', color);
                }
            } else {
                $(semaforoId).css('background-color', 'transparent');
            }
        }

        // Aplicar cambio de color al cambiar la selección
        $('.nivel-desempeno').change(function () {
            actualizarSemaforo(this);
        });

        // Inicializar colores si ya hay valores seleccionados al cargar la página
        $('.nivel-desempeno').each(function () {
            actualizarSemaforo(this);
        });
    });
</script>
<script>
    $(document).ready(function () {
        // VARIABLE CRÍTICA: ID de persona actual desde Razor
        var currentIdPersona = @idPersonaActual;

        // TOKEN ACTUAL desde la URL
        var currentToken = '@Request.QueryString["token"]';

        console.log('=== Inicializando navegación ===');
        console.log('ID Persona:', currentIdPersona);
        console.log('Token recibido:', currentToken ? '✓ Sí' : '✗ No');

        // 1. Verificar ID válido
        if (currentIdPersona <= 0) {
            console.error('⚠️ ID de persona inválido');
            $('#posicionActual').text('Error: ID inválido');
            $('#btnAnterior, #btnSiguiente').prop('disabled', true);
            return;
        }

        // 2. Verificar token
        if (!currentToken || currentToken === '') {
            console.error('⚠️ Token no disponible');
            $('#posicionActual').text('Error: Sin token');
            $('#btnAnterior, #btnSiguiente').prop('disabled', true);
            return;
        }

        // 3. LLAMADA AJAX para obtener navegación
        $.ajax({
            type: 'POST',
            url: '@Url.Action("ObtenerNavegacionEntrevistas", "Asesor")',
            data: {
                idPersona: currentIdPersona,
                token: currentToken
            },
            dataType: 'json',
            beforeSend: function() {
                $('#posicionActual').text('Cargando...');
                console.log('→ Enviando petición AJAX...');
            },
            success: function (response) {
                console.log('✓ Respuesta recibida:', response);

                if (response.success) {
                    // Actualizar posición
                    $('#posicionActual').text(response.posicion + ' de ' + response.total);

                    // --- Botón ANTERIOR ---
                    if (response.idAnterior && response.tokenAnterior) {
                        $('#btnAnterior')
                            .data('id', response.idAnterior)
                            .data('token', response.tokenAnterior)
                            .prop('disabled', false);
                        console.log('✓ Botón Anterior habilitado (ID:', response.idAnterior + ')');
                    } else {
                        $('#btnAnterior').prop('disabled', true);
                        console.log('⊗ Botón Anterior deshabilitado (primer alumno)');
                    }

                    // --- Botón SIGUIENTE ---
                    if (response.idSiguiente && response.tokenSiguiente) {
                        $('#btnSiguiente')
                            .data('id', response.idSiguiente)
                            .data('token', response.tokenSiguiente)
                            .prop('disabled', false);
                        console.log('✓ Botón Siguiente habilitado (ID:', response.idSiguiente + ')');
                    } else {
                        $('#btnSiguiente').prop('disabled', true);
                        console.log('⊗ Botón Siguiente deshabilitado (último alumno)');
                    }

                } else {
                    console.error('✗ Error en respuesta:', response.message);
                    $('#posicionActual').text('Error');
                    $('#btnAnterior, #btnSiguiente').prop('disabled', true);
                    alert('Error al cargar navegación: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error('✗ Error AJAX:', error);
                console.error('Status:', status);
                console.error('Response:', xhr.responseText);
                $('#posicionActual').text('Error de conexión');
                $('#btnAnterior, #btnSiguiente').prop('disabled', true);
                alert('Error de conexión al cargar la navegación. Por favor recarga la página.');
            }
        });

        // 4. EVENTOS CLICK de los botones
        $('#btnAnterior').click(function (e) {
            e.preventDefault();
            var idAnterior = $(this).data('id');
            var tokenAnterior = $(this).data('token');

            console.log('→ Click Anterior - ID:', idAnterior);

            if (idAnterior && tokenAnterior) {
                // Deshabilitar botones para evitar clics múltiples
                $('.navegacion-entrevistas button').addClass('btn-navegando');

                var url = '@Url.Action("Detalles", "Asesor", new { id = (int?)null })' +
                    '?id=' + idAnterior +
                    '&token=' + encodeURIComponent(tokenAnterior);

                console.log('→ Navegando a:', url);
                window.location.href = url;
            } else {
                console.error('Datos de navegación anterior no disponibles');
            }
        });

        $('#btnSiguiente').click(function (e) {
            e.preventDefault();
            var idSiguiente = $(this).data('id');
            var tokenSiguiente = $(this).data('token');

            console.log('→ Click Siguiente - ID:', idSiguiente);

            if (idSiguiente && tokenSiguiente) {
                // Deshabilitar botones para evitar clics múltiples
                $('.navegacion-entrevistas button').addClass('btn-navegando');

                var url = '@Url.Action("Detalles", "Asesor", new { id = (int?)null })' +
                    '?id=' + idSiguiente +
                    '&token=' + encodeURIComponent(tokenSiguiente);

                console.log('→ Navegando a:', url);
                window.location.href = url;
            } else {
                console.error('Datos de navegación siguiente no disponibles');
            }
        });

        console.log('=== Navegación inicializada correctamente ===');
    });
</script>
<script>
    // Manejar navegación con flechas del historial del navegador
    (function() {
        var navigationRefreshed = false;
        var currentIdPersona = @idPersonaActual;

        function refreshNavigation() {
            if (currentIdPersona <= 0) {
                console.error('ID de persona inválido');
                return;
            }

            console.log('=== Refrescando navegación ===');

            // Remover la clase que bloquea los botones (si quedó del clic anterior)
            $('.navegacion-entrevistas button').removeClass('btn-navegando');

            // Mostrar estado de carga
            $('#posicionActual').text('Actualizando...');
            $('#btnAnterior, #btnSiguiente').prop('disabled', true);

            // Solicitar nuevo token al servidor
            $.ajax({
                type: 'POST',
                url: '@Url.Action("RegenerarTokenNavegacion", "Asesor")',
                data: { idPersona: currentIdPersona },
                dataType: 'json',
                success: function(tokenResponse) {
                    if (tokenResponse.success) {
                        console.log('✓ Token regenerado exitosamente');

                        // Ahora obtener la navegación con el nuevo token
                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("ObtenerNavegacionEntrevistas", "Asesor")',
                            data: {
                                idPersona: currentIdPersona,
                                token: tokenResponse.token
                            },
                            dataType: 'json',
                            success: function(navResponse) {
                                if (navResponse.success) {
                                    $('#posicionActual').text(navResponse.posicion + ' de ' + navResponse.total);

                                    if (navResponse.idAnterior && navResponse.tokenAnterior) {
                                        $('#btnAnterior')
                                            .data('id', navResponse.idAnterior)
                                            .data('token', navResponse.tokenAnterior)
                                            .prop('disabled', false);
                                    }

                                    if (navResponse.idSiguiente && navResponse.tokenSiguiente) {
                                        $('#btnSiguiente')
                                            .data('id', navResponse.idSiguiente)
                                            .data('token', navResponse.tokenSiguiente)
                                            .prop('disabled', false);
                                    }

                                    console.log('✓ Navegación actualizada');
                                } else {
                                    console.error('Error al obtener navegación:', navResponse.message);
                                    $('#posicionActual').text('Error');
                                }
                            },
                            error: function() {
                                console.error('Error de conexión al obtener navegación');
                                $('#posicionActual').text('Error');
                            }
                        });
                    } else {
                        console.error('Error al regenerar token:', tokenResponse.message);
                        $('#posicionActual').text('Error');
                    }
                },
                error: function() {
                    console.error('Error de conexión al regenerar token');
                    $('#posicionActual').text('Error');
                }
            });
        }

        // Evento pageshow: se dispara cuando la página se muestra (incluido desde bfcache)
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                console.log('Página restaurada desde bfcache');
                refreshNavigation();
            }
        });

        // Evento visibilitychange: se dispara cuando el usuario vuelve a la pestaña
        document.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'visible' && navigationRefreshed) {
                // Solo refrescar si ya se había inicializado antes
                console.log('Pestaña visible de nuevo, refrescando navegación');
                refreshNavigation();
            }
        });

        // Marcar como inicializado después de un pequeño delay
        setTimeout(function() {
            navigationRefreshed = true;
        }, 2000);
    })();
</script>
