@model IEnumerable<Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales>
@using Plataforma_Web.Models
@using PlataformaWeb.Helpers
@{
    ViewBag.Title = "Grupo";
    Usuario usuario = Session["Usuario"] as Usuario;
    int i = 0;

    // ✅ OBTENER DATOS DEL GRUPO DEL USUARIO ACTUAL
    string grupoActual = "N/A";
    int idGrupoActual = 1;
    int idCarreraActual = 1;
    int idGradoActual = 1;

    var alumnos = ViewBag.Alumnos as List<Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales>;
    if (alumnos == null)
    {
        alumnos = new List<Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales>();
    }

    // Si hay alumnos, obtener datos del primer alumno para determinar el grupo
    if (alumnos.Any())
    {
        var primerAlumno = alumnos.First();
        idGrupoActual = primerAlumno.IdGrupo;
        idCarreraActual = primerAlumno.IdCarrera;
        idGradoActual = primerAlumno.IdGrado;

        // Intentar obtener nombres reales o usar IDs
        if (primerAlumno.Grupo != null)
        {
            grupoActual = primerAlumno.Grupo.Nombre;
        }
        else
        {
            grupoActual = idGrupoActual.ToString();
        }
    }
}

<h2>Grupo</h2>

<!-- ✅ SOLO BOTÓN DE 3 PUNTOS CON MENÚ -->
<div class="menu-container-standalone">
    <button type="button" class="btn-menu-trigger-green" onclick="toggleMenuAcciones(event)" title="Gestión de Calificaciones">
        <span class="menu-icon">⋮</span>
    </button>

    <!-- Menú de acciones (oculto por defecto) -->
    <div id="menu-acciones" class="menu-acciones-standalone" style="display: none;">
        <!-- Botones de acción en línea -->
        <div class="menu-buttons">
            <button type="button" class="btn btn-success btn-compact" onclick="exportarMaterias()" title="Descargar plantilla Excel">
                <span class="glyphicon glyphicon-download-alt"></span> Exportar Excel
            </button>
            <button type="button" class="btn btn-primary btn-compact" id="btn-importar-modal" title="Subir Excel con calificaciones">
                <span class="glyphicon glyphicon-cloud-upload"></span> Importar Excel
            </button>
            <!-- ✅ NUEVO BOTÓN DE ARRASTRE -->
            <button type="button" class="btn btn-danger btn-compact" onclick="verArrastrePorGrupo()" title="Ver materias de arrastre del grupo">
                <span class="glyphicon glyphicon-exclamation-triangle"></span> Consultar Arrastre
            </button>
            <button type="button" class="btn btn-info btn-compact btn-help" onclick="mostrarAyudaRapida()" title="Ver flujo de trabajo">
                <span class="glyphicon glyphicon-question-sign"></span> Ayuda
            </button>
        </div>

        <hr class="menu-divider">

        <!-- Info del grupo y flujo -->
        <div class="menu-info-section">
            <h5><strong>Gestión de Calificaciones - Grupo @grupoActual</strong></h5>
            <p class="menu-flujo">
                <strong>Flujo:</strong> 1) Exportar plantilla → 2) Llenar calificaciones → 3) Importar archivo → 4) Verificar resultados
            </p>
        </div>

        <hr class="menu-divider">

        <!-- ✅ NUEVA SECCIÓN: INFO SOBRE ARRASTRE -->
        <div class="menu-info-section">
            <h5><strong>📊 Consulta de Arrastre por Grupo</strong></h5>
            <p class="menu-flujo">
                <strong>Función:</strong> Ver alumnos con materias reprobadas → Clasificación por criticidad → Seguimiento individual → Programar extraordinarios
            </p>
            <p class="menu-flujo" style="font-size: 11px; color: #888;">
                <strong>Criticidad:</strong> 🔴 1er-2do cuatri (crítico) | 🟡 3er cuatri (medio) | 🔵 4to+ cuatri (reciente)
            </p>
        </div>
    </div>
</div>
<div style="clear: both;"></div>

<!-- ✅ MODAL PARA IMPORTACIÓN DE EXCEL -->
<div class="modal fade" id="modalImportarExcel" tabindex="-1" role="dialog" aria-labelledby="modalImportarLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modalImportarLabel">
                    <span class="glyphicon glyphicon-cloud-upload text-primary"></span>
                    Importar Calificaciones desde Excel
                </h4>
                <p class="text-muted">Grupo: <strong>@grupoActual</strong></p>
            </div>

            <div class="modal-body">
                <!-- Instrucciones rápidas -->
                <div class="alert alert-info alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h5><span class="glyphicon glyphicon-info-sign"></span> <strong>Instrucciones:</strong></h5>
                    <ol>
                        <li><strong>Exporta la plantilla</strong> con el botón "Descargar Plantilla"</li>
                        <li><strong>Completa las calificaciones</strong> en el Excel (valores 0-10)</li>
                        <li><strong>Sube el archivo</strong> usando el formulario inferior</li>
                        <li><strong>El sistema procesará</strong> automáticamente las calificaciones</li>
                    </ol>
                </div>

                <!-- Formulario de importación -->
                <form id="formImportarModal" enctype="multipart/form-data">
                    <input type="hidden" name="idGrupo" value="@idGrupoActual" />
                    <input type="hidden" name="idCarrera" value="@idCarreraActual" />
                    <input type="hidden" name="idGrado" value="@idGradoActual" />

                    <!-- Información del grupo -->
                    <div class="form-group">
                        <label class="control-label"><strong>Grupo Destino:</strong></label>
                        <div class="well well-sm">
                            <span class="label label-info">@grupoActual</span>
                            <small class="text-muted">(Grupo: @idGrupoActual, Carrera: @idCarreraActual, Grado: @idGradoActual)</small>
                        </div>
                    </div>

                    <!-- Selector de archivo -->
                    <div class="form-group">
                        <label for="archivoExcelModal" class="control-label">
                            <span class="glyphicon glyphicon-file"></span> <strong>Archivo Excel:</strong>
                        </label>
                        <div class="input-group">
                            <input type="file"
                                   id="archivoExcelModal"
                                   name="archivoExcel"
                                   class="form-control"
                                   accept=".xlsx,.xls"
                                   onchange="validarArchivoModal(this)" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-folder-open"></span>
                            </span>
                        </div>
                        <small class="help-block">Selecciona el archivo Excel (.xlsx o .xls) con las calificaciones completadas.</small>

                        <!-- Información del archivo seleccionado -->
                        <div id="info-archivo-modal" class="alert alert-success" style="display: none; margin-top: 10px;">
                            <h6><span class="glyphicon glyphicon-file"></span> <strong>Archivo seleccionado:</strong></h6>
                            <p id="nombre-archivo-modal" style="margin: 0;"></p>
                            <p id="tamaño-archivo-modal" style="margin: 0;"></p>
                        </div>
                    </div>

                    <!-- Progress bar para el proceso -->
                    <div id="progress-container" style="display: none;">
                        <div class="form-group">
                            <label class="control-label">Progreso del procesamiento:</label>
                            <div class="progress">
                                <div id="progress-bar" class="progress-bar progress-bar-striped active"
                                     role="progressbar" style="width: 0%">
                                    <span id="progress-text">Preparando...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <div class="btn-group">
                    <!-- Botón para descargar plantilla -->
                    <a href="@Url.Action("MateriasGrupo", "Exportar", new { idGrupo = idGrupoActual, idCarrera = idCarreraActual, idGrado = idGradoActual })"
                       class="btn btn-info" target="_blank">
                        <span class="glyphicon glyphicon-download-alt"></span> Descargar Plantilla
                    </a>

                    <!-- Botón de procesamiento -->
                    <button type="button" class="btn btn-success" id="btn-procesar-modal" onclick="procesarExcelModal()" disabled>
                        <span class="glyphicon glyphicon-cog"></span> Procesar e Importar
                    </button>

                    <!-- Botón cerrar -->
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <span class="glyphicon glyphicon-remove"></span> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ MODAL PARA MOSTRAR RESULTADOS -->
<div class="modal fade" id="modalResultados" tabindex="-1" role="dialog" aria-labelledby="modalResultadosLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modalResultadosLabel">
                    <span id="icono-resultado" class="glyphicon"></span>
                    Resultados de la Importación
                </h4>
            </div>

            <div class="modal-body" id="contenido-resultados">
                <!-- Los resultados se cargarán aquí dinámicamente -->
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="volverAImportar()">
                    <span class="glyphicon glyphicon-upload"></span> Importar Otro Archivo
                </button>
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <span class="glyphicon glyphicon-remove"></span> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ TABLA ORIGINAL SIN MODIFICACIONES -->
<table class="table">
    <tr>
        <th>#</th>
        <th>@Html.DisplayNameFor(model => model.Matricula)</th>
        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
        <th>@Html.DisplayNameFor(model => model.Estado)</th>
        <th>Detalles</th>
        <th>Imprimir</th>
        <th>Seguimiento individual</th>
        <th><b>Control de Materias</b></th>
        <th>Tramitar baja de alumno</th>
        <th>Remover del grupo</th>
        <th>Eliminacion definitiva</th>
    </tr>

    @foreach (var item in (ViewBag.Alumnos as List<Plataforma_Web.Models.PrimeraEntrevista.DatosPersonales>))
    {
        i++;
        <tr>
            <th>@i.ToString()</th>
            <td>@Html.DisplayFor(modelItem => item.Matricula)</td>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>

            @if (item.Estado == true)
            {
                <td>
                    <span class="glyphicon glyphicon-eye-open" style="color:green"></span>
                    Revisado
                    <br />
                    @if (usuario != null)
                    {
                        string token = AccesoSeguroHelper.GenerarToken(item.IdPersona, usuario.IdUsuario);
                        <form action="@Url.Action("Desbloquear", "Asesor")" method="post" style="display:inline-block; margin-top:5px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.IdPersona" />
                            <input type="hidden" name="token" value="@token" />
                            <button type="submit" class="btn btn-warning btn-xs" onclick="return confirm('¿Seguro que desea desbloquear esta entrevista? El alumno podrá editarla nuevamente.');" title="Desbloquear edición">
                                <span class="glyphicon glyphicon-lock"></span> Desbloquear
                            </button>
                        </form>
                    }
                </td>
            }
            else
            {
                <td>
                    <span class="glyphicon glyphicon-edit" style="color:red"></span>
                    Sin Revisar
                </td>
            }

            @if (item.Estado == true)
            {
                <td>
                    <a class="btn btn-primary" href="@Url.Action("Detalles", new { id = item.IdPersona })">
                        <span class="glyphicon glyphicon-eye-open"></span> Ver
                    </a>
                </td>
            }
            else
            {
                <td></td>
            }

            @if (item.Estado == true)
            {
                <td>
                    <a class="btn btn-primary" href="@Url.Action("ReporteEntrevista", new { id = item.IdPersona })">
                        <span class="glyphicon glyphicon-paperclip"></span> Imprimir
                    </a>
                </td>
            }
            else
            {
                <td></td>
            }

            <td>
                <a class="btn btn-primary" href="@Url.Action("Index", "Individuals", new { id = item.IdPersona })">
                    <span class="glyphicon glyphicon-file"></span> Seguimiento individual
                </a>
            </td>

            <td>
                <a class="btn btn-primary" href="@Url.Action("Index", "MateriasAlumno", new { id = item.IdPersona })">
                    <span class="glyphicon glyphicon-book"></span> Materias
                </a>
            </td>

            <td>
                <a class="btn btn-primary" href="@Url.Action("Index", "Bajas", new { id = item.IdPersona })">
                    <span class="glyphicon glyphicon-file"></span> Tramitar baja
                </a>
            </td>

            @if (item.Grado != null)
            {
                <td>
                    <a class="btn btn-danger" href="@Url.Action("Opcion1", "Reportar", new { id = item.IdPersona })">
                        <span class="glyphicon glyphicon-exclamation-sign"></span> Remover del grupo
                    </a>
                </td>
            }
            else
            {
                <td>Removido</td>
            }

            <td>
                <a class="btn btn-danger" href="@Url.Action("Eliminar", new { id = item.IdPersona })">
                    <span class="glyphicon glyphicon-exclamation-sign"></span> Eliminación
                </a>
            </td>
        </tr>
    }
</table>

<!-- ✅ JAVASCRIPT OPTIMIZADO CON FUNCIONALIDAD DE MODAL + NUEVA FUNCIÓN DE ARRASTRE -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<script>
// Variables del grupo actual
var idGrupo = @idGrupoActual;
var idCarrera = @idCarreraActual;
var idGrado = @idGradoActual;
var nombreGrupo = '@grupoActual';

// Debug: Verificar que las variables se cargaron correctamente
console.log('=== DEBUG: Variables del grupo ===');
console.log('idGrupo:', idGrupo);
console.log('idCarrera:', idCarrera);
console.log('idGrado:', idGrado);
console.log('nombreGrupo:', nombreGrupo);

// ====================================================================
// ✅ NUEVA FUNCIÓN PARA TOGGLE DEL MENÚ DE ACCIONES
// ====================================================================
function toggleMenuAcciones(event) {
    event.stopPropagation(); // Evitar propagación

    var menu = document.getElementById('menu-acciones');
    var trigger = event.currentTarget;
    var icon = trigger.querySelector('.menu-icon');

    if (menu.style.display === 'none' || menu.style.display === '') {
        // Abrir menú
        menu.style.display = 'block';
        icon.textContent = '×';
        trigger.classList.add('active');

        // Agregar listener para cerrar al hacer clic fuera
        setTimeout(function() {
            document.addEventListener('click', cerrarMenuAcciones);
        }, 10);
    } else {
        // Cerrar menú
        cerrarMenuAcciones();
    }
}

function cerrarMenuAcciones() {
    var menu = document.getElementById('menu-acciones');
    var trigger = document.querySelector('.btn-menu-trigger-green');
    var icon = trigger.querySelector('.menu-icon');

    menu.style.display = 'none';
    icon.textContent = '⋮';
    trigger.classList.remove('active');

    // Remover listener
    document.removeEventListener('click', cerrarMenuAcciones);
}

// ====================================================================
// ✅ FUNCIÓN PARA EXPORTAR MATERIAS
// ====================================================================
function exportarMaterias() {
    console.log('=== Exportando materias ===');
    cerrarMenuAcciones(); // Cerrar menú al hacer clic
    var url = '/Exportar/MateriasGrupo?idGrupo=' + idGrupo + '&idCarrera=' + idCarrera + '&idGrado=' + idGrado;
    console.log('URL de exportación:', url);
    window.location.href = url;
    showNotificationCompact('✅ Descarga iniciada', 'success', 2000);
}

// ====================================================================
// ✅ NUEVA FUNCIÓN PARA VER ARRASTRE POR GRUPO
// ====================================================================
function verArrastrePorGrupo() {
    console.log('=== Abriendo consulta de arrastre por grupo ===');
    cerrarMenuAcciones(); // Cerrar menú al hacer clic

    var url = '@Url.Action("ArrastrePorGrupo", "MateriasAlumno")' +
              '?idGrupo=' + idGrupo +
              '&idCarrera=' + idCarrera +
              '&idGrado=' + idGrado;

    console.log('URL de arrastre por grupo:', url);

    // Mostrar notificación
    showNotificationCompact('📋 Cargando consulta de arrastre...', 'info', 2000);

    // Redirigir a la nueva vista
    window.location.href = url;
}

// ====================================================================
// ✅ FUNCIÓN PARA ABRIR MODAL DE IMPORTACIÓN
// ====================================================================
function abrirModalImportar() {
    console.log('=== Abriendo modal de importación ===');
    cerrarMenuAcciones(); // Cerrar menú al hacer clic

    // Verificar que el modal existe
    if ($('#modalImportarExcel').length === 0) {
        console.error('ERROR: Modal #modalImportarExcel no encontrado');
        alert('Error: No se encontró el modal de importación. Redirigiendo a la página tradicional...');
        // Fallback a página tradicional
        var urlTradicional = '@Url.Action("Index", "Importar")' +
                           '?idGrupo=' + idGrupo +
                           '&idCarrera=' + idCarrera +
                           '&idGrado=' + idGrado;
        window.location.href = urlTradicional;
        return;
    }

    console.log('Modal encontrado, limpiando formulario...');

    // Limpiar formulario
    $('#formImportarModal')[0].reset();
    $('#info-archivo-modal').hide();
    $('#progress-container').hide();
    $('#btn-procesar-modal').prop('disabled', true);

    console.log('Mostrando modal...');

    // Mostrar modal
    $('#modalImportarExcel').modal('show');

    showNotificationCompact('📤 Modal de importación abierto', 'info', 1500);
}

// ====================================================================
// ✅ FUNCIÓN PARA VALIDAR ARCHIVO EN MODAL
// ====================================================================
function validarArchivoModal(input) {
    console.log('=== Validando archivo en modal ===');
    var archivo = input.files[0];
    var infoDiv = $('#info-archivo-modal');
    var btnProcesar = $('#btn-procesar-modal');

    if (archivo) {
        console.log('Archivo seleccionado:', archivo.name);

        // Validación de extensión
        var extension = archivo.name.toLowerCase().split('.').pop();
        console.log('Extensión del archivo:', extension);

        if (extension !== 'xlsx' && extension !== 'xls') {
            console.error('Extensión inválida:', extension);
            alert('❌ Error: El archivo debe ser un Excel (.xlsx o .xls)');
            input.value = '';
            infoDiv.hide();
            btnProcesar.prop('disabled', true);
            return;
        }

        // Validar tamaño (máximo 10MB)
        var tamañoMB = (archivo.size / 1024 / 1024).toFixed(2);
        console.log('Tamaño del archivo:', tamañoMB, 'MB');

        if (archivo.size > 10 * 1024 * 1024) {
            console.error('Archivo demasiado grande:', tamañoMB, 'MB');
            alert('❌ Error: El archivo es demasiado grande. Máximo 10MB permitido.');
            input.value = '';
            infoDiv.hide();
            btnProcesar.prop('disabled', true);
            return;
        }

        // Mostrar información del archivo válido
        $('#nombre-archivo-modal').html('<strong>Nombre:</strong> ' + archivo.name);
        $('#tamaño-archivo-modal').html('<strong>Tamaño:</strong> ' + tamañoMB + ' MB');
        infoDiv.show();
        btnProcesar.prop('disabled', false);

        console.log('✓ Archivo Excel válido seleccionado:', archivo.name);
    } else {
        console.log('No hay archivo seleccionado');
        infoDiv.hide();
        btnProcesar.prop('disabled', true);
    }
}

// ====================================================================
// ✅ FUNCIÓN PARA PROCESAR EXCEL DESDE MODAL
// ====================================================================
function procesarExcelModal() {
    console.log('=== Procesando Excel desde modal ===');
    var archivo = $('#archivoExcelModal')[0].files[0];

    if (!archivo) {
        console.error('No hay archivo seleccionado');
        alert('❌ Por favor selecciona un archivo Excel para importar.');
        return;
    }

    console.log('Archivo a procesar:', archivo.name);

    // Confirmación
    if (!confirm('¿Estás seguro de que deseas importar las calificaciones desde este archivo?\n\n' +
                 'Archivo: ' + archivo.name + '\n' +
                 'Grupo: ' + nombreGrupo + '\n\n' +
                 '⚠️ Las calificaciones se registrarán en el sistema.')) {
        console.log('Usuario canceló la importación');
        return;
    }

    console.log('Usuario confirmó, iniciando procesamiento...');

    // Mostrar barra de progreso
    $('#progress-container').show();
    $('#btn-procesar-modal').prop('disabled', true);

    // Simular progreso
    actualizarProgreso(0, 'Iniciando procesamiento...');

    // Crear FormData para envío
    var formData = new FormData();
    formData.append('archivoExcel', archivo);
    formData.append('idGrupo', idGrupo);
    formData.append('idCarrera', idCarrera);
    formData.append('idGrado', idGrado);

    console.log('FormData creado, enviando AJAX...');

    // Realizar petición AJAX
    $.ajax({
        url: '@Url.Action("ProcesarExcel", "Importar")',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        timeout: 120000, // 2 minutos timeout
        xhr: function() {
            var xhr = new window.XMLHttpRequest();
            // Simular progreso durante la carga
            xhr.upload.addEventListener("progress", function(evt) {
                if (evt.lengthComputable) {
                    var percentComplete = (evt.loaded / evt.total) * 50; // Solo 50% para la carga
                    actualizarProgreso(percentComplete, 'Subiendo archivo...');
                }
            }, false);
            return xhr;
        },
        beforeSend: function() {
            console.log('Enviando petición AJAX...');
            actualizarProgreso(10, 'Validando archivo...');
        },
        success: function(response) {
            console.log('AJAX exitoso, respuesta recibida');
            actualizarProgreso(80, 'Procesando calificaciones...');

            setTimeout(function() {
                actualizarProgreso(100, '¡Completado!');

                setTimeout(function() {
                    console.log('Cerrando modal de importación...');
                    // Cerrar modal de importación
                    $('#modalImportarExcel').modal('hide');

                    // Mostrar resultados en modal de resultados
                    mostrarResultadosEnModal(response);
                }, 500);
            }, 1000);
        },
        error: function(xhr, status, error) {
            console.error('Error en AJAX:', status, error);
            console.error('Respuesta del servidor:', xhr.responseText);
            actualizarProgreso(0, 'Error en el procesamiento');

            var mensajeError = 'Error al procesar el archivo';
            if (xhr.responseText) {
                try {
                    var errorResponse = JSON.parse(xhr.responseText);
                    mensajeError = errorResponse.mensaje || mensajeError;
                } catch (e) {
                    console.error('No se pudo parsear respuesta de error');
                }
            }

            alert('❌ ' + mensajeError);
            $('#btn-procesar-modal').prop('disabled', false);
            $('#progress-container').hide();
        }
    });
}

// ====================================================================
// ✅ FUNCIÓN PARA ACTUALIZAR BARRA DE PROGRESO
// ====================================================================
function actualizarProgreso(porcentaje, mensaje) {
    $('#progress-bar').css('width', porcentaje + '%');
    $('#progress-text').text(mensaje + ' (' + Math.round(porcentaje) + '%)');

    // Cambiar color según progreso
    if (porcentaje === 100) {
        $('#progress-bar').removeClass('progress-bar-striped active')
                          .addClass('progress-bar-success');
    }
}

// ====================================================================
// ✅ FUNCIÓN PARA MOSTRAR RESULTADOS EN MODAL
// ====================================================================
function mostrarResultadosEnModal(htmlResultado) {
    console.log('=== Mostrando resultados en modal ===');
    console.log('Tipo de respuesta:', typeof htmlResultado);

    var contenido = '';
    var esExitoso = false;

    try {
        // Si la respuesta es un objeto JSON (respuesta AJAX)
        if (typeof htmlResultado === 'object' && htmlResultado.html) {
            console.log('Respuesta es objeto JSON con HTML');
            contenido = htmlResultado.html;
            esExitoso = htmlResultado.exito || false;
        }
        // Si la respuesta es HTML directo
        else if (typeof htmlResultado === 'string') {
            console.log('Respuesta es HTML string');
            // Extraer contenido del body de la respuesta
            var $response = $(htmlResultado);
            contenido = $response.find('.container-fluid').html();

            // Si no se encuentra el contenedor, usar toda la respuesta
            if (!contenido || contenido.trim() === '') {
                contenido = htmlResultado;
            }

            // Determinar si fue exitoso basado en el contenido HTML
            esExitoso = contenido.indexOf('panel-success') !== -1 ||
                       contenido.indexOf('Importación Completada') !== -1 ||
                       contenido.indexOf('glyphicon-ok-circle') !== -1;
        }
        // Si no podemos determinar el tipo
        else {
            console.log('Tipo de respuesta desconocido, usando como string');
            contenido = String(htmlResultado);
            esExitoso = false;
        }

        console.log('Contenido extraído (primeros 200 chars):', contenido.substring(0, 200));
        console.log('Importación exitosa:', esExitoso);

        // Verificar que tenemos contenido válido
        if (!contenido || contenido.trim() === '') {
            throw new Error('No se pudo extraer contenido válido de la respuesta');
        }

    } catch (error) {
        console.error('Error procesando respuesta:', error);
        // Crear contenido de error
        contenido = `
            <div class="alert alert-danger">
                <h4><span class="glyphicon glyphicon-exclamation-triangle"></span> Error al procesar resultados</h4>
                <p>Hubo un problema al mostrar los resultados de la importación.</p>
                <p><strong>Error:</strong> ${error.message}</p>
                <p>Por favor, verifica manualmente el estado de las calificaciones o intenta nuevamente.</p>
            </div>
        `;
        esExitoso = false;
    }

    // Configurar icono del modal
    if (esExitoso) {
        $('#icono-resultado').removeClass().addClass('glyphicon glyphicon-ok-circle text-success');
    } else {
        $('#icono-resultado').removeClass().addClass('glyphicon glyphicon-exclamation-triangle text-danger');
    }

    // Cargar contenido en el modal
    $('#contenido-resultados').html(contenido);

    // Mostrar modal de resultados
    $('#modalResultados').modal('show');

    // ✅ SOLUCIÓN CORREGIDA: Configurar paneles colapsables después de mostrar el modal
    $('#modalResultados').on('shown.bs.modal', function() {
        initializeCollapseInModal();
    });

    // Mostrar notificación
    if (esExitoso) {
        showNotificationCompact('✅ Importación completada exitosamente', 'success', 3000);
    } else {
        showNotificationCompact('⚠️ Importación completada con errores', 'warning', 3000);
    }
}

// ====================================================================
// ✅ FUNCIÓN CORREGIDA PARA PANELES COLAPSABLES - SOLUCIÓN DIRECTA
// ====================================================================
function initializeCollapseInModal() {
    console.log('=== Inicializando paneles colapsables en modal (SOLUCIÓN DIRECTA) ===');

    // ✅ LIMPIAR EVENT LISTENERS PREVIOS
    $('#contenido-resultados').off('click.panel-collapse-custom');

    // ✅ IMPLEMENTACIÓN MANUAL SIMPLE Y DIRECTA
    $('#contenido-resultados').on('click.panel-collapse-custom', '[data-toggle="collapse"]', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $trigger = $(this);
        var target = $trigger.attr('href');
        var $target = $(target);
        var $icon = $trigger.find('.glyphicon-chevron-down, .glyphicon-chevron-up');

        console.log('Click en panel:', target);

        if ($target.length === 0) {
            console.error('Target no encontrado:', target);
            return;
        }

        // ✅ TOGGLE SIMPLE CON SLIDEUP/SLIDEDOWN
        if ($target.is(':visible')) {
            // Cerrar
            $target.slideUp(300, function() {
                console.log('Panel cerrado:', target);
            });
            $icon.removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
        } else {
            // Abrir
            $target.slideDown(300, function() {
                console.log('Panel abierto:', target);
            });
            $icon.removeClass('glyphicon-chevron-down').addClass('glyphicon-chevron-up');
        }
    });

    // ✅ CONFIGURAR ESTADO INICIAL
    setTimeout(function() {
        $('#contenido-resultados .panel-collapse').each(function() {
            var $panel = $(this);
            var panelId = $panel.attr('id');
            var $trigger = $('a[href="#' + panelId + '"]');
            var $icon = $trigger.find('.glyphicon-chevron-down, .glyphicon-chevron-up');

            // Verificar si debe estar abierto (clase 'in' o display: block)
            var debeEstarAbierto = $panel.hasClass('in') ||
                                  $panel.css('display') === 'block' ||
                                  $panel.attr('style') && $panel.attr('style').includes('display: block');

            if (debeEstarAbierto) {
                $panel.show();
                $icon.removeClass('glyphicon-chevron-down').addClass('glyphicon-chevron-up');
                console.log('Panel inicializado como abierto:', panelId);
            } else {
                $panel.hide();
                $icon.removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
                console.log('Panel inicializado como cerrado:', panelId);
            }
        });
    }, 300);

    console.log('✅ Paneles colapsables inicializados con implementación manual');
}

