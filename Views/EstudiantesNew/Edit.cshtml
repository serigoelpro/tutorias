@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit"></i> Editar Usuario
                    </h4>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
                    {
                        var tipoMensaje = ViewBag.MensajeTipo as string ?? "success";
                        var iconoMensaje = tipoMensaje == "success" ? "check-circle" :
                                          tipoMensaje == "warning" ? "exclamation-triangle" :
                                          tipoMensaje == "info" ? "info-circle" : "exclamation-circle";

                        <div class="alert alert-@tipoMensaje alert-dismissible fade show">
                            <i class="fas fa-@iconoMensaje"></i> @ViewBag.Mensaje
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Edit", "EstudiantesNew", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.IdUsuario)

                        <!-- Formulario simplificado con campos esenciales -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="NombreCompleto" class="form-label">
                                        <i class="fas fa-user"></i> Nombre Completo *
                                    </label>
                                    @Html.TextBoxFor(model => model.NombreCompleto, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.NombreCompleto, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="UserName" class="form-label">
                                        <i class="fas fa-id-card"></i> Usuario *
                                    </label>
                                    @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="Password" class="form-label">
                                        <i class="fas fa-key"></i> Contraseña
                                    </label>
                                    <div class="input-group">
                                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", id = "passwordField" })
                                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                            <i class="fas fa-eye" id="toggleIcon"></i>
                                        </button>
                                    </div>
                                    <small class="form-text text-muted">Deje en blanco para mantener la contraseña actual</small>
                                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="CorreoElectronico" class="form-label">
                                        <i class="fas fa-envelope"></i> Correo Electrónico
                                    </label>
                                    @Html.TextBoxFor(model => model.CorreoElectronico, new { @class = "form-control", type = "email" })
                                    @Html.ValidationMessageFor(model => model.CorreoElectronico, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-toggle-on"></i> Estado
                                    </label>
                                    <div class="form-check">
                                        @Html.CheckBoxFor(model => model.Estado, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="Estado">
                                            Usuario habilitado
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ml-3">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ViewsStyles/Master/sga-theme.js"></script>
    <script>
        // Toggle password visibility
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordField = document.getElementById('passwordField');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        });
    </script>
}
