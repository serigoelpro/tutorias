@model IEnumerable<Plataforma_Web.Models.Usuario>

@{
    ViewBag.Title = "Gestión de Coordinadores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
    <style>
        .sga-scope .sga-filter-bar {
            border: 1px solid #cfe8e2;
            color: var(--primary);
            background: #e9f8f4;
            border-radius: 10px;
            font-weight: 600;
            padding: 10px 15px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px 10px;
        }

            .sga-scope .sga-filter-bar strong {
                margin-right: 5px;
            }

            .sga-scope .sga-filter-bar .btn-utt-outline {
                padding: 4px 10px;
                font-size: 0.9rem;
            }

        #coordinadoresTable td[data-label="Acciones"] .btn {
            display: block;
            width: 100%;
            max-width: 120px;
            margin: 5px auto;
            box-sizing: border-box;
        }
    </style>
}

<div class="sga-scope">
    <h2>Gestión de Coordinadores</h2>
    @if (ViewBag.Carreras != null)
    {
        <div class="row" style="margin-bottom: 20px;">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="filtroCarrera" class="control-label">Filtrar por carrera:</label>
                    @using (Html.BeginForm("Index", "AsignarCoordinadoresMaster", FormMethod.Get, new { id = "formFiltroCarrera" }))
                    {
                        @Html.DropDownList("idCarrera", ViewBag.Carreras as SelectList, "-- Todas las carreras --",
                                 new { @class = "form-control", @id = "filtroCarrera", @onchange = "this.form.submit();" })
                    }
                </div>
                <!-- Buscador -->
                <div class="form-group" style="margin-top:8px;">
                    <label for="buscarUsuarios" class="control-label">Buscar:</label>
                    <input id="buscarUsuarios" type="text" class="form-control" />
                </div>

            </div>
            @if (ViewBag.CarreraSeleccionada != null)
            {
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label">&nbsp;</label>
                        <div>
                            <a href="@Url.Action("Index", "AsignarCoordinadoresMaster")" class="btn btn-utt-outline">Limpiar filtro</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }


    <a href="@Url.Action("AsignarCoordinador", "AsignarCoordinadoresMaster")" class="btn btn-utt-outline">Asignar nuevo coordinador</a>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info">
            @ViewBag.Mensaje
        </div>
    }

    @* Información del filtro activo *@
    @if (ViewBag.CarreraSeleccionada != null)
    {
        var carreraSeleccionada = ((SelectList)ViewBag.Carreras).FirstOrDefault(x => x.Value == ViewBag.CarreraSeleccionada.ToString());

        if (carreraSeleccionada != null)
        {
            <div class="sga-filter-bar" style="margin-bottom: 20px; margin-top: 15px;">

                <strong>Filtros activos:</strong>

                <span>
                    Carrera: <strong>@carreraSeleccionada.Text</strong>
                </span>

                <a href="@Url.Action("Index")" class="btn-utt-outline" style="text-decoration: none;">
                    <span class="glyphicon glyphicon-remove"></span> Quitar filtro
                </a>
            </div>
        }
    }

    <div class="table-responsive">
        <table id="coordinadoresTable" class="table table-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.NombreCompleto)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserName)
                    </th>
                    <th>
                        Estado
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CorreoElectronico)
                    </th>
                    <th>
                        Microsoft ID
                    </th>
                    @* Mostrar columna Carrera solo para usuarios Master *@
                    @if (ViewBag.Carreras != null)
                    {
                        <th>
                            Carrera
                        </th>
                    }
                    <th>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Nombre completo">
                            @Html.DisplayFor(modelItem => item.NombreCompleto)
                        </td>
                        <td data-label="Usuario">
                            @Html.DisplayFor(modelItem => item.UserName)
                        </td>
                        <td data-label="Estado">
                            @(item.Estado ? "Activo" : "Inactivo")
                        </td>
                        <td data-label="Correo Electr nico">
                            @Html.DisplayFor(modelItem => item.CorreoElectronico)
                        </td>
                        <td data-label="Microsoft ID">
                            @(string.IsNullOrEmpty(item.MicrosoftIdentifier) ? "No asignado" : "Asignado")
                        </td>
                        @if (ViewBag.Carreras != null)
                        {
                            <td data-label="Carrera">
                                @{
                                    var carrera = ((SelectList)ViewBag.Carreras).FirstOrDefault(x => x.Value == item.IdCarrera.ToString());
                                }
                                @(carrera != null ? carrera.Text : "Sin carrera")
                            </td>
                        }
                        <td data-label="Acciones">
                            <a href="@Url.Action("EditarCoordinador", new { id = item.IdUsuario })" class="btn btn-warning btn-sm">
                                <i class="fa fa-pencil"></i>&nbsp; Editar
                            </a>

                            <a href="@Url.Action("EliminarCoordinador", new { id = item.IdUsuario })" class="btn btn-danger btn-sm">
                                <i class="fa fa-trash"></i>&nbsp; Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/ViewsStyles/Master/sga-theme.js"></script>
    <script>
        $(function () {
            var table = $('#coordinadoresTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json" },
                pageLength: 25,
                responsive: true,
                dom: '<"row"<"col-sm-12"f>>t<"row"<"col-sm-5"i><"col-sm-7"p>>',
                initComplete: function () {
                    // input
                    var $dtFilter = $('#coordinadoresTable_filter');
                    var $dtInput = $dtFilter.find('input');

                    //estilo
                    $dtInput
                        .addClass('form-control')
                        .attr('placeholder', 'Buscar')
                        .attr('id', 'buscarUsuarios');

                    $('#buscarUsuarios').replaceWith($dtInput);

                    // Quitamos el contenedor original para que no quede duplicado abajo/arriba
                    $dtFilter.remove();
                }
            });
        });</script>

}