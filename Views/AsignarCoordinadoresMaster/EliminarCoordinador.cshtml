@model Plataforma_Web.Models.Usuario

@{
    ViewBag.Title = "Eliminar Coordinador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/ViewsStyles/Master/sga-theme.css" rel="stylesheet" />
}
<div class="sga-scope">
    <h2>Eliminar Coordinador</h2>

    <div class="alert alert-warning">
        <h4>¿Está seguro de que desea eliminar este coordinador?</h4>
        <p>Esta acción cambiará el nivel de acceso del usuario, pero no eliminará el registro completamente.</p>
    </div>

    <div>
        <h4>Información del Coordinador</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.NombreCompleto)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.NombreCompleto)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.UserName)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.UserName)
            </dd>

            <dt>
                Estado
            </dt>
            <dd>
                @(Model.Estado ? "Activo" : "Inactivo")
            </dd>

            @if (!string.IsNullOrEmpty(Model.MicrosoftIdentifier))
            {
                <dt>
                    Microsoft Identifier
                </dt>
                <dd>
                    @Model.MicrosoftIdentifier
                </dd>
            }

            <dt>
                @Html.DisplayNameFor(model => model.Tiempo)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Tiempo)
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Confirmar Eliminación" class="btn btn-danger"
                       onclick="return confirm('¿Está completamente seguro de eliminar este coordinador?')" />
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
@section Scripts {
    <script src="~/ViewsStyles/Master/sga-theme.js"></script>
}


